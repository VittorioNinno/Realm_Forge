    //	Saves a changed token, and puts it back as it was if the API refuses
    private async Task SaveTokenAsync(MapTokenDto before, MapTokenDto after)
    {
        if (map is null)
        {
            return;
        }
        Replace(after);
        if (!(await Campaigns.UpdateTokenAsync(CampaignId, map.Id, before.Id, ToSave(after))).Ok)
        {
            Replace(before);
            message = UiText.MapSaveFailed(Lang);
        }
    }

    private Task SetColorAsync(MapTokenDto t, string? color) =>
        color is { Length: 7 } && color.StartsWith('#') ? SaveTokenAsync(t, t with { Color = color }) : Task.CompletedTask;

    private Task ToggleControlAsync(MapTokenDto t, string userId)
    {
        var list = (t.ControlledBy ?? new()).ToList();
        if (!list.Remove(userId))
        {
            list.Add(userId);
        }
        return SaveTokenAsync(t, t with { ControlledBy = list });
    }

    private Task AddHpAsync(MapTokenDto t, int delta) => SetHpAsync(t, Math.Max(0, (t.Hp ?? t.MaxHp ?? 0) + delta));

    private Task SetMaxHpAsync(MapTokenDto t, int max) =>
        SaveTokenAsync(t, t with { MaxHp = max > 0 ? max : null, Hp = max > 0 ? Math.Min(t.Hp ?? max, max) : null });

    private async Task DuplicateTokenAsync(MapTokenDto t)
    {
        var copy = ToSave(t);
        var same = tokens.Count(x => x.MonsterId is not null && x.MonsterId == t.MonsterId);
        copy.Label = t.MonsterId is not null && monsters.TryGetValue(t.MonsterId.Value, out var m) ? $"{m.Name} {same + 1}" : t.Label;
        if (t.CharacterId is { } characterId)
        {
            //	A copy of a character: an NPC of its own (hit points, conditions) with the numbers of the character's sheet
            copy.SheetCharacterId = characterId;
            copy.Kind = TokenKind.Npc;
            copy.MaxHp = CharacterOf(t) is { } source ? Math.Max(1, LifeMax(source)) : 1;
            copy.Label = UiText.TokenCopyName(t.Label, Lang);
        }
        copy.CharacterId = null;
        copy.Hp = copy.MaxHp;
        await AddAsync(copy);
    }

    // ===== The quick sheet: what is needed at the table of a character, an NPC or a monster, in the side panel =====

    private sealed record SheetStat(string Top, string Value, string Bottom, bool Highlight);
    private sealed record SheetAbility(string Name, string Mod, int Score, bool Prime, TokenRoll Roll);
    private sealed record SheetSave(string Short, string Bonus, bool Proficient, TokenRoll Roll);
    //	An attack: its rolls, and what an attack at a target on the map needs (bonus, damage, reach, the weapon in the
    //	inventory that spends ammunition)
    private sealed record SheetLine(string Name, string Detail, TokenRoll? Roll, TokenRoll? Damage, int Bonus = 0, string? DamageDice = null,
        string? DamageType = null, AttackReach? Reach = null, Guid? InventoryId = null, string? Condition = null);
    private sealed record SheetProse(string Title, string Markdown);
    private sealed record QuickSheet(string Kind, string Sub, string Line, string Extra, List<SheetStat> Vitals, List<SheetAbility> Abilities,
        List<SheetSave> Saves, string? SavesNote, List<SheetStat> Passives, List<SheetLine> Attacks, List<SheetProse> Prose, string? Link,
        List<SheetGroup>? Actions = null, List<SheetCasting>? Casting = null, List<SheetGroup>? Features = null);

    //	A named entry with its text (a trait, an action, a feature), in groups; the spells of a source with its numbers
    private sealed record SheetEntry(string Name, string Markdown, string? Badge = null);
    private sealed record SheetGroup(string Title, List<SheetEntry> Entries);
    private sealed record SheetSpell(Guid Id, string Name, int Level, bool Concentration, bool Ritual);
    private sealed record SheetCasting(string Title, string Line, TokenRoll? Attack, List<SheetSpell> Spells, string? Slots, bool UsesSlots = false);

    private Guid? sheetTokenId;

    private MapTokenDto? SheetToken => sheetTokenId is { } id ? tokens.FirstOrDefault(t => t.Id == id) : null;

    //	The sheets open in the side panel, one tab each (a token once), until their tab is closed
    private readonly List<Guid> openSheets = new();

    private IEnumerable<MapTokenDto> SheetTabs => openSheets.Select(id => tokens.FirstOrDefault(t => t.Id == id)).OfType<MapTokenDto>();

    private void ShowSheet(Guid id)
    {
        sheetTokenId = id;
        panel = "sheet";
    }

    private void CloseSheet(Guid id)
    {
        openSheets.Remove(id);
        if (sheetTokenId != id)
        {
            return;
        }
        sheetTokenId = SheetTabs.LastOrDefault()?.Id;
        if (panel == "sheet")
        {
            panel = sheetTokenId is not null ? "sheet" : null;
        }
    }

    //	The panel closed: its sheets with it
    private void ClosePanel()
    {
        panel = null;
        openSheets.Clear();
        sheetTokenId = null;
    }

    //	My characters (all of them for a master) and, for the masters, the monsters and NPCs
    //	A player reads the quick sheet of an ally (another character at the table, a friendly NPC) without touching it
    private bool PeekSheet(MapTokenDto t) => !RunsTheTable && !HasSheet(t) && IsAlly(t);

    private bool IsAlly(MapTokenDto t) => !t.Hidden && t.PropType is null
        && (t.CharacterId is not null || (t.Kind == TokenKind.Npc && t.MonsterId is { } id && monsters.TryGetValue(id, out var m) && m.Attitude == NpcAttitude.Friendly));

    private bool HasSheet(MapTokenDto t) =>
        t.CharacterId is not null ? CharacterOf(t) is { } c && (c.IsMine || RunsTheTable || t.Controlled)
        : (RunsTheTable || t.Controlled) && (t.MonsterId is not null || t.SheetCharacterId is not null);

    private void OpenSheet(MapTokenDto t)
    {
        if (!openSheets.Contains(t.Id))
        {
            openSheets.Add(t.Id);
        }
        sheetTokenId = t.Id;
        ShowPanel("sheet");
        _ = LoadStatsAsync(t);
    }

    private static string KindClass(MapTokenDto? t) => t?.Kind switch
    {
        TokenKind.Character => "pc",
        TokenKind.Npc => "npc",
        TokenKind.Monster => "monster",
        TokenKind.Prop => "prop",
        _ => "other"
    };

    //	The hit points of a token as far as I may know them: a bar and its text (only the state of health for the
    //	others' monsters)
    private sealed record Life(double Fraction, string Text);

    private Life? LifeOf(MapTokenDto t)
    {
        if (CharacterOf(t) is { } c && c.Character.MaxHitPoints > 0)
        {
            var (current, top) = (LifeHp(c), LifeMax(c));
            return new Life(Math.Clamp((double)current / Math.Max(1, top), 0, 1), $"{current}/{top}");
        }
        if (t.Hp is { } hp && t.MaxHp is { } max && max > 0)
        {
            return new Life(Math.Clamp((double)hp / max, 0, 1), $"{hp}/{max}");
        }
        return t.Health is { } health
            ? new Life(health switch { CombatantHealth.Unharmed => 1, CombatantHealth.Wounded => .75, CombatantHealth.Bloodied => .4, _ => 0 }, UiText.HealthName(health, Lang))
            : null;
    }

    private RenderFragment QuickSheetPanel(MapTokenDto t) => __builder =>
    {
        var sheet = StatsOf(t)?.Sheet;
        var life = LifeOf(t);
        var canRoll = CanRoll(t);
        var portrait = PortraitOf(t);
        <section class="rf-qs kind-@KindClass(t)" data-test="vtt-quick-sheet">
            <header class="rf-qs-top">
                <h2 class="rf-qs-title">@t.Label</h2>
                @if (PeekSheet(t))
                {
                    <span class="rf-qs-readonly" title="@UiText.VttSheetReadOnlyHint(Lang)" data-test="vtt-quick-sheet-readonly"><Icon Name="eye" /> @UiText.VttSheetReadOnly(Lang)</span>
                }
                @if (sheet?.Link is { } link)
                {
                    <a href="@link" class="rf-vtt-icon-button" target="_blank" title="@UiText.VttQuickSheetFull(Lang)" aria-label="@UiText.VttQuickSheetFull(Lang)" data-test="vtt-quick-sheet-full"><Icon Name="external" /></a>
                }
            </header>
            @if (sheet is null)
            {
                <p class="small mb-0" style="color: var(--rf-text-muted);">…</p>
            }
            else
            {
            <text>
            <div class="rf-qs-hero">
                <span class="rf-qs-avatar">
                    @if (portrait is not null)
                    {
                        <img src="@portrait" alt="" draggable="false" />
                    }
                    else
                    {
                        @Initials(t.Label)
                    }
                </span>
                <div class="rf-qs-meta">
                    <span class="rf-qs-sub">@sheet.Sub</span>
                    <strong class="rf-qs-line">@sheet.Line</strong>
                    @if (sheet.Extra.Length > 0)
                    {
                        <span class="rf-qs-extra">@sheet.Extra</span>
                    }
                </div>
                @if (life is not null)
                {
                    <div class="rf-qs-hp" data-test="vtt-quick-sheet-hp">
                        <span>@UiText.VttHitPointsShort(Lang)</span>
                        <strong>@life.Text</strong>
                    </div>
                }
            </div>
            @if (sheet.Vitals.Count > 0)
            {
                <div class="rf-qs-vitals">
                    @foreach (var v in sheet.Vitals)
                    {
                        <div class="rf-qs-vital @(v.Highlight ? "highlight" : null)">
                            <span>@v.Top</span>
                            <strong>@v.Value</strong>
                            <span>@v.Bottom</span>
                        </div>
                    }
                </div>
            }
            @if (KnockedOut(t))
            {
                @DeathCard(t, canRoll)
            }
            @{
                var tabs = SheetTabsOf(sheet);
                if (RunsTheTable && t.CharacterId is null && t.PropType is null)
                {
                    tabs.Add("loot");
                }
                if (PeekSheet(t))
                {
                    //	An ally's notes stay with its owner and the masters
                    tabs.Remove("notes");
                }
                var current = qsTabs.GetValueOrDefault(t.Id) is { } chosen && tabs.Contains(chosen) ? chosen : "general";
            }
            @if (tabs.Count > 1)
            {
                <nav class="rf-qs-tabs" role="tablist">
                    @foreach (var key in tabs)
                    {
                        var k = key;
                        <button type="button" role="tab" class="@(current == k ? "active" : null)" aria-selected="@(current == k ? "true" : "false")" @onclick="() => qsTabs[t.Id] = k" data-test="vtt-quick-sheet-tab" data-tab="@k">@UiText.VttSheetTab(k, Lang)</button>
                    }
                </nav>
            }
            @switch (current)
            {
                case "actions":
                    @if (KnockedOut(t))
                    {
                        <p class="rf-qs-note rf-qs-down-note" data-test="vtt-quick-sheet-down"><Icon Name="moon-stars" /> @UiText.VttDownNoActions(Lang)</p>
                    }
                    @if (sheet.Attacks.Count > 0)
                    {
                        <section class="rf-qs-card">
                            <h3 class="rf-qs-card-title">@UiText.VttQuickAttacks(Lang)</h3>
                            <div class="rf-qs-attacks">
                                @foreach (var line in sheet.Attacks.Where(a => t.Gear?.Disarmed.Contains(a.Name) != true || t.CharacterId is not null))
                                {
                                    var attack = line;
                                    <div class="rf-qs-attack">
                                        <button type="button" class="rf-qs-attack-main" disabled="@(!canRoll || busy || attack.Roll is null || KnockedOut(t))" @onclick="() => RollAsync(t, attack.Roll!)" data-test="map-token-attack">
                                            <span class="rf-qs-attack-name">@attack.Name</span>
                                            <span class="rf-qs-attack-detail">@attack.Detail</span>
                                        </button>
                                        @if (CanAim(t) && !KnockedOut(t))
                                        {
                                            <button type="button" class="rf-qs-attack-damage aim @(aim is { } aiming && aiming.AttackerId == t.Id && aiming.Attack.Name == attack.Name ? "active" : null)" disabled="@busy"
                                                    title="@UiText.VttAimStart(attack.Name, Lang)" aria-label="@UiText.VttAimStart(attack.Name, Lang)" @onclick="() => StartAimAsync(t, attack)" data-test="map-token-aim"><Icon Name="crosshair" /></button>
                                        }
                                        @if (attack.Damage is { } damage)
                                        {
                                            <button type="button" class="rf-qs-attack-damage" disabled="@(!canRoll || busy || KnockedOut(t))" title="@damage.Label" aria-label="@damage.Label" @onclick="() => RollAsync(t, damage)" data-test="map-token-damage-roll"><Icon Name="dice" /></button>
                                        }
                                    </div>
                                }
                            </div>
                            @if (t.CharacterId is null && t.Gear?.Disarmed is { Count: > 0 } lost)
                            {
                                <p class="rf-qs-note" data-test="vtt-quick-sheet-disarmed"><Icon Name="hammer" /> @UiText.VttDisarmed(string.Join(", ", lost), Lang)</p>
                            }
                        </section>
                    }
                    @foreach (var group in sheet.Actions ?? new())
                    {
                        @EntryGroup(group)
                    }
                    break;
                case "spells":
                    @foreach (var cast in sheet.Casting ?? new())
                    {
                        var casting = cast;
                        <section class="rf-qs-card" data-test="vtt-quick-sheet-spells">
                            <h3 class="rf-qs-card-title">@casting.Title</h3>
                            <div class="rf-qs-cast-head">
                                <span>@casting.Line</span>
                                @if (casting.Attack is { } spellAttack)
                                {
                                    <button type="button" class="rf-qs-attack-damage" disabled="@(!canRoll || busy || KnockedOut(t))" title="@spellAttack.Label" aria-label="@spellAttack.Label" @onclick="() => RollAsync(t, spellAttack)" data-test="map-token-spell-attack"><Icon Name="dice" /></button>
                                }
                            </div>
                            @if (casting.Slots is { } slots)
                            {
                                <p class="rf-qs-slots">@slots</p>
                            }
                            @foreach (var level in casting.Spells.GroupBy(sp => sp.Level))
                            {
                                <div class="rf-qs-spell-level">@UiText.VttSpellLevelName(level.Key, Lang)</div>
                                <div class="rf-qs-spells">
                                    @foreach (var sp in level)
                                    {
                                        var spell = sp;
                                        var picked = castChoice is { } cc && cc.TokenId == t.Id && cc.Spell.Id == spell.Id;
                                        @if (canRoll && t.CharacterId is not null && !KnockedOut(t))
                                        {
                                            <button type="button" class="rf-qs-spell @(picked ? "active" : null)" aria-expanded="@(picked ? "true" : "false")" @onclick="() => ChooseCast(t, spell, casting.UsesSlots)" data-test="map-token-spell">
                                                @spell.Name
                                                @if (spell.Concentration)
                                                {
                                                    <span class="rf-qs-spell-tag" title="@UiText.ConditionName(EncounterRules.Concentrating, Lang)">C</span>
                                                }
                                                @if (spell.Ritual)
                                                {
                                                    <span class="rf-qs-spell-tag">R</span>
                                                }
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="@($"spells?id={spell.Id}")" target="_blank" rel="noopener" class="rf-qs-spell">
                                                @spell.Name
                                                @if (spell.Concentration)
                                                {
                                                    <span class="rf-qs-spell-tag" title="@UiText.ConditionName(EncounterRules.Concentrating, Lang)">C</span>
                                                }
                                                @if (spell.Ritual)
                                                {
                                                    <span class="rf-qs-spell-tag">R</span>
                                                }
                                            </a>
                                        }
                                    }
                                </div>
                                @if (castChoice is { } choice && choice.TokenId == t.Id && level.Any(sp => sp.Id == choice.Spell.Id))
                                {
                                    @CastCard(t, choice)
                                }
                            }
                        </section>
                    }
                    break;
                case "features":
                    @foreach (var group in sheet.Features ?? new())
                    {
                        @EntryGroup(group)
                    }
                    break;
                case "loot":
                    @LootEditor(t)
                    break;
                case "notes":
                    @foreach (var prose in sheet.Prose)
                    {
                        <section class="rf-qs-card">
                            <h3 class="rf-qs-card-title">@prose.Title</h3>
                            <div class="rf-markdown-container rf-qs-prose">@((MarkupString)MarkdownText.ToHtml(prose.Markdown, null))</div>
                        </section>
                    }
                    break;
                default:
                    @if (CanRest(t))
                    {
                        <div class="rf-qs-rests">
                            <button type="button" class="rf-qs-rest" disabled="@restBusy" @onclick="@(() => OpenRestAsync(t, false))" data-test="map-token-short-rest">@UiText.BtnShortRest(Lang)</button>
                            <button type="button" class="rf-qs-rest" disabled="@restBusy" @onclick="@(() => OpenRestAsync(t, true))" data-test="map-token-long-rest">@UiText.BtnLongRest(Lang)</button>
                        </div>
                    }
                    <div class="rf-qs-abilities">
                        @foreach (var a in sheet.Abilities)
                        {
                            var ability = a;
                            <button type="button" class="rf-qs-ability @(ability.Prime ? "prime" : null)" disabled="@(!canRoll || busy)" title="@ability.Roll.Label" @onclick="() => RollAsync(t, ability.Roll)" data-test="map-token-roll">
                                <span class="rf-qs-ability-name">@ability.Name</span>
                                <strong>@ability.Mod</strong>
                                <span class="rf-qs-ability-score">@ability.Score</span>
                            </button>
                        }
                    </div>
                    @if (sheet.Saves.Count > 0)
                    {
                        <section class="rf-qs-card">
                            <h3 class="rf-qs-card-title">@UiText.VttSaves(Lang)</h3>
                            <div class="rf-qs-saves">
                                @foreach (var sv in sheet.Saves)
                                {
                                    var save = sv;
                                    <button type="button" class="rf-qs-save @(save.Proficient ? "prof" : null)" disabled="@(!canRoll || busy)" title="@save.Roll.Label" @onclick="() => RollAsync(t, save.Roll)" data-test="map-token-save">
                                        <span class="rf-qs-dot"></span><span class="rf-qs-save-name">@save.Short</span><strong>@save.Bonus</strong>
                                    </button>
                                }
                            </div>
                        </section>
                    }
                    else if (!string.IsNullOrWhiteSpace(sheet.SavesNote))
                    {
                        <section class="rf-qs-card">
                            <h3 class="rf-qs-card-title">@UiText.VttSaves(Lang)</h3>
                            <p class="rf-qs-note">@sheet.SavesNote</p>
                        </section>
                    }
                    @if (sheet.Passives.Count > 0)
                    {
                        <section class="rf-qs-card">
                            <h3 class="rf-qs-card-title">@UiText.VttPassives(Lang)</h3>
                            <div class="rf-qs-passives">
                                @foreach (var pv in sheet.Passives)
                                {
                                    <div class="rf-qs-passive"><strong>@pv.Value</strong><span>@pv.Bottom</span></div>
                                }
                            </div>
                        </section>
                    }
                    break;
            }
            </text>
            }
        </section>
    };

    //	A character at 0 hit points: unconscious, no actions nor bonus actions, only the death saves
    private bool KnockedOut(MapTokenDto t) => t.CharacterId is { } id && Characters.FirstOrDefault(c => c.Character.Id == id) is { } c && LifeMax(c) > 0 && LifeHp(c) == 0;

    private bool deathRolling;
    private string? deathNote;

    private RenderFragment DeathCard(MapTokenDto t, bool canRoll) => __builder =>
    {
        var id = t.CharacterId!.Value;
        var vitals = charVitals.GetValueOrDefault(id);
        if (vitals is null)
        {
            _ = LoadVitalsAsync(id);
        }
        var successes = vitals?.DeathSaveSuccesses ?? 0;
        var failures = vitals?.DeathSaveFailures ?? 0;
        var stable = successes >= 3;
        var dead = failures >= 3;
        <section class="rf-death rf-qs-death @(stable ? "stable" : dead ? "dead" : null)" data-test="vtt-death-saves">
            <div class="rf-death-head">
                <span class="rf-qs-card-title mb-0">@UiText.SheetDeathSaves(Lang)</span>
                <span class="rf-death-state" data-test="vtt-death-state">@(stable ? UiText.DeathSaveStable(Lang) : dead ? UiText.DeathSaveDead(Lang) : UiText.VttDownState(Lang))</span>
            </div>
            <div class="rf-death-body">
                <div class="rf-death-group">
                    <span>@UiText.SheetSuccesses(Lang)</span>
                    @for (var i = 1; i <= 3; i++)
                    {
                        <span class="rf-death-box success @(successes >= i ? "on" : null)"></span>
                    }
                </div>
                <div class="rf-death-group">
                    <span>@UiText.SheetFailures(Lang)</span>
                    @for (var i = 1; i <= 3; i++)
                    {
                        <span class="rf-death-box fail @(failures >= i ? "on" : null)"></span>
                    }
                </div>
                @if (canRoll && !PeekSheet(t))
                {
                    <button type="button" class="rf-death-roll" disabled="@(stable || dead || deathRolling || busy || vitals is null)" @onclick="() => RollDeathSaveAsync(t)" data-test="vtt-death-roll">@UiText.BtnRollDeathSave(Lang)</button>
                }
            </div>
            @if (deathNote is not null)
            {
                <div class="rf-death-note" data-test="vtt-death-note">@deathNote</div>
            }
        </section>
    };

    //	The d20 goes to the log like any roll, then the sheet takes the result
    private async Task RollDeathSaveAsync(MapTokenDto t)
    {
        if (deathRolling)
        {
            return;
        }
        deathRolling = true;
        deathNote = null;
        try
        {
            var rolled = await RollForAsync(t, new TokenRoll(UiText.SheetDeathSaves(Lang), string.Empty, "1d20", false));
            if (rolled?.Dice.FirstOrDefault(d => !d.Dropped)?.Value is not { } die)
            {
                return;
            }
            RealmForge.Shared.Characters.CharacterVitals.DeathSaveOutcome? outcome = null;
            await ChangeCharacterAsync(t, (sheet, computed) => outcome = RealmForge.Shared.Characters.CharacterVitals.DeathSave(sheet, Math.Max(1, computed.MaxHitPoints), die));
            if (outcome is { } o)
            {
                deathNote = (o.Twenty ? UiText.DeathSaveTwenty(Lang) : o.One ? UiText.DeathSaveOne(Lang) : o.Success ? UiText.DeathSaveSuccess(Lang) : UiText.DeathSaveFailure(Lang))
                    + (o.Stable ? " · " + UiText.DeathSaveStable(Lang) : o.Dead ? " · " + UiText.DeathSaveDead(Lang) : string.Empty);
            }
        }
        finally
        {
            deathRolling = false;
            StateHasChanged();
        }
    }

    //	The tab of the quick sheet each token shows
    private readonly Dictionary<Guid, string> qsTabs = new();

    private static List<string> SheetTabsOf(QuickSheet sheet)
    {
        var tabs = new List<string> { "general" };
        if (sheet.Attacks.Count > 0 || sheet.Actions is { Count: > 0 })
        {
            tabs.Add("actions");
        }
        if (sheet.Casting is { Count: > 0 })
        {
            tabs.Add("spells");
        }
        if (sheet.Features is { Count: > 0 })
        {
            tabs.Add("features");
        }
        if (sheet.Prose.Count > 0)
        {
            tabs.Add("notes");
        }
        return tabs;
    }

    private RenderFragment EntryGroup(SheetGroup group) => __builder =>
    {
        <section class="rf-qs-card">
            <h3 class="rf-qs-card-title">@group.Title</h3>
            <div class="rf-qs-entries">
                @foreach (var entry in group.Entries)
                {
                    @if (string.IsNullOrWhiteSpace(entry.Markdown))
                    {
                        <div class="rf-qs-entry plain">
                            <span>@entry.Name</span>
                            @if (entry.Badge is { } badge)
                            {
                                <span class="rf-qs-entry-badge">@badge</span>
                            }
                        </div>
                    }
                    else if (entry.Name.Length == 0)
                    {
                        <div class="rf-markdown-container rf-qs-prose">@((MarkupString)MarkdownText.ToHtml(entry.Markdown, null))</div>
                    }
                    else
                    {
                        <details class="rf-qs-entry">
                            <summary>
                                <span>@entry.Name</span>
                                @if (entry.Badge is { } badge)
                                {
                                    <span class="rf-qs-entry-badge">@badge</span>
                                }
                            </summary>
                            <div class="rf-markdown-container rf-qs-prose">@((MarkupString)MarkdownText.ToHtml(entry.Markdown, null))</div>
                        </details>
                    }
                }
            </div>
        </section>
    };

    //	A spell chosen in the quick sheet: the slot to cast it with (a cantrip, a spell without slots: just cast), its page
    private RenderFragment CastCard(MapTokenDto t, CastChoice choice) => __builder =>
    {
        var spell = choice.Spell;
        var slots = spell.Level > 0 && choice.UsesSlots ? CastSlots(t, spell) : new();
        <div class="rf-qs-cast" data-test="map-token-cast">
            <div class="rf-qs-cast-title">
                <strong>@spell.Name</strong>
                <a href="@($"spells?id={spell.Id}")" target="_blank" rel="noopener" class="rf-vtt-icon-button" title="@UiText.VttCastDetails(Lang)" aria-label="@UiText.VttCastDetails(Lang)"><Icon Name="external" /></a>
            </div>
            @if (spell.Level == 0 || !choice.UsesSlots)
            {
                <button type="button" class="rf-qs-cast-slot" disabled="@busy" @onclick="() => CastAsync(t, spell, 0, false)" data-test="map-token-cast-go"><Icon Name="magic" /> @UiText.VttCast(Lang)</button>
            }
            else if (slots.Count == 0)
            {
                <p class="rf-qs-note mb-0">@UiText.VttCastNoSlot(Lang)</p>
            }
            else
            {
                <div class="rf-qs-cast-slots">
                    @foreach (var sl in slots)
                    {
                        var slot = sl;
                        <button type="button" class="rf-qs-cast-slot @(slot.Pact ? "pact" : null)" disabled="@busy" @onclick="() => CastAsync(t, spell, slot.Level, slot.Pact)" data-test="map-token-cast-slot" data-level="@slot.Level">
                            <Icon Name="magic" /> @(slot.Pact ? UiText.CastPact(slot.Level, Lang) : UiText.VttSpellLevelName(slot.Level, Lang)) <small>(@slot.Left)</small>
                        </button>
                    }
                </div>
            }
        </div>
    };

    //	The masters fill what a creature carries: items with their quantity, coins
    private RenderFragment LootEditor(MapTokenDto t) => __builder =>
    {
        var draft = LootOf(t);
        <section class="rf-qs-card" data-test="vtt-loot">
            <h3 class="rf-qs-card-title">@UiText.VttLoot(Lang)</h3>
            <p class="rf-qs-note">@UiText.VttLootHint(Lang)</p>
            @if (draft.Items.Count > 0)
            {
                <ul class="rf-qs-loot">
                    @foreach (var entry in draft.Items.ToList())
                    {
                        var item = entry;
                        <li>
                            <span>@item.Name</span>
                            <input type="number" class="rf-hud-hp-amount" min="1" max="999" value="@item.Quantity" @onchange="e => item.Quantity = int.TryParse(e.Value?.ToString(), out var q) ? Math.Clamp(q, 1, 999) : item.Quantity" aria-label="@UiText.LabelQuantity(Lang)" />
                            <button type="button" class="rf-vtt-icon-button" title="@UiText.BtnRemove(Lang)" aria-label="@UiText.BtnRemove(Lang)" @onclick="() => draft.Items.Remove(item)"><Icon Name="trash" /></button>
                        </li>
                    }
                </ul>
            }
            <div class="rf-qs-loot-add">
                <input class="rf-form-control" maxlength="100" placeholder="@UiText.VttLootItem(Lang)" @bind="draft.NewName" @bind:event="oninput" @onkeydown="e => LootKey(e, draft)" data-test="vtt-loot-name" />
                <input type="number" class="rf-hud-hp-amount" min="1" max="999" @bind="draft.NewQuantity" aria-label="@UiText.LabelQuantity(Lang)" data-test="vtt-loot-qty" />
                <button type="button" class="btn btn-sm btn-rf-outline" disabled="@string.IsNullOrWhiteSpace(draft.NewName)" @onclick="() => AddLoot(draft)" data-test="vtt-loot-add"><Icon Name="plus" /></button>
            </div>
            <label class="rf-qs-loot-coins">
                <Icon Name="coin" /> <span>@UiText.VttLootCoins(Lang)</span>
                <input type="number" class="rf-hud-hp-amount" min="0" max="1000000" @bind="draft.Coins" data-test="vtt-loot-coins" />
            </label>
            <button type="button" class="btn btn-sm btn-rf-orange" disabled="@busy" @onclick="() => SaveLootAsync(t, draft)" data-test="vtt-loot-save">@UiText.MapSave(Lang)</button>
            @if (gearNote is not null)
            {
                <p class="rf-qs-note mb-0" data-test="vtt-loot-note">@gearNote</p>
            }
        </section>
    };

    private void LootKey(KeyboardEventArgs e, LootDraft draft)
    {
        if (e.Key == "Enter")
        {
            AddLoot(draft);
        }
    }

    //	What can be taken from a token (an item on the ground, a beaten creature's loot), by my tokens next to it
    private RenderFragment TakeList(MapTokenDto it) => __builder =>
    {
        var gear = it.Gear;
        var takers = Takers(it);
        <div class="rf-hud-take" data-test="map-token-take">
            @if (gear is null || (gear.Items.Count == 0 && gear.Coins == 0))
            {
                <p class="small mb-0">@UiText.VttLootEmpty(Lang)</p>
            }
            else
            {
                <ul class="rf-hud-take-list">
                    @foreach (var entry in gear.Items)
                    {
                        var item = entry;
                        <li>
                            <span>@item.Name@(item.Quantity > 1 ? $" ×{item.Quantity}" : null)</span>
                            @foreach (var tk in takers.Take(3))
                            {
                                var taker = tk;
                                <button type="button" class="rf-hud-pill" disabled="@busy" title="@UiText.VttTakeBy(taker.Label, Lang)" @onclick="() => TakeAsync(it, taker, item.Index)" data-test="map-token-take-item">
                                    <Icon Name="hand-index" /> @(takers.Count > 1 ? taker.Label : UiText.VttTake(Lang))
                                </button>
                            }
                        </li>
                    }
                    @if (gear.Coins > 0)
                    {
                        <li>
                            <span><Icon Name="coin" /> @UiText.VttLootCoinsValue(gear.Coins, Lang)</span>
                            @foreach (var tk in takers.Take(3))
                            {
                                var taker = tk;
                                <button type="button" class="rf-hud-pill" disabled="@busy" title="@UiText.VttTakeBy(taker.Label, Lang)" @onclick="() => TakeAsync(it, taker, -1)" data-test="map-token-take-coins">
                                    <Icon Name="hand-index" /> @(takers.Count > 1 ? taker.Label : UiText.VttTake(Lang))
                                </button>
                            }
                        </li>
                    }
                </ul>
                @if (takers.Count == 0)
                {
                    <p class="small mb-0" data-test="map-token-take-far">@UiText.VttTakeNear(Lang)</p>
                }
                else if (combat is not null)
                {
                    <p class="small mb-0 rf-hud-take-cost">@UiText.VttTakeCost(Lang)</p>
                }
            }
            @if (gearNote is not null)
            {
                <p class="small mb-0" data-test="map-token-take-note">@gearNote</p>
            }
        </div>
    };

    //	Over the map, while aiming an attack or placing the area of a spell: what is going on, the options, cancel; then
    //	what the last cast did
    private RenderFragment CombatBar => __builder =>
    {
