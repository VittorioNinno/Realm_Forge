                    <button type="button" @onclick="() => ZoomByHand(-1)" aria-label="−" data-test="map-zoom-out"><Icon Name="dash" /></button>
                    <span data-test="map-zoom">@($"{zoom * 100:0}%")</span>
                    <button type="button" @onclick="() => ZoomByHand(1)" aria-label="+" data-test="map-zoom-in"><Icon Name="plus" /></button>
                    <button type="button" @onclick="FitByHand" title="@UiText.VttFit(Lang)" aria-label="@UiText.VttFit(Lang)" data-test="map-fit"><Icon Name="aspect-ratio" /></button>
                    @if (RunsTheTable)
                    {
                        <button type="button" @onclick="FocusAsync" title="@UiText.VttFocus(Lang)" aria-label="@UiText.VttFocus(Lang)" data-test="vtt-focus"><Icon Name="crosshair" /></button>
