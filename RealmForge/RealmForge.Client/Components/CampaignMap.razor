    private string? propMessage;

    //	Opens or closes an object; a locked one says so
    private async Task InteractAsync(MapTokenDto t)
    {
        if (map is null)
        {
            return;
        }
        busy = true;
        var (changed, stuck) = await Campaigns.InteractAsync(CampaignId, map.Id, t.Id);
        busy = false;
