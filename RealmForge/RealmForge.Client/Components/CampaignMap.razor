    //	The second row of the dock (masters): art, below the others, who controls it, copy, remove
    private bool moreDock;

    //	Healing and damage by the amount typed (Enter: damage, the usual case in a fight)
    private int? hpAmount;

    // ----- Hit points from the pop-up: a master, and whoever has the token (a character: its sheet) -----

    //	The hit points, temporary ones and maximum of the characters, read from their sheets when the pop-up asks
    private readonly Dictionary<Guid, SheetVitalsDto> charVitals = new();

    //	The players see the simple pop-up of what is not theirs: nothing to open under it
    private bool HasDock(MapTokenDto t, CampaignCharacterDto? character) =>
        RunsTheTable || (t.PropType is null && (CanChangeHp(t, character) || t.Controlled || HasLoot(t) || (Table && CanDrop(t)) || character?.CanOpen == true));

    //	Conditions: the masters any token; a character's (on its sheet) also its owner and whoever has it
    private bool CanChangeConditions(MapTokenDto t, CampaignCharacterDto? character) => t.PropType is null && (character is not null
        ? character.IsMine || (RunsTheTable && character.CanEdit) || t.Controlled
        : RunsTheTable);

    private static int? ArmorOf(MapTokenDto t, MonsterResponseDto? monster) => t.ArmorClass ?? monster?.ArmorClass;

    private async Task SetCurrentAsync(MapTokenDto t, string? text)
    {
        if (!int.TryParse(text, out var hp))
        {
            return;
        }
        hp = Math.Clamp(hp, 0, 100_000);
        if (t.CharacterId is not null)
        {
            await ChangeCharacterAsync(t, (sheet, computed) => sheet.CurrentHitPoints = Math.Min(hp, Math.Max(1, computed.MaxHitPoints)));
        }
        else
        {
            await SetVitalsAsync(t, hp, null, null);
        }
    }

    private async Task SetArmorAsync(MapTokenDto t, string? text)
    {
        if (map is null || !int.TryParse(text, out var armor) || armor is < 1 or > 50)
        {
            return;
        }
        Replace(t with { ArmorClass = armor });
        if (!(await Campaigns.SetTokenExtrasAsync(CampaignId, map.Id, t.Id, (t.Conditions ?? new()).ToList(), null, armor)).Ok)
        {
            Replace(t);
            message = UiText.MapSaveFailed(Lang);
        }
    }

    private async Task ToggleShowHpAsync(MapTokenDto t)
    {
        if (map is null)
        {
            return;
        }
        Replace(t with { ShowHp = !t.ShowHp });
        if (!(await Campaigns.SetTokenExtrasAsync(CampaignId, map.Id, t.Id, (t.Conditions ?? new()).ToList(), !t.ShowHp, null)).Ok)
        {
            Replace(t);
            message = UiText.MapSaveFailed(Lang);
        }
    }

    private bool CanChangeHp(MapTokenDto t, CampaignCharacterDto? character) => t.PropType is null && (character is not null
        ? character.IsMine || (RunsTheTable && character.CanEdit) || t.Controlled
        : RunsTheTable || t.Controlled);

    private int LifeHp(CampaignCharacterDto c) => charVitals.TryGetValue(c.Character.Id, out var v) ? v.CurrentHitPoints ?? v.MaxHitPoints
        : hpAfterRest.TryGetValue(c.Character.Id, out var r) ? r.Now : c.Character.CurrentHitPoints;

    private int LifeMax(CampaignCharacterDto c) => charVitals.TryGetValue(c.Character.Id, out var v) ? v.MaxHitPoints
        : hpAfterRest.TryGetValue(c.Character.Id, out var r) ? r.Max : c.Character.MaxHitPoints;

    //	The hit points of the characters as the server sent them with the tokens: newer than those of the page
    //	(a monster hit one, a player healed on the sheet); a vitals read that no longer matches goes
    private void TakeSheetLife()
    {
        foreach (var t in tokens)
        {
            if (t.CharacterId is not { } id || t.SheetHp is not { } now || t.SheetMaxHp is not { } max)
            {
                continue;
            }
            hpAfterRest[id] = (now, max);
            if (charVitals.TryGetValue(id, out var v) && ((v.CurrentHitPoints ?? v.MaxHitPoints) != now || v.MaxHitPoints != max || v.TemporaryHitPoints != (t.SheetTempHp ?? 0)))
            {
                charVitals.Remove(id);
            }
        }
    }

    private async Task LoadVitalsAsync(Guid characterId)
    {
        if (await CharacterService.GetVitalsAsync(characterId) is { } vitals)
        {
            charVitals[characterId] = vitals;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HealAsync(MapTokenDto t, int sign)
    {
        if (hpAmount is not { } amount || amount <= 0)
        {
            return;
        }
        hpAmount = null;
        _ = ShowStrikeAsync(t.Id, sign > 0 ? "heal" : "hit", sign > 0 ? $"+{amount}" : $"−{amount}");
        if (t.CharacterId is not null)
        {
            await ChangeCharacterAsync(t, (sheet, computed) =>
            {
                //	As on the sheet: down at 0 (unconscious and prone, the death saves), awake again when healed
                var max = Math.Max(1, computed.MaxHitPoints);
                if (sign > 0)
                {
                    RealmForge.Shared.Characters.CharacterVitals.Heal(sheet, max, amount);
                }
                else
                {
                    RealmForge.Shared.Characters.CharacterVitals.Damage(sheet, max, amount, false, null);
                }
            });
            return;
        }
        var current = t.Hp ?? t.MaxHp ?? 0;
        var temp = t.TempHp ?? 0;
        if (sign > 0)
        {
            await SetVitalsAsync(t, t.MaxHp is { } top ? Math.Min(top, current + amount) : current + amount, null, null);
        }
        else
        {
            var absorbed = Math.Min(temp, amount);
            await SetVitalsAsync(t, Math.Max(0, current - (amount - absorbed)), absorbed > 0 ? temp - absorbed : null, null);
        }
    }

    private async Task SetTempHpAsync(MapTokenDto t, string? text)
    {
        if (!int.TryParse(text, out var temp))
        {
            return;
        }
        temp = Math.Clamp(temp, 0, 10_000);
        if (t.CharacterId is not null)
        {
            await ChangeCharacterAsync(t, (sheet, _) => sheet.TemporaryHitPoints = temp);
        }
        else
        {
            await SetVitalsAsync(t, null, temp, null);
        }
    }

    //	A new maximum: for a character, the adjustment of its sheet that brings it there
    private async Task SetMaxAsync(MapTokenDto t, string? text)
    {
        if (!int.TryParse(text, out var max) || max < 1)
        {
            return;
        }
        max = Math.Min(max, 100_000);
        if (t.CharacterId is not null)
        {
            await ChangeCharacterAsync(t, (sheet, computed) =>
            {
                sheet.MaxHitPointsAdjustment += max - computed.MaxHitPoints;
                if (sheet.CurrentHitPoints is { } hp)
                {
                    sheet.CurrentHitPoints = Math.Min(hp, max);
                }
            });
        }
        else
        {
            await SetVitalsAsync(t, null, null, max);
        }
    }

    private async Task SetVitalsAsync(MapTokenDto t, int? hp, int? temp, int? max)
    {
        if (map is null)
        {
            return;
        }
        var changed = t with
        {
            Hp = max is { } top ? Math.Min(hp ?? t.Hp ?? top, top) : hp ?? t.Hp,
            TempHp = temp is { } tv ? (tv > 0 ? tv : null) : t.TempHp,
            MaxHp = max ?? t.MaxHp
        };
        Replace(changed);
        if (!(await Campaigns.SetTokenStateAsync(CampaignId, map.Id, t.Id, (t.Conditions ?? new()).ToList(), hp, temp, max)).Ok)
        {
            Replace(t);
            message = UiText.MapSaveFailed(Lang);
        }
    }

    //	A character's sheet read now, changed and saved (the same as from the sheet itself)
    private async Task ChangeCharacterAsync(MapTokenDto t, Action<RealmForge.Shared.Characters.CharacterSheetState, RealmForge.Shared.Characters.ComputedCharacter> change)
    {
        if (t.CharacterId is not { } id)
        {
            return;
        }
        busy = true;
        (CharacterDto Character, RealmForge.Shared.Characters.ComputedCharacter Computed)? loaded = null;
        CharacterSavedDto? saved = null;
        try
        {
            //	Never left busy: a failure leaves the buttons usable and says so
            loaded = await ComputeCharacterAsync(id);
            if (loaded is { } ready)
            {
                change(ready.Character.Sheet, ready.Computed);
                RealmForge.Shared.Characters.CharacterVitals.Normalize(ready.Character.Sheet, Math.Max(1, ready.Computed.MaxHitPoints));
                saved = await CharacterService.SaveSheetAsync(id, ready.Character.Sheet);
            }
        }
        catch (Exception)
        {
            saved = null;
        }
        finally
        {
            busy = false;
        }
        if (loaded is not { } done)
        {
            message = UiText.MapSaveFailed(Lang);
            StateHasChanged();
            return;
        }
        var character = done.Character;
        if (saved is null)
        {
            message = UiText.MapSaveFailed(Lang);
            return;
        }
        message = null;
        var max = Math.Max(1, saved.MaxHitPoints);
        var now = Math.Clamp(saved.Vitals?.CurrentHitPoints ?? character.Sheet.CurrentHitPoints ?? max, 0, max);
        hpAfterRest[id] = (now, max);
        charVitals[id] = SheetVitalsDto.From(character.Sheet, max, saved.UpdatedAt);
        stats.Remove($"c:{id}");
        _ = LoadStatsAsync(t);
        StateHasChanged();
    }

    private Task HpKeyAsync(KeyboardEventArgs e, MapTokenDto t) => e.Key == "Enter" ? HealAsync(t, -1) : Task.CompletedTask;

