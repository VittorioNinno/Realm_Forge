    private async Task QuickCombatAsync()
    {
        if (map is null)
        {
            return;
        }
        var chosen = FightableTokens.Select(t => t.Id).ToList();
        if (chosen.Count == 0)
        {
            return;
        }
        await CombatCallAsync(() => Campaigns.QuickCombatAsync(CampaignId, map.Id, chosen));
    }

    private Task LeaveFightAsync(MapTokenDto t) => map is null ? Task.CompletedTask : CombatCallAsync(() => Campaigns.LeaveFightAsync(CampaignId, map.Id, t.Id));

    //	From the token's toolbar: into the fight, out of it, or a fight with this token alone
    private Task ToggleFightAsync(MapTokenDto t)
    {
        if (map is null)
        {
            return Task.CompletedTask;
        }
        if (combat is null)
        {
            return CombatCallAsync(() => Campaigns.QuickCombatAsync(CampaignId, map.Id, new List<Guid> { t.Id }));
        }
        return InFight(t) ? LeaveFightAsync(t) : CombatCallAsync(() => Campaigns.JoinFightAsync(CampaignId, map.Id, t.Id));
    }

    private bool InFight(MapTokenDto t) => combat is not null && t.CombatantId is { } id && combat.Order.Any(o => o.Id == id);

    private async Task SetInitiativeAsync(Guid combatantId, string? value)
    {
        if (map is not null && int.TryParse(value, out var initiative))
        {
            await CombatCallAsync(() => Campaigns.SetInitiativeAsync(CampaignId, map.Id, combatantId, Math.Clamp(initiative, -10, 99)));
        }
    }

    //	A player rolls the initiative of their character from the sheet's bonus, and it takes its place in the order
    private async Task RollInitiativeAsync(MapTokenDto t, Guid combatantId)
    {
        await LoadStatsAsync(t);
        if (StatsOf(t)?.Rolls.FirstOrDefault() is not { } roll || map is null)
        {
            return;
        }
        if (await RollForAsync(t, roll) is { } result)
        {
            await CombatCallAsync(() => Campaigns.SetInitiativeAsync(CampaignId, map.Id, combatantId, result.Total));
        }
    }

    private async Task CombatCallAsync(Func<Task<CampaignResult>> call)
    {
        busy = true;
        localEdits++;
        var result = await call();
        busy = false;
        message = result.Ok ? null : UiText.MapSaveFailed(Lang);
        await RefreshAsync();
    }

    private async Task StartCombatAsync()
    {
        if (map is null || encounterId is not { } id)
        {
            return;
        }
        busy = true;
        var result = await Campaigns.StartCombatAsync(CampaignId, map.Id, id);
        busy = false;
        message = result.Ok ? null : UiText.MapSaveFailed(Lang);
        if (result.Ok)
        {
            await SelectAsync(map.Id);
        }
    }

    private async Task NextTurnAsync()
    {
        if (map is null)
        {
            return;
        }
        busy = true;
        await Campaigns.NextTurnAsync(CampaignId, map.Id);
        await RefreshAsync();
        busy = false;
    }

    private async Task EndCombatAsync()
    {
        if (map is null)
        {
            return;
        }
        busy = true;
        await Campaigns.EndCombatAsync(CampaignId, map.Id);
        combat = null;
        await LoadEncountersAsync();
        await RefreshAsync();
        busy = false;
    }

    //	The state of the map now, without waiting for the next poll
    private async Task RefreshAsync()
    {
        if (map is null || await Campaigns.GetMapStateAsync(CampaignId, map.Id) is not { } state)
        {
            return;
        }
        map = map with { UpdatedAt = state.UpdatedAt };
        localEdits++;
        tokens = state.Tokens;
        TakeSheetLife();
        TakeTerrain(state.Terrain);
        shapes = state.Shapes ?? new();
        ApplyTable(state.Table, first: false);
        ApplyCombat(state.Combat);
    }

    private async Task FocusTokenAsync(MapTokenDto? t)
    {
        if (t is null || string.IsNullOrEmpty(stageElement.Id))
        {
            return;
        }
        var (x, y) = MapGeometry.Center(gridType, grid, offsetX, offsetY, t.X, t.Y, t.Size);
        await JS.InvokeVoidAsync("rfVtt.center", stageElement, x, y);
    }

    private static string HpColor(double share) => share > 0.5 ? "#22c55e" : share > 0.25 ? "#f59e0b" : "#ef4444";

    private async Task SetStateAsync(MapTokenDto t, List<string> conditions, int? hp)
    {
        if (map is null)
        {
            return;
        }
        var changed = t with { Conditions = conditions, Hp = hp ?? t.Hp };
        Replace(changed);
        if (!(await Campaigns.SetTokenStateAsync(CampaignId, map.Id, t.Id, conditions, hp)).Ok)
        {
            Replace(t);
            message = UiText.MapSaveFailed(Lang);
        }
    }

    private async Task ToggleConditionAsync(MapTokenDto t, string key)
    {
        var list = (t.Conditions ?? new()).ToList();
        var adding = !list.Remove(key);
        if (adding)
        {
            list.Add(key);
        }
        if (t.CharacterId is null)
        {
            await SetStateAsync(t, list, null);
            return;
        }
        //	A character's conditions are on its sheet
        Replace(t with { Conditions = list });
        await ChangeCharacterAsync(t, (sheet, _) =>
        {
            if (key == EncounterRules.Exhaustion)
            {
                sheet.Exhaustion = adding ? Math.Max(1, sheet.Exhaustion) : 0;
            }
            else if (key == EncounterRules.Concentrating)
            {
                if (!adding)
                {
                    sheet.Concentration = null;
                }
            }
            else if (adding)
            {
                if (!sheet.Conditions.Contains(key))
                {
                    sheet.Conditions.Add(key);
                }
            }
            else
            {
                sheet.Conditions.Remove(key);
            }
        });
    }

    private Task SetHpAsync(MapTokenDto t, int hp) => SetStateAsync(t, (t.Conditions ?? new()).ToList(), hp);

    // ===== Rolls and speed from the sheet or the statblock =====

    //	The sheet a token's numbers come from: its character, the character it is a copy of, its statblock
    private static Guid? SheetIdOf(MapTokenDto t) => t.CharacterId ?? t.SheetCharacterId;

    private static string StatsKey(MapTokenDto t) => SheetIdOf(t) is { } c ? $"c:{c}" : t.MonsterId is { } m ? $"m:{m}" : string.Empty;

    private TokenStats? StatsOf(MapTokenDto t) => stats.TryGetValue(StatsKey(t), out var found) ? found : null;

    //	My characters roll from the map; the masters roll for the monsters (behind the screen)
    private bool CanRoll(MapTokenDto t) =>
        (t.CharacterId is not null && (CharacterOf(t)?.IsMine == true || t.Controlled))
        || ((RunsTheTable || t.Controlled) && (t.MonsterId is not null || t.SheetCharacterId is not null) && t.CharacterId is null);

    //	A speed of 0 (grappled, restrained…) keeps the token where it is
    private int? SpeedCells(MapTokenDto t) => StatsOf(t)?.SpeedFeet is { } feet ? feet / 5 : null;

    private async Task PreloadStatsAsync()
    {
        foreach (var t in tokens.Where(t => t.CanMove && StatsKey(t).Length > 0).DistinctBy(StatsKey).Take(16).ToList())
        {
            await LoadStatsAsync(t);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadStatsAsync(MapTokenDto t)
    {
        var key = StatsKey(t);
        if (key.Length == 0 || stats.ContainsKey(key))
        {
            return;
        }
        stats[key] = null;
        try
        {
            stats[key] = SheetIdOf(t) is { } characterId ? await CharacterStatsAsync(characterId) : await MonsterStatsAsync(t.MonsterId!.Value);
        }
        catch (Exception)
        {
            stats.Remove(key);
        }
        await InvokeAsync(StateHasChanged);
    }

    private static string Bonus(int value) => value >= 0 ? $"+{value}" : value.ToString(CultureInfo.InvariantCulture);

    private static string D20(int bonus) => bonus == 0 ? "1d20" : $"1d20{Bonus(bonus)}";

    //	A character read now, with its numbers worked out as the sheet does
    private async Task<(CharacterDto Character, RealmForge.Shared.Characters.ComputedCharacter Computed)?> ComputeCharacterAsync(Guid id)
    {
        var character = await CharacterService.GetCharacterAsync(id);
        if (character is null)
        {
            return null;
        }
        var context = character.IsOwner && !character.ReadOnly
            ? await CharacterService.GetContextAsync(character.Ruleset, Lang)
            : await CharacterService.GetCharacterContextAsync(id, character.Ruleset, Lang);
        if (context is null)
        {
            return null;
        }
        var computed = RealmForge.Shared.Characters.CharacterCalculator.Compute(new RealmForge.Shared.Characters.CharacterInput
        {
            Name = character.Name,
            Ruleset = character.Ruleset,
            SpeciesId = character.SpeciesId,
            SubspeciesId = character.SubspeciesId,
            BackgroundId = character.BackgroundId,
            Build = character.Build,
            Sheet = character.Sheet,
            CampaignModuleIds = character.CampaignModuleIds ?? new()
        }, context);
        contexts[id] = context;
        return (character, computed);
    }

    //	The compendium a character was worked out with (the names of its spells)
    private readonly Dictionary<Guid, RealmForge.Shared.Characters.CharacterContextDto> contexts = new();

    private async Task<TokenStats?> CharacterStatsAsync(Guid id)
    {
        var loaded = await ComputeCharacterAsync(id);
        if (loaded is null)
        {
            return null;
        }
        var (character, computed) = loaded.Value;
        var rolls = new List<TokenRoll> { new(UiText.RollInitiative(Lang), Bonus(computed.Initiative), D20(computed.Initiative), false) };
        var attacks = new List<SheetLine>();
        foreach (var attack in computed.Attacks.Where(a => a.InHand).Take(4))
        {
            var hit = new TokenRoll(UiText.RollAttack(attack.Item.Name, Lang), Bonus(attack.AttackBonus), D20(attack.AttackBonus), false);
            var damage = attack.Damage.Replace(" ", string.Empty);
            var hurt = System.Text.RegularExpressions.Regex.IsMatch(damage, @"^\d*d\d+([+-]\d+)?$") ? new TokenRoll(UiText.RollDamage(attack.Item.Name, Lang), damage, damage, false) : null;
            rolls.Add(hit);
            if (hurt is not null)
            {
                rolls.Add(hurt);
            }
            var props = attack.Item.WeaponProperties;
            var reach = RealmForge.Shared.Campaigns.TableCombat.OfWeapon(attack.Item.WeaponRange == WeaponRange.Ranged, props.Contains(WeaponProperty.Reach),
                props.Contains(WeaponProperty.Thrown), attack.Item.NormalRange, attack.Item.LongRange);
            attacks.Add(new SheetLine(attack.Item.Name, $"{Bonus(attack.AttackBonus)} · {attack.Damage}", hit, hurt, attack.AttackBonus, hurt is null ? null : damage,
                attack.DamageType is { } type ? EquipmentTerms.DamageTypeName(type, Lang).ToLowerInvariant() : null, reach, attack.InventoryId));
        }
        var abilities = new List<SheetAbility>();
        var saves = new List<SheetSave>();
        foreach (var ability in Enum.GetValues<AbilityScore>())
        {
            var shortName = UiText.AbilityShort(ability, Lang);
            var save = new TokenRoll(UiText.RollSave(shortName, Lang), Bonus(computed.SaveBonus(ability)), D20(computed.SaveBonus(ability)), false);
            rolls.Add(save);
            var mod = computed.Modifier(ability);
            abilities.Add(new SheetAbility(FeatPrerequisiteFormatter.AbilityName(ability, Lang), Bonus(mod), computed.Score(ability), computed.SaveProficiencies.Contains(ability),
                new TokenRoll(UiText.RollCheck(shortName, Lang), Bonus(mod), D20(mod), false)));
            saves.Add(new SheetSave(shortName, Bonus(computed.SaveBonus(ability)), computed.SaveProficiencies.Contains(ability), save));
        }
        //	Saves in two columns: the physical ones on the left, the mental ones on the right
        saves = Enumerable.Range(0, 3).SelectMany(i => new[] { saves[i], saves[i + 3] }).ToList();
        var classes = string.Join(" / ", computed.Classes.Select(c => $"{c.Class.Name} {c.Level}"));
        var sheet = new QuickSheet("pc",
            string.Join(" · ", new[] { computed.Species?.Name, computed.Background?.Name }.Where(x => !string.IsNullOrWhiteSpace(x))),
            UiText.TokenLevel(computed.Level, classes, Lang),
            UiText.FormatRuleset(character.Ruleset, Lang),
            new List<SheetStat>
            {
                new(UiText.VttProficiency(Lang), Bonus(computed.ProficiencyBonus), UiText.VttBonus(Lang), false),
                new(UiText.VttWalk(Lang), UiText.FormatSpeed(computed.Speed, Lang), UiText.VttSpeed(Lang), false),
                new(UiText.AbilityShort(AbilityScore.Dexterity, Lang), Bonus(computed.Initiative), UiText.RollInitiative(Lang), true),
                new(UiText.VttArmor(Lang), computed.ArmorClass.ToString(CultureInfo.InvariantCulture), UiText.VttArmorClass(Lang), false)
            },
            abilities, saves, null,
            new List<SheetStat>
            {
                new(string.Empty, computed.PassivePerception.ToString(CultureInfo.InvariantCulture), UiText.VttPassivePerception(Lang), false),
                new(string.Empty, (10 + computed.SkillBonus(Skill.Investigation)).ToString(CultureInfo.InvariantCulture), UiText.VttPassiveInvestigation(Lang), false),
                new(string.Empty, (10 + computed.SkillBonus(Skill.Insight)).ToString(CultureInfo.InvariantCulture), UiText.VttPassiveInsight(Lang), false)
            },
            attacks, new List<SheetProse>(), $"characters/{id}",
            TurnGroups(computed), CastingOf(computed, character.Sheet, contexts.GetValueOrDefault(id)), await FeatureGroupsAsync(character, computed));
        var left = Enumerable.Range(0, 9).Select(i => Math.Max(0, computed.SpellSlots[i] - (i < character.Sheet.SpentSlots.Count ? character.Sheet.SpentSlots[i] : 0))).ToArray();
        return new TokenStats(computed.Speed, rolls, sheet, new TokenSlots(left, Math.Max(0, computed.PactSlots - character.Sheet.SpentPactSlots), computed.PactSlotLevel));
    }

    //	What the character does in a turn besides the standard actions: its features by action, bonus action, reaction
    private List<SheetGroup> TurnGroups(RealmForge.Shared.Characters.ComputedCharacter c) =>
        TurnActions.Features(c, Lang).GroupBy(f => f.Slot).OrderBy(g => g.Key)
            .Select(g => new SheetGroup(UiText.VttTurnSlot((int)g.Key, Lang), g.Select(f => new SheetEntry(f.Name, f.Note ?? string.Empty)).ToList()))
            .ToList();

    //	Each source of spells: save DC, attack (rolled from here), slots left, the spells by level
    private List<SheetCasting> CastingOf(RealmForge.Shared.Characters.ComputedCharacter c, RealmForge.Shared.Characters.CharacterSheetState sheet, RealmForge.Shared.Characters.CharacterContextDto? context)
    {
        var list = new List<SheetCasting>();
        if (context is null)
        {
            return list;
        }
        var byId = context.Spells.ToDictionary(sp => sp.Id);
        var slots = string.Join(" · ", Enumerable.Range(0, 9).Where(i => c.SpellSlots[i] > 0)
            .Select(i => $"{i + 1}°: {Math.Max(0, c.SpellSlots[i] - (i < sheet.SpentSlots.Count ? sheet.SpentSlots[i] : 0))}/{c.SpellSlots[i]}"));
        if (c.PactSlots > 0)
        {
            slots = string.Join(" · ", new[] { slots, UiText.VttPactSlots(Math.Max(0, c.PactSlots - sheet.SpentPactSlots), c.PactSlots, c.PactSlotLevel, Lang) }.Where(x => x.Length > 0));
        }
        var first = true;
        foreach (var source in c.AllSpellSources())
        {
            var spells = source.Known.Select(sid => byId.GetValueOrDefault(sid)).OfType<RealmForge.Shared.Characters.ContextSpell>()
                .OrderBy(sp => sp.Level).ThenBy(sp => sp.Name)
                .Select(sp => new SheetSpell(sp.Id, sp.Name, sp.Level, sp.Concentration, sp.Ritual)).ToList();
            var attack = new TokenRoll(UiText.VttSpellAttack(Lang), Bonus(source.AttackBonus), D20(source.AttackBonus), false);
            list.Add(new SheetCasting(source.Source, UiText.VttSpellNumbers(source.SaveDc, Bonus(source.AttackBonus), Lang), attack, spells, first && slots.Length > 0 ? slots : null, source.Class is not null));
            first = false;
        }
        if (c.InnateSpells.Count > 0)
        {
            var innate = c.InnateSpells[0];
            list.Add(new SheetCasting(UiText.VttInnateSpells(Lang), UiText.VttSpellNumbers(innate.SaveDc, Bonus(innate.AttackBonus), Lang),
                new TokenRoll(UiText.VttSpellAttack(Lang), Bonus(innate.AttackBonus), D20(innate.AttackBonus), false),
                c.InnateSpells.Select(i => new SheetSpell(i.Spell.Id, i.Spell.Name, i.Spell.Level, i.Spell.Concentration, i.Spell.Ritual)).DistinctBy(sp => sp.Id).ToList(), null));
        }
        return list;
    }

    //	Features: the uses left of the limited ones, the feats, the class and species features up to its level
    private async Task<List<SheetGroup>> FeatureGroupsAsync(CharacterDto character, RealmForge.Shared.Characters.ComputedCharacter c)
    {
        var groups = new List<SheetGroup>();
        var uses = RealmForge.Shared.Characters.CharacterResources.For(c, Lang)
            .Select(res => new SheetEntry(res.Name, string.Empty, $"{Math.Max(0, res.Maximum - character.Sheet.ResourceUses.GetValueOrDefault(res.Key))}/{res.Maximum}"))
            .Concat(character.Sheet.Resources.Select(res => new SheetEntry(res.Name, string.Empty, $"{Math.Max(0, res.Maximum - res.Used)}/{res.Maximum}")))
            .ToList();
        if (uses.Count > 0)
        {
            groups.Add(new SheetGroup(UiText.VttResources(Lang), uses));
        }
        if (c.Feats.Count > 0)
        {
            groups.Add(new SheetGroup(UiText.VttFeats(Lang), c.Feats.Select(f => new SheetEntry(f.Feat.Name, string.Empty)).ToList()));
        }
        try
        {
            foreach (var info in c.Classes)
            {
                if (await ClassService.GetClassDetailAsync(info.Class.Id, Lang) is not { } detail)
                {
                    continue;
                }
                var entries = detail.Features.Where(f => f.Level <= info.Level).OrderBy(f => f.Level).ThenBy(f => f.SortOrder)
                    .Select(f => new SheetEntry(f.Name, f.Description, UiText.VttFeatureLevel(f.Level, Lang))).ToList();
                if (detail.Subclasses.FirstOrDefault(sc => sc.Id == info.Subclass?.Id) is { } subclass)
                {
                    entries.AddRange(subclass.Features.Where(f => f.Level <= info.Level).OrderBy(f => f.Level).ThenBy(f => f.SortOrder)
                        .Select(f => new SheetEntry(f.Name, f.Description, subclass.Name)));
                }
                if (entries.Count > 0)
                {
                    groups.Add(new SheetGroup($"{info.Class.Name} {info.Level}", entries));
                }
            }
            if (character.SpeciesId != Guid.Empty && await SpeciesService.GetSpeciesDetailAsync(character.SpeciesId, Lang) is { } species)
            {
                var traits = species.BaseTraits.Where(tr => tr.RequiredLevel <= c.Level).Select(tr => new SheetEntry(tr.Name, tr.Description)).ToList();
                if (traits.Count > 0)
                {
                    groups.Add(new SheetGroup(species.Name, traits));
                }
            }
        }
        catch (Exception)
        {
            //	Without the compendium the features stay out
        }
        return groups;
    }

    private async Task<TokenStats?> MonsterStatsAsync(Guid id)
    {
        var monster = await MonsterService.GetMonsterAsync(id, Lang);
        if (monster is null || monster.Abilities.Count < 6)
        {
            return null;
        }
        int Mod(int score) => (int)Math.Floor((score - 10) / 2.0);
        var dex = Mod(monster.Abilities[1]);
        var rolls = new List<TokenRoll> { new(UiText.RollInitiative(Lang), Bonus(dex), D20(dex), true) };
        var abilities = new List<SheetAbility>();
        foreach (var ability in Enum.GetValues<AbilityScore>())
        {
            var score = monster.Abilities[(int)ability - 1];
            var mod = Mod(score);
            var check = new TokenRoll(UiText.RollCheck(UiText.AbilityShort(ability, Lang), Lang), Bonus(mod), D20(mod), true);
            rolls.Add(check);
            abilities.Add(new SheetAbility(UiText.AbilityShort(ability, Lang), Bonus(mod), score, mod >= 3, check));
        }
        var text = monster.Text;
        var prose = new List<SheetProse>();
        void Add(string title, string? body)
        {
            if (!string.IsNullOrWhiteSpace(body))
            {
                prose.Add(new SheetProse(title, body));
            }
        }
        if (monster.IsNpc)
        {
            Add(UiText.VttNpcPersonality(Lang), text.Personality);
            Add(UiText.VttNpcSecrets(Lang), text.Secrets);
        }
        //	The actions as entries; those with a roll to hit become attacks, rolled from here
        var attacks = new List<SheetLine>();
        var actions = new List<SheetGroup>();
        void Group(string title, string? body)
        {
            var entries = new List<SheetEntry>();
            foreach (var entry in Entries(body))
            {
                if (AttackOf(entry) is { } line)
                {
                    attacks.Add(line);
                    rolls.Add(line.Roll!);
                }
                else
                {
                    entries.Add(entry);
                }
            }
            if (entries.Count > 0)
            {
                actions.Add(new SheetGroup(title, entries));
            }
        }
        Group(UiText.VttActions(Lang), text.Actions);
        Group(UiText.VttBonusActions(Lang), text.BonusActions);
        Group(UiText.VttReactions(Lang), text.Reactions);
        Group(UiText.VttLegendary(Lang), text.LegendaryActions);
        var features = new List<SheetGroup>();
        if (Entries(text.Traits) is { Count: > 0 } traits)
        {
            features.Add(new SheetGroup(UiText.VttTraits(Lang), traits));
        }
        var details = new[]
        {
            (UiText.VttMonsterSkills(Lang), text.Skills), (UiText.VttMonsterVulnerable(Lang), text.DamageVulnerabilities),
            (UiText.VttMonsterResistant(Lang), text.DamageResistances), (UiText.VttMonsterImmune(Lang), text.DamageImmunities),
            (UiText.VttMonsterConditionImmune(Lang), text.ConditionImmunities), (UiText.VttMonsterSenses(Lang), text.Senses),
            (UiText.VttMonsterLanguages(Lang), text.Languages)
        }.Where(d => !string.IsNullOrWhiteSpace(d.Item2)).Select(d => new SheetEntry(d.Item1, d.Item2!)).ToList();
        if (details.Count > 0)
        {
            features.Insert(0, new SheetGroup(UiText.VttMonsterDetails(Lang), details));
        }
        var challenge = $"{UiText.MonsterChallengeShort(Lang)} {RealmForge.Shared.Monsters.MonsterMath.FormatChallenge(monster.ChallengeRating)} ({monster.Xp} PE)";
        var sheet = new QuickSheet(monster.IsNpc ? "npc" : "monster",
            text.Subtitle,
            monster.IsNpc && !string.IsNullOrWhiteSpace(text.Role) ? $"{text.Role} · {challenge}" : challenge,
            monster.IsNpc && monster.Attitude is { } attitude
                ? $"{UiText.NpcAttitudeIs(attitude, Lang)}{(monster.SocialDc is { } dc ? $" (CD {dc})" : null)}"
                : $"{UiText.TokenArmorClass(monster.ArmorClass, Lang)} · {text.Speed}",
            new List<SheetStat>
            {
                new(UiText.VttArmor(Lang), monster.ArmorClass.ToString(CultureInfo.InvariantCulture), UiText.VttArmorClass(Lang), false),
                new(UiText.VttWalk(Lang), UiText.FormatSpeed(monster.Speed, Lang), UiText.VttSpeed(Lang), false),
                new(UiText.AbilityShort(AbilityScore.Dexterity, Lang), Bonus(dex), UiText.RollInitiative(Lang), true),
                new(UiText.VttProficiency(Lang), Bonus(monster.ProficiencyBonus), UiText.VttBonus(Lang), false)
            },
            abilities, new List<SheetSave>(), text.SavingThrows,
            new List<SheetStat> { new(string.Empty, monster.PassivePerception.ToString(CultureInfo.InvariantCulture), UiText.VttPassivePerception(Lang), false) },
            attacks, prose, monster.IsNpc ? $"npcs/{id}" : $"monsters?id={id}", actions, null, features);
        return new TokenStats(monster.Speed, rolls, sheet);
    }

    //	"***Name.*** text" paragraphs of a statblock, one entry each
    private static List<SheetEntry> Entries(string? markdown)
    {
        var list = new List<SheetEntry>();
        if (string.IsNullOrWhiteSpace(markdown))
        {
            return list;
        }
        foreach (var block in System.Text.RegularExpressions.Regex.Split(markdown.Trim(), @"\r?\n\s*\r?\n|\r?\n(?=\*{2,3}[^*])"))
        {
            var text = block.Trim();
            if (text.Length == 0)
            {
                continue;
            }
            var m = System.Text.RegularExpressions.Regex.Match(text, @"^\*{2,3}(?<name>[^*]+?)\*{2,3}\s*(?<body>.*)$", System.Text.RegularExpressions.RegexOptions.Singleline);
            list.Add(m.Success ? new SheetEntry(m.Groups["name"].Value.Trim().TrimEnd('.', ':').Trim(), m.Groups["body"].Value.Trim()) : new SheetEntry(string.Empty, text));
        }
        return list;
    }

    //	An action with a roll to hit ("+4 al tiro per colpire", "+4 to hit") and its damage ("5 (1d6 + 2)")
    private SheetLine? AttackOf(SheetEntry entry)
    {
        var hit = System.Text.RegularExpressions.Regex.Match(entry.Markdown, @"([+\-−]\s?\d+)\s*(?:al tiro per colpire|to hit)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (!hit.Success || entry.Name.Length == 0)
        {
            return null;
        }
        var bonus = int.Parse(hit.Groups[1].Value.Replace("−", "-").Replace(" ", string.Empty), CultureInfo.InvariantCulture);
        //	Every damage of the hit ("1d8+3 slashing plus 1d6 fire" → "1d8+3+1d6") and the condition it gives
        var damage = RealmForge.Shared.Campaigns.TableCombat.DamageOf(entry.Markdown);
        var type = System.Text.RegularExpressions.Regex.Match(entry.Markdown, @"\)\s+danni\s+(?:da\s+)?(\p{L}+)|\)\s+(\p{L}+)\s+damage", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return new SheetLine(entry.Name, damage is null ? Bonus(bonus) : $"{Bonus(bonus)} · {damage}",
            new TokenRoll(UiText.RollAttack(entry.Name, Lang), Bonus(bonus), D20(bonus), true),
            damage is null ? null : new TokenRoll(UiText.RollDamage(entry.Name, Lang), damage, damage, true),
            bonus, damage, type.Success ? (type.Groups[1].Success ? type.Groups[1].Value : type.Groups[2].Value).ToLowerInvariant() : null,
            RealmForge.Shared.Campaigns.TableCombat.OfStatblock(entry.Markdown), null, RealmForge.Shared.Campaigns.TableCombat.ConditionOf(entry.Markdown));
    }

