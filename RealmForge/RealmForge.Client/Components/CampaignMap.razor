    // ===== Loading and polling =====

    protected override void OnParametersSet()
    {
        if (!liveTableSet)
        {
            liveTable = LiveTable;
            liveTableSet = true;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        self = DotNetObjectReference.Create(this);
        sawLive = LiveTable is not null || Live.Of(CampaignId) is not null;
        Live.Changed += OnLiveChanged;
        if (RunsTheTable || Table)
        {
            //	The players too: which NPCs are friendly (their sheets are read only)
            _ = LoadMonstersAsync();
        }
        await LoadMapsAsync();
        if (RunsTheTable)
        {
            _ = LoadEncountersAsync();
        }
        stop = new CancellationTokenSource();
        _ = PollAsync(stop.Token);
    }

    //	A player at the table: when the master closes it, back to the campaign
    private bool sawLive;

    private void OnLiveChanged() => _ = InvokeAsync(LeaveIfClosed);

    private void LeaveIfClosed()
    {
        if (!Table || RunsTheTable)
        {
            return;
        }
        if (Live.Of(CampaignId) is not null)
        {
            sawLive = true;
        }
        else if (sawLive)
        {
            sawLive = false;
            Navigation.NavigateTo(BackHref);
        }
    }

    private async Task LoadMonstersAsync()
    {
        try
        {
            var all = await MonsterService.GetMonstersAsync(Lang);
            monsters = all.GroupBy(m => m.Id).ToDictionary(g => g.Key, g => g.First());
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            //	The cards show the names only
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Table)
        {
            await LoadLayoutAsync();
        }
        //	The turn that just came is brought into view in a long order
        if (combat?.CurrentId is { } currentId && currentId != revealedTurn)
        {
            revealedTurn = currentId;
            try
            {
                await JS.InvokeVoidAsync("rfVtt.reveal", $"[data-test=vtt-combatant][data-id=\"{currentId}\"]");
            }
            catch (JSException)
            {
            }
        }
        if (map is null || self is null || string.IsNullOrEmpty(stageElement.Id))
        {
            return;
        }
        if (attachedTo != stageElement.Id)
        {
            attachedTo = stageElement.Id;
            await JS.InvokeVoidAsync("rfVtt.attach", stageElement, self, new { wheelZoom = Table, perCell = UiText.VttPerCell(Lang), unit = UiText.VttUnit(Lang), locale = Lang == LanguageCode.It ? "it-IT" : "en-GB" });
            await JS.InvokeVoidAsync("rfVtt.tool", stageElement, tool, ToolOptions);
            terrainSent = null;
        }
        await PushTerrainAsync();
        if (fitPending)
        {
            fitPending = false;
            await FitAsync();
        }
        if (Table && infoToken is not null && !string.IsNullOrEmpty(stageElement.Id))
        {
            //	The pop-up of a token stays wholly on screen (moved or turned to the other side of the token)
            await JS.InvokeVoidAsync("rfVtt.keepVisible", stageElement);
        }
        if (pendingFocus is { } at)
        {
            pendingFocus = null;
            await JS.InvokeVoidAsync("rfVtt.center", stageElement, at.X, at.Y, pendingInstant);
            pendingInstant = false;
        }
    }

    private async Task LoadMapsAsync(Guid? select = null)
    {
        maps = await Campaigns.GetMapsAsync(CampaignId) ?? new();
        var id = select ?? (maps.Any(m => m.Id == selectedId) ? selectedId : maps.FirstOrDefault(m => m.Shown)?.Id ?? maps.FirstOrDefault()?.Id);
        if (id is { } mapId)
        {
            await SelectAsync(mapId);
        }
        else
        {
            map = null;
            tokens = new();
        }
    }

    private async Task SelectAsync(Guid id)
    {
        var other = id != selectedId || map is null;
        selectedId = id;
        infoToken = null;
        map = await Campaigns.GetMapAsync(CampaignId, id);
        if (map is not null)
        {
            tokens = map.Tokens;
            TakeSheetLife();
            TakeTerrain(map.Terrain);
            shapes = map.Shapes ?? new();
            ApplyTable(map.Table, first: true);
            ApplyCombat(map.Combat);
            _ = PreloadStatsAsync();
            mapName = map.Name;
            gridType = map.GridType;
            grid = map.GridSize;
            offsetX = map.GridOffsetX;
            offsetY = map.GridOffsetY;
            shown = map.Shown;
            fitPending = Table && other;
            autoFit = autoFit || fitPending;
        }
    }

    //	Every 2 seconds what moved on the map (not while a token is dragged); the players also follow the map shown to them
    private async Task PollAsync(CancellationToken token)
    {
        //	The API answers as soon as something changes on the map (or after 20 seconds): moves show up at once. The
        //	players also look every few seconds for the map shown to them.
        var listCheckedAt = DateTime.UtcNow;
        try
        {
            while (!token.IsCancellationRequested)
            {
                if (grabbing)
                {
                    await Task.Delay(250, token);
                    continue;
                }
                if (!RunsTheTable && (map is null || DateTime.UtcNow - listCheckedAt > TimeSpan.FromSeconds(6)))
                {
                    listCheckedAt = DateTime.UtcNow;
                    var list = await Campaigns.GetMapsAsync(CampaignId) ?? new();
                    if (list.Count != (maps?.Count ?? 0) || list.Any(m => maps!.All(x => x.Id != m.Id)))
                    {
                        maps = list;
                        if (list.All(m => m.Id != selectedId) || map is null)
                        {
                            await LoadMapsAsync(list.FirstOrDefault()?.Id);
                        }
                        await InvokeAsync(StateHasChanged);
                        continue;
                    }
                }
                if (map is null)
                {
                    await Task.Delay(2000, token);
                    continue;
                }
                var waitingFor = map.Id;
                var editsBefore = localEdits;
                var (state, reached) = await Campaigns.WaitMapStateAsync(CampaignId, map.Id, map.UpdatedAt, token);
                if (!reached)
                {
                    await Task.Delay(3000, token);
                    continue;
                }
                if (grabbing || map is null || map.Id != waitingFor || localEdits != editsBefore)
                {
                    continue;
                }
                if (state is null)
                {
                    //	Hidden from the players again, or deleted: maybe the table was closed
                    if (Table && !RunsTheTable && sawLive)
                    {
                        await Live.RefreshAsync();
                    }
                    await LoadMapsAsync();
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(1000, token);
                    continue;
                }
                if (state.UpdatedAt != map.UpdatedAt)
                {
                    map = map with { UpdatedAt = state.UpdatedAt, GridType = state.GridType, GridSize = state.GridSize, GridOffsetX = state.GridOffsetX, GridOffsetY = state.GridOffsetY, Shown = state.Shown, Name = state.Name };
                    tokens = state.Tokens;
                    TakeSheetLife();
                    TakeTerrain(state.Terrain);
                    shapes = state.Shapes ?? new();
                    ApplyTable(state.Table, first: false);
                    ApplyCombat(state.Combat);
                    _ = PreloadStatsAsync();
                    if (!RunsTheTable || Table)
                    {
                        gridType = state.GridType;
                        grid = state.GridSize;
                        offsetX = state.GridOffsetX;
                        offsetY = state.GridOffsetY;
                        shown = state.Shown;
                    }
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
            //	Left the page
        }
    }

    // ===== From the browser =====

    [JSInvokable]
    public void TokenGrabbed() => grabbing = true;

    [JSInvokable]
    public async Task TokenClicked(string id)
    {
        grabbing = false;
        if (aim is not null && Guid.TryParse(id, out var aimedId))
        {
            await AimAtAsync(aimedId);
            StateHasChanged();
            return;
        }
        infoToken = Guid.TryParse(id, out var tokenId) && infoToken != tokenId ? tokenId : null;
        toolTab = null;
        moreDock = false;
        hpAmount = null;
        propMessage = null;
        if (InfoToken is { PropType: PropType.Item } ground)
        {
            gearNote = null;
            groundTaker = null;
            _ = LoadGroundItemAsync(ground);
        }
        if (InfoToken is { } t && (CanRoll(t) || HasSheet(t) || PeekSheet(t)))
        {
            _ = LoadStatsAsync(t);
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void BoardClicked()
    {
        if (infoToken is not null)
        {
            infoToken = null;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task Resized()
    {
        if (Table && autoFit)
        {
            await FitAsync();
        }
    }

    //	The box drawn over one cell of the picture: the cell size and the offsets that put a cell exactly there
    [JSInvokable]
    public async Task Calibrated(double x, double y, double width, double height)
    {
        await SetToolAsync("select");
        if (width < 8 || height < 8)
        {
            StateHasChanged();
            return;
        }
        (grid, offsetX, offsetY) = MapGeometry.Calibrate(gridType, x, y, width, height);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task Wheel(int direction)
    {
        await ZoomByHand(direction);
        StateHasChanged();
    }

    //	A token released at (x, y) on the map: it lands on the nearest cell, if that is on the map
    [JSInvokable]
    public async Task TokenDropped(string id, double x, double y)
    {
        grabbing = false;
        var t = map is null || !Guid.TryParse(id, out var tokenId) ? null : tokens.FirstOrDefault(k => k.Id == tokenId);
        if (t is null || map is null)
        {
            return;
        }
        var (col, row) = MapGeometry.Nearest(gridType, grid, offsetX, offsetY, x, y, t.Size);
        await MoveToAsync(t, col, row);
    }

    //	The keyboard: the arrows move the token whose toolbar is open (one cell), Esc closes the toolbar
    [JSInvokable]
    public async Task KeyPressed(string key)
    {
        if (key == "Escape")
        {
            CancelAim();
            CancelCast();
            CloseToolbar();
            StateHasChanged();
            return;
        }
        if (InfoToken is not { CanMove: true } t)
        {
            return;
        }
        var (dx, dy) = key switch
        {
            "ArrowUp" => (0, -1),
            "ArrowDown" => (0, 1),
            "ArrowLeft" => (-1, 0),
            "ArrowRight" => (1, 0),
            _ => (0, 0)
        };
        if (dx != 0 || dy != 0)
        {
            await MoveToAsync(t, t.X + dx, t.Y + dy);
        }
    }

    private async Task MoveToAsync(MapTokenDto t, int col, int row)
    {
        if (map is null || (col == t.X && row == t.Y) || !MapGeometry.Inside(gridType, grid, offsetX, offsetY, col, row, t.Size, map.Width, map.Height))
        {
            return;
        }
        //	A player's token goes around the walls and the closed doors: the way it takes is what it moves
        var cost = MapGeometry.Distance(gridType, t.X, t.Y, col, row);
        if (FollowsTerrain && t.Kind != TokenKind.Prop)
        {
            if (WayCost(t, col, row) is not { } way)
            {
                message = UiText.VttWayBlocked(Lang);
                Replace(t);
                StateHasChanged();
                return;
            }
            cost = way;
        }
        //	A player moves no further than the speed (in a fight, counting what was already moved in the turn)
        if (!RunsTheTable && SpeedCells(t) is { } speed
            && cost + (combat is not null ? moved.GetValueOrDefault(t.Id) : 0) > speed)
        {
            message = UiText.VttTooFar(Lang);
            Replace(t);
            StateHasChanged();
            return;
        }
        Replace(t with { X = col, Y = row });
        StateHasChanged();
        if (combat is not null)
        {
            moved[t.Id] = moved.GetValueOrDefault(t.Id) + cost;
        }
        var result = await Campaigns.MoveTokenAsync(CampaignId, map.Id, t.Id, col, row);
        message = result.Ok ? null : result.Status == System.Net.HttpStatusCode.Conflict ? UiText.VttWayBlocked(Lang) : UiText.MapMoveFailed(Lang);
        if (!result.Ok)
        {
            Replace(t);
            StateHasChanged();
        }
    }

    private void Replace(MapTokenDto token)
    {
        tokens = tokens.Select(x => x.Id == token.Id ? token : x).ToList();
        localEdits++;
    }

    //	Changes made here since a wait for the API began: its answer may predate them, so it is not shown
    private int localEdits;

    // ===== View =====

    //	Steps of 10%: from a zoom in between (the one that fits the map) to the next round one
    private void Zoom(int direction)
    {
        var tenths = zoom * 10;
        var next = direction > 0 ? Math.Floor(tenths + 0.001) + 1 : Math.Ceiling(tenths - 0.001) - 1;
        zoom = Math.Clamp(next / 10, 0.1, 3);
    }

    //	The zoom changes around the centre of the view
    private async Task ZoomByHand(int direction)
    {
        autoFit = false;
        double[]? centre = null;
        if (Table && !string.IsNullOrEmpty(stageElement.Id))
        {
            try
            {
                centre = await JS.InvokeAsync<double[]>("rfVtt.view", stageElement);
            }
            catch (JSException)
            {
            }
        }
        Zoom(direction);
        if (centre is { Length: 2 })
        {
            pendingFocus = (centre[0], centre[1]);
            pendingInstant = true;
        }
    }

    private Task FitByHand()
    {
        autoFit = true;
        return FitAsync();
    }

    private async Task ToggleCalibrateAsync() => await SetToolAsync(tool == "calibrate" ? "select" : "calibrate");

    private async Task DuplicateAsync()
    {
        if (map is null)
        {
            return;
        }
        var copy = await Campaigns.DuplicateMapAsync(CampaignId, map.Id, UiText.MapCopyName(map.Name, Lang));
        message = copy is null ? UiText.MapSaveFailed(Lang) : null;
        if (copy is not null)
        {
            await LoadMapsAsync(copy.Id);
        }
    }

    private async Task FitAsync()
    {
        if (map is null || string.IsNullOrEmpty(stageElement.Id))
        {
            return;
        }
        var fit = await JS.InvokeAsync<double>("rfVtt.fit", stageElement, map.Width, map.Height);
        if (fit > 0)
        {
            //	Down to a multiple of 5%, in the middle of the view
            zoom = Math.Clamp(Math.Floor(fit * 20 + 0.001) / 20, 0.1, 3);
            if (Table)
            {
                pendingFocus = (map.Width / 2.0, map.Height / 2.0);
                pendingInstant = true;
            }
            StateHasChanged();
        }
    }

    private async Task SetToolAsync(string name)
    {
        tool = name;
        textAt = null;
        if (!string.IsNullOrEmpty(stageElement.Id))
        {
            await JS.InvokeVoidAsync("rfVtt.tool", stageElement, name, ToolOptions);
        }
    }

    private object ToolOptions => new
    {
        color = drawColor,
        area = areaKind.ToString().ToLowerInvariant(),
        fogMode = fogCover ? "cover" : "reveal",
        fogShape = fogBrush ? "brush" : "rect",
        fogBrush = fogBrushSize,
        fogCells = !Table,
        eraseArea,
        terrain = brush,
        terrainShape = brushBox ? "rect" : "brush",
        blockedText = UiText.VttWayBlockedShort(Lang)
    };

    //	The eraser: a click on a drawing, or a box drawn over the map that takes away all it touches
    private bool eraseArea;

    private Task SetEraseAsync(bool area)
    {
        eraseArea = area;
        return SetToolAsync("erase");
    }

    [JSInvokable]
    public async Task EraseArea(double x, double y, double width, double height)
    {
        if (map is null)
        {
            return;
        }
        var before = shapes;
        shapes = shapes.Where(sh => !sh.CanDelete || !MapRules.Touches(sh.Points, x, y, width, height)).ToList();
        localEdits++;
        StateHasChanged();
        if (!(await Campaigns.EraseAreaAsync(CampaignId, map.Id, x, y, width, height)).Ok)
        {
            shapes = before;
            message = UiText.MapSaveFailed(Lang);
            StateHasChanged();
        }
    }

    // ===== Fog of war, pings, the view =====

    //	What the polling brought: the fog; a new ping is shown for three seconds; the players follow a new view of the masters
    // ===== The fight =====

    private List<RfSelect<Guid?>.OptionItem> EncounterOptions => encounters
        .Where(e => e.Status != EncounterStatus.Finished)
        .Select(e => new RfSelect<Guid?>.OptionItem(e.Id, e.Name)).ToList();

    private bool IsCurrent(MapTokenDto t) => combat?.CurrentId is { } current && t.CombatantId == current;

    private void ApplyCombat(MapCombatDto? fight)
    {
        combat = fight;
        //	A new turn: the cells moved start again
        if (fight?.CurrentId != movedTurn)
        {
            movedTurn = fight?.CurrentId;
            moved.Clear();
        }
    }

    private async Task LoadEncountersAsync()
    {
        if (RunsTheTable && Table)
        {
            encounters = await Encounters.GetEncountersAsync(CampaignId) ?? new();
            encounterId ??= EncounterOptions.FirstOrDefault()?.Value;
            if (StartEncounter is { } wanted && encounters.FirstOrDefault(e => e.Id == wanted && e.Status != EncounterStatus.Finished) is { } chosen)
            {
                StartEncounter = null;
                encounterId = chosen.Id;
                encounterPick = true;
                if (chosen.MapId is { } mapId && mapId != selectedId && maps?.Any(m => m.Id == mapId) == true)
                {
                    await SelectAsync(mapId);
                }
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    // ===== Who fights =====

    //	Tokens a quick fight can start with: on the map, not markers nor props
    private IEnumerable<MapTokenDto> FightableTokens => tokens.Where(t => t.Kind is not (TokenKind.Marker or TokenKind.Prop) && t.Layer == TokenLayer.Tokens);

