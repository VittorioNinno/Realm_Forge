@using System.Globalization
@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.Campaigns
@using RealmForge.Shared.DTOs
@using RealmForge.Shared.Enums
@using RealmForge.Shared.Localization
@inject CampaignDataService Campaigns
@inject MonsterDataService MonsterService
@inject ImageDataService Images
@inject EncounterDataService Encounters
@inject CharacterDataService CharacterService
@inject ClassDataService ClassService
@inject SpeciesDataService SpeciesService
@inject LanguageStateService LanguageState
@inject LiveTableService Live
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

@* The virtual tabletop. Two faces of the same board: the masters' preparation (Table = false, in the campaign's Maps tab:
   the picture, the grid, the tokens, away from the players) and the table (Table = true, a page of its own: a tool bar on
   the left, the map in the middle, the zoom in the corner; the players see the map shown to them and move their tokens).
   The browser moves a dragged token and the view; the app picks the cell where the token lands *@
@if (Table)
{
    <div class="rf-vtt-table" @ref="tableElement" data-test="vtt">
        <DiceTray @ref="tray" AutoHideMs="1800" ShowHistory="false" />
        <EquipmentInfoModal Item="groundInfo" OnClose="() => groundInfo = null" />
        <header class="rf-vtt-top">
            <a href="@BackHref" class="rf-vtt-back" data-test="vtt-back"><Icon Name="left" /> <span>@UiText.VttBack(Lang)</span></a>
            @if (RunsTheTable && maps is { Count: > 0 })
            {
                <div class="rf-vtt-select" data-test="map-select">
                    <RfSelect TValue="Guid" Value="selectedId" ValueChanged="SelectAsync" Options="MapOptions" />
                </div>
            }
            <div class="rf-vtt-top-actions">
                @if (RunsTheTable)
                {
                    @if (liveTable is not null)
                    {
                        <span class="rf-vtt-live rf-vtt-live-on" title="@UiText.TableOpenedBy(liveTable.OpenedBy, liveTable.OpenedAt, Lang)" data-test="vtt-table-open"><span class="rf-live-dot"></span> @UiText.TableLive(Lang)</span>
                        <button type="button" class="btn btn-sm btn-rf-outline" disabled="@tableBusy" @onclick="CloseTableAsync" data-test="vtt-table-close">@UiText.TableClose(Lang)</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-rf-orange" disabled="@tableBusy" title="@UiText.TableOpenHint(Lang)" @onclick="OpenTableAsync" data-test="vtt-table-start"><Icon Name="broadcast" /> @UiText.TableOpen(Lang)</button>
                    }
                }
                @if (RunsTheTable && map is not null)
                {
                    @if (map.Shown)
                    {
                        <button type="button" class="btn btn-sm rf-vtt-shown-toggle on" disabled="@tableBusy" title="@UiText.VttHideHint(Lang)" @onclick="HideAsync" data-test="vtt-displayed"><Icon Name="eye" /> @UiText.VttDisplayed(Lang)</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-rf-orange" disabled="@tableBusy" @onclick="DisplayAsync" data-test="vtt-display"><Icon Name="eye" /> @UiText.VttDisplay(Lang)</button>
                    }
                }
            </div>
        </header>
        <div class="rf-vtt-body">
            <nav class="rf-vtt-tools" aria-label="@UiText.VttTitle(Lang)">
                <button type="button" class="@ToolButton("select")" title="@UiText.VttToolSelect(Lang)" aria-label="@UiText.VttToolSelect(Lang)" @onclick="@(() => SetToolAsync("select"))" data-test="vtt-tool-select"><Icon Name="cursor" /></button>
                <button type="button" class="@ToolButton("pan")" title="@UiText.VttToolPan(Lang)" aria-label="@UiText.VttToolPan(Lang)" @onclick="@(() => SetToolAsync("pan"))" data-test="vtt-tool-pan"><Icon Name="arrows-move" /></button>
                <button type="button" class="@ToolButton("ruler")" title="@UiText.VttToolRuler(Lang)" aria-label="@UiText.VttToolRuler(Lang)" @onclick="@(() => SetToolAsync("ruler"))" data-test="vtt-tool-ruler"><Icon Name="rulers" /></button>
                @if (!PlayersStopped)
                {
                    <button type="button" class="@ToolButton("area")" title="@UiText.VttToolArea(Lang)" aria-label="@UiText.VttToolArea(Lang)" @onclick="@(() => SetToolAsync("area"))" data-test="vtt-tool-area"><Icon Name="bullseye" /></button>
                    <button type="button" class="@ToolButton("ping")" title="@UiText.VttToolPing(Lang)" aria-label="@UiText.VttToolPing(Lang)" @onclick="@(() => SetToolAsync("ping"))" data-test="vtt-tool-ping"><Icon Name="geo-alt" /></button>
                }
                <button type="button" class="@ToolButton("draw")" title="@UiText.VttToolDraw(Lang)" aria-label="@UiText.VttToolDraw(Lang)" @onclick="@(() => SetToolAsync("draw"))" data-test="vtt-tool-draw"><Icon Name="edit" /></button>
                <button type="button" class="@ToolButton("text")" title="@UiText.VttToolText(Lang)" aria-label="@UiText.VttToolText(Lang)" @onclick="@(() => SetToolAsync("text"))" data-test="vtt-tool-text"><Icon Name="type" /></button>
                <button type="button" class="@ToolButton("erase")" title="@UiText.VttToolErase(Lang)" aria-label="@UiText.VttToolErase(Lang)" @onclick="@(() => SetToolAsync("erase"))" data-test="vtt-tool-erase"><Icon Name="eraser" /></button>
                @if (RunsTheTable)
                {
                    <button type="button" class="@ToolButton("fog")" title="@UiText.VttToolFog(Lang)" aria-label="@UiText.VttToolFog(Lang)" @onclick="@(() => SetToolAsync("fog"))" data-test="vtt-tool-fog"><Icon Name="eye-slash" /></button>
                    <button type="button" class="rf-vtt-tool @(playersLocked ? "locked" : null)" disabled="@(map is null)" title="@(playersLocked ? UiText.VttUnlockPlayers(Lang) : UiText.VttLockPlayers(Lang))" aria-label="@(playersLocked ? UiText.VttUnlockPlayers(Lang) : UiText.VttLockPlayers(Lang))"
                            aria-pressed="@(playersLocked ? "true" : "false")" @onclick="ToggleLockAsync" data-test="vtt-lock-players"><Icon Name="@(playersLocked ? "lock" : "unlock")" /></button>
                    <span class="rf-vtt-tools-sep"></span>
                    <button type="button" class="rf-vtt-tool @(panel == "tokens" ? "active" : null)" title="@UiText.VttToolTokens(Lang)" aria-label="@UiText.VttToolTokens(Lang)" @onclick="@(() => TogglePanel("tokens"))" data-test="vtt-tool-tokens"><Icon Name="people" /></button>
                }
                <span class="rf-vtt-tools-sep"></span>
                <button type="button" class="rf-vtt-tool" title="@UiText.VttFullscreen(Lang)" aria-label="@UiText.VttFullscreen(Lang)" @onclick="FullscreenAsync" data-test="vtt-fullscreen"><Icon Name="fullscreen" /></button>
            </nav>
            <div class="rf-vtt-viewport">
                @InitiativeBar
                @Board
                @if (map is not null && tool is "area" or "draw" or "text" or "erase" or "fog")
                {
                    @ToolOptionsBar
                }
                else if (map is not null && (aim is not null || placing is not null || castNote is not null || (gearNote is not null && !PanelShown("sheet"))))
                {
                    @CombatBar
                }
                @DiceCluster
            </div>
            @if (panel is not null)
            {
                <aside class="rf-vtt-drawer @(drawerFolded ? "folded" : null)" data-test="vtt-drawer">
                    @if (drawerFolded)
                    {
                        @* Folded to a rail: an icon per tab, the map gets the room *@
                        <nav class="rf-vtt-rail" aria-label="@UiText.VttDrawer(Lang)">
                            <button type="button" class="rf-vtt-rail-btn" title="@UiText.CardExpand(Lang)" aria-label="@UiText.CardExpand(Lang)" @onclick="() => drawerFolded = false" data-test="vtt-drawer-unfold"><Icon Name="chevron-double-left" /></button>
                            @if (RunsTheTable)
                            {
                                <button type="button" class="rf-vtt-rail-btn @(panel == "tokens" ? "active" : null)" title="@UiText.VttTokensShort(Lang)" @onclick="@(() => OpenDrawer("tokens"))"><Icon Name="people" /></button>
                            }
                            @foreach (var tab in SheetTabs)
                            {
                                var sheetTab = tab;
                                <button type="button" class="rf-vtt-rail-btn @(panel == "sheet" && sheetTokenId == sheetTab.Id ? "active" : null)" title="@sheetTab.Label" @onclick="() => { ShowSheet(sheetTab.Id); drawerFolded = false; }">@Initials(sheetTab.Label)</button>
                            }
                            @if (diceDocked)
                            {
                                <button type="button" class="rf-vtt-rail-btn @(panel == "dice" ? "active" : null)" title="@UiText.VttDice(Lang)" @onclick="@(() => OpenDrawer("dice"))"><Icon Name="dice" /></button>
                            }
                            @if (logDocked)
                            {
                                <button type="button" class="rf-vtt-rail-btn @(panel == "log" ? "active" : null)" title="@UiText.VttRollLog(Lang)" @onclick="@(() => OpenDrawer("log"))"><Icon Name="list" /></button>
                            }
                        </nav>
                    }
                    else
                    {
                    <nav class="rf-vtt-panel-tabs">
                        @if (RunsTheTable)
                        {
                            <button type="button" class="@(panel == "tokens" ? "active" : null)" @onclick="@(() => panel = "tokens")">@UiText.VttTokensShort(Lang)</button>
                        }
                        @foreach (var tab in SheetTabs)
                        {
                            var sheetTab = tab;
                            <span class="rf-vtt-sheet-tab @(panel == "sheet" && sheetTokenId == sheetTab.Id ? "active" : null)" data-test="vtt-tab-sheet">
                                <button type="button" class="rf-vtt-sheet-tab-name" title="@sheetTab.Label" @onclick="() => ShowSheet(sheetTab.Id)">@sheetTab.Label</button>
                                <button type="button" class="rf-vtt-sheet-tab-close" title="@UiText.TokenClose(Lang)" aria-label="@UiText.TokenClose(Lang)" @onclick="() => CloseSheet(sheetTab.Id)" data-test="vtt-tab-sheet-close"><Icon Name="close" /></button>
                            </span>
                        }
                        @if (diceDocked)
                        {
                            <button type="button" class="@(panel == "dice" ? "active" : null)" @onclick="@(() => panel = "dice")" data-test="vtt-tab-dice"><Icon Name="dice" /> @UiText.VttDice(Lang)</button>
                        }
                        @if (logDocked)
                        {
                            <button type="button" class="@(panel == "log" ? "active" : null)" @onclick="@(() => panel = "log")" data-test="vtt-tab-log"><Icon Name="list" /> @UiText.VttRollLog(Lang)</button>
                        }
                        <span class="ms-auto d-inline-flex gap-1">
                            <button type="button" class="rf-vtt-icon-button" title="@UiText.CardMinimize(Lang)" aria-label="@UiText.CardMinimize(Lang)" @onclick="() => drawerFolded = true" data-test="vtt-drawer-fold"><Icon Name="chevron-double-right" /></button>
                            <button type="button" class="rf-vtt-icon-button" @onclick="ClosePanel" aria-label="@UiText.TokenClose(Lang)" data-test="vtt-drawer-close"><Icon Name="close" /></button>
                        </span>
                    </nav>
                    @switch (panel)
                    {
                        case "tokens" when RunsTheTable:
                            <button type="button" class="btn btn-sm btn-rf-orange" @onclick="OpenNewMap" data-test="map-new"><Icon Name="plus" /> @UiText.MapNew(Lang)</button>
                            @if (map is not null)
                            {
                                @OnMapList
                                @AddTokens
                            }
                            break;
                        case "sheet" when SheetToken is { } sheetToken:
                            @QuickSheetPanel(sheetToken)
                            break;
                        case "dice" when diceDocked:
                            <CampaignRolls CampaignId="CampaignId" Role="Role" Characters="Characters" MyColor="@MyColor" Compact="true" Part="console" Pinned="true" OnPin="UnpinDice"
                                           GivenCharacters="GivenCharacters" OnRolled="r => rollLog?.Add(r)" />
                            break;
                        case "log" when logDocked:
                            <CampaignRolls @ref="rollLog" CampaignId="CampaignId" Role="Role" Characters="Characters" MyColor="@MyColor" Compact="true" Part="log" Pinned="true" OnPin="UnpinLog" OnNews="OnRollNews" />
                            break;
                    }
                    }
                </aside>
            }
        </div>
        @RestDialog
    </div>
}
else
{
    @* The map editor: the map, its zones and its fog painted on the cells, its grid and its tokens *@
    <section class="rf-vtt rf-me" data-test="campaign-map">
        <header class="rf-me-top">
            <div class="rf-me-top-left">
                @if (maps is { Count: > 0 })
                {
                    <div class="rf-me-picker">
                        <span class="rf-me-dot @(map?.Shown == true ? "shown" : null)" title="@(map?.Shown == true ? UiText.MapShownShort(Lang) : UiText.MapHiddenShort(Lang))"></span>
                        <div class="rf-vtt-select" data-test="map-select">
                            <RfSelect TValue="Guid" Value="selectedId" ValueChanged="SelectAsync" Options="MapOptions" />
                        </div>
                    </div>
                }
                @if (map is not null)
                {
                    <div class="rf-me-seg" role="group" aria-label="@UiText.MapViewAs(Lang)">
                        <button type="button" class="@(previewPlayers ? null : "active")" aria-pressed="@(previewPlayers ? "false" : "true")" @onclick="() => previewPlayers = false" data-test="map-preview-editor"><Icon Name="pencil" /> @UiText.MapViewEditor(Lang)</button>
                        <button type="button" class="@(previewPlayers ? "active" : null)" aria-pressed="@(previewPlayers ? "true" : "false")" @onclick="() => previewPlayers = true" data-test="map-preview-players"><Icon Name="eye" /> @UiText.MapViewPlayers(Lang)</button>
                    </div>
                }
            </div>
            <div class="rf-me-top-right">
                <a href="@($"campaigns/{CampaignId}/vtt")" class="btn btn-sm btn-rf-outline" data-test="map-open-vtt"><Icon Name="map" /> @UiText.VttTitle(Lang)</a>
                <button type="button" class="btn btn-sm btn-rf-orange" @onclick="OpenNewMap" data-test="map-new"><Icon Name="plus" /> @UiText.MapNew(Lang)</button>
            </div>
        </header>

        @if (message is not null)
        {
            <div class="rf-cast-warning mb-2" role="alert" data-test="map-message">@message</div>
        }

        @if (map is null)
        {
            <p class="small mb-2" style="color: var(--rf-text-muted);">@UiText.MapPrepHint(Lang)</p>
            @Board
        }
        else
        {
            <div class="rf-me-grid">
                <div class="rf-me-canvas">
                    <div class="rf-me-tools" data-test="map-brushes">
                        <div class="rf-me-tool-group">
                            <button type="button" class="rf-me-tool @(brush == "select" ? "active" : null)" title="@UiText.MapBrushSelect(Lang)" @onclick="SelectBrushAsync" data-test="map-brush-select"><Icon Name="cursor" /><span>@UiText.MapBrushSelect(Lang)</span></button>
                        </div>
                        <span class="rf-me-sep"></span>
                        <div class="rf-me-tool-group">
                            <button type="button" class="rf-me-tool @(!brushBox && brush != "select" ? "active" : null)" title="@UiText.MapBrushCell(Lang)" @onclick="() => SetBrushBoxAsync(false)" data-test="map-shape-cell"><Icon Name="brush" /><span>@UiText.MapBrushCell(Lang)</span></button>
                            <button type="button" class="rf-me-tool @(brushBox && brush != "select" ? "active" : null)" title="@UiText.MapBrushBox(Lang)" @onclick="() => SetBrushBoxAsync(true)" data-test="map-shape-box"><Icon Name="bounding-box" /><span>@UiText.MapBrushBox(Lang)</span></button>
                        </div>
                        <span class="rf-me-sep"></span>
                        <div class="rf-me-tool-group">
                            @foreach (var b in new[] { "walkable", "wall", "difficult", "door", "fog" })
                            {
                                var name = b;
                                <button type="button" class="rf-me-tool brush @(brush == name ? "active" : null)" title="@UiText.MapZoneHint(name, Lang)" @onclick="() => SetBrushAsync(name)" data-test="map-brush-@name">
                                    <span class="rf-me-swatch @name"><Icon Name="@ZoneIcon(name)" /></span><span>@UiText.MapZoneName(name, Lang)</span>
                                </button>
                            }
                        </div>
                        @if (brush == "fog")
                        {
                            <span class="rf-me-sep"></span>
                            <div class="rf-me-tool-group">
                                <button type="button" class="rf-me-tool @(!fogCover ? "active" : null)" @onclick="() => SetFogCoverAsync(false)" data-test="map-fog-reveal"><Icon Name="eye" /><span>@UiText.VttFogReveal(Lang)</span></button>
                                <button type="button" class="rf-me-tool @(fogCover ? "active" : null)" @onclick="() => SetFogCoverAsync(true)" data-test="map-fog-cover"><Icon Name="eye-slash" /><span>@UiText.VttFogCover(Lang)</span></button>
                            </div>
                        }
                    </div>
                    <div class="rf-me-view">
                        <div class="rf-vtt-viewport prep">
                            @Board
                        </div>
                        @* Zoom and fit over the map, as at the table *@
                        <div class="rf-me-zoom rf-vtt-dock-zoom" role="group" aria-label="@UiText.MapZoom(Lang)">
                            <button type="button" @onclick="() => ZoomByHand(-1)" aria-label="−" title="−" data-test="map-zoom-out"><Icon Name="dash" /></button>
                            <span data-test="map-zoom">@($"{zoom * 100:0}%")</span>
                            <button type="button" @onclick="() => ZoomByHand(1)" aria-label="+" title="+" data-test="map-zoom-in"><Icon Name="plus" /></button>
                            <button type="button" @onclick="FitByHand" title="@UiText.VttFit(Lang)" aria-label="@UiText.VttFit(Lang)" data-test="map-fit"><Icon Name="aspect-ratio" /></button>
                        </div>
                    </div>
                    <footer class="rf-me-status">
                        <span class="rf-me-counts" data-test="map-zone-counts">
                            @UiText.MapZoneCounts(ZoneCount(TerrainKind.Wall), ZoneCount(TerrainKind.Difficult), ZoneCount(TerrainKind.Door), Lang)
                            @if (previewPlayers)
                            {
                                <span class="rf-me-preview-tag">@UiText.MapViewPlayers(Lang)</span>
                            }
                        </span>
                        <label class="rf-checkbox-wrapper small mb-0">
                            <input type="checkbox" class="rf-checkbox" checked="@showZones" @onchange="() => showZones = !showZones" data-test="map-show-zones" />
                            <span>@UiText.MapShowZones(Lang)</span>
                        </label>
                    </footer>
                </div>

                <aside class="rf-me-inspector">
                    <nav class="rf-me-tabs" role="tablist">
                        <button type="button" role="tab" class="@(editorTab == "zones" ? "active" : null)" aria-selected="@(editorTab == "zones" ? "true" : "false")" @onclick="ShowZonesTab" data-test="map-tab-zones">@UiText.MapTabZones(Lang)</button>
                        <button type="button" role="tab" class="@(editorTab == "grid" ? "active" : null)" aria-selected="@(editorTab == "grid" ? "true" : "false")" @onclick="ShowGridTab" data-test="map-tab-grid">@UiText.MapTabGrid(Lang)</button>
                        <button type="button" role="tab" class="@(editorTab == "tokens" ? "active" : null)" aria-selected="@(editorTab == "tokens" ? "true" : "false")" @onclick="ShowTokensTab" data-test="map-tab-tokens">@UiText.MapTabTokens(tokens.Count, Lang)</button>
                    </nav>
                    <div class="rf-me-panel">
                        @if (editorTab == "zones")
                        {
                            <section class="rf-me-section">
                                <span class="rf-me-kicker">@UiText.MapZonesTitle(Lang)</span>
                                <p class="rf-me-help">@UiText.MapZonesHelp(Lang)</p>
                                <div class="rf-me-zones">
                                    @foreach (var b in new[] { "walkable", "wall", "difficult", "door", "fog" })
                                    {
                                        var name = b;
                                        <button type="button" class="rf-me-zone @(brush == name ? "active" : null)" @onclick="() => SetBrushAsync(name)" data-test="map-zone-@name">
                                            <span class="rf-me-swatch @name"><Icon Name="@ZoneIcon(name)" /></span>
                                            <span class="rf-me-zone-info"><strong>@UiText.MapZoneTitle(name, Lang)</strong><span>@UiText.MapZoneHint(name, Lang)</span></span>
                                        </button>
                                    }
                                </div>
                            </section>
                            <section class="rf-me-section">
                                <span class="rf-me-kicker">@UiText.MapQuickTitle(Lang)</span>
                                <div class="rf-me-quick">
                                    <button type="button" class="rf-me-action" @onclick="WallTheEdgeAsync" data-test="map-wall-edge"><Icon Name="bricks" /> @UiText.MapWallEdge(Lang)</button>
                                    <button type="button" class="rf-me-action" @onclick="ClearTerrainAsync" data-test="map-clear-terrain"><Icon Name="check" /> @UiText.MapAllWalkable(Lang)</button>
                                    <button type="button" class="rf-me-action" @onclick="() => FogAllAsync(true)" data-test="map-fog-all"><Icon Name="eye-slash" /> @UiText.MapFogAll(Lang)</button>
                                    <button type="button" class="rf-me-action" @onclick="() => FogAllAsync(false)" data-test="map-reveal-all"><Icon Name="eye" /> @UiText.MapRevealAll(Lang)</button>
                                </div>
                            </section>
                            <section class="rf-me-section">
                                <span class="rf-me-kicker">@UiText.MapRulesTitle(Lang)</span>
                                <label class="rf-checkbox-wrapper small mb-0">
                                    <input type="checkbox" class="rf-checkbox" checked="@(terrain?.BlockPlayers ?? true)" @onchange="SetBlockPlayersAsync" data-test="map-block-players" />
                                    <span>@UiText.MapBlockPlayers(Lang)</span>
                                </label>
                                <label class="rf-checkbox-wrapper small mb-0">
                                    <input type="checkbox" class="rf-checkbox" checked="@fogEnabled" @onchange="ToggleFogAsync" data-test="map-fog-enabled" />
                                    <span>@UiText.MapFogEnabled(Lang)</span>
                                </label>
                            </section>
                        }
                        else if (editorTab == "grid")
                        {
                            <section class="rf-me-section" data-test="map-settings">
                                <span class="rf-me-kicker">@UiText.MapSettings(Lang)</span>
                                <label class="rf-vtt-field">
                                    <span class="rf-vtt-label">@UiText.MapName(Lang)</span>
                                    <input class="rf-form-control" maxlength="120" @bind="mapName" data-test="map-name" />
                                </label>
                                <div class="rf-vtt-field">
                                    <span class="rf-vtt-label">@UiText.MapGridType(Lang)</span>
                                    <div data-test="map-grid-type">
                                        <RfSelect TValue="GridType" Value="gridType" ValueChanged="v => gridType = v" Options="GridOptions" />
                                    </div>
                                </div>
                                <div class="rf-vtt-grid-fields">
                                    <div class="rf-vtt-field">
                                        <span class="rf-vtt-label">@UiText.MapGrid(Lang)</span>
                                        <NumberStepper Value="grid" ValueChanged="v => grid = v" Min="MapRules.MinGrid" Max="MapRules.MaxGrid" AriaLabel="@UiText.MapGrid(Lang)" InputTest="map-grid" />
                                    </div>
                                    <div class="rf-vtt-field">
                                        <span class="rf-vtt-label">@UiText.MapOffsetX(Lang)</span>
                                        <NumberStepper Value="offsetX" ValueChanged="v => offsetX = v" Min="0" Max="@(grid - 1)" AriaLabel="@UiText.MapOffsetX(Lang)" />
                                    </div>
                                    <div class="rf-vtt-field">
                                        <span class="rf-vtt-label">@UiText.MapOffsetY(Lang)</span>
                                        <NumberStepper Value="offsetY" ValueChanged="v => offsetY = v" Min="0" Max="@(grid - 1)" AriaLabel="@UiText.MapOffsetY(Lang)" />
                                    </div>
                                </div>
                                <div class="rf-me-quick">
                                    <button type="button" class="rf-me-action @(tool == "calibrate" ? "active" : null)" @onclick="ToggleCalibrateAsync" data-test="map-calibrate"><Icon Name="aspect-ratio" /> @UiText.MapCalibrate(Lang)</button>
                                    <label class="rf-me-action rf-vtt-replace @(replacingImage ? "disabled" : null)" data-test="map-replace-image">
                                        <Icon Name="images" /> @UiText.MapReplaceImage(Lang)
                                        <InputFile OnChange="ReplaceImageAsync" accept="image/png,image/jpeg,image/webp" class="d-none" />
                                    </label>
                                </div>
                                @if (tool == "calibrate")
                                {
                                    <p class="small mb-0" style="color: var(--rf-orange-primary);" data-test="map-calibrate-hint">@UiText.MapCalibrateHint(gridType, Lang)</p>
                                }
                                @if (imageError is not null && newMap is null)
                                {
                                    <p class="small mb-0" style="color: #ef4444;">@imageError</p>
                                }
                                <label class="rf-checkbox-wrapper small mb-0">
                                    <input type="checkbox" class="rf-checkbox" @bind="shown" data-test="map-shown" />
                                    <span>@UiText.MapShown(Lang)</span>
                                </label>
                            </section>
                        }
                        else
                        {
                            <section class="rf-me-section rf-me-tokens">
                                @AddTokens
                                <p class="rf-me-help mb-0">@UiText.MapTokenHint(Lang)</p>
                            </section>
                        }
                    </div>
                    <footer class="rf-me-foot">
                        <button type="button" class="btn btn-sm btn-rf-orange" @onclick="SaveMapAsync" data-test="map-save">@UiText.MapSave(Lang)</button>
                        <button type="button" class="btn btn-sm btn-rf-outline" @onclick="DuplicateAsync" data-test="map-duplicate">@UiText.MapDuplicate(Lang)</button>
                        <button type="button" class="btn btn-sm btn-rf-outline rf-me-delete" @onclick="() => confirmDelete = true" data-test="map-delete">@UiText.Delete(Lang)</button>
                    </footer>
                </aside>
            </div>
        }
    </section>
}

@if (newMap is not null)
{
    <div class="rf-modal-backdrop" @onclick="() => newMap = null">
        <div class="rf-modal-dialog" style="max-width: 520px;" @onclick:stopPropagation="true" data-test="map-new-dialog">
            <h2 class="h5 mb-3" style="color: var(--rf-orange-primary); font-family: var(--rf-font-display);">@UiText.MapNew(Lang)</h2>
            <label class="rf-vtt-field mb-3">
                <span class="rf-vtt-label">@UiText.MapName(Lang)</span>
                <input class="rf-form-control" maxlength="120" @bind="newMap.Name" data-test="map-new-name" />
            </label>
            <div class="rf-vtt-field mb-3">
                <span class="rf-vtt-label">@UiText.MapGridType(Lang)</span>
                <RfSelect TValue="GridType" Value="newMap.GridType" ValueChanged="v => newMap.GridType = v" Options="GridOptions" />
            </div>
            <label class="btn btn-sm btn-rf-outline mb-2" data-test="map-new-image">
                <InputFile OnChange="PickImageAsync" accept="image/*" class="d-none" />
                <Icon Name="map" /> @UiText.MapPickImage(Lang)
            </label>
            @if (newMap.Image is { Length: > 0 } preview)
            {
                <img src="@preview" alt="" class="rf-vtt-preview mb-2" />
                <div class="small mb-2" style="color: var(--rf-text-muted);">@newMap.Width × @newMap.Height px</div>
            }
            @if (imageError is not null)
            {
                <div class="small text-warning mb-2">@imageError</div>
            }
            <p class="small" style="color: var(--rf-text-muted);">@UiText.MapNewHint(Lang)</p>
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-sm btn-rf-outline" @onclick="() => newMap = null">@UiText.BtnCancel(Lang)</button>
                <button type="button" class="btn btn-sm btn-rf-orange" disabled="@(busy || string.IsNullOrEmpty(newMap.Image) || string.IsNullOrWhiteSpace(newMap.Name))" @onclick="CreateMapAsync" data-test="map-new-save">@UiText.MapSave(Lang)</button>
            </div>
        </div>
    </div>
}

@if (confirmDelete && map is not null)
{
    <div class="rf-modal-backdrop" @onclick="() => confirmDelete = false">
        <div class="rf-modal-dialog" style="max-width: 440px;" @onclick:stopPropagation="true">
            <p class="mb-3">@UiText.MapDeleteConfirm(map.Name, Lang)</p>
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-sm btn-rf-outline" @onclick="() => confirmDelete = false">@UiText.BtnCancel(Lang)</button>
                <button type="button" class="btn btn-sm btn-rf-orange" style="background-color: #dc3545; border-color: #dc3545;" @onclick="DeleteMapAsync" data-test="map-delete-yes">@UiText.Delete(Lang)</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid CampaignId { get; set; }
    [Parameter] public CampaignRole Role { get; set; } = CampaignRole.Player;
    [Parameter] public IReadOnlyList<CampaignCharacterDto> Characters { get; set; } = Array.Empty<CampaignCharacterDto>();
    [Parameter] public bool Table { get; set; }

    //	An encounter to start at once (from its page): chosen in the initiative bar, on its map
    [Parameter] public Guid? StartEncounter { get; set; }
    [Parameter] public string BackHref { get; set; } = "campaigns";
    [Parameter] public string MyColor { get; set; } = PlayerColors.Master;
    [Parameter] public IReadOnlyList<CampaignMemberDto> Members { get; set; } = Array.Empty<CampaignMemberDto>();

    //	The table open now (null: closed); the masters open and close it from the top bar
    [Parameter] public CampaignLiveTableDto? LiveTable { get; set; }

    private CampaignLiveTableDto? liveTable;
    private bool liveTableSet;
    private bool tableBusy;

    private async Task OpenTableAsync()
    {
        tableBusy = true;
        var opened = await Campaigns.OpenTableAsync(CampaignId);
        tableBusy = false;
        message = opened is null ? UiText.MapSaveFailed(Lang) : null;
        liveTable = opened ?? liveTable;
        if (opened is not null)
        {
            Live.Update(CampaignId, opened);
        }
    }

    private async Task CloseTableAsync()
    {
        tableBusy = true;
        var ok = (await Campaigns.CloseTableAsync(CampaignId)).Ok;
        tableBusy = false;
        message = ok ? null : UiText.MapSaveFailed(Lang);
        if (ok)
        {
            liveTable = null;
            Live.Update(CampaignId, null);
        }
    }

    private LanguageCode Lang => LanguageState.CurrentLanguage;
    private bool RunsTheTable => CampaignRules.RunsTheTable(Role);

    private List<CampaignMapSummaryDto>? maps;
    private Guid selectedId;
    private CampaignMapDto? map;
    private List<MapTokenDto> tokens = new();
    private double zoom = 1;
    private bool fitPending;

    //	At the table the map follows the window until the zoom is changed by hand
    private bool autoFit;
    private string? message;
    private bool busy;
    private bool confirmDelete;
    //	The panel on the right of the table: initiative, dice, tokens (masters), the quick sheet of a token
    private string? panel;
    private CampaignRolls? rollLog;

    private void TogglePanel(string name) => panel = panel == name ? null : name;

    private bool PanelShown(string name) => panel == name;

    private void ShowPanel(string name) => panel = name;

    private string tool = "select";

    //	Drawings, texts, notes and areas
    private List<MapShapeDto> shapes = new();
    private ShapeKind areaKind = ShapeKind.Cone;
    private string? drawColorChoice;
    private string drawColor => drawColorChoice ?? MyColor;
    private (double X, double Y)? textAt;
    private string? textValue;
    private bool textShared;

    //	The fight: the initiative order, the encounters a master can start, the cells moved in the current turn
    private MapCombatDto? combat;
    private List<EncounterSummaryDto> encounters = new();
    private Guid? encounterId;
    private Dictionary<Guid, int> moved = new();
    private Guid? movedTurn;
    private DiceTray? tray;

    //	What a token can roll and how far it moves, read from the sheet or the statblock
    private sealed record TokenRoll(string Label, string Bonus, string Expression, bool Hidden);
    private sealed record TokenStats(int? SpeedFeet, List<TokenRoll> Rolls, QuickSheet? Sheet = null, TokenSlots? Slots = null);

    //	The spell slots left of a character, by level, and its pact slots
    private sealed record TokenSlots(int[] Left, int PactLeft, int PactLevel);
    private readonly Dictionary<string, TokenStats?> stats = new();

    //	Fog of war, pings, the view the masters bring everyone to
    private bool fogEnabled;
    private List<double> fog = new();
    private bool fogCover;
    private bool fogBrush;

    //	The brush paints whole cells: 1 the cell under the pointer, 2 that one and the ring around it, and so on
    private const int MaxFogBrush = 4;
    private int fogBrushSize = 1;
    private MapPingDto? pingShown;
    private DateTimeOffset? pingSeen;
    private DateTimeOffset? focusSeen;

    //	Map settings (the board follows them before they are saved)
    private string mapName = string.Empty;
    private GridType gridType;
    private int grid = 70;
    private int offsetX;
    private int offsetY;
    private bool shown;

    //	Tokens: the one whose card is open, one being dragged (no polling meanwhile), the monsters' statistics
    private Guid? infoToken;
    private bool grabbing;
    private Dictionary<Guid, MonsterResponseDto> monsters = new();
    private string monsterSearch = string.Empty;
    private List<MonsterResponseDto> monsterResults = new();
    private string? markerLabel;
    private string markerColor = "#ff8c00";

    //	New map
    private SaveMapDto? newMap;
    private string? imageError;

    //	The board in the browser
    private ElementReference stageElement;
    private ElementReference tableElement;
    private string? attachedTo;
    private DotNetObjectReference<CampaignMap>? self;

    private CancellationTokenSource? stop;
    private readonly string patternId = $"rf-vtt-grid-{Guid.NewGuid():N}";

    private List<RfSelect<Guid>.OptionItem> MapOptions => (maps ?? new())
        .Select(m => new RfSelect<Guid>.OptionItem(m.Id, RunsTheTable && !m.Shown ? $"{m.Name} · {UiText.MapNotShown(Lang)}" : m.Name)).ToList();

    private List<RfSelect<GridType>.OptionItem> GridOptions => Enum.GetValues<GridType>()
        .Select(t => new RfSelect<GridType>.OptionItem(t, UiText.MapGridTypeName(t, Lang))).ToList();

    private MapTokenDto? InfoToken => tokens.FirstOrDefault(t => t.Id == infoToken);

    //	Characters of the table not yet on this map
    private IEnumerable<CampaignCharacterDto> FreeCharacters => Characters.Where(c => c.Active && tokens.All(t => t.CharacterId != c.Character.Id));

    private string ToolButton(string name) => tool == name ? "rf-vtt-tool active" : "rf-vtt-tool";

    private static string N(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private CampaignCharacterDto? CharacterOf(MapTokenDto t) => t.CharacterId is { } id ? Characters.FirstOrDefault(c => c.Character.Id == id) : null;

    private string? PortraitOf(MapTokenDto t) =>
        t.Portrait ?? CharacterOf(t)?.Character.Portrait ?? (t.ImageId is { } imageId ? Images.FileUrl(imageId) : null);

    private static string Initials(string label)
    {
        var words = label.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var initials = words.Length switch
        {
            0 => "?",
            1 => words[0][..Math.Min(2, words[0].Length)],
            _ => $"{words[0][0]}{words[^1][0]}"
        };
        return initials.ToUpperInvariant();
    }

    //	The short line under a token's name: level and class of a character, the numbers of a monster (for the masters)
    private string? Summary(MapTokenDto t)
    {
        if (CharacterOf(t) is { } c)
        {
            var ch = c.Character;
            return $"{UiText.TokenHitPoints(ch.CurrentHitPoints, ch.MaxHitPoints, Lang)} · {UiText.TokenArmorClass(ch.ArmorClass, Lang)}";
        }
        if (RunsTheTable && t.MonsterId is { } id && monsters.TryGetValue(id, out var m))
        {
            return $"{UiText.TokenHitPointsMax(m.HitPoints, Lang)} · {UiText.TokenArmorClass(m.ArmorClass, Lang)} · {UiText.MonsterChallengeShort(Lang)} {RealmForge.Shared.Monsters.MonsterMath.FormatChallenge(m.ChallengeRating)}";
        }
        return null;
    }

    // ===== The board =====

    private (double Width, double Height, string Path) Pattern()
    {
        var (w, h) = MapGeometry.Cell(gridType, grid);
        return gridType switch
        {
            GridType.HexRows => (w, 1.5 * h,
                $"M {N(w / 2)},0 L {N(w)},{N(h / 4)} L {N(w)},{N(3 * h / 4)} L {N(w / 2)},{N(h)} L 0,{N(3 * h / 4)} L 0,{N(h / 4)} Z M {N(w / 2)},{N(h)} L {N(w / 2)},{N(1.5 * h)}"),
            GridType.HexColumns => (1.5 * w, h,
                $"M 0,{N(h / 2)} L {N(w / 4)},0 L {N(3 * w / 4)},0 L {N(w)},{N(h / 2)} L {N(3 * w / 4)},{N(h)} L {N(w / 4)},{N(h)} Z M {N(w)},{N(h / 2)} L {N(1.5 * w)},{N(h / 2)}"),
            _ => (grid, grid, $"M {grid} 0 L 0 0 0 {grid}")
        };
    }

    private RenderFragment Board => __builder =>
    {
        if (maps is null)
        {
            <div class="small p-3" style="color: var(--rf-text-muted);">…</div>
            return;
        }
        if (map is null)
        {
            <div class="rf-vtt-empty" data-test="map-empty">
                <Icon Name="map" />
                <p class="mb-0">@(RunsTheTable ? UiText.MapEmptyMaster(Lang) : UiText.MapEmptyPlayer(Lang))</p>
            </div>
            return;
        }
        var (pw, ph, path) = Pattern();
        var z = N(zoom);
        <div class="rf-vtt-stage tool-@tool" @ref="stageElement" data-test="map-stage">
            <div class="rf-vtt-map" style="width: @(N(map.Width * zoom))px; height: @(N(map.Height * zoom))px;">
                <div class="rf-vtt-board" data-board data-zoom="@z" data-grid-type="@((int)gridType)" data-grid="@grid" data-ox="@offsetX" data-oy="@offsetY"
                     style="width: @(map.Width)px; height: @(map.Height)px; transform: scale(@z); --rf-zoom: @z;">
                    <img src="@map.Image" alt="@map.Name" draggable="false" width="@map.Width" height="@map.Height" />
                    <svg class="rf-vtt-grid" width="@map.Width" height="@map.Height" viewBox="0 0 @map.Width @map.Height" aria-hidden="true" data-test="map-grid" data-grid-type="@gridType">
                        <defs>
                            <pattern id="@patternId" width="@N(pw)" height="@N(ph)" x="@offsetX" y="@offsetY" patternUnits="userSpaceOnUse">
                                <path d="@path" fill="none" stroke="rgba(255,255,255,.4)" stroke-width="@N(1.25 / zoom)" />
                            </pattern>
                        </defs>
                        <rect width="@map.Width" height="@map.Height" fill="@($"url(#{patternId})")" />
                    </svg>
                    <svg class="rf-vtt-shapes" width="@map.Width" height="@map.Height" viewBox="0 0 @map.Width @map.Height" data-test="map-shapes">
                        @foreach (var sh in shapes)
                        {
                            @ShapeMarkup(sh)
                        }
                    </svg>
                    @if (ShowTerrain)
                    {
                        <svg class="rf-vtt-terrain" width="@map.Width" height="@map.Height" viewBox="0 0 @map.Width @map.Height" aria-hidden="true" data-test="map-terrain">
                            @foreach (var cell in terrainCells)
                            {
                                <polygon class="rf-terrain-@cell.Value.ToString().ToLowerInvariant()" points="@TerrainPoints(cell.Key.Col, cell.Key.Row)" data-test="map-terrain-cell" data-kind="@cell.Value" />
                            }
                        </svg>
                    }
                    @foreach (var t in tokens.Where(t => !HidesFromPreview(t)).OrderBy(t => t.Layer == TokenLayer.Below ? 0 : 1))
                    {
                        var (cx, cy) = MapGeometry.Center(gridType, grid, offsetX, offsetY, t.X, t.Y, t.Size);
                        var side = grid * t.Size;
                        var portrait = PortraitOf(t);
                        var summary = Summary(t);
                        <div class="rf-vtt-token @(t.Hidden ? "hidden-token" : null) @(t.Layer == TokenLayer.Below ? "below" : null) @(t.CanMove ? "movable" : null) @(infoToken == t.Id ? "selected" : null) @(IsCurrent(t) ? "current" : null) @(t.Kind == TokenKind.Prop ? $"prop state-{t.PropState.ToString().ToLowerInvariant()}" : null) @(t.Health is { } hl ? $"health-{hl.ToString().ToLowerInvariant()}" : null) @AimClass(t) @(t.PropType == PropType.Item ? "item" : null)"
                             style="left: @(N(cx - side / 2.0))px; top: @(N(cy - side / 2.0))px; width: @(side)px; height: @(side)px; --rf-token: @t.Color;"
                             data-token="@t.Id" data-col="@t.X" data-row="@t.Y" data-movable="@(t.CanMove ? "1" : "0")" data-cx="@N(cx)" data-cy="@N(cy)" data-speed="@SpeedCells(t)" data-moved="@(moved.GetValueOrDefault(t.Id))" data-size="@t.Size" data-test="map-token" data-label="@t.Label">
                            @if (t.Kind == TokenKind.Prop && t.PropType is { } propType)
                            {
                                <span class="rf-vtt-token-face" data-test="map-prop" data-state="@t.PropState">
                                    <Icon Name="@PropIcon(propType, t.PropState)" />
                                </span>
                                @if (t.PropState is PropState.Locked)
                                {
                                    <span class="rf-vtt-prop-badge locked" title="@UiText.PropStateName(propType, PropState.Locked, Lang)" data-test="map-prop-locked"><Icon Name="lock" /></span>
                                }
                                else if (t.PropState is PropState.Barred)
                                {
                                    <span class="rf-vtt-prop-badge barred" title="@UiText.PropStateName(propType, PropState.Barred, Lang)" data-test="map-prop-barred"><Icon Name="dash-square-fill" /></span>
                                }
                            }
                            else
                            {
                            <span class="rf-vtt-token-face">
                                @if (portrait is not null)
                                {
                                    <img src="@portrait" alt="" draggable="false" />
                                }
                                else
                                {
                                    <span>@Initials(t.Label)</span>
                                }
                            </span>
                            }
                            @if (RunsTheTable && t.Hp is { } hp && t.MaxHp is { } max && max > 0)
                            {
                                var share = Math.Clamp(hp / (double)max, 0, 1);
                                <svg class="rf-vtt-hp" viewBox="0 0 100 100" aria-hidden="true" data-test="map-token-hp-ring">
                                    <circle cx="50" cy="50" r="47" pathLength="100" stroke-dasharray="@($"{N(share * 100)} 100")" stroke="@HpColor(share)" />
                                </svg>
                            }
                            @if (t.Conditions is { Count: > 0 } conditions)
                            {
                                <span class="rf-vtt-conds" data-test="map-token-conditions">
                                    @foreach (var key in conditions.Take(4))
                                    {
                                        <span class="cond-@UiText.ConditionFamily(key)" title="@UiText.ConditionName(key, Lang)" data-condition="@key">@UiText.ConditionCode(key, Lang)</span>
                                    }
                                    @if (conditions.Count > 4)
                                    {
                                        <span>+@(conditions.Count - 4)</span>
                                    }
                                </span>
                            }
                            @if (t.Layer == TokenLayer.Tokens && t.Kind != TokenKind.Marker)
                            {
                                <span class="rf-vtt-token-name" data-test="map-token-name">@t.Label</span>
                            }
                            <span class="rf-vtt-tip" role="tooltip" data-test="map-token-tip">
                                <strong>@t.Label</strong>
                                <span>@(t.PropType is { } tipType ? $"{UiText.PropTypeName(tipType, Lang)} · {UiText.PropStateName(tipType, t.PropState, Lang)}" : UiText.TokenKindName(t.Kind, Lang))@(summary is null ? null : $" · {summary}")</span>
                                @if (t.Conditions is { Count: > 0 } named)
                                {
                                    <span>@string.Join(", ", named.Select(k => UiText.ConditionName(k, Lang)))</span>
                                }
                                @if (t.Health is { } health)
                                {
                                    <span>@UiText.HealthName(health, Lang)</span>
                                }
                            </span>
                        </div>
                    }
                    @if (fogEnabled)
                    {
                        <svg class="rf-vtt-fog @(RunsTheTable && !previewPlayers ? "master" : null)" width="@map.Width" height="@map.Height" viewBox="0 0 @map.Width @map.Height" aria-hidden="true" data-test="map-fog">
                            <defs>
                                <mask id="@($"{patternId}-fog")" maskUnits="userSpaceOnUse" x="0" y="0" width="@map.Width" height="@map.Height">
                                    <rect width="@map.Width" height="@map.Height" fill="#ffffff" />
                                    @for (var i = 0; i + 4 < fog.Count; i += 5)
                                    {
                                        var kind = (int)fog[i];
                                        var paint = MapFog.Reveals(kind) ? "#000000" : "#ffffff";
                                        if (kind is MapFog.RevealCircle or MapFog.CoverCircle)
                                        {
                                            <circle cx="@N(fog[i + 1])" cy="@N(fog[i + 2])" r="@N(fog[i + 3])" fill="@paint" />
                                        }
                                        else if (kind is MapFog.RevealHex or MapFog.CoverHex)
                                        {
                                            <polygon points="@HexPoints(fog[i + 1], fog[i + 2], fog[i + 3], (int)fog[i + 4])" fill="@paint" />
                                        }
                                        else
                                        {
                                            <rect x="@N(fog[i + 1])" y="@N(fog[i + 2])" width="@N(fog[i + 3])" height="@N(fog[i + 4])" fill="@paint" />
                                        }
                                    }
                                </mask>
                            </defs>
                            <rect width="@map.Width" height="@map.Height" fill="#0b0b0b" mask="@($"url(#{patternId}-fog)")" />
                        </svg>
                    }
                    @if (pingShown is { } pg)
                    {
                        <span class="rf-vtt-ping" @key="pg.At" style="left: @(N(pg.X))px; top: @(N(pg.Y))px; --rf-token: @pg.Color;" data-test="map-ping"><span class="rf-vtt-ping-dot"></span></span>
                    }
                    @if (InfoToken is { } selected)
                    {
                        @Toolbar(selected)
                    }
                    <svg class="rf-vtt-ruler" width="@map.Width" height="@map.Height" viewBox="0 0 @map.Width @map.Height" data-ruler aria-hidden="true"></svg>
                </div>
            </div>
        </div>
    };

    // ===== The options of the tool in use, at the bottom of the map =====

    private RenderFragment ToolOptionsBar => __builder =>
    {
        <div class="rf-vtt-options" data-test="vtt-options">
            @if (tool == "area")
            {
                @foreach (var kind in new[] { ShapeKind.Cone, ShapeKind.Sphere, ShapeKind.Line, ShapeKind.Cube })
                {
                    var k = kind;
                    <button type="button" class="rf-vtt-chip @(areaKind == k ? "active" : null)" @onclick="() => SetAreaAsync(k)" data-test="vtt-area-@k.ToString().ToLowerInvariant()">@UiText.AreaName(k, Lang)</button>
                }
                <span class="rf-vtt-options-hint">@UiText.VttAreaHint(Lang)</span>
            }
            else if (tool == "draw")
            {
                <input type="color" class="rf-vtt-color small" value="@drawColor" @onchange="SetColorAsync" aria-label="@UiText.MapColor(Lang)" />
                <span class="rf-vtt-options-hint">@UiText.VttDrawHint(Lang) @UiText.VttOnlyYou(Lang)</span>
            }
            else if (tool == "text")
            {
                @if (textAt is not null)
                {
                    <input class="rf-form-control rf-vtt-text-input" maxlength="@MapRules.MaxShapeText" placeholder="@UiText.VttTextHint(Lang)" @bind="textValue" @bind:event="oninput" @onkeydown="TextKeyAsync" data-test="vtt-text-input" />
                    <button type="button" class="btn btn-sm btn-rf-orange" disabled="@string.IsNullOrWhiteSpace(textValue)" @onclick="AddTextAsync" data-test="vtt-text-add">@UiText.MapSave(Lang)</button>
                }
                else
                {
                    <span class="rf-vtt-options-hint">@UiText.VttTextPlace(Lang)</span>
                }
                @if (RunsTheTable)
                {
                    <label class="rf-checkbox-wrapper small mb-0">
                        <input type="checkbox" class="rf-checkbox" @bind="textShared" data-test="vtt-text-shared" />
                        <span>@UiText.VttTextShared(Lang)</span>
                    </label>
                }
                else
                {
                    <span class="rf-vtt-options-hint">@UiText.VttOnlyYou(Lang)</span>
                }
            }
            else if (tool == "fog")
            {
                <label class="rf-checkbox-wrapper small mb-0">
                    <input type="checkbox" class="rf-checkbox" checked="@fogEnabled" @onchange="ToggleFogAsync" data-test="vtt-fog-enabled" />
                    <span>@UiText.VttFogOn(Lang)</span>
                </label>
                <button type="button" class="rf-vtt-chip @(fogCover ? null : "active")" @onclick="() => SetFogAsync(false, fogBrush)" data-test="vtt-fog-reveal">@UiText.VttFogReveal(Lang)</button>
                <button type="button" class="rf-vtt-chip @(fogCover ? "active" : null)" @onclick="() => SetFogAsync(true, fogBrush)" data-test="vtt-fog-cover">@UiText.VttFogCover(Lang)</button>
                <button type="button" class="rf-vtt-chip @(fogBrush ? null : "active")" @onclick="() => SetFogAsync(fogCover, false)" data-test="vtt-fog-rect">@UiText.VttFogRect(Lang)</button>
                <button type="button" class="rf-vtt-chip @(fogBrush ? "active" : null)" @onclick="() => SetFogAsync(fogCover, true)" data-test="vtt-fog-brush">@UiText.VttFogBrush(Lang)</button>
                @if (fogBrush)
                {
                    <span class="rf-vtt-chips" role="group" aria-label="@UiText.VttFogBrushSize(Lang)" data-test="vtt-fog-sizes">
                        @for (var n = 1; n <= MaxFogBrush; n++)
                        {
                            var size = n;
                            <button type="button" class="rf-vtt-chip @(fogBrushSize == size ? "active" : null)" title="@UiText.VttFogBrushSize(Lang)"
                                    @onclick="() => SetFogBrushSizeAsync(size)" data-test="vtt-fog-size-@size">@FogBrushLabel(size)</button>
                        }
                    </span>
                }
                <button type="button" class="btn btn-sm btn-rf-outline" @onclick="() => FogAllAsync(false)" data-test="vtt-fog-reveal-all">@UiText.VttFogRevealAll(Lang)</button>
                <button type="button" class="btn btn-sm btn-rf-outline" @onclick="() => FogAllAsync(true)" data-test="vtt-fog-cover-all">@UiText.VttFogCoverAll(Lang)</button>
            }
            else
            {
                <span class="rf-vtt-chips" role="group" aria-label="@UiText.VttToolErase(Lang)">
                    <button type="button" class="rf-vtt-chip @(eraseArea ? null : "active")" @onclick="() => SetEraseAsync(false)" data-test="vtt-erase-click">@UiText.VttEraseClick(Lang)</button>
                    <button type="button" class="rf-vtt-chip @(eraseArea ? "active" : null)" @onclick="() => SetEraseAsync(true)" data-test="vtt-erase-area">@UiText.VttEraseArea(Lang)</button>
                </span>
                <span class="rf-vtt-options-hint">@(eraseArea ? UiText.VttEraseAreaHint(Lang) : UiText.VttEraseHint(Lang))</span>
                <button type="button" class="btn btn-sm btn-rf-outline" @onclick="ClearShapesAsync" data-test="vtt-clear-shapes">@(RunsTheTable ? UiText.VttClearAll(Lang) : UiText.VttClearMine(Lang))</button>
            }
        </div>
    };

    // ===== The token's toolbar: what a click on a token opens, next to it =====

    private static readonly string[] RingColors =
        { "#ff8c00", "#dc3545", "#f59e0b", "#22c55e", "#14b8a6", "#3b82f6", "#6366f1", "#ab47bc", "#ec4899", "#9e9e9e", "#f5f5f5", "#111827" };

    private string? toolTab;
    private string? renameValue;

    //	A master changes anything; the owner of a character only reads it here (the sheet holds it). The head: the quick
    //	sheet, the name and what matters of it, the conditions (or what an object does); the dock: what can be done, in
    //	two rows (the second behind "Altro"); under it, the drawer of the item chosen
    private RenderFragment Toolbar(MapTokenDto it) => __builder =>
    {
        if (it.PropType == PropType.Item)
        {
            @GroundPopup(it)
            return;
        }
        var character = CharacterOf(it);
        MonsterResponseDto? monster = it.MonsterId is { } mid && monsters.TryGetValue(mid, out var found) ? found : null;
        var (cx, cy) = MapGeometry.Center(gridType, grid, offsetX, offsetY, it.X, it.Y, it.Size);
        var side = grid * it.Size;
        var hasSheet = HasSheet(it) || PeekSheet(it);
        <section class="rf-vtt-toolbar rf-hud" data-ui style="left: @(N(cx + side / 2.0 + 4 / zoom))px; top: @(N(cy - side / 2.0))px; --rf-token: @it.Color;" data-token-id="@it.Id" data-test="map-token-card"
                 @onkeydown:stopPropagation="true">
            <header class="rf-hud-top">
                @if (hasSheet)
                {
                    <button type="button" class="rf-hud-sheet @(PanelShown("sheet") && sheetTokenId == it.Id ? "active" : null)" title="@UiText.VttQuickSheetOpen(Lang)" aria-label="@UiText.VttQuickSheetOpen(Lang)"
                            @onclick="() => OpenSheet(it)" data-test="map-token-sheet"><Icon Name="file-text" /></button>
                }
                else
                {
                    <span class="rf-hud-sheet static"><Icon Name="@(it.PropType is { } headType ? PropIcon(headType, it.PropState) : KindIcon(it.Kind))" /></span>
                }
                <div class="rf-hud-identity">
                    <div class="rf-hud-name-line">
                        @if (toolTab == "rename")
                        {
                            <input class="rf-form-control rf-vtt-rename" maxlength="100" @bind="renameValue" @bind:event="oninput" @onkeydown="RenameKeyAsync" data-test="map-token-rename" />
                        }
                        else
                        {
                            <strong class="rf-hud-name" data-test="map-token-card-name">@it.Label</strong>
                            @if (RunsTheTable)
                            {
                                <button type="button" class="rf-vtt-icon-button" title="@UiText.TokenRename(Lang)" aria-label="@UiText.TokenRename(Lang)" @onclick="() => StartRename(it)"><Icon Name="edit" /></button>
                            }
                            @if (RunsTheTable && monster?.Attitude is { } attitude)
                            {
                                <span class="rf-hud-attitude attitude-@attitude.ToString().ToLowerInvariant()">@UiText.FormatNpcAttitude(attitude, Lang)</span>
                            }
                        }
                    </div>
                    <span class="rf-hud-sub" data-test="map-token-card-stats">@ToolbarLine(it, character, monster)</span>
                </div>
                @if (it.PropType is { } usedType && usedType != PropType.Item)
                {
                    @if (RunsTheTable || it.PlayersInteract)
                    {
                        @if (PropRules.Toggle(it.PropState) is not null)
                        {
                            <button type="button" class="rf-hud-action" disabled="@busy" @onclick="() => InteractAsync(it)" data-test="map-prop-use">@UiText.PropAction(usedType, it.PropState, Lang)</button>
                        }
                        else
                        {
                            <span class="rf-hud-stuck" data-test="map-prop-stuck"><Icon Name="@(it.PropState == PropState.Barred ? "dash-square-fill" : "lock")" /> @UiText.PropStuck(usedType, it.PropState, Lang)</span>
                        }
                    }
                }
                else if (it.PropType is null && !RunsTheTable && !CanChangeConditions(it, character))
                {
                    @if (it.Conditions is { Count: > 0 } shownConditions)
                    {
                        <span class="rf-hud-conditions static" data-test="map-token-conditions-static">@string.Join(" · ", shownConditions.Select(k => UiText.ConditionName(k, Lang)))</span>
                    }
                }
                else if (it.PropType is null)
                {
                    <button type="button" class="rf-hud-conditions @(toolTab == "conditions" ? "active" : null)" @onclick="@(() => Tab("conditions"))" data-test="map-token-conditions-tab">
                        @if (it.Conditions is { Count: > 0 } conditionList)
                        {
                            <span>@string.Join(" · ", conditionList.Take(2).Select(k => UiText.ConditionName(k, Lang)))@(conditionList.Count > 2 ? $" +{conditionList.Count - 2}" : null)</span>
                        }
                        else
                        {
                            <span>@UiText.TokenConditions(Lang)</span>
                        }
                        @if (CanChangeConditions(it, character))
                        {
                            <span class="rf-hud-plus"><Icon Name="plus" /></span>
                        }
                    </button>
                }
                <button type="button" class="rf-vtt-card-close rf-vtt-icon-button" @onclick="CloseToolbar" aria-label="@UiText.TokenClose(Lang)" title="@UiText.TokenClose(Lang)"><Icon Name="close" /></button>
            </header>
            @if (propMessage is not null)
            {
                <p class="rf-hud-message" data-test="map-prop-message">@propMessage</p>
            }
            @if (it.PropType == PropType.Item)
            {
                @TakeList(it)
            }
            @if (moreDock && RunsTheTable)
            {
                <nav class="rf-hud-dock more">
                    @if (it.CharacterId is null && it.PropType is null)
                    {
                        @DockButton("art", "images", UiText.ToolArt(Lang), "map-token-tab-art")
                    }
                    <button type="button" class="rf-hud-dock-item @(it.Layer == TokenLayer.Below ? "on" : null)" aria-pressed="@(it.Layer == TokenLayer.Below ? "true" : "false")" title="@UiText.MapTokenBelow(Lang)"
                            @onclick="() => ToggleLayerAsync(it)" data-test="map-token-below"><Icon Name="layers" /><span>@UiText.ToolBelow(Lang)</span></button>
                    @if (PlayerMembers.Any())
                    {
                        @DockButton("assign", "people", UiText.ToolAssign(Lang), "map-token-tab-assign")
                    }
                    <button type="button" class="rf-hud-dock-item" @onclick="() => DuplicateTokenAsync(it)" data-test="map-token-duplicate"><Icon Name="copy" /><span>@UiText.ToolDuplicate(Lang)</span></button>
                    <button type="button" class="rf-hud-dock-item danger" @onclick="() => RemoveTokenAsync(it)" data-test="map-token-remove"><Icon Name="trash" /><span>@UiText.BtnRemove(Lang)</span></button>
                    <button type="button" class="rf-hud-dock-back" title="@UiText.ToolBack(Lang)" aria-label="@UiText.ToolBack(Lang)" @onclick="() => { moreDock = false; toolTab = null; }" data-test="map-token-more-back"><Icon Name="left" /></button>
                </nav>
            }
            else if (HasDock(it, character))
            {
                <nav class="rf-hud-dock">
                    @if (RunsTheTable && it.PropType is not null and not PropType.Item)
                    {
                        @DockButton("state", "key", UiText.ToolState(Lang), "map-token-tab-state")
                    }
                    @if (it.PropType is null && (RunsTheTable || CanChangeHp(it, character)))
                    {
                        @DockButton("hp", "heart", UiText.ToolHp(Lang), "map-token-tab-hp")
                    }
                    @if (Table && CanDrop(it))
                    {
                        @DockButton("drop", "hammer", UiText.ToolDrop(Lang), "map-token-tab-drop")
                    }
                    @if (Table && it.PropType is null && HasLoot(it))
                    {
                        @DockButton("loot", "backpack", UiText.VttLoot(Lang), "map-token-tab-loot")
                    }
                    @if (RunsTheTable && Table && it.Kind is not (TokenKind.Marker or TokenKind.Prop))
                    {
                        <button type="button" class="rf-hud-dock-item @(InFight(it) ? "on" : null)" disabled="@busy" @onclick="() => ToggleFightAsync(it)" data-test="map-token-fight"
                                title="@(InFight(it) ? UiText.VttLeaveFight(Lang) : combat is null ? UiText.VttFightAlone(Lang) : UiText.VttJoinFight(Lang))">
                            <Icon Name="shield" /><span>@UiText.VttInitiative(Lang)</span>
                        </button>
                    }
                    @if (RunsTheTable)
                    {
                        <button type="button" class="rf-hud-dock-item @(it.Hidden ? "on" : null)" aria-pressed="@(it.Hidden ? "true" : "false")" @onclick="() => ToggleHiddenAsync(it)" data-test="map-token-hidden">
                            <Icon Name="@(it.Hidden ? "eye-slash" : "eye")" /><span>@UiText.ToolHide(Lang)</span>
                        </button>
                        @DockButton("ring", "circle", UiText.ToolRing(Lang), "map-token-tab-ring")
                        @if (it.CharacterId is null)
                        {
                            @DockButton("size", "aspect-ratio", UiText.ToolSize(Lang), "map-token-tab-size")
                        }
                        <button type="button" class="rf-hud-dock-item" @onclick="() => { moreDock = true; toolTab = null; }" data-test="map-token-tab-more"><Icon Name="three-dots" /><span>@UiText.ToolMore(Lang)</span></button>
                    }
                    else
                    {
                        @if (it.Controlled)
                        {
                            @DockButton("ring", "circle", UiText.ToolRing(Lang), "map-token-tab-ring")
                        }
                        @if (character?.CanOpen == true)
                        {
                            @DockButton("more", "three-dots", UiText.ToolMore(Lang), "map-token-tab-more")
                        }
                    }
                </nav>
            }
            @switch (toolTab)
            {
                case "drop":
                    var weapons = Droppable(it);
                    <div class="rf-vtt-toolbar-panel rf-hud-drawer" data-test="map-token-drop">
                        <span class="rf-vtt-label">@UiText.VttDropHint(Lang)</span>
                        @if (weapons.Count == 0)
                        {
                            <p class="small mb-0">@UiText.VttDropNone(Lang)</p>
                        }
                        <div class="rf-hud-pills">
                            @foreach (var w in weapons)
                            {
                                var weapon = w;
                                <button type="button" class="rf-hud-pill" disabled="@busy" @onclick="() => DropAsync(it, weapon)" data-test="map-token-drop-weapon">@weapon.Name</button>
                            }
                        </div>
                        @if (gearNote is not null)
                        {
                            <p class="small mb-0" data-test="map-token-drop-note">@gearNote</p>
                        }
                    </div>
                    break;
                case "loot":
                    <div class="rf-vtt-toolbar-panel rf-hud-drawer">
                        @TakeList(it)
                    </div>
                    break;
                case "state" when it.PropType is { } stateType:
                    <div class="rf-vtt-toolbar-panel rf-hud-drawer">
                        <div class="rf-hud-pills">
                            @foreach (var st in PropRules.States(stateType))
                            {
                                var state = st;
                                <button type="button" class="rf-hud-pill @(it.PropState == state ? "active" : null)" @onclick="() => SaveTokenAsync(it, it with { PropState = state })" data-test="map-prop-state" data-state="@state">@UiText.PropStateName(stateType, state, Lang)</button>
                            }
                        </div>
                        <label class="rf-checkbox-wrapper small mb-0">
                            <input type="checkbox" class="rf-checkbox" checked="@it.PlayersInteract" @onchange="() => SaveTokenAsync(it, it with { PlayersInteract = !it.PlayersInteract })" data-test="map-prop-players" />
                            <span>@UiText.PropPlayers(Lang)</span>
                        </label>
                    </div>
                    break;
                case "hp":
                    var vitals = character is null ? null : charVitals.GetValueOrDefault(character.Character.Id);
                    <div class="rf-vtt-toolbar-panel rf-hud-drawer" data-test="map-token-hp">
                        @if (CanChangeHp(it, character))
                        {
                            var nowHp = character is not null ? LifeHp(character) : it.Hp ?? it.MaxHp ?? 0;
                            var maxHp = character is not null ? LifeMax(character) : it.MaxHp ?? 0;
                            var tempHp = character is not null ? vitals?.TemporaryHitPoints ?? it.SheetTempHp ?? 0 : it.TempHp ?? 0;
                            <div class="rf-hud-hp-row">
                                <button type="button" class="rf-hud-hp heal" disabled="@(hpAmount is null or <= 0 || busy)" @onclick="() => HealAsync(it, 1)" data-test="map-token-heal"><Icon Name="plus" /> @UiText.ToolHeal(Lang)</button>
                                <input type="number" class="rf-hud-hp-amount" min="0" max="10000" placeholder="—" @bind="hpAmount" @bind:event="oninput" @onkeydown="e => HpKeyAsync(e, it)" aria-label="@UiText.ToolHpAmount(Lang)" data-test="map-token-hp-amount" />
                                <button type="button" class="rf-hud-hp damage" disabled="@(hpAmount is null or <= 0 || busy)" @onclick="() => HealAsync(it, -1)" data-test="map-token-damage">@UiText.ToolDamage(Lang) <Icon Name="dash" /></button>
                            </div>
                            <div class="rf-hud-stats">
                                <label class="rf-hud-stat temp">
                                    <span>@UiText.ToolTempHp(Lang)</span>
                                    <input type="number" min="0" max="10000" value="@tempHp" @onchange="e => SetTempHpAsync(it, e.Value?.ToString())" aria-label="@UiText.ToolTempHp(Lang)" data-test="map-token-temp-hp" />
                                </label>
                                @if (character is not null || it.CombatantId is null)
                                {
                                    <label class="rf-hud-stat">
                                        <span>@UiText.ToolHpMaxEdit(Lang)</span>
                                        <input type="number" min="1" max="100000" value="@maxHp" @onchange="e => SetMaxAsync(it, e.Value?.ToString())" aria-label="@UiText.ToolHpMaxEdit(Lang)" data-test="map-token-max-hp" />
                                    </label>
                                }
                                @if (RunsTheTable && character is null)
                                {
                                    <label class="rf-hud-stat armor">
                                        <span>@UiText.ToolArmorClass(Lang)</span>
                                        <input type="number" min="1" max="50" value="@(ArmorOf(it, monster))" @onchange="e => SetArmorAsync(it, e.Value?.ToString())" aria-label="@UiText.ToolArmorClass(Lang)" data-test="map-token-ac" />
                                    </label>
                                }
                            </div>
                            @if (RunsTheTable && character is null)
                            {
                                <button type="button" class="rf-hud-share @(it.ShowHp ? "on" : null)" aria-pressed="@(it.ShowHp ? "true" : "false")" @onclick="() => ToggleShowHpAsync(it)" data-test="map-token-show-hp">
                                    <Icon Name="@(it.ShowHp ? "eye" : "eye-slash")" />
                                    <span>@(it.ShowHp ? UiText.ToolHpShown(Lang) : UiText.ToolHpHidden(Lang))</span>
                                </button>
                            }
                        }
                        else if (character is not null)
                        {
                            <p class="small mb-0">@UiText.TokenHitPoints(character.Character.CurrentHitPoints, character.Character.MaxHitPoints, Lang)</p>
                        }
                        else if (it.Hp is { } shownHp && it.MaxHp is { } shownMax)
                        {
                            <p class="small mb-0">@UiText.TokenHitPoints(shownHp, shownMax, Lang)</p>
                        }
                    </div>
                    break;
                case "conditions":
                    <div class="rf-vtt-toolbar-panel rf-hud-drawer">
                        @if (CanChangeConditions(it, character))
                        {
                            <div class="rf-hud-pills" data-test="map-token-condition-list">
                                @foreach (var key in EncounterRules.Conditions)
                                {
                                    var k = key;
                                    var on = it.Conditions?.Contains(k) == true;
                                    <button type="button" class="rf-hud-pill @(on ? "active" : null)" aria-pressed="@(on ? "true" : "false")" @onclick="() => ToggleConditionAsync(it, k)" data-test="map-token-condition" data-key="@k">@UiText.ConditionName(k, Lang)</button>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="small mb-0">@(it.Conditions is { Count: > 0 } cs ? string.Join(", ", cs.Select(k => UiText.ConditionName(k, Lang))) : UiText.ToolNoConditions(Lang))</p>
                        }
                    </div>
                    break;
                case "art":
                    <div class="rf-vtt-toolbar-panel rf-hud-drawer">
                        <ImagePicker Selected="it.ImageId" Name="@it.Label" OnPick="id => SaveTokenAsync(it, it with { ImageId = id })" />
                    </div>
                    break;
                case "ring":
                    <div class="rf-vtt-toolbar-panel rf-hud-drawer">
                        <div class="rf-hud-swatches">
                            @foreach (var c in RingColors)
                            {
                                var color = c;
                                <button type="button" class="rf-hud-swatch @(string.Equals(it.Color, color, StringComparison.OrdinalIgnoreCase) ? "active" : null)" style="--c: @color;" aria-label="@color" title="@color" @onclick="() => SetColorAsync(it, color)" data-test="map-token-color"></button>
                            }
                            <input type="color" class="rf-vtt-color" value="@it.Color" @onchange="e => SetColorAsync(it, e.Value?.ToString())" aria-label="@UiText.MapColor(Lang)" />
                        </div>
                    </div>
                    break;
                case "size":
                    <div class="rf-vtt-toolbar-panel rf-hud-drawer">
                        <div class="rf-hud-pills">
                            @for (var n = 1; n <= MapRules.MaxTokenSize; n++)
                            {
                                var size = n;
                                <button type="button" class="rf-hud-pill @(it.Size == size ? "active" : null)" @onclick="() => ResizeAsync(it, size)" data-test="map-token-size" data-size="@size">@UiText.ToolSizeName(size, Lang)</button>
                            }
                        </div>
                    </div>
                    break;
                case "assign" when RunsTheTable:
                    <div class="rf-vtt-toolbar-panel rf-hud-drawer">
                        <span class="rf-vtt-label">@UiText.ToolControlledBy(Lang)</span>
                        @foreach (var m in PlayerMembers)
                        {
                            var member = m;
                            <label class="rf-checkbox-wrapper small mb-0">
                                <input type="checkbox" class="rf-checkbox" checked="@(it.ControlledBy?.Contains(member.UserId) == true)" @onchange="() => ToggleControlAsync(it, member.UserId)" data-test="map-token-assign" data-user="@member.Name" />
                                <span style="color: @member.Color;">@member.Name</span>
                            </label>
                        }
                    </div>
                    break;
                case "more":
                    <div class="rf-vtt-toolbar-panel rf-hud-drawer rf-vtt-toolbar-more">
                        @if (character is not null && character.CanOpen)
                        {
                            <a href="@($"characters/{character.Character.Id}")" class="rf-vtt-card-link"><Icon Name="external" /> @UiText.TokenOpenSheet(Lang)</a>
                        }
                        @if (it.CanMove)
                        {
                            <p class="small mb-0">@UiText.ToolMoveHint(Lang)</p>
                        }
                        else
                        {
                            <p class="small mb-0">@UiText.TokenKindName(it.Kind, Lang)</p>
                        }
                    </div>
                    break;
            }
        </section>
    };

    //	An item lying on the ground: what it is (its numbers from the compendium, its card behind "i"), and who can take
    //	it: into the pack or in hand, from a token next to it (the action of the turn in a fight), or how far mine is
    private RenderFragment GroundPopup(MapTokenDto it) => __builder =>
    {
        var (cx, cy) = MapGeometry.Center(gridType, grid, offsetX, offsetY, it.X, it.Y, it.Size);
        var side = grid * it.Size;
        var item = it.Gear?.Items.FirstOrDefault();
        var detail = item is null ? null : GroundItemOf(item);
        var st = detail?.Stats;
        var takers = Takers(it);
        var taker = takers.FirstOrDefault(k => k.Id == groundTaker) ?? takers.FirstOrDefault();
        var (nearest, distance) = NearestMine(it);
        <section class="rf-vtt-toolbar rf-ground-pop" data-ui style="left: @(N(cx + side / 2.0 + 4 / zoom))px; top: @(N(cy - side / 2.0))px;" data-token-id="@it.Id" data-test="map-token-card"
                 @onkeydown:stopPropagation="true">
            <header class="gip-header">
                <div class="gip-identity">
                    <span class="gip-icon-box"><Icon Name="hammer" /></span>
                    <div class="gip-title-group">
                        <div class="gip-name-row">
                            <h3 class="gip-name" data-test="map-token-card-name">@(item?.Name ?? it.Label)@(item is { Quantity: > 1 } many ? $" ×{many.Quantity}" : null)</h3>
                            @if (detail is not null)
                            {
                                <button type="button" class="rf-info-i" title="@UiText.VttGroundInfo(Lang)" aria-label="@UiText.VttGroundInfo(Lang)" @onclick="() => groundInfo = detail" data-test="map-ground-info">i</button>
                            }
                        </div>
                        <div class="gip-sub-row">
                            <span class="gip-status">@UiText.PropStateName(PropType.Item, it.PropState, Lang)</span>
                            @if (st is not null)
                            {
                                <span class="gip-dot">•</span>
                                <span class="gip-cat">@EquipmentInfoModal.SubtitleOf(st, Lang)</span>
                            }
                        </div>
                    </div>
                </div>
                <button type="button" class="rf-vtt-card-close rf-vtt-icon-button" @onclick="CloseToolbar" aria-label="@UiText.TokenClose(Lang)" title="@UiText.TokenClose(Lang)"><Icon Name="close" /></button>
            </header>
            @if (st is not null)
            {
                <div class="gip-stats" data-test="map-ground-stats">
                    @if (st.Category == EquipmentCategory.Weapon)
                    {
                        <div class="g-chip dmg"><span>@UiText.ColDamage(Lang)</span><strong>@EquipmentTerms.FormatDamage(st.DamageDice, st.DamageType, Lang)</strong></div>
                        @if (st.WeaponProperties.Count > 0)
                        {
                            <div class="g-chip"><span>@UiText.ColProperties(Lang)</span><strong>@EquipmentTerms.FormatProperties(st.WeaponProperties, st.NormalRange, st.LongRange, st.VersatileDamageDice, Lang)</strong></div>
                        }
                        @if (st.Mastery is { } mastery)
                        {
                            <div class="g-chip mastery"><span>@UiText.LabelMastery(Lang)</span><strong>@EquipmentTerms.MasteryName(mastery, Lang)</strong></div>
                        }
                    }
                    else if (st.Category == EquipmentCategory.Armor)
                    {
                        <div class="g-chip dmg"><span>@UiText.ColArmorClass(Lang)</span><strong>@EquipmentTerms.FormatArmorClass(st.ArmorCategory, st.ArmorClass, st.ArmorAddsDexterity, st.ArmorMaxDexterityBonus, Lang)</strong></div>
                    }
                    <div class="g-chip"><span>@UiText.ColWeight(Lang)</span><strong>@EquipmentTerms.FormatWeight(st.WeightInPounds, Lang)</strong></div>
                </div>
            }
            @if (item is null)
            {
                <p class="gip-note">@UiText.VttLootEmpty(Lang)</p>
            }
            else if (taker is not null)
            {
                <footer class="gip-footer" data-test="map-token-take">
                    <div class="gip-range">
                        <span class="gip-who"><span class="gip-dot-ok"></span>@((MarkupString)UiText.VttGroundNext(System.Net.WebUtility.HtmlEncode(taker.Label), Lang))</span>
                        @if (combat is not null)
                        {
                            <span class="gip-cost">@UiText.VttGroundCost(Lang)</span>
                        }
                    </div>
                    @if (takers.Count > 1)
                    {
                        <div class="rf-hud-pills" role="group" aria-label="@UiText.VttGroundWho(Lang)">
                            @foreach (var tk in takers)
                            {
                                var choice = tk;
                                <button type="button" class="rf-hud-pill @(choice.Id == taker.Id ? "active" : null)" @onclick="() => groundTaker = choice.Id">@choice.Label</button>
                            }
                        </div>
                    }
                    <div class="gip-buttons">
                        <button type="button" class="gip-pack" disabled="@busy" @onclick="() => TakeAsync(it, taker, item.Index, false)" data-test="map-token-take-item"><Icon Name="backpack2" /> @UiText.VttGroundPack(Lang)</button>
                        <button type="button" class="gip-wield" disabled="@busy" @onclick="() => TakeAsync(it, taker, item.Index, true)" data-test="map-token-take-wield"><Icon Name="hand-index" /> @UiText.VttGroundWield(Lang)</button>
                    </div>
                    @if (gearNote is not null)
                    {
                        <p class="gip-note" data-test="map-token-take-note">@gearNote</p>
                    }
                </footer>
            }
            else
            {
                <footer class="gip-footer">
                    <div class="gip-far" data-test="map-token-take-far">
                        <Icon Name="warning" />
                        <div>
                            <strong>@(nearest is null ? UiText.VttGroundNobody(Lang) : UiText.VttGroundFar(distance, Lang))</strong>
                            <span>@UiText.VttGroundFarHint(Lang)</span>
                        </div>
                    </div>
                </footer>
            }
        </section>
    };

    //	The token that takes an item on the ground, when more of mine are next to it
    private Guid? groundTaker;

