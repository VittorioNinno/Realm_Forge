    private static string Bonus(int value) => value >= 0 ? $"+{value}" : value.ToString(CultureInfo.InvariantCulture);

    private static string D20(int bonus) => bonus == 0 ? "1d20" : $"1d20{Bonus(bonus)}";

    private async Task<TokenStats?> CharacterStatsAsync(Guid id)
    {
        var character = await CharacterService.GetCharacterAsync(id);
        if (character is null)
        {
            return null;
        }
        var context = character.IsOwner && !character.ReadOnly
            ? await CharacterService.GetContextAsync(character.Ruleset, Lang)
            : await CharacterService.GetCharacterContextAsync(id, character.Ruleset, Lang);
        if (context is null)
        {
            return null;
        }
        var computed = RealmForge.Shared.Characters.CharacterCalculator.Compute(new RealmForge.Shared.Characters.CharacterInput
        {
            Name = character.Name,
            Ruleset = character.Ruleset,
            SpeciesId = character.SpeciesId,
            SubspeciesId = character.SubspeciesId,
            BackgroundId = character.BackgroundId,
            Build = character.Build,
            Sheet = character.Sheet,
            CampaignModuleIds = character.CampaignModuleIds ?? new()
        }, context);
        var rolls = new List<TokenRoll> { new(UiText.RollInitiative(Lang), Bonus(computed.Initiative), D20(computed.Initiative), false) };
        foreach (var attack in computed.Attacks.Take(3))
        {
            rolls.Add(new(UiText.RollAttack(attack.Item.Name, Lang), Bonus(attack.AttackBonus), D20(attack.AttackBonus), false));
            var damage = attack.Damage.Replace(" ", string.Empty);
            if (System.Text.RegularExpressions.Regex.IsMatch(damage, @"^\d*d\d+([+-]\d+)?$"))
            {
                rolls.Add(new(UiText.RollDamage(attack.Item.Name, Lang), damage, damage, false));
            }
        }
        foreach (var ability in Enum.GetValues<AbilityScore>())
        {
            rolls.Add(new(UiText.RollSave(UiText.AbilityShort(ability, Lang), Lang), Bonus(computed.SaveBonus(ability)), D20(computed.SaveBonus(ability)), false));
        }
        return new TokenStats(computed.Speed, rolls);
    }

    private async Task<TokenStats?> MonsterStatsAsync(Guid id)
    {
        var monster = await MonsterService.GetMonsterAsync(id, Lang);
        if (monster is null || monster.Abilities.Count < 6)
        {
            return null;
        }
        int Mod(int score) => (int)Math.Floor((score - 10) / 2.0);
        var dex = Mod(monster.Abilities[1]);
        var rolls = new List<TokenRoll> { new(UiText.RollInitiative(Lang), Bonus(dex), D20(dex), true) };
        foreach (var ability in Enum.GetValues<AbilityScore>())
        {
            var mod = Mod(monster.Abilities[(int)ability - 1]);
            rolls.Add(new(UiText.RollCheck(UiText.AbilityShort(ability, Lang), Lang), Bonus(mod), D20(mod), true));
        }
        return new TokenStats(monster.Speed, rolls);
    }

