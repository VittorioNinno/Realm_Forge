    private void ApplyTable(MapTableDto? table, bool first)
    {
        if (table is null)
        {
            return;
        }
        fogEnabled = table.FogEnabled;
        fog = table.Fog;
        playersLocked = table.PlayersLocked;
        if (PlayersStopped && tool is "area" or "ping")
        {
            _ = SetToolAsync("select");
        }
        if (table.Ping is { } ping && ping.At != pingSeen)
        {
            pingSeen = ping.At;
            if (!first)
            {
                ShowPing(ping);
            }
        }
        if (table.Strike is { } hit && hit.At != strikeSeen)
        {
            strikeSeen = hit.At;
            if (!first)
            {
                _ = ShowStrikeAsync(hit.TokenId, hit.Kind == 0 ? "miss" : hit.Kind == 2 ? "crit" : "hit",
                    hit.Kind == 0 ? UiText.VttMissed(Lang) : hit.Damage is { } dealt ? $"−{dealt}" : UiText.VttHit(Lang));
            }
        }
        if (table.Focus is { } focus && focus.At != focusSeen)
        {
            focusSeen = focus.At;
            if (!first && Table && !RunsTheTable)
            {
                autoFit = false;
                zoom = focus.Zoom;
                pendingFocus = (focus.X, focus.Y);
            }
        }
    }

