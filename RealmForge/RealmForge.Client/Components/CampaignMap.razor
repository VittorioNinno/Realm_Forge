                                   GivenCharacters="GivenCharacters" Minimized="diceMin" OnMinimize="() => diceMin = !diceMin" OnClose="() => diceOpen = false"
                                   OnRolled="r => rollLog?.Add(r)" OnPin="PinDice" />
                </div>
                }
                @if (!logDocked)
                {
