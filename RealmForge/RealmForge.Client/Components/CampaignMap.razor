    //	The health of a combatant in the bar: always for the masters, my own and given ones, the characters; the others
    //	only when the master shows them
    private Life? BarLifeOf(MapTokenDto? t) => t is null ? null
        : RunsTheTable || t.Controlled || t.CharacterId is not null || combat?.ShowHealth == true ? LifeOf(t) : null;

