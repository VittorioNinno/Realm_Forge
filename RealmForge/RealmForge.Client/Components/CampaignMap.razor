    // ===== Master: maps =====

    private void OpenNewMap()
    {
        imageError = null;
        newMap = new SaveMapDto { Name = UiText.MapDefaultName((maps?.Count ?? 0) + 1, Lang), GridSize = 70 };
    }

    private async Task PickImageAsync(InputFileChangeEventArgs e)
    {
        imageError = null;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 20_000_000);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            var source = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}";
            var resized = await JS.InvokeAsync<ResizedImage>("rfResizeImage", source, 2048);
            if (newMap is null || string.IsNullOrEmpty(resized.Url) || resized.Url.Length > MapRules.MaxImageLength)
            {
                imageError = UiText.MapImageTooLarge(Lang);
                return;
            }
            newMap.Image = resized.Url;
            newMap.Width = resized.Width;
            newMap.Height = resized.Height;
            if (string.IsNullOrWhiteSpace(newMap.Name) || newMap.Name.StartsWith(UiText.MapDefaultName(0, Lang)[..4], StringComparison.Ordinal))
            {
                newMap.Name = Path.GetFileNameWithoutExtension(e.File.Name);
            }
        }
        catch (Exception)
        {
            imageError = UiText.MapImageTooLarge(Lang);
        }
    }

    private sealed record ResizedImage(string Url, int Width, int Height);

    private async Task CreateMapAsync()
    {
        if (newMap is null)
        {
            return;
        }
        busy = true;
        newMap.Name = newMap.Name.Length > 120 ? newMap.Name[..120] : newMap.Name;
        var created = await Campaigns.CreateMapAsync(CampaignId, newMap);
        busy = false;
        if (created is null)
        {
            imageError = UiText.MapSaveFailed(Lang);
            return;
        }
        newMap = null;
        await LoadMapsAsync(created.Id);
    }

    private async Task SaveMapAsync()
    {
        if (map is null)
        {
            return;
        }
        var result = await Campaigns.UpdateMapAsync(CampaignId, map.Id, new SaveMapDto
        {
            Name = string.IsNullOrWhiteSpace(mapName) ? map.Name : mapName.Trim(),
            Width = map.Width,
            Height = map.Height,
            GridType = gridType,
            GridSize = grid,
            GridOffsetX = Math.Min(offsetX, grid - 1),
            GridOffsetY = Math.Min(offsetY, grid - 1),
            Shown = shown
        });
        message = result.Ok ? null : UiText.MapSaveFailed(Lang);
        if (result.Ok)
        {
            await LoadMapsAsync(map.Id);
        }
    }

    //	At the table: this map in front of the players, the others put away
    private async Task DisplayAsync()
    {
        if (map is not null && (await Campaigns.DisplayMapAsync(CampaignId, map.Id)).Ok)
        {
            await LoadMapsAsync(map.Id);
        }
    }

    private async Task DeleteMapAsync()
    {
        confirmDelete = false;
        if (map is not null && (await Campaigns.DeleteMapAsync(CampaignId, map.Id)).Ok)
        {
            selectedId = Guid.Empty;
            await LoadMapsAsync();
        }
    }

    // ===== Master: tokens =====

    //	New tokens go on the first free cell from the top left
    private (int X, int Y) FreeCell(int size)
    {
        if (map is null)
        {
            return (0, 0);
        }
        for (var row = 0; row < 64; row++)
        {
            for (var col = 0; col < 64; col++)
            {
                if (!MapGeometry.Inside(gridType, grid, offsetX, offsetY, col, row, size, map.Width, map.Height))
                {
                    continue;
                }
                var free = gridType == GridType.Square
                    ? tokens.All(t => col + size <= t.X || t.X + t.Size <= col || row + size <= t.Y || t.Y + t.Size <= row)
                    : tokens.All(t => t.X != col || t.Y != row);
                if (free)
                {
                    return (col, row);
                }
            }
        }
        return (0, 0);
    }

    private async Task AddAsync(SaveTokenDto dto)
    {
        if (map is null)
        {
            return;
        }
        (dto.X, dto.Y) = FreeCell(dto.Size);
        var token = await Campaigns.AddTokenAsync(CampaignId, map.Id, dto);
        message = token is null ? UiText.MapSaveFailed(Lang) : null;
        if (token is not null)
        {
            tokens = tokens.Append(token).ToList();
        }
    }

    private Task AddCharacterAsync(CampaignCharacterDto c) =>
        AddAsync(new SaveTokenDto { Label = c.Character.Name, Kind = TokenKind.Character, CharacterId = c.Character.Id, Size = 1 });

    private async Task AddMonsterAsync(MonsterResponseDto m)
    {
        monsterSearch = string.Empty;
        monsterResults = new();
        monsters.TryAdd(m.Id, m);
        var same = tokens.Count(t => t.MonsterId == m.Id);
        await AddAsync(new SaveTokenDto
        {
            Label = same == 0 ? m.Name : $"{m.Name} {same + 1}",
            Kind = m.IsNpc ? TokenKind.Npc : TokenKind.Monster,
            MonsterId = m.Id,
            Color = m.IsNpc ? "#ab47bc" : "#dc3545",
            Size = m.Size switch { CreatureSize.Large => 2, CreatureSize.Huge => 3, CreatureSize.Gargantuan => 4, _ => 1 }
        });
    }

    private async Task AddMarkerAsync()
    {
        if (string.IsNullOrWhiteSpace(markerLabel))
        {
            return;
        }
        await AddAsync(new SaveTokenDto { Label = markerLabel.Trim(), Kind = TokenKind.Marker, Color = markerColor, Size = 1 });
        markerLabel = null;
    }

    private async Task SearchMonstersAsync(ChangeEventArgs e)
    {
        monsterSearch = e.Value?.ToString() ?? string.Empty;
        var term = monsterSearch.Trim();
        if (term.Length < 2)
        {
            monsterResults = new();
            return;
        }
        var all = await MonsterService.GetMonstersAsync(Lang);
        monsterResults = all.Where(m => m.Name.Contains(term, StringComparison.OrdinalIgnoreCase))
            .OrderBy(m => RealmForge.Shared.Text.SearchRank.Of(term, m.Name, new[] { m.Alias })).ThenBy(m => m.Name).Take(8).ToList();
    }

    private SaveTokenDto ToSave(MapTokenDto t) => new()
    {
        Label = t.Label, Color = t.Color, Kind = t.Kind, CharacterId = t.CharacterId, MonsterId = t.MonsterId, X = t.X, Y = t.Y, Size = t.Size, Hidden = t.Hidden, Layer = t.Layer
    };

    private async Task ResizeAsync(MapTokenDto t, int size)
    {
        if (map is null)
        {
            return;
        }
        var changed = t with { Size = size };
        Replace(changed);
        if (!(await Campaigns.UpdateTokenAsync(CampaignId, map.Id, t.Id, ToSave(changed))).Ok)
        {
            Replace(t);
            message = UiText.MapSaveFailed(Lang);
        }
    }

    private async Task ToggleHiddenAsync(MapTokenDto t)
    {
        if (map is null)
        {
            return;
        }
        var changed = t with { Hidden = !t.Hidden };
        Replace(changed);
        if (!(await Campaigns.UpdateTokenAsync(CampaignId, map.Id, t.Id, ToSave(changed))).Ok)
        {
            Replace(t);
        }
    }

    private async Task ToggleLayerAsync(MapTokenDto t)
    {
        if (map is null)
        {
            return;
        }
        var changed = t with { Layer = t.Layer == TokenLayer.Below ? TokenLayer.Tokens : TokenLayer.Below };
        Replace(changed);
        if (!(await Campaigns.UpdateTokenAsync(CampaignId, map.Id, t.Id, ToSave(changed))).Ok)
        {
            Replace(t);
        }
    }

    private async Task RemoveTokenAsync(MapTokenDto t)
    {
        if (map is not null && (await Campaigns.DeleteTokenAsync(CampaignId, map.Id, t.Id)).Ok)
        {
            tokens = tokens.Where(x => x.Id != t.Id).ToList();
            infoToken = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        stop?.Cancel();
        timer?.Dispose();
        try
        {
            if (!string.IsNullOrEmpty(stageElement.Id))
            {
                await JS.InvokeVoidAsync("rfVtt.detach", stageElement);
            }
        }
        catch (Exception)
        {
            //	The page is going away
        }
        self?.Dispose();
    }
}
