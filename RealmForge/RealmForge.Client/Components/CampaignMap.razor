    // ===== Loading and polling =====

    protected override async Task OnInitializedAsync()
    {
        self = DotNetObjectReference.Create(this);
        if (RunsTheTable)
        {
            _ = LoadMonstersAsync();
            _ = LoadEncountersAsync();
        }
        await LoadMapsAsync();
        stop = new CancellationTokenSource();
        _ = PollAsync(stop.Token);
    }

    private async Task LoadMonstersAsync()
    {
        try
        {
            var all = await MonsterService.GetMonstersAsync(Lang);
            monsters = all.GroupBy(m => m.Id).ToDictionary(g => g.Key, g => g.First());
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            //	The cards show the names only
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (map is null || self is null || string.IsNullOrEmpty(stageElement.Id))
        {
            return;
        }
        if (attachedTo != stageElement.Id)
        {
            attachedTo = stageElement.Id;
            await JS.InvokeVoidAsync("rfVtt.attach", stageElement, self, new { wheelZoom = Table, perCell = UiText.VttPerCell(Lang), unit = UiText.VttUnit(Lang), locale = Lang == LanguageCode.It ? "it-IT" : "en-GB" });
            await JS.InvokeVoidAsync("rfVtt.tool", stageElement, tool, ToolOptions);
        }
        if (fitPending)
        {
            fitPending = false;
            await FitAsync();
        }
        if (pendingFocus is { } at)
        {
            pendingFocus = null;
            await JS.InvokeVoidAsync("rfVtt.center", stageElement, at.X, at.Y);
        }
    }

    private async Task LoadMapsAsync(Guid? select = null)
    {
        maps = await Campaigns.GetMapsAsync(CampaignId) ?? new();
        var id = select ?? (maps.Any(m => m.Id == selectedId) ? selectedId : maps.FirstOrDefault(m => m.Shown)?.Id ?? maps.FirstOrDefault()?.Id);
        if (id is { } mapId)
        {
            await SelectAsync(mapId);
        }
        else
        {
            map = null;
            tokens = new();
        }
    }

    private async Task SelectAsync(Guid id)
    {
        var other = id != selectedId || map is null;
        selectedId = id;
        infoToken = null;
        map = await Campaigns.GetMapAsync(CampaignId, id);
        if (map is not null)
        {
            tokens = map.Tokens;
            shapes = map.Shapes ?? new();
            ApplyTable(map.Table, first: true);
            ApplyCombat(map.Combat);
            _ = PreloadStatsAsync();
            mapName = map.Name;
            gridType = map.GridType;
            grid = map.GridSize;
            offsetX = map.GridOffsetX;
            offsetY = map.GridOffsetY;
            shown = map.Shown;
            fitPending = Table && other;
            autoFit = autoFit || fitPending;
        }
    }

    //	Every 2 seconds what moved on the map (not while a token is dragged); the players also follow the map shown to them
    private async Task PollAsync(CancellationToken token)
    {
        //	The API answers as soon as something changes on the map (or after 20 seconds): moves show up at once. The
        //	players also look every few seconds for the map shown to them.
        var listCheckedAt = DateTime.UtcNow;
        try
        {
            while (!token.IsCancellationRequested)
            {
                if (grabbing)
                {
                    await Task.Delay(250, token);
                    continue;
                }
                if (!RunsTheTable && (map is null || DateTime.UtcNow - listCheckedAt > TimeSpan.FromSeconds(6)))
                {
                    listCheckedAt = DateTime.UtcNow;
                    var list = await Campaigns.GetMapsAsync(CampaignId) ?? new();
                    if (list.Count != (maps?.Count ?? 0) || list.Any(m => maps!.All(x => x.Id != m.Id)))
                    {
                        maps = list;
                        if (list.All(m => m.Id != selectedId) || map is null)
                        {
                            await LoadMapsAsync(list.FirstOrDefault()?.Id);
                        }
                        await InvokeAsync(StateHasChanged);
                        continue;
                    }
                }
                if (map is null)
                {
                    await Task.Delay(2000, token);
                    continue;
                }
                var waitingFor = map.Id;
                var editsBefore = localEdits;
                var (state, reached) = await Campaigns.WaitMapStateAsync(CampaignId, map.Id, map.UpdatedAt, token);
                if (!reached)
                {
                    await Task.Delay(3000, token);
                    continue;
                }
                if (grabbing || map is null || map.Id != waitingFor || localEdits != editsBefore)
                {
                    continue;
                }
                if (state is null)
                {
                    //	Hidden from the players again, or deleted
                    await LoadMapsAsync();
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(1000, token);
                    continue;
                }
                if (state.UpdatedAt != map.UpdatedAt)
                {
                    map = map with { UpdatedAt = state.UpdatedAt, GridType = state.GridType, GridSize = state.GridSize, GridOffsetX = state.GridOffsetX, GridOffsetY = state.GridOffsetY, Shown = state.Shown, Name = state.Name };
                    tokens = state.Tokens;
                    shapes = state.Shapes ?? new();
                    ApplyTable(state.Table, first: false);
                    ApplyCombat(state.Combat);
                    if (!RunsTheTable || Table)
                    {
                        gridType = state.GridType;
                        grid = state.GridSize;
                        offsetX = state.GridOffsetX;
                        offsetY = state.GridOffsetY;
                        shown = state.Shown;
                    }
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
            //	Left the page
        }
    }

    // ===== From the browser =====

    [JSInvokable]
    public void TokenGrabbed() => grabbing = true;

    [JSInvokable]
    public void TokenClicked(string id)
    {
        grabbing = false;
        infoToken = Guid.TryParse(id, out var tokenId) && infoToken != tokenId ? tokenId : null;
        if (InfoToken is { } t && CanRoll(t))
        {
            _ = LoadStatsAsync(t);
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void BoardClicked()
    {
        if (infoToken is not null)
        {
            infoToken = null;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task Resized()
    {
        if (Table && autoFit)
        {
            await FitAsync();
        }
    }

    //	The box drawn over one cell of the picture: the cell size and the offsets that put a cell exactly there
    [JSInvokable]
    public async Task Calibrated(double x, double y, double width, double height)
    {
        await SetToolAsync("select");
        if (width < 8 || height < 8)
        {
            StateHasChanged();
            return;
        }
        (grid, offsetX, offsetY) = MapGeometry.Calibrate(gridType, x, y, width, height);
        StateHasChanged();
    }

    [JSInvokable]
    public void Wheel(int direction)
    {
        autoFit = false;
        Zoom(direction);
        StateHasChanged();
    }

    //	A token released at (x, y) on the map: it lands on the nearest cell, if that is on the map
    [JSInvokable]
    public async Task TokenDropped(string id, double x, double y)
    {
        grabbing = false;
        var t = map is null || !Guid.TryParse(id, out var tokenId) ? null : tokens.FirstOrDefault(k => k.Id == tokenId);
        if (t is null || map is null)
        {
            return;
        }
        var (col, row) = MapGeometry.Nearest(gridType, grid, offsetX, offsetY, x, y, t.Size);
        await MoveToAsync(t, col, row);
    }

    //	The keyboard: the arrows move the token whose toolbar is open (one cell), Esc closes the toolbar
    [JSInvokable]
    public async Task KeyPressed(string key)
    {
        if (key == "Escape")
        {
            CloseToolbar();
            StateHasChanged();
            return;
        }
        if (InfoToken is not { CanMove: true } t)
        {
            return;
        }
        var (dx, dy) = key switch
        {
            "ArrowUp" => (0, -1),
            "ArrowDown" => (0, 1),
            "ArrowLeft" => (-1, 0),
            "ArrowRight" => (1, 0),
            _ => (0, 0)
        };
        if (dx != 0 || dy != 0)
        {
            await MoveToAsync(t, t.X + dx, t.Y + dy);
        }
    }

    private async Task MoveToAsync(MapTokenDto t, int col, int row)
    {
        if (map is null || (col == t.X && row == t.Y) || !MapGeometry.Inside(gridType, grid, offsetX, offsetY, col, row, t.Size, map.Width, map.Height))
        {
            return;
        }
        Replace(t with { X = col, Y = row });
        StateHasChanged();
        if (combat is not null)
        {
            moved[t.Id] = moved.GetValueOrDefault(t.Id) + MapGeometry.Distance(gridType, t.X, t.Y, col, row);
        }
        var result = await Campaigns.MoveTokenAsync(CampaignId, map.Id, t.Id, col, row);
        message = result.Ok ? null : UiText.MapMoveFailed(Lang);
        if (!result.Ok)
        {
            Replace(t);
            StateHasChanged();
        }
    }

    private void Replace(MapTokenDto token)
    {
        tokens = tokens.Select(x => x.Id == token.Id ? token : x).ToList();
        localEdits++;
    }

    //	Changes made here since a wait for the API began: its answer may predate them, so it is not shown
    private int localEdits;

    // ===== View =====

    private void Zoom(int direction) => zoom = Math.Clamp(Math.Round((direction > 0 ? zoom * 1.25 : zoom / 1.25) * 100) / 100, 0.1, 3);

    private Task ZoomByHand(int direction)
    {
        autoFit = false;
        Zoom(direction);
        return Task.CompletedTask;
    }

    private Task FitByHand()
    {
        autoFit = true;
        return FitAsync();
    }

    private async Task ToggleCalibrateAsync() => await SetToolAsync(tool == "calibrate" ? "select" : "calibrate");

    private async Task DuplicateAsync()
    {
        if (map is null)
        {
            return;
        }
        var copy = await Campaigns.DuplicateMapAsync(CampaignId, map.Id, UiText.MapCopyName(map.Name, Lang));
        message = copy is null ? UiText.MapSaveFailed(Lang) : null;
        if (copy is not null)
        {
            await LoadMapsAsync(copy.Id);
        }
    }

    private async Task FitAsync()
    {
        if (map is null || string.IsNullOrEmpty(stageElement.Id))
        {
            return;
        }
        var fit = await JS.InvokeAsync<double>("rfVtt.fit", stageElement, map.Width, map.Height);
        if (fit > 0)
        {
            zoom = Math.Clamp(Math.Floor(fit * 100) / 100, 0.1, 3);
            StateHasChanged();
        }
    }

    private async Task SetToolAsync(string name)
    {
        tool = name;
        textAt = null;
        if (!string.IsNullOrEmpty(stageElement.Id))
        {
            await JS.InvokeVoidAsync("rfVtt.tool", stageElement, name, ToolOptions);
        }
    }

    private object ToolOptions => new
    {
        color = drawColor,
        area = areaKind.ToString().ToLowerInvariant(),
        fogMode = fogCover ? "cover" : "reveal",
        fogShape = fogBrush ? "brush" : "rect",
        fogBrush = 1
    };

    // ===== Fog of war, pings, the view =====

    //	What the polling brought: the fog; a new ping is shown for three seconds; the players follow a new view of the masters
    // ===== The fight =====

    private List<RfSelect<Guid?>.OptionItem> EncounterOptions => encounters
        .Where(e => e.Status != EncounterStatus.Finished)
        .Select(e => new RfSelect<Guid?>.OptionItem(e.Id, e.Name)).ToList();

    private bool IsCurrent(MapTokenDto t) => combat?.CurrentId is { } current && t.CombatantId == current;

    private void ApplyCombat(MapCombatDto? fight)
    {
        combat = fight;
        //	A new turn: the cells moved start again
        if (fight?.CurrentId != movedTurn)
        {
            movedTurn = fight?.CurrentId;
            moved.Clear();
        }
    }

    private async Task LoadEncountersAsync()
    {
        if (RunsTheTable && Table)
        {
            encounters = await Encounters.GetEncountersAsync(CampaignId) ?? new();
            encounterId ??= EncounterOptions.FirstOrDefault()?.Value;
        }
    }

    // ===== The initiative panel =====

    //	Tokens a quick fight can start with: on the map, not markers nor props
    private IEnumerable<MapTokenDto> FightableTokens => tokens.Where(t => t.Kind != TokenKind.Marker && t.Layer == TokenLayer.Tokens);
    private readonly HashSet<Guid> quickLeftOut = new();
    private Guid? addTokenId;

    private RenderFragment InitiativePanel => __builder =>
    {
        <section class="rf-vtt-initiative-panel" data-test="vtt-initiative-panel">
            @if (map is null)
            {
                <p class="small mb-0" style="color: var(--rf-text-muted);">@UiText.MapEmptyPlayer(Lang)</p>
            }
            else if (combat is null)
            {
                @if (RunsTheTable)
                {
                    <section class="rf-vtt-box" data-test="vtt-combat-box">
                        <span class="rf-vtt-title">@UiText.VttQuickCombat(Lang)</span>
                        @if (!FightableTokens.Any())
                        {
                            <p class="small mb-0" style="color: var(--rf-text-muted);">@UiText.VttQuickCombatEmpty(Lang)</p>
                        }
                        else
                        {
                            @foreach (var t in FightableTokens)
                            {
                                var token = t;
                                <label class="rf-checkbox-wrapper small mb-0">
                                    <input type="checkbox" class="rf-checkbox" checked="@(!quickLeftOut.Contains(token.Id))" @onchange="() => ToggleQuick(token.Id)" data-test="vtt-quick-token" />
                                    <span style="color: @token.Color;">@token.Label</span>
                                </label>
                            }
                            <button type="button" class="btn btn-sm btn-rf-orange" disabled="@busy" @onclick="QuickCombatAsync" data-test="vtt-quick-combat"><Icon Name="play" /> @UiText.VttQuickCombatStart(Lang)</button>
                        }
                    </section>
                    <section class="rf-vtt-box">
                        <span class="rf-vtt-title">@UiText.VttCombat(Lang)</span>
                        @if (EncounterOptions.Count == 0)
                        {
                            <p class="small mb-0" style="color: var(--rf-text-muted);">@UiText.VttNoEncounters(Lang)</p>
                        }
                        else
                        {
                            <div data-test="vtt-encounter">
                                <RfSelect TValue="Guid?" @bind-Value="encounterId" Options="EncounterOptions" />
                            </div>
                            <button type="button" class="btn btn-sm btn-rf-outline" disabled="@(encounterId is null || busy)" @onclick="StartCombatAsync" data-test="vtt-start-combat"><Icon Name="play" /> @UiText.VttStartCombat(Lang)</button>
                        }
                    </section>
                }
                else
                {
                    <p class="small mb-0" style="color: var(--rf-text-muted);" data-test="vtt-no-combat">@UiText.VttNoCombat(Lang)</p>
                }
            }
            else
            {
                <div class="rf-vtt-initiative-head">
                    <strong>@combat.Name</strong>
                    <span class="rf-vtt-round">@UiText.VttRound(combat.Round, Lang)</span>
                </div>
                <ol class="rf-vtt-initiative-list">
                    @foreach (var c in combat.Order)
                    {
                        var who = c;
                        var token = who.TokenId is { } tid ? tokens.FirstOrDefault(t => t.Id == tid) : null;
                        var mine = token?.CharacterId is not null && CharacterOf(token)?.IsMine == true;
                        <li class="@(combat.CurrentId == who.Id ? "current" : null) @(who.Hidden ? "hidden-token" : null)" style="--rf-token: @(token?.Color ?? "#9e9e9e");" data-test="vtt-initiative-row">
                            @if (RunsTheTable)
                            {
                                <input type="number" class="rf-form-control rf-vtt-init-input" value="@who.Initiative" @onchange="e => SetInitiativeAsync(who.Id, e.Value?.ToString())" aria-label="@UiText.RollInitiative(Lang)" data-test="vtt-init-input" />
                            }
                            else
                            {
                                <span class="rf-vtt-init-value">@(who.Initiative?.ToString() ?? "–")</span>
                            }
                            <button type="button" class="rf-vtt-initiative-name" @onclick="() => FocusTokenAsync(token)">
                                <span>@who.Name</span>
                                <small>@InitiativeLine(token)</small>
                            </button>
                            @if (mine && token is not null)
                            {
                                <button type="button" class="rf-vtt-chip" disabled="@busy" @onclick="() => RollInitiativeAsync(token, who.Id)" data-test="vtt-roll-init"><Icon Name="dice" /></button>
                            }
                            @if (RunsTheTable && token is not null)
                            {
                                <button type="button" class="rf-vtt-icon-button" title="@UiText.VttLeaveFight(Lang)" aria-label="@UiText.VttLeaveFight(Lang)" @onclick="() => LeaveFightAsync(token)" data-test="vtt-remove-combatant"><Icon Name="close" /></button>
                            }
                        </li>
                    }
                </ol>
                @if (RunsTheTable)
                {
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-sm btn-rf-orange" disabled="@busy" @onclick="NextTurnAsync">@UiText.VttNextTurn(Lang)</button>
                        <button type="button" class="btn btn-sm btn-rf-outline" disabled="@busy" @onclick="EndCombatAsync">@UiText.VttEndCombat(Lang)</button>
                    </div>
                    @if (FightableTokens.Where(t => t.CombatantId is null || combat.Order.All(o => o.Id != t.CombatantId)).ToList() is { Count: > 0 } outside)
                    {
                        <div class="rf-vtt-field">
                            <span class="rf-vtt-label">@UiText.VttJoinFight(Lang)</span>
                            <div class="d-flex gap-2" data-test="vtt-add-combatant">
                                <RfSelect TValue="Guid?" @bind-Value="addTokenId" Options="@(outside.Select(t => new RfSelect<Guid?>.OptionItem(t.Id, t.Label)).ToList())" />
                                <button type="button" class="btn btn-sm btn-rf-outline" disabled="@(addTokenId is null || busy)" @onclick="JoinFightAsync" data-test="vtt-add-combatant-go"><Icon Name="plus" /></button>
                            </div>
                        </div>
                    }
                }
            }
        </section>
    };

    private string InitiativeLine(MapTokenDto? t)
    {
        if (t is null)
        {
            return string.Empty;
        }
        if (CharacterOf(t) is { } c)
        {
            return UiText.TokenHitPoints(c.Character.CurrentHitPoints, c.Character.MaxHitPoints, Lang);
        }
        if (RunsTheTable && t.Hp is { } hp && t.MaxHp is { } max)
        {
            return $"{hp}/{max}";
        }
        return t.Health is { } health ? UiText.HealthName(health, Lang) : string.Empty;
    }

    private void ToggleQuick(Guid id)
    {
        if (!quickLeftOut.Remove(id))
        {
            quickLeftOut.Add(id);
        }
    }

    private async Task QuickCombatAsync()
    {
        if (map is null)
        {
            return;
        }
        var chosen = FightableTokens.Where(t => !quickLeftOut.Contains(t.Id)).Select(t => t.Id).ToList();
        if (chosen.Count == 0)
        {
            return;
        }
        await CombatCallAsync(() => Campaigns.QuickCombatAsync(CampaignId, map.Id, chosen));
    }

    private async Task JoinFightAsync()
    {
        if (map is not null && addTokenId is { } id)
        {
            addTokenId = null;
            await CombatCallAsync(() => Campaigns.JoinFightAsync(CampaignId, map.Id, id));
        }
    }

    private Task LeaveFightAsync(MapTokenDto t) => map is null ? Task.CompletedTask : CombatCallAsync(() => Campaigns.LeaveFightAsync(CampaignId, map.Id, t.Id));

    //	From the token's toolbar: into the fight, out of it, or a fight with this token alone
    private Task ToggleFightAsync(MapTokenDto t)
    {
        if (map is null)
        {
            return Task.CompletedTask;
        }
        if (combat is null)
        {
            return CombatCallAsync(() => Campaigns.QuickCombatAsync(CampaignId, map.Id, new List<Guid> { t.Id }));
        }
        return InFight(t) ? LeaveFightAsync(t) : CombatCallAsync(() => Campaigns.JoinFightAsync(CampaignId, map.Id, t.Id));
    }

    private bool InFight(MapTokenDto t) => combat is not null && t.CombatantId is { } id && combat.Order.Any(o => o.Id == id);

    private async Task SetInitiativeAsync(Guid combatantId, string? value)
    {
        if (map is not null && int.TryParse(value, out var initiative))
        {
            await CombatCallAsync(() => Campaigns.SetInitiativeAsync(CampaignId, map.Id, combatantId, Math.Clamp(initiative, -10, 99)));
        }
    }

    //	A player rolls the initiative of their character from the sheet's bonus, and it takes its place in the order
