    private sealed record TableLayout(bool DiceDocked, bool LogDocked, bool InitVertical, bool GroupInit);

    private async Task LoadLayoutAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", "realmforge.vtt.layout");
            if (!string.IsNullOrWhiteSpace(json) && System.Text.Json.JsonSerializer.Deserialize<TableLayout>(json) is { } layout)
            {
                (diceDocked, logDocked, initVertical, groupInit) = (layout.DiceDocked, layout.LogDocked, layout.InitVertical, layout.GroupInit);
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            //	No storage: the default layout
        }
    }

    private async Task SaveLayoutAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "realmforge.vtt.layout", System.Text.Json.JsonSerializer.Serialize(new TableLayout(diceDocked, logDocked, initVertical, groupInit)));
        }
        catch (Exception)
        {
        }
    }

    private void ToggleDice()
    {
        if (diceDocked)
        {
            if (panel == "dice" && !drawerFolded)
            {
                panel = null;
            }
            else
            {
                OpenDrawer("dice");
            }
            return;
        }
        diceOpen = !diceOpen || diceMin;
        diceMin = false;
    }

    private void ToggleLog()
    {
        if (logDocked)
        {
            unreadRolls = 0;
            if (panel == "log" && !drawerFolded)
            {
                panel = null;
            }
            else
            {
                OpenDrawer("log");
            }
            return;
        }
        logOpen = !logOpen || logMin;
        logMin = false;
        if (logOpen)
        {
            unreadRolls = 0;
        }
    }

    //	The two cards down to their titles, or open again
    private void CollapseAll()
    {
        var shrink = (diceOpen && !diceMin) || (logOpen && !logMin);
        diceMin = shrink && diceOpen;
        logMin = shrink && logOpen;
        if (!shrink && logOpen)
        {
            unreadRolls = 0;
        }
    }

    private void ToggleLogMin()
    {
        logMin = !logMin;
        if (!logMin)
        {
            unreadRolls = 0;
        }
    }

    private void OnRollNews(int count)
    {
        if (!logOpen || logMin)
        {
            unreadRolls += count;
            StateHasChanged();
        }
    }

    private RenderFragment DiceCluster => __builder =>
    {
        <div class="rf-vtt-cluster" data-test="vtt-cluster">
