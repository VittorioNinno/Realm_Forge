    private async Task SearchMonstersAsync(ChangeEventArgs e)
    {
        monsterSearch = e.Value?.ToString() ?? string.Empty;
        var term = monsterSearch.Trim();
        if (term.Length < 2)
        {
            monsterResults = new();
            return;
        }
        var all = await MonsterService.GetMonstersAsync(Lang);
        monsterResults = all.Where(m => m.Name.Contains(term, StringComparison.OrdinalIgnoreCase))
            .OrderBy(m => RealmForge.Shared.Text.SearchRank.Of(term, m.Name, new[] { m.Alias })).ThenBy(m => m.Name).Take(8).ToList();
    }

    private SaveTokenDto ToSave(MapTokenDto t) => new()
    {
        Label = t.Label, Color = t.Color, Kind = t.Kind, CharacterId = t.CharacterId, MonsterId = t.MonsterId, X = t.X, Y = t.Y, Size = t.Size, Hidden = t.Hidden, Layer = t.Layer,
        ControlledBy = t.ControlledBy?.ToList() ?? new(), Hp = t.CombatantId is null ? t.Hp : null, MaxHp = t.CombatantId is null ? t.MaxHp : null
    };

    private async Task ResizeAsync(MapTokenDto t, int size)
    {
        if (map is null)
        {
            return;
        }
        var changed = t with { Size = size };
        Replace(changed);
        if (!(await Campaigns.UpdateTokenAsync(CampaignId, map.Id, t.Id, ToSave(changed))).Ok)
        {
            Replace(t);
            message = UiText.MapSaveFailed(Lang);
        }
    }

    private async Task ToggleHiddenAsync(MapTokenDto t)
    {
        if (map is null)
        {
            return;
        }
        var changed = t with { Hidden = !t.Hidden };
        Replace(changed);
        if (!(await Campaigns.UpdateTokenAsync(CampaignId, map.Id, t.Id, ToSave(changed))).Ok)
        {
            Replace(t);
        }
    }

    private async Task ToggleLayerAsync(MapTokenDto t)
    {
        if (map is null)
        {
            return;
        }
        var changed = t with { Layer = t.Layer == TokenLayer.Below ? TokenLayer.Tokens : TokenLayer.Below };
        Replace(changed);
        if (!(await Campaigns.UpdateTokenAsync(CampaignId, map.Id, t.Id, ToSave(changed))).Ok)
        {
            Replace(t);
        }
    }

    private async Task RemoveTokenAsync(MapTokenDto t)
    {
        if (map is not null && (await Campaigns.DeleteTokenAsync(CampaignId, map.Id, t.Id)).Ok)
        {
            tokens = tokens.Where(x => x.Id != t.Id).ToList();
            localEdits++;
            infoToken = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        stop?.Cancel();
        timer?.Dispose();
        try
        {
            if (!string.IsNullOrEmpty(stageElement.Id))
            {
                await JS.InvokeVoidAsync("rfVtt.detach", stageElement);
            }
        }
        catch (Exception)
        {
            //	The page is going away
        }
        self?.Dispose();
    }
}
