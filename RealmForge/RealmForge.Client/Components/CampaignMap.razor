    };

    //	The line under the name: hit points and armour class of a character, of a monster (masters), its health (players)
    private string ToolbarLine(MapTokenDto it, CampaignCharacterDto? character, MonsterResponseDto? monster)
    {
        if (it.PropType is { } propType)
        {
            return $"{UiText.PropTypeName(propType, Lang)} · {UiText.PropStateName(propType, it.PropState, Lang)}{(it.Hidden ? $" · {UiText.MapTokenHidden(Lang)}" : null)}";
        }
        if (character is not null)
        {
            var ch = character.Character;
            return $"{UiText.TokenHitPoints(ch.CurrentHitPoints, ch.MaxHitPoints, Lang)} · {UiText.TokenArmorClass(ch.ArmorClass, Lang)} · {UiText.TokenLevel(ch.Level, ch.ClassLine, Lang)}";
        }
        var parts = new List<string>();
        if (!RunsTheTable && it.CreatureType is { } creatureType)
        {
            //	The players: what kind of creature it is, and its hit points when a master shows them
            parts.Add(it.CreatureSize is { } size ? $"{UiText.FormatCreatureType(creatureType, Lang)} {UiText.FormatSizeSingle(size, Lang).ToLowerInvariant()}" : UiText.FormatCreatureType(creatureType, Lang));
        }
        if (it.Hp is { } hp && it.MaxHp is { } max && (RunsTheTable || it.Controlled || it.ShowHp))
        {
            parts.Add(RunsTheTable ? $"{hp}/{max}" : UiText.TokenHitPoints(hp, max, Lang));
        }
        else if (RunsTheTable && it.Health is { } health)
        {
            parts.Add(UiText.HealthName(health, Lang));
        }
        if (RunsTheTable && (monster is not null || it.ArmorClass is not null))
        {
            parts.Add(UiText.TokenArmorClass(ArmorOf(it, monster) ?? 10, Lang));
        }
        if (RunsTheTable && monster is not null)
        {
            parts.Add($"{UiText.MonsterChallengeShort(Lang)} {RealmForge.Shared.Monsters.MonsterMath.FormatChallenge(monster.ChallengeRating)}");
        }
        if (it.Hidden)
        {
            parts.Add(UiText.MapTokenHidden(Lang));
        }
        return parts.Count == 0 ? UiText.TokenKindName(it.Kind, Lang) : string.Join(" · ", parts);
    }

