    // ===== Rests from the quick sheet: the same as the sheet's, saved on the character =====

    //	Hit points after a rest taken here, until the campaign reads the characters again
    private readonly Dictionary<Guid, (int Now, int Max)> hpAfterRest = new();

    private sealed class RestState
    {
        public required Guid TokenId { get; init; }
        public required bool Long { get; init; }
        public required CharacterDto Character { get; init; }
        public required RealmForge.Shared.Characters.ComputedCharacter Computed { get; init; }
        public List<string> Log { get; } = new();
    }

    private RestState? rest;
    private bool restBusy;

    //	The owner of the character, or a master of the campaign (the sheets of the table are theirs to keep)
    private bool CanRest(MapTokenDto t) => CharacterOf(t) is { } c && (c.IsMine || (RunsTheTable && c.CanEdit) || t.Controlled);

    private int RestMax => Math.Max(1, rest?.Computed.MaxHitPoints ?? 1);
    private int RestHp => rest is null ? 0 : Math.Clamp(rest.Character.Sheet.CurrentHitPoints ?? RestMax, 0, RestMax);

    //	The sheet is read again first, so the rest starts from what it holds now (damage taken in a fight included)
    private async Task OpenRestAsync(MapTokenDto t, bool longRest)
    {
        if (t.CharacterId is not { } id)
        {
            return;
        }
        restBusy = true;
        var loaded = await ComputeCharacterAsync(id);
        restBusy = false;
        if (loaded is null)
        {
            message = UiText.MapSaveFailed(Lang);
            return;
        }
        var (character, computed) = loaded.Value;
        rest = new RestState { TokenId = t.Id, Long = longRest, Character = character, Computed = computed };
    }

    private async Task SpendRestDieAsync(int die)
    {
        if (rest is null || RealmForge.Shared.Characters.CharacterRests.SpendHitDie(rest.Character.Sheet, rest.Computed, die, size => Random.Shared.Next(1, size + 1)) is not { } spent)
        {
            return;
        }
        var con = rest.Computed.Modifier(AbilityScore.Constitution);
        rest.Log.Add(UiText.HitDieSpentLine(die, spent.Roll, con, spent.Healed, Lang));
        if (tray is not null)
        {
            await tray.ShowAsync(new DiceRollResult(UiText.BtnSpendHitDie(die, Lang), new List<DieFace> { new(die, spent.Roll) }, con, spent.Healed));
        }
        await SaveRestAsync(close: false);
    }

    private async Task FinishRestAsync()
    {
        if (rest is null)
        {
            return;
        }
        var sheet = rest.Character.Sheet;
        RealmForge.Shared.Characters.CharacterRests.RechargeItems(sheet, rest.Long, (_, dice) => RollTotal(dice));
        if (rest.Long)
        {
            RealmForge.Shared.Characters.CharacterRests.LongRest(sheet, rest.Computed, rest.Character.Ruleset);
        }
        else
        {
            RealmForge.Shared.Characters.CharacterRests.FinishShortRest(sheet, RealmForge.Shared.Characters.CharacterResources.For(rest.Computed, Lang));
        }
        await SaveRestAsync(close: true);
    }

    private async Task SaveRestAsync(bool close)
    {
        if (rest is null)
        {
            return;
        }
        restBusy = true;
        var saved = await CharacterService.SaveSheetAsync(rest.Character.Id, rest.Character.Sheet);
        restBusy = false;
        if (saved is null)
        {
            message = UiText.MapSaveFailed(Lang);
            return;
        }
        var max = Math.Max(1, saved.MaxHitPoints);
        var now = saved.Vitals?.CurrentHitPoints ?? rest.Character.Sheet.CurrentHitPoints ?? max;
        hpAfterRest[rest.Character.Id] = (Math.Clamp(now, 0, max), max);
        //	The numbers of the quick sheet are worked out again from the sheet just saved
        stats.Remove($"c:{rest.Character.Id}");
        if (tokens.FirstOrDefault(x => x.Id == rest.TokenId) is { } token)
        {
            _ = LoadStatsAsync(token);
        }
        if (close)
        {
            rest = null;
        }
    }

    //	"1d6+1": the charges an item gets back
    private static int? RollTotal(string formula)
    {
        var match = System.Text.RegularExpressions.Regex.Match(formula.Replace('−', '-').Replace(" ", string.Empty), @"^(\d+)d(\d+)([+-]\d+)?$");
        if (!match.Success)
        {
            return null;
        }
        var count = Math.Min(20, int.Parse(match.Groups[1].Value, CultureInfo.InvariantCulture));
        var size = int.Parse(match.Groups[2].Value, CultureInfo.InvariantCulture);
        var bonus = match.Groups[3].Success ? int.Parse(match.Groups[3].Value, CultureInfo.InvariantCulture) : 0;
        return Math.Max(0, Enumerable.Range(0, count).Sum(_ => Random.Shared.Next(1, size + 1)) + bonus);
    }

