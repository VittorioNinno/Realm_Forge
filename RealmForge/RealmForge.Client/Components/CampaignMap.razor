    //	A box (x, y, width, height), or the cells a brush stroke went over (column, row pairs), revealed or covered
    [JSInvokable]
    public async Task FogDrawn(bool brush, double[] numbers)
    {
        if (map is null)
        {
            return;
        }
        var steps = brush
            ? FogCells(numbers)
            : numbers.Length == 4 ? new List<double> { fogCover ? MapFog.Cover : MapFog.Reveal, numbers[0], numbers[1], numbers[2], numbers[3] } : new();
        if (steps.Count == 0)
        {
            return;
        }
        if ((fog.Count + steps.Count) / 5 > MapFog.MaxSteps)
        {
            message = UiText.VttFogFull(Lang);
            return;
        }
        fog = fog.Concat(steps).ToList();
        fogEnabled = true;
        StateHasChanged();
        await SaveFogAsync();
    }

    //	The cells of a brush stroke as steps of the fog: only those that change; squares in runs along a row, hexagons one by one
    private List<double> FogCells(double[] cells)
    {
        var steps = new List<double>();
        var changed = new List<(int Col, int Row)>();
        for (var i = 0; i + 1 < cells.Length; i += 2)
        {
            var (col, row) = ((int)cells[i], (int)cells[i + 1]);
            var (x, y) = MapGeometry.Center(gridType, grid, offsetX, offsetY, col, row);
            if (MapGeometry.Inside(gridType, grid, offsetX, offsetY, col, row, 1, map!.Width, map.Height) && MapFog.Covered(fog, x, y) != fogCover)
            {
                changed.Add((col, row));
            }
        }
        if (gridType == GridType.Square)
        {
            foreach (var line in changed.Distinct().GroupBy(c => c.Row))
            {
                var cols = line.Select(c => c.Col).OrderBy(c => c).ToList();
                for (var start = 0; start < cols.Count;)
                {
                    var end = start;
                    while (end + 1 < cols.Count && cols[end + 1] == cols[end] + 1)
                    {
                        end++;
                    }
                    steps.AddRange(new double[] { fogCover ? MapFog.Cover : MapFog.Reveal, offsetX + cols[start] * grid, offsetY + line.Key * grid, (end - start + 1) * grid, grid });
                    start = end + 1;
                }
            }
        }
        else
        {
            var radius = grid / Math.Sqrt(3);
            foreach (var (col, row) in changed.Distinct())
            {
                var (x, y) = MapGeometry.Center(gridType, grid, offsetX, offsetY, col, row);
                steps.AddRange(new[] { fogCover ? MapFog.CoverHex : MapFog.RevealHex, Math.Round(x, 1), Math.Round(y, 1), Math.Round(radius, 2), (int)gridType });
            }
        }
        return steps;
    }

    //	A cell of the fog, a hair bigger than the grid's so that two cells side by side leave no seam
    private static string HexPoints(double cx, double cy, double radius, int type)
    {
        var r = radius + 0.75;
        var start = type == 2 ? 0 : -90;
        return string.Join(' ', Enumerable.Range(0, 6).Select(i =>
        {
            var a = (start + 60 * i) * Math.PI / 180;
            return $"{N(cx + r * Math.Cos(a))},{N(cy + r * Math.Sin(a))}";
        }));
    }

