    private RenderFragment ShapeMarkup(MapShapeDto sh) => __builder =>
    {
        var erasable = sh.CanDelete ? "erasable" : null;
        switch (sh.Kind)
        {
            case ShapeKind.Freehand:
                <polyline points="@PointList(sh.Points)" fill="none" stroke="@sh.Color" stroke-width="@N(Math.Max(2, grid / 14.0))" stroke-linecap="round" stroke-linejoin="round"
                          class="@erasable" data-shape="@sh.Id" data-test="map-shape" data-kind="freehand" />
                break;
            case ShapeKind.Text:
                @TextMarkup(sh, erasable)
                break;
            default:
                var (ox, oy, tx, ty) = (sh.Points[0], sh.Points[1], sh.Points[2], sh.Points[3]);
                var outline = MapAreas.Outline(sh.Kind, ox, oy, tx, ty, sh.Size * (double)grid, grid);
                <g class="@erasable" data-shape="@sh.Id" data-test="map-shape" data-kind="@sh.Kind.ToString().ToLowerInvariant()">
                    @foreach (var (c, r) in MapAreas.Cells(gridType, grid, offsetX, offsetY, sh.Kind, ox, oy, tx, ty, sh.Size, map!.Width, map.Height))
                    {
                        <polygon points="@PointList(MapAreas.Corners(gridType, grid, offsetX, offsetY, c, r))" fill="@sh.Color" fill-opacity=".28" data-test="map-area-cell" />
                    }
                    @if (sh.Kind == ShapeKind.Sphere)
                    {
                        <circle cx="@N(ox)" cy="@N(oy)" r="@N(sh.Size * (double)grid)" fill="@sh.Color" fill-opacity=".1" stroke="@sh.Color" stroke-width="@N(2 / zoom)" />
                    }
                    else
                    {
                        <polygon points="@PointList(outline)" fill="@sh.Color" fill-opacity=".1" stroke="@sh.Color" stroke-width="@N(2 / zoom)" />
                    }
                </g>
                break;
        }
    };

    //	An SVG text written by hand: Razor keeps <text> for itself
    private MarkupString TextMarkup(MapShapeDto sh, string? erasable)
    {
        var size = Math.Max(12, grid * 0.35);
        //	What only I see is marked with a pencil and drawn in lilac
        var label = System.Net.WebUtility.HtmlEncode(sh.Private ? $"✎ {sh.Text}" : sh.Text ?? string.Empty);
        return new MarkupString($"<text x=\"{N(sh.Points[0])}\" y=\"{N(sh.Points[1])}\" font-size=\"{N(size)}\" font-weight=\"700\" class=\"rf-vtt-text {(sh.Private ? "master" : "")} {erasable} {(sh.CanMove ? "movable" : "")}\" "
            + $"fill=\"{(sh.Private ? "#c4b5fd" : "#ffffff")}\" stroke=\"#0a0a0a\" stroke-width=\"{N(size / 6)}\" paint-order=\"stroke\" data-shape=\"{sh.Id}\" data-movable=\"{(sh.CanMove ? "1" : "0")}\" data-test=\"map-shape\" "
            + $"data-kind=\"{(sh.Private ? "note" : "text")}\">{label}</text>");
    }

    private static string PointList(IReadOnlyList<double> values) =>
