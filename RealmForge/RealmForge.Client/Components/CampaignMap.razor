    //	The masters roll whoever has not rolled yet but the players' characters (their players roll them)
    //	Enemies of a kind (the same monster, or the same name but the number) roll one initiative for all, when asked
    private bool initVertical;
    private bool groupInit;

    private async Task ToggleInitLayoutAsync()
    {
        initVertical = !initVertical;
        await SaveLayoutAsync();
    }

    private async Task ToggleGroupInitAsync()
    {
        groupInit = !groupInit;
        await SaveLayoutAsync();
    }

    private static string GroupKeyOf(MapCombatantDto who, MapTokenDto? token) =>
        token?.MonsterId is { } monsterId ? monsterId.ToString()
        : System.Text.RegularExpressions.Regex.Replace(who.Name.Trim(), @"\s*\d+$", string.Empty).ToLowerInvariant();

    //	The others of its group not rolled yet (none for a character, or when the groups are off)
    private List<MapCombatantDto> GroupOf(MapCombatantDto who, MapTokenDto? token)
    {
        if (!groupInit || combat is null || token is null || token.CharacterId is not null)
        {
            return new();
        }
        var key = GroupKeyOf(who, token);
        return combat.Order.Where(o => o.Id != who.Id && o.Initiative is null && TokenOf(o) is { CharacterId: null } other && GroupKeyOf(o, other) == key).ToList();
    }

    private async Task RollOneAsync(MapTokenDto token, MapCombatantDto who)
    {
        var group = GroupOf(who, token);
        await LoadStatsAsync(token);
        if (StatsOf(token)?.Rolls.FirstOrDefault() is not { } roll || map is null)
        {
            return;
        }
        var label = group.Count > 0 ? roll with { Label = $"{roll.Label} ×{group.Count + 1}" } : roll;
        if (await RollForAsync(token, label) is { } result)
        {
            foreach (var member in group.Prepend(who))
            {
                await CombatCallAsync(() => Campaigns.SetInitiativeAsync(CampaignId, map.Id, member.Id, result.Total));
            }
        }
    }

    private async Task RollAllAsync()
    {
        if (combat is null)
        {
            return;
        }
        var done = new HashSet<Guid>();
        foreach (var who in combat.Order.Where(o => o.Initiative is null).ToList())
        {
            if (done.Contains(who.Id))
            {
                continue;
            }
            if (TokenOf(who) is { } token && (token.CharacterId is null || CharacterOf(token)?.IsMine == true))
            {
                foreach (var member in GroupOf(who, token))
                {
                    done.Add(member.Id);
                }
                await RollOneAsync(token, who);
            }
        }
    }

