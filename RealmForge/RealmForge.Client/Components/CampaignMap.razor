    //	A box (x, y, width, height) or the centres of a brush stroke, revealed or covered
    [JSInvokable]
    public async Task FogDrawn(bool brush, double[] numbers)
    {
        if (map is null)
        {
            return;
        }
        var steps = new List<double>();
        if (brush)
        {
            for (var i = 0; i + 1 < numbers.Length; i += 2)
            {
                steps.AddRange(new[] { fogCover ? MapFog.CoverCircle : MapFog.RevealCircle, numbers[i], numbers[i + 1], grid, 0 });
            }
        }
        else if (numbers.Length == 4)
        {
            steps.AddRange(new[] { fogCover ? MapFog.Cover : MapFog.Reveal, numbers[0], numbers[1], numbers[2], numbers[3] });
        }
        if (steps.Count == 0 || (fog.Count + steps.Count) / 5 > MapFog.MaxSteps)
        {
            return;
        }
        fog = fog.Concat(steps).ToList();
        fogEnabled = true;
        StateHasChanged();
        await SaveFogAsync();
    }

