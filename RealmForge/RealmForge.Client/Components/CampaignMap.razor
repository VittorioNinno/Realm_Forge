    //	Who rolls a combatant's initiative: the masters, and the player of a character (theirs, or the one given to them)
    private bool CanRollFor(MapTokenDto? t) => t is not null && (RunsTheTable || t.Controlled || CharacterOf(t)?.IsMine == true);

    //	The bonus shown on the chip: the sheet's one when it is known
    private string InitBonus(MapCombatantDto who, MapTokenDto? t) =>
