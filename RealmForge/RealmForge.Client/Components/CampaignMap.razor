                </div>
                <span class="rf-vtt-dock-sep"></span>
                }
                <button type="button" class="rf-vtt-dock-btn @(diceOpen && !diceMin ? "lit" : null)" aria-pressed="@(diceOpen ? "true" : "false")" @onclick="ToggleDice" data-test="vtt-dock-dice"><Icon Name="dice" /> @UiText.VttDice(Lang)</button>
                <button type="button" class="rf-vtt-dock-btn @(logOpen && !logMin ? "on" : null)" aria-pressed="@(logOpen ? "true" : "false")" @onclick="ToggleLog" data-test="vtt-dock-log">
