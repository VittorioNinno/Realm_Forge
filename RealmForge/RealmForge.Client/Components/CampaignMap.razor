@using System.Globalization
@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.Campaigns
@using RealmForge.Shared.DTOs
@using RealmForge.Shared.Enums
@inject CampaignDataService Campaigns
@inject MonsterDataService MonsterService
@inject LanguageStateService LanguageState
@inject IJSRuntime JS
@implements IAsyncDisposable

@* The virtual tabletop. Two faces of the same board: the masters' preparation (Table = false, in the campaign's Maps tab:
   the picture, the grid, the tokens, away from the players) and the table (Table = true, a page of its own: a tool bar on
   the left, the map in the middle, the zoom in the corner; the players see the map shown to them and move their tokens).
   The browser moves a dragged token and the view; the app picks the cell where the token lands *@
@if (Table)
{
    <div class="rf-vtt-table" @ref="tableElement" data-test="vtt">
        <header class="rf-vtt-top">
            <a href="@BackHref" class="rf-vtt-back" data-test="vtt-back"><Icon Name="left" /> <span>@UiText.VttBack(Lang)</span></a>
            @if (maps is { Count: > 0 })
            {
                <div class="rf-vtt-select" data-test="map-select">
                    <RfSelect TValue="Guid" Value="selectedId" ValueChanged="SelectAsync" Options="MapOptions" />
                </div>
            }
            <div class="rf-vtt-top-actions">
                @if (RunsTheTable && map is not null)
                {
                    @if (map.Shown)
                    {
                        <span class="rf-vtt-live" data-test="vtt-displayed"><Icon Name="eye" /> @UiText.VttDisplayed(Lang)</span>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-rf-orange" @onclick="DisplayAsync" data-test="vtt-display"><Icon Name="eye" /> @UiText.VttDisplay(Lang)</button>
                    }
                }
            </div>
        </header>
        <div class="rf-vtt-body">
            <nav class="rf-vtt-tools" aria-label="@UiText.VttTitle(Lang)">
                <button type="button" class="@ToolButton("select")" title="@UiText.VttToolSelect(Lang)" aria-label="@UiText.VttToolSelect(Lang)" @onclick="@(() => SetToolAsync("select"))" data-test="vtt-tool-select"><Icon Name="cursor" /></button>
                <button type="button" class="@ToolButton("pan")" title="@UiText.VttToolPan(Lang)" aria-label="@UiText.VttToolPan(Lang)" @onclick="@(() => SetToolAsync("pan"))" data-test="vtt-tool-pan"><Icon Name="arrows-move" /></button>
                <button type="button" class="@ToolButton("ruler")" title="@UiText.VttToolRuler(Lang)" aria-label="@UiText.VttToolRuler(Lang)" @onclick="@(() => SetToolAsync("ruler"))" data-test="vtt-tool-ruler"><Icon Name="rulers" /></button>
                <button type="button" class="@ToolButton("area")" title="@UiText.VttToolArea(Lang)" aria-label="@UiText.VttToolArea(Lang)" @onclick="@(() => SetToolAsync("area"))" data-test="vtt-tool-area"><Icon Name="bullseye" /></button>
                <button type="button" class="@ToolButton("draw")" title="@UiText.VttToolDraw(Lang)" aria-label="@UiText.VttToolDraw(Lang)" @onclick="@(() => SetToolAsync("draw"))" data-test="vtt-tool-draw"><Icon Name="edit" /></button>
                <button type="button" class="@ToolButton("text")" title="@UiText.VttToolText(Lang)" aria-label="@UiText.VttToolText(Lang)" @onclick="@(() => SetToolAsync("text"))" data-test="vtt-tool-text"><Icon Name="type" /></button>
                <button type="button" class="@ToolButton("erase")" title="@UiText.VttToolErase(Lang)" aria-label="@UiText.VttToolErase(Lang)" @onclick="@(() => SetToolAsync("erase"))" data-test="vtt-tool-erase"><Icon Name="eraser" /></button>
                @if (RunsTheTable)
                {
                    <span class="rf-vtt-tools-sep"></span>
                    <button type="button" class="rf-vtt-tool @(drawer ? "active" : null)" title="@UiText.VttToolTokens(Lang)" aria-label="@UiText.VttToolTokens(Lang)" @onclick="() => drawer = !drawer" data-test="vtt-tool-tokens"><Icon Name="people" /></button>
                }
                <span class="rf-vtt-tools-sep"></span>
                <button type="button" class="rf-vtt-tool" title="@UiText.VttFullscreen(Lang)" aria-label="@UiText.VttFullscreen(Lang)" @onclick="FullscreenAsync" data-test="vtt-fullscreen"><Icon Name="fullscreen" /></button>
            </nav>
            <div class="rf-vtt-viewport">
                @Board
                @if (map is not null && tool is "area" or "draw" or "text" or "erase")
                {
                    <div class="rf-vtt-options" data-test="vtt-options">
                        @if (tool == "area")
                        {
                            @foreach (var kind in new[] { ShapeKind.Cone, ShapeKind.Sphere, ShapeKind.Line, ShapeKind.Cube })
                            {
                                var k = kind;
                                <button type="button" class="rf-vtt-chip @(areaKind == k ? "active" : null)" @onclick="() => SetAreaAsync(k)" data-test="vtt-area-@k.ToString().ToLowerInvariant()">@UiText.AreaName(k, Lang)</button>
                            }
                            <span class="rf-vtt-options-hint">@UiText.VttAreaHint(Lang)</span>
                        }
                        else if (tool == "draw")
                        {
                            <input type="color" class="rf-vtt-color small" value="@drawColor" @onchange="SetColorAsync" aria-label="@UiText.MapColor(Lang)" />
                            <span class="rf-vtt-options-hint">@UiText.VttDrawHint(Lang)</span>
                        }
                        else if (tool == "text")
                        {
                            @if (textAt is not null)
                            {
                                <input class="rf-form-control rf-vtt-text-input" maxlength="@MapRules.MaxShapeText" placeholder="@UiText.VttTextHint(Lang)" @bind="textValue" @bind:event="oninput" @onkeydown="TextKeyAsync" data-test="vtt-text-input" />
                                <button type="button" class="btn btn-sm btn-rf-orange" disabled="@string.IsNullOrWhiteSpace(textValue)" @onclick="AddTextAsync" data-test="vtt-text-add">@UiText.MapSave(Lang)</button>
                            }
                            else
                            {
                                <span class="rf-vtt-options-hint">@UiText.VttTextPlace(Lang)</span>
                            }
                            @if (RunsTheTable)
                            {
                                <label class="rf-checkbox-wrapper small mb-0">
                                    <input type="checkbox" class="rf-checkbox" @bind="textMasterOnly" data-test="vtt-text-master" />
                                    <span>@UiText.VttMasterNote(Lang)</span>
                                </label>
                            }
                        }
                        else
                        {
                            <span class="rf-vtt-options-hint">@UiText.VttEraseHint(Lang)</span>
                            <button type="button" class="btn btn-sm btn-rf-outline" @onclick="ClearShapesAsync" data-test="vtt-clear-shapes">@(RunsTheTable ? UiText.VttClearAll(Lang) : UiText.VttClearMine(Lang))</button>
                        }
                    </div>
                }
                @if (map is not null)
                {
                    <div class="rf-vtt-corner" role="group" aria-label="@UiText.MapZoom(Lang)">
                        <button type="button" @onclick="() => ZoomByHand(-1)" aria-label="−" data-test="map-zoom-out">−</button>
                        <span data-test="map-zoom">@($"{zoom * 100:0}%")</span>
                        <button type="button" @onclick="() => ZoomByHand(1)" aria-label="+" data-test="map-zoom-in">+</button>
                        <button type="button" @onclick="FitByHand" title="@UiText.VttFit(Lang)" aria-label="@UiText.VttFit(Lang)" data-test="map-fit"><Icon Name="aspect-ratio" /></button>
                    </div>
                }
            </div>
            @if (RunsTheTable && drawer)
            {
                <aside class="rf-vtt-drawer" data-test="vtt-drawer">
                    <button type="button" class="btn btn-sm btn-rf-orange" @onclick="OpenNewMap" data-test="map-new"><Icon Name="plus" /> @UiText.MapNew(Lang)</button>
                    @if (map is not null)
                    {
                        @AddTokens
                    }
                </aside>
            }
        </div>
    </div>
}
else
{
    <section class="rf-vtt" data-test="campaign-map">
        <div class="rf-vtt-bar">
            @if (maps is { Count: > 0 })
            {
                <div class="rf-vtt-select" data-test="map-select">
                    <RfSelect TValue="Guid" Value="selectedId" ValueChanged="SelectAsync" Options="MapOptions" />
                </div>
            }
            @if (map is not null)
            {
                <div class="rf-vtt-zoom" role="group" aria-label="@UiText.MapZoom(Lang)">
                    <button type="button" @onclick="() => ZoomByHand(-1)" aria-label="−" data-test="map-zoom-out">−</button>
                    <span>@($"{zoom * 100:0}%")</span>
                    <button type="button" @onclick="() => ZoomByHand(1)" aria-label="+" data-test="map-zoom-in">+</button>
                </div>
            }
            <div class="d-flex flex-wrap gap-2 ms-auto">
                <a href="@($"campaigns/{CampaignId}/vtt")" class="btn btn-sm btn-rf-outline" data-test="map-open-vtt"><Icon Name="map" /> @UiText.VttTitle(Lang)</a>
                <button type="button" class="btn btn-sm btn-rf-orange" @onclick="OpenNewMap" data-test="map-new"><Icon Name="plus" /> @UiText.MapNew(Lang)</button>
            </div>
        </div>
        <p class="small mb-3" style="color: var(--rf-text-muted);">@UiText.MapPrepHint(Lang)</p>

        @if (message is not null)
        {
            <div class="rf-cast-warning mb-3" role="alert" data-test="map-message">@message</div>
        }

        @if (map is null)
        {
            @Board
        }
        else
        {
            <div class="rf-vtt-layout master">
                <div class="rf-vtt-viewport prep">
                    @Board
                </div>
                <aside class="rf-vtt-panel">
                    <section class="rf-vtt-box" data-test="map-settings">
                        <span class="rf-vtt-title">@UiText.MapSettings(Lang)</span>
                        <label class="rf-vtt-field">
                            <span class="rf-vtt-label">@UiText.MapName(Lang)</span>
                            <input class="rf-form-control" maxlength="120" @bind="mapName" data-test="map-name" />
                        </label>
                        <div class="rf-vtt-field">
                            <span class="rf-vtt-label">@UiText.MapGridType(Lang)</span>
                            <div data-test="map-grid-type">
                                <RfSelect TValue="GridType" Value="gridType" ValueChanged="v => gridType = v" Options="GridOptions" />
                            </div>
                        </div>
                        <div class="rf-vtt-grid-fields">
                            <div class="rf-vtt-field">
                                <span class="rf-vtt-label">@UiText.MapGrid(Lang)</span>
                                <NumberStepper Value="grid" ValueChanged="v => grid = v" Min="MapRules.MinGrid" Max="MapRules.MaxGrid" AriaLabel="@UiText.MapGrid(Lang)" InputTest="map-grid" />
                            </div>
                            <div class="rf-vtt-field">
                                <span class="rf-vtt-label">@UiText.MapOffsetX(Lang)</span>
                                <NumberStepper Value="offsetX" ValueChanged="v => offsetX = v" Min="0" Max="@(grid - 1)" AriaLabel="@UiText.MapOffsetX(Lang)" />
                            </div>
                            <div class="rf-vtt-field">
                                <span class="rf-vtt-label">@UiText.MapOffsetY(Lang)</span>
                                <NumberStepper Value="offsetY" ValueChanged="v => offsetY = v" Min="0" Max="@(grid - 1)" AriaLabel="@UiText.MapOffsetY(Lang)" />
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-rf-outline @(tool == "calibrate" ? "active" : null)" @onclick="ToggleCalibrateAsync" data-test="map-calibrate"><Icon Name="aspect-ratio" /> @UiText.MapCalibrate(Lang)</button>
                        @if (tool == "calibrate")
                        {
                            <p class="small mb-0" style="color: var(--rf-orange-primary);" data-test="map-calibrate-hint">@UiText.MapCalibrateHint(gridType, Lang)</p>
                        }
                        <label class="rf-checkbox-wrapper small mb-0">
                            <input type="checkbox" class="rf-checkbox" @bind="shown" data-test="map-shown" />
                            <span>@UiText.MapShown(Lang)</span>
                        </label>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-rf-orange" @onclick="SaveMapAsync" data-test="map-save">@UiText.MapSave(Lang)</button>
                            <button type="button" class="btn btn-sm btn-rf-outline" @onclick="DuplicateAsync" data-test="map-duplicate">@UiText.MapDuplicate(Lang)</button>
                            <button type="button" class="btn btn-sm btn-rf-outline" style="border-color: #dc3545; color: #dc3545;" @onclick="() => confirmDelete = true" data-test="map-delete">@UiText.Delete(Lang)</button>
                        </div>
                    </section>
                    @AddTokens
                    <p class="small mb-0" style="color: var(--rf-text-muted);">@UiText.MapTokenHint(Lang)</p>
                </aside>
            </div>
        }
    </section>
}

@if (newMap is not null)
{
    <div class="rf-modal-backdrop" @onclick="() => newMap = null">
        <div class="rf-modal-dialog" style="max-width: 520px;" @onclick:stopPropagation="true" data-test="map-new-dialog">
            <h2 class="h5 mb-3" style="color: var(--rf-orange-primary); font-family: var(--rf-font-display);">@UiText.MapNew(Lang)</h2>
            <label class="rf-vtt-field mb-3">
                <span class="rf-vtt-label">@UiText.MapName(Lang)</span>
                <input class="rf-form-control" maxlength="120" @bind="newMap.Name" data-test="map-new-name" />
            </label>
            <div class="rf-vtt-field mb-3">
                <span class="rf-vtt-label">@UiText.MapGridType(Lang)</span>
                <RfSelect TValue="GridType" Value="newMap.GridType" ValueChanged="v => newMap.GridType = v" Options="GridOptions" />
            </div>
            <label class="btn btn-sm btn-rf-outline mb-2" data-test="map-new-image">
                <InputFile OnChange="PickImageAsync" accept="image/*" class="d-none" />
                <Icon Name="map" /> @UiText.MapPickImage(Lang)
            </label>
            @if (newMap.Image is { Length: > 0 } preview)
            {
                <img src="@preview" alt="" class="rf-vtt-preview mb-2" />
                <div class="small mb-2" style="color: var(--rf-text-muted);">@newMap.Width × @newMap.Height px</div>
            }
            @if (imageError is not null)
            {
                <div class="small text-warning mb-2">@imageError</div>
            }
            <p class="small" style="color: var(--rf-text-muted);">@UiText.MapNewHint(Lang)</p>
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-sm btn-rf-outline" @onclick="() => newMap = null">@UiText.BtnCancel(Lang)</button>
                <button type="button" class="btn btn-sm btn-rf-orange" disabled="@(busy || string.IsNullOrEmpty(newMap.Image) || string.IsNullOrWhiteSpace(newMap.Name))" @onclick="CreateMapAsync" data-test="map-new-save">@UiText.MapSave(Lang)</button>
            </div>
        </div>
    </div>
}

@if (confirmDelete && map is not null)
{
    <div class="rf-modal-backdrop" @onclick="() => confirmDelete = false">
        <div class="rf-modal-dialog" style="max-width: 440px;" @onclick:stopPropagation="true">
            <p class="mb-3">@UiText.MapDeleteConfirm(map.Name, Lang)</p>
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-sm btn-rf-outline" @onclick="() => confirmDelete = false">@UiText.BtnCancel(Lang)</button>
                <button type="button" class="btn btn-sm btn-rf-orange" style="background-color: #dc3545; border-color: #dc3545;" @onclick="DeleteMapAsync" data-test="map-delete-yes">@UiText.Delete(Lang)</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid CampaignId { get; set; }
    [Parameter] public CampaignRole Role { get; set; } = CampaignRole.Player;
    [Parameter] public IReadOnlyList<CampaignCharacterDto> Characters { get; set; } = Array.Empty<CampaignCharacterDto>();
    [Parameter] public bool Table { get; set; }
    [Parameter] public string BackHref { get; set; } = "campaigns";
    [Parameter] public string MyColor { get; set; } = PlayerColors.Master;

    private LanguageCode Lang => LanguageState.CurrentLanguage;
    private bool RunsTheTable => CampaignRules.RunsTheTable(Role);

    private List<CampaignMapSummaryDto>? maps;
    private Guid selectedId;
    private CampaignMapDto? map;
    private List<MapTokenDto> tokens = new();
    private double zoom = 1;
    private bool fitPending;

    //	At the table the map follows the window until the zoom is changed by hand
    private bool autoFit;
    private string? message;
    private bool busy;
    private bool confirmDelete;
    private bool drawer;
    private string tool = "select";

    //	Drawings, texts, notes and areas
    private List<MapShapeDto> shapes = new();
    private ShapeKind areaKind = ShapeKind.Cone;
    private string? drawColorChoice;
    private string drawColor => drawColorChoice ?? MyColor;
    private (double X, double Y)? textAt;
    private string? textValue;
    private bool textMasterOnly;

    //	Map settings (the board follows them before they are saved)
    private string mapName = string.Empty;
    private GridType gridType;
    private int grid = 70;
    private int offsetX;
    private int offsetY;
    private bool shown;

    //	Tokens: the one whose card is open, one being dragged (no polling meanwhile), the monsters' statistics
    private Guid? infoToken;
    private bool grabbing;
    private Dictionary<Guid, MonsterResponseDto> monsters = new();
    private string monsterSearch = string.Empty;
    private List<MonsterResponseDto> monsterResults = new();
    private string? markerLabel;
    private string markerColor = "#ff8c00";

    //	New map
    private SaveMapDto? newMap;
    private string? imageError;

    //	The board in the browser
    private ElementReference stageElement;
    private ElementReference tableElement;
    private string? attachedTo;
    private DotNetObjectReference<CampaignMap>? self;

    private PeriodicTimer? timer;
    private CancellationTokenSource? stop;
    private readonly string patternId = $"rf-vtt-grid-{Guid.NewGuid():N}";

    private List<RfSelect<Guid>.OptionItem> MapOptions => (maps ?? new())
        .Select(m => new RfSelect<Guid>.OptionItem(m.Id, RunsTheTable && !m.Shown ? $"{m.Name} · {UiText.MapNotShown(Lang)}" : m.Name)).ToList();

    private List<RfSelect<GridType>.OptionItem> GridOptions => Enum.GetValues<GridType>()
        .Select(t => new RfSelect<GridType>.OptionItem(t, UiText.MapGridTypeName(t, Lang))).ToList();

    private MapTokenDto? InfoToken => tokens.FirstOrDefault(t => t.Id == infoToken);

    //	Characters of the table not yet on this map
    private IEnumerable<CampaignCharacterDto> FreeCharacters => Characters.Where(c => c.Active && tokens.All(t => t.CharacterId != c.Character.Id));

    private string ToolButton(string name) => tool == name ? "rf-vtt-tool active" : "rf-vtt-tool";

    private static string N(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private CampaignCharacterDto? CharacterOf(MapTokenDto t) => t.CharacterId is { } id ? Characters.FirstOrDefault(c => c.Character.Id == id) : null;

    private string? PortraitOf(MapTokenDto t) => t.Portrait ?? CharacterOf(t)?.Character.Portrait;

    private static string Initials(string label)
    {
        var words = label.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var initials = words.Length switch
        {
            0 => "?",
            1 => words[0][..Math.Min(2, words[0].Length)],
            _ => $"{words[0][0]}{words[^1][0]}"
        };
        return initials.ToUpperInvariant();
    }

    //	The short line under a token's name: level and class of a character, the numbers of a monster (for the masters)
    private string? Summary(MapTokenDto t)
    {
        if (CharacterOf(t) is { } c)
        {
            var ch = c.Character;
            return $"{UiText.TokenHitPoints(ch.CurrentHitPoints, ch.MaxHitPoints, Lang)} · {UiText.TokenArmorClass(ch.ArmorClass, Lang)}";
        }
        if (RunsTheTable && t.MonsterId is { } id && monsters.TryGetValue(id, out var m))
        {
            return $"{UiText.TokenHitPointsMax(m.HitPoints, Lang)} · {UiText.TokenArmorClass(m.ArmorClass, Lang)} · {UiText.MonsterChallengeShort(Lang)} {RealmForge.Shared.Monsters.MonsterMath.FormatChallenge(m.ChallengeRating)}";
        }
        return null;
    }

    // ===== The board =====

    private (double Width, double Height, string Path) Pattern()
    {
        var (w, h) = MapGeometry.Cell(gridType, grid);
        return gridType switch
        {
            GridType.HexRows => (w, 1.5 * h,
                $"M {N(w / 2)},0 L {N(w)},{N(h / 4)} L {N(w)},{N(3 * h / 4)} L {N(w / 2)},{N(h)} L 0,{N(3 * h / 4)} L 0,{N(h / 4)} Z M {N(w / 2)},{N(h)} L {N(w / 2)},{N(1.5 * h)}"),
            GridType.HexColumns => (1.5 * w, h,
                $"M 0,{N(h / 2)} L {N(w / 4)},0 L {N(3 * w / 4)},0 L {N(w)},{N(h / 2)} L {N(3 * w / 4)},{N(h)} L {N(w / 4)},{N(h)} Z M {N(w)},{N(h / 2)} L {N(1.5 * w)},{N(h / 2)}"),
            _ => (grid, grid, $"M {grid} 0 L 0 0 0 {grid}")
        };
    }

    private RenderFragment Board => __builder =>
    {
        if (maps is null)
        {
            <div class="small p-3" style="color: var(--rf-text-muted);">…</div>
            return;
        }
        if (map is null)
        {
            <div class="rf-vtt-empty" data-test="map-empty">
                <Icon Name="map" />
                <p class="mb-0">@(RunsTheTable ? UiText.MapEmptyMaster(Lang) : UiText.MapEmptyPlayer(Lang))</p>
            </div>
            return;
        }
        var (pw, ph, path) = Pattern();
        var z = N(zoom);
        <div class="rf-vtt-stage tool-@tool" @ref="stageElement" data-test="map-stage">
            <div class="rf-vtt-map" style="width: @(N(map.Width * zoom))px; height: @(N(map.Height * zoom))px;">
                <div class="rf-vtt-board" data-board data-zoom="@z" data-grid-type="@((int)gridType)" data-grid="@grid" data-ox="@offsetX" data-oy="@offsetY"
                     style="width: @(map.Width)px; height: @(map.Height)px; transform: scale(@z); --rf-zoom: @z;">
                    <img src="@map.Image" alt="@map.Name" draggable="false" width="@map.Width" height="@map.Height" />
                    <svg class="rf-vtt-grid" width="@map.Width" height="@map.Height" viewBox="0 0 @map.Width @map.Height" aria-hidden="true" data-test="map-grid" data-grid-type="@gridType">
                        <defs>
                            <pattern id="@patternId" width="@N(pw)" height="@N(ph)" x="@offsetX" y="@offsetY" patternUnits="userSpaceOnUse">
                                <path d="@path" fill="none" stroke="rgba(255,255,255,.4)" stroke-width="@N(1.25 / zoom)" />
                            </pattern>
                        </defs>
                        <rect width="@map.Width" height="@map.Height" fill="@($"url(#{patternId})")" />
                    </svg>
                    <svg class="rf-vtt-shapes" width="@map.Width" height="@map.Height" viewBox="0 0 @map.Width @map.Height" data-test="map-shapes">
                        @foreach (var sh in shapes)
                        {
                            @ShapeMarkup(sh)
                        }
                    </svg>
                    @foreach (var t in tokens.OrderBy(t => t.Layer == TokenLayer.Below ? 0 : 1))
                    {
                        var (cx, cy) = MapGeometry.Center(gridType, grid, offsetX, offsetY, t.X, t.Y, t.Size);
                        var side = grid * t.Size;
                        var portrait = PortraitOf(t);
                        var summary = Summary(t);
                        <div class="rf-vtt-token @(t.Hidden ? "hidden-token" : null) @(t.Layer == TokenLayer.Below ? "below" : null) @(t.CanMove ? "movable" : null) @(infoToken == t.Id ? "selected" : null)"
                             style="left: @(N(cx - side / 2.0))px; top: @(N(cy - side / 2.0))px; width: @(side)px; height: @(side)px; --rf-token: @t.Color;"
                             data-token="@t.Id" data-movable="@(t.CanMove ? "1" : "0")" data-cx="@N(cx)" data-cy="@N(cy)" data-test="map-token" data-label="@t.Label">
                            <span class="rf-vtt-token-face">
                                @if (portrait is not null)
                                {
                                    <img src="@portrait" alt="" draggable="false" />
                                }
                                else
                                {
                                    <span>@Initials(t.Label)</span>
                                }
                            </span>
                            <span class="rf-vtt-tip" role="tooltip" data-test="map-token-tip">
