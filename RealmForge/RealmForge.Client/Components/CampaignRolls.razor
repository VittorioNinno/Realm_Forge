@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.Campaigns
@using RealmForge.Shared.DTOs
@using RealmForge.Shared.Enums
@using RealmForge.Shared.Rules
@inject CampaignDataService Campaigns
@inject LanguageStateService LanguageState
@implements IDisposable

@* The shared dice table of a campaign: a console on the left (who rolls, in public or behind the screen, the dice
   picked one by one with the modifier and the d20 mode, the formula that stays editable, what for) and the log of
   everyone's rolls on the right, including the ones made on the sheets; the server rolls, so nobody picks the numbers.
   My rolls land in the dice tray with the animation; the log refreshes every few seconds *@
<section class="rf-dice-table @(Compact ? "compact" : null) @(Floating ? "floating" : null) @(Minimized ? "minimized" : null) part-@Part" data-test="campaign-rolls">
    @if (!Compact)
    {
        <p class="rf-dice-lead">@UiText.RollsHint(Lang)</p>
    }

    <div class="rf-dice-workspace">
        @if (Part != "log")
        {
        <aside class="rf-dice-console" data-test="roll-form">
            <div class="rf-dice-console-head">
                <span class="rf-dice-kicker">@UiText.DiceConsole(Lang)</span>
                <div class="rf-dice-head-actions">
                    @if (!Minimized)
                    {
                        <button type="button" class="rf-dice-reset" @onclick="ResetPool" data-test="roll-reset">@UiText.DiceReset(Lang)</button>
                    }
                    @WindowButtons
                </div>
            </div>
            @if (!Minimized)
            {

            <div class="rf-dice-actor">
                <div class="rf-dice-field" data-test="roll-as">
                    <span class="rf-dice-label">
                        @UiText.RollAs(Lang)
                        <span class="rf-roll-swatch ms-2" style="background-color: @MyColor;" title="@UiText.RollMyColor(Lang)" data-test="roll-my-color"></span>
                    </span>
                    @if (RollAsOptions.Count > 1)
                    {
                        <RfSelect TValue="Guid" @bind-Value="rollAs" Options="RollAsOptions" />
                    }
                    else
                    {
                        <div class="rf-form-control rf-roll-as-fixed">@RollAsOptions[0].Label</div>
                    }
                </div>
                @if (SessionRules.CanRollHidden(Role))
                {
                    <div class="rf-dice-field">
                        <span class="rf-dice-label">@UiText.DiceVisibility(Lang)</span>
                        <div class="rf-dice-privacy" role="group">
                            <button type="button" class="@(hidden ? null : "active")" @onclick="() => hidden = false" data-test="roll-public">@UiText.DicePublic(Lang)</button>
                            <button type="button" class="secret @(hidden ? "active" : null)" @onclick="() => hidden = true" data-test="roll-hidden"><Icon Name="eye-slash" /> @UiText.RollHidden(Lang)</button>
                        </div>
                    </div>
                }
            </div>

            <div class="rf-dice-tray-pick">
                <div class="rf-dice-pick-head">
                    <span class="rf-dice-label">@UiText.DicePick(Lang)</span>
                    <div class="rf-dice-mod" aria-label="@UiText.DiceModifier(Lang)">
                        <span>@UiText.DiceModifierShort(Lang)</span>
                        <button type="button" @onclick="() => SetModifier(modifier - 1)" aria-label="−1">−</button>
                        <strong data-test="roll-modifier">@CharacterMath.FormatModifier(modifier)</strong>
                        <button type="button" @onclick="() => SetModifier(modifier + 1)" aria-label="+1">+</button>
                    </div>
                </div>
                @if (Floating)
                {
                    @* Four big dice above, three below *@
                    <div class="rf-dice-pick rows-4">
                        @foreach (var sides in new[] { 20, 12, 100, 10 })
                        {
                            @DieButton(sides)
                        }
                    </div>
                    <div class="rf-dice-pick rows-3">
                        @foreach (var sides in new[] { 8, 6, 4 })
                        {
                            @DieButton(sides)
                        }
                    </div>
                }
                else
                {
                    <div class="rf-dice-pick">
                        @foreach (var sides in Sides)
                        {
                            @DieButton(sides)
                        }
                    </div>
                }
            </div>

            <div class="rf-dice-field">
                <span class="rf-dice-label">@UiText.DiceMode(Lang)</span>
                <div class="rf-dice-modes">
                    <button type="button" class="@(mode == 0 ? "active" : null)" @onclick="() => SetMode(0)" data-test="roll-normal">@UiText.RollNormal(Lang)</button>
                    <button type="button" class="adv @(mode == 1 ? "active" : null)" @onclick="() => SetMode(1)" data-test="roll-advantage">@UiText.RollAdvantage(Lang)</button>
                    <button type="button" class="dis @(mode == 2 ? "active" : null)" @onclick="() => SetMode(2)" data-test="roll-disadvantage">@UiText.RollDisadvantage(Lang)</button>
                </div>
            </div>

            <div class="rf-dice-formula">
                <div class="rf-dice-formula-row">
                <label class="rf-dice-field">
                    <span class="rf-dice-label">@UiText.DiceFormula(Lang)</span>
                    <input class="rf-form-control rf-dice-formula-input" maxlength="80" placeholder="1d20+5" @bind="expression" @bind:event="oninput"
                           @onkeydown="OnKeyAsync" aria-invalid="@(invalid ? "true" : null)" data-test="roll-expression" />
                </label>
                @if (invalid)
                {
                    <div class="small text-warning" data-test="roll-invalid">@UiText.RollInvalid(Lang)</div>
                }
                <label class="rf-dice-field">
                    <span class="rf-dice-label">@UiText.RollLabel(Lang)</span>
                    <input class="rf-form-control" maxlength="120" placeholder="@UiText.DiceReasonHint(Lang)" @bind="label" @bind:event="oninput" @onkeydown="OnKeyAsync" data-test="roll-label" />
                </label>
                </div>
                <div class="rf-dice-reasons">
                    @foreach (var reason in UiText.DiceQuickReasons(Lang))
                    {
                        var r = reason;
                        <button type="button" @onclick="() => label = r">@r</button>
                    }
                </div>
                <div class="rf-dice-cta">
                    @if (Floating)
                    {
                        <button type="button" class="rf-dice-cta-reset" @onclick="ResetPool">@UiText.DiceResetShort(Lang)</button>
                    }
                    <button type="button" class="rf-dice-go @(hidden ? "secret" : null)" disabled="@(rolling || string.IsNullOrWhiteSpace(expression))" @onclick="() => RollAsync(expression)" data-test="roll-go">
                        <Icon Name="dice" />
                        <span>@UiText.DiceRollButton(expression.Trim(), hidden, Lang)</span>
                    </button>
                </div>
            </div>
            }
        </aside>
        }

        @if (Part != "console")
        {
        <div class="rf-dice-log">
            <div class="rf-dice-log-head">
                <div class="d-flex flex-column gap-2 flex-grow-1" style="min-width: 0; flex-basis: 320px;">
                    <div class="rf-dice-console-head">
                        <span class="rf-dice-kicker">@UiText.DiceLogTitle(Lang)</span>
                        @if (Floating)
                        {
                            <div class="rf-dice-head-actions">@WindowButtons</div>
                        }
                    </div>
                    @if (!Minimized)
                    {
                    <div class="rf-dice-filters">
                        @foreach (var (key, name) in Filters)
                        {
                            var k = key;
                            <button type="button" class="@(filter == k ? "active" : null) @(k == "hidden" ? "secret" : null)" @onclick="() => filter = k" data-test="@($"rolls-filter-{k}")">@name</button>
                        }
                    </div>
                    }
                </div>
                @if (!Floating && SessionRules.CanClearRolls(Role) && rolls is { Count: > 0 })
                {
                    <button type="button" class="rf-dice-clear" @onclick="() => clearing = true" data-test="rolls-clear">@UiText.BtnClearRolls(Lang)</button>
                }
            </div>

            @if (Minimized)
            {
            }
            else if (rolls is null)
            {
                <div class="small" style="color: var(--rf-text-muted);">…</div>
            }
            else if (rolls.Count == 0)
            {
                <div class="rf-dice-empty" data-test="rolls-empty">@UiText.RollsEmpty(Lang)</div>
            }
            else
            {
                <ol class="rf-dice-feed" data-test="roll-log">
                    @foreach (var roll in Shown)
                    {
                        var r = roll;
                        var outcome = Outcome(r);
                        <li class="rf-dice-card @(r.Hidden ? "secret" : null) @(outcome == "crit" ? "crit" : null) @(fresh.Contains(r.Id) ? "fresh" : null)" style="--rf-roller: @r.Color;" data-test="roll">
                            <div class="rf-dice-card-main">
                                <div class="rf-dice-card-who">
                                    <span class="rf-roll-swatch" style="background-color: @r.Color;"></span>
                                    <strong class="rf-roll-name @(r.Removed ? "removed" : null)" style="color: @r.Color;" data-test="roll-roller">@(r.Removed && !r.IsCharacter ? UiText.RollDeletedAccount(Lang) : r.Roller)</strong>
                                    @if (r.Hidden)
                                    {
                                        <span class="rf-dice-badge secret"><Icon Name="eye-slash" /> @UiText.DiceHiddenBadge(Lang)</span>
                                    }
                                    @if (ModeOf(r) is { } m)
                                    {
                                        <span class="rf-dice-badge @(m == 1 ? "adv" : "dis")">@(m == 1 ? UiText.RollAdvantage(Lang) : UiText.RollDisadvantage(Lang))</span>
                                    }
                                    @if (outcome == "crit")
                                    {
                                        <span class="rf-dice-badge crit">@UiText.DiceNatural20(Lang)</span>
                                    }
                                    else if (outcome == "fumble")
                                    {
                                        <span class="rf-dice-badge fumble">@UiText.DiceNatural1(Lang)</span>
                                    }
                                    <span class="rf-roll-time">@UiText.RollTime(r.CreatedAt, Lang)</span>
                                </div>
                                <div class="rf-dice-card-what">
                                    <span class="rf-roll-label" data-test="roll-label-text">@r.Label</span>
                                    @if (r.Label != r.Expression)
                                    {
                                        <span class="rf-dice-formula-tag">@r.Expression</span>
                                    }
                                </div>
                                <div class="rf-dice-card-dice">
                                    @foreach (var d in r.Dice)
                                    {
                                        <span class="rf-dice-chip @(d.Dropped ? "dropped" : null) @(d.Sides == 20 && !d.Dropped && d.Value == 20 ? "crit" : null) @(d.Sides == 20 && !d.Dropped && d.Value == 1 ? "fumble" : null)" title="d@(d.Sides)">@d.Value</span>
                                    }
                                    @if (r.Modifier != 0)
                                    {
                                        <span class="rf-dice-op">@(r.Modifier > 0 ? "+" : "−")</span>
                                        <span class="rf-dice-modchip">@Math.Abs(r.Modifier)</span>
                                    }
                                    @if (!string.IsNullOrEmpty(r.Note))
                                    {
                                        <span class="rf-roll-note">@r.Note</span>
                                    }
                                </div>
                            </div>
                            <div class="rf-dice-card-side">
                                <div class="rf-dice-card-actions">
                                    @if (r.Hidden && SessionRules.CanRollHidden(Role))
                                    {
                                        <button type="button" class="reveal" @onclick="() => RevealAsync(r)" data-test="roll-reveal">@UiText.DiceReveal(Lang)</button>
                                    }
                                    @if (r.IsMine && DiceNotation.TryParse(r.Expression, out _))
                                    {
                                        <button type="button" disabled="@rolling" @onclick="() => RerollAsync(r)" data-test="roll-again">@UiText.DiceReroll(Lang)</button>
                                    }
                                </div>
                                <div class="rf-dice-card-total @(outcome)" data-test="roll-total">@r.Total</div>
                            </div>
                        </li>
                    }
                </ol>
            }
            @if (Floating && !Minimized)
            {
                <div class="rf-dice-log-foot">
                    <span class="rf-dice-synced"><span class="rf-live-dot"></span> @UiText.DiceSynced(Lang)</span>
                    @if (SessionRules.CanClearRolls(Role) && rolls is { Count: > 0 })
                    {
                        <button type="button" class="rf-dice-clear" @onclick="() => clearing = true" data-test="rolls-clear">@UiText.BtnClearAll(Lang)</button>
                    }
                </div>
            }
        </div>
        }
    </div>
</section>

<DiceTray @ref="tray" AutoHideMs="1800" ShowHistory="false" />

@if (clearing)
{
    <div class="rf-modal-backdrop" @onclick="() => clearing = false">
        <div class="rf-modal-dialog" style="max-width: 440px;" @onclick:stopPropagation="true" data-test="rolls-clear-confirm">
            <p class="mb-3">@UiText.RollsClearConfirm(Lang)</p>
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-sm btn-rf-outline" @onclick="() => clearing = false">@UiText.BtnCancel(Lang)</button>
                <button type="button" class="btn btn-sm btn-rf-orange" @onclick="ClearAsync" data-test="rolls-clear-yes">@UiText.BtnClearRolls(Lang)</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid CampaignId { get; set; }
    [Parameter] public CampaignRole Role { get; set; } = CampaignRole.Player;
    [Parameter] public IReadOnlyList<CampaignCharacterDto> Characters { get; set; } = Array.Empty<CampaignCharacterDto>();

    //	My colour at this table (the colour of my rolls)
    [Parameter] public string MyColor { get; set; } = PlayerColors.Master;

    //	In the side panel of the virtual tabletop: the console above the log, in a narrow column
    [Parameter] public bool Compact { get; set; }

    //	The virtual tabletop splits the two: "console" (the dice, in a popover over the map) and "log" (in the side
    //	panel); "all" elsewhere
    [Parameter] public string Part { get; set; } = "all";

    //	On the virtual tabletop: a card floating over the map, with the buttons to shrink it to its title and to close it
    [Parameter] public bool Floating { get; set; }
    [Parameter] public bool Minimized { get; set; }
    [Parameter] public EventCallback OnMinimize { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    //	Characters the master gave to me on the map: I roll for them too
    [Parameter] public IReadOnlyCollection<Guid> GivenCharacters { get; set; } = Array.Empty<Guid>();

    private RenderFragment WindowButtons => __builder =>
    {
        @if (Floating)
        {
            <button type="button" class="rf-dice-win" title="@(Minimized ? UiText.CardExpand(Lang) : UiText.CardMinimize(Lang))" aria-label="@(Minimized ? UiText.CardExpand(Lang) : UiText.CardMinimize(Lang))" @onclick="() => OnMinimize.InvokeAsync()" data-test="@($"rolls-{Part}-minimize")"><Icon Name="@(Minimized ? "up" : "dash")" /></button>
            <button type="button" class="rf-dice-win" title="@UiText.TokenClose(Lang)" aria-label="@UiText.TokenClose(Lang)" @onclick="() => OnClose.InvokeAsync()" data-test="@($"rolls-{Part}-close")"><Icon Name="close" /></button>
        }
    };

    private RenderFragment DieButton(int die) => __builder =>
    {
        var count = pool.GetValueOrDefault(die);
        <button type="button" class="rf-dice-pick-btn @(count > 0 ? "selected" : null)" @onclick="() => AddDie(die)" @oncontextmenu="() => RemoveDie(die)" @oncontextmenu:preventDefault="true"
                title="@UiText.DicePickHint(Lang)" data-test="@("roll-d" + die)">
            @if (count > 0)
            {
                <span class="rf-dice-pick-count">×@count</span>
            }
            <svg viewBox="0 0 24 24" aria-hidden="true">@DieShape(die)</svg>
            <span>d@(die)</span>
        </button>
    };

    //	A roll made here (the log of the table adds it at once) and the count of others' rolls the log just received
    [Parameter] public EventCallback<CampaignRollDto> OnRolled { get; set; }
    [Parameter] public EventCallback<int> OnNews { get; set; }

    //	A roll made elsewhere on the page (the console, a token's sheet): on top of the log at once
    public void Add(CampaignRollDto roll)
    {
        Merge(new[] { roll });
        StateHasChanged();
    }

    private static readonly int[] Sides = { 4, 6, 8, 10, 12, 20, 100 };

    private LanguageCode Lang => LanguageState.CurrentLanguage;
    private List<CampaignRollDto>? rolls;
    private readonly HashSet<Guid> fresh = new();
    private DiceTray? tray;

    //	Console: the dice picked, the modifier and the d20 mode build the formula, which stays editable
    private readonly SortedDictionary<int, int> pool = new(Comparer<int>.Create((a, b) => b.CompareTo(a)));
    private int modifier;
    private int mode;
    private string expression = "1d20";
    private string? label;
    private Guid rollAs;
    private bool hidden;
    private bool rolling;
    private bool invalid;
    private bool clearing;
    private string filter = "all";
    private PeriodicTimer? timer;
    private CancellationTokenSource? stop;

    private bool RunsTheTable => CampaignRules.RunsTheTable(Role);

    //	The characters I can roll for: a player's own; for masters and co-masters, everyone's
    private IEnumerable<CampaignCharacterDto> Playable => Characters.Where(c => c.Active && (RunsTheTable ? c.CanEdit : c.IsMine || GivenCharacters.Contains(c.Character.Id)));

    //	A roll shows the character's name: masters roll as themselves ("Master") or for a character; a player rolls for
    //	one of their characters, as themselves only without any
    private List<RfSelect<Guid>.OptionItem> RollAsOptions
    {
        get
        {
            var characters = Playable.Select(c => new RfSelect<Guid>.OptionItem(c.Character.Id, c.Character.Name)).ToList();
            if (RunsTheTable || characters.Count == 0)
            {
                var self = Role switch
                {
                    CampaignRole.Master => "Master",
                    CampaignRole.CoMaster => "Co-master",
                    _ => UiText.RollAsMe(Lang)
                };
                characters.Insert(0, new RfSelect<Guid>.OptionItem(Guid.Empty, self));
            }
            return characters;
        }
    }

    private List<(string Key, string Name)> Filters
    {
        get
        {
            var all = rolls ?? new();
            var list = new List<(string, string)>
            {
                ("all", UiText.DiceFilterAll(all.Count, Lang)),
                ("players", UiText.DiceFilterPlayers(Lang)),
                ("master", UiText.DiceFilterMaster(Lang))
            };
            if (all.Any(r => r.Hidden))
            {
                list.Add(("hidden", UiText.DiceFilterHidden(all.Count(r => r.Hidden), Lang)));
            }
            return list;
        }
    }

    private IEnumerable<CampaignRollDto> Shown => (rolls ?? new()).Where(r => filter switch
    {
        "players" => !r.ByMaster,
        "master" => r.ByMaster,
        "hidden" => r.Hidden,
        _ => true
    });

    protected override void OnParametersSet()
    {
        //	A player starts on their (first) character
        var options = RollAsOptions;
        if (options.All(o => o.Value != rollAs))
        {
            rollAs = options[0].Value;
        }
    }

    private static string? Outcome(CampaignRollDto r)
    {
        var kept = r.Dice.Where(d => !d.Dropped && d.Sides == 20).ToList();
        return kept.Count == 1 && kept[0].Value == 20 ? "crit" : kept.Count == 1 && kept[0].Value == 1 ? "fumble" : null;
    }

    //	2d20kh1 is advantage, 2d20kl1 disadvantage
    private static int? ModeOf(CampaignRollDto r) =>
        r.Expression.Contains("2d20kh1", StringComparison.OrdinalIgnoreCase) ? 1
        : r.Expression.Contains("2d20kl1", StringComparison.OrdinalIgnoreCase) ? 2 : null;

    // ===== Console =====

    private void AddDie(int sides)
    {
        pool[sides] = Math.Min(pool.GetValueOrDefault(sides) + 1, 20);
        BuildExpression();
    }

    private void RemoveDie(int sides)
    {
        if (pool.GetValueOrDefault(sides) <= 1)
        {
            pool.Remove(sides);
        }
        else
        {
            pool[sides]--;
        }
        BuildExpression();
    }

    private void SetModifier(int value)
    {
        modifier = Math.Clamp(value, -99, 99);
        BuildExpression();
    }

    private void SetMode(int value)
    {
        mode = value;
        BuildExpression();
    }

    private void ResetPool()
    {
        pool.Clear();
        modifier = 0;
        mode = 0;
        expression = "1d20";
        label = null;
        invalid = false;
    }

    //	"1d20 + 2d6 + 3": one d20 with advantage or disadvantage becomes 2d20kh1 or 2d20kl1
    private void BuildExpression()
    {
        var terms = pool.Where(p => p.Value > 0).Select(p => p.Key == 20 && p.Value == 1 && mode != 0
            ? (mode == 1 ? "2d20kh1" : "2d20kl1")
            : $"{p.Value}d{p.Key}").ToList();
        if (terms.Count == 0)
        {
            terms.Add(mode == 1 ? "2d20kh1" : mode == 2 ? "2d20kl1" : "1d20");
        }
        var text = string.Join(" + ", terms);
        if (modifier != 0)
        {
            text += modifier > 0 ? $" + {modifier}" : $" - {-modifier}";
        }
        expression = text;
        invalid = false;
    }

    private RenderFragment DieShape(int sides) => sides switch
    {
        4 => @<polygon points="12,3 21,19 3,19" fill="none" stroke="currentColor" stroke-width="1.8" />,
        6 => @<rect x="4" y="4" width="16" height="16" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8" />,
        8 => @<g fill="none" stroke="currentColor"><polygon points="12,2 21,12 12,22 3,12" stroke-width="1.8" /><line x1="3" y1="12" x2="21" y2="12" stroke-width="1.2" /></g>,
        10 => @<g fill="none" stroke="currentColor"><polygon points="12,2 21,10 12,22 3,10" stroke-width="1.8" /><polyline points="3,10 12,14 21,10" stroke-width="1.2" /></g>,
        12 => @<polygon points="12,2 20,7 20,17 12,22 4,17 4,7" fill="none" stroke="currentColor" stroke-width="1.8" />,
        20 => @<g fill="none" stroke="currentColor"><polygon points="12,2 21,7 21,17 12,22 3,17 3,7" stroke-width="1.8" /><polygon points="12,6 17,15 7,15" stroke-width="1.2" /></g>,
        _ => @<g fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9" cy="12" r="5" /><circle cx="16" cy="12" r="5" /></g>
    };

    // ===== Log =====

    protected override async Task OnInitializedAsync()
    {
        if (Part == "console")
        {
            rolls = new List<CampaignRollDto>();
            return;
        }
        rolls = await Campaigns.GetRollsAsync(CampaignId) ?? new List<CampaignRollDto>();
        stop = new CancellationTokenSource();
        _ = PollAsync(stop.Token);
    }

    //	Every 4 seconds the rolls made (or shown to the table) since the newest one shown
    private async Task PollAsync(CancellationToken token)
    {
        timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                var newest = rolls?.Select(r => r.CreatedAt).DefaultIfEmpty().Max();
                var since = newest is { } at && at != default ? at : (DateTimeOffset?)null;
                var news = await Campaigns.GetRollsAsync(CampaignId, since);
                if (news is { Count: > 0 } && !token.IsCancellationRequested)
                {
                    var unseen = news.Count(n => !n.IsMine && rolls?.All(r => r.Id != n.Id) != false);
                    Merge(news);
                    await InvokeAsync(StateHasChanged);
                    if (unseen > 0)
                    {
                        await InvokeAsync(() => OnNews.InvokeAsync(unseen));
                    }
                }
            }
        }
        catch (OperationCanceledException)
        {
            //	Left the tab
        }
    }

    //	New rolls on top; a roll already listed (shown to the table) is replaced
    private void Merge(IEnumerable<CampaignRollDto> news)
    {
        rolls ??= new List<CampaignRollDto>();
        fresh.Clear();
        foreach (var roll in news)
        {
            rolls.RemoveAll(r => r.Id == roll.Id);
            rolls.Add(roll);
            fresh.Add(roll.Id);
        }
        rolls = rolls.OrderByDescending(r => r.CreatedAt).Take(SessionRules.MaxRolls).ToList();
    }

    private async Task OnKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(expression))
        {
            await RollAsync(expression);
        }
    }

    private async Task RollAsync(string dice, string? what = null, bool? secret = null)
    {
        invalid = !DiceNotation.TryParse(dice, out _);
        if (invalid || rolling)
        {
            return;
        }
        rolling = true;
        var (roll, _) = await Campaigns.RollAsync(CampaignId, new NewCampaignRollDto
        {
            Expression = dice,
            Label = what ?? (string.IsNullOrWhiteSpace(label) ? null : label.Trim()),
            CharacterId = rollAs == Guid.Empty ? null : rollAs,
            Hidden = (secret ?? hidden) && SessionRules.CanRollHidden(Role)
        });
        rolling = false;
        if (roll is not null)
        {
            Merge(new[] { roll });
            await OnRolled.InvokeAsync(roll);

            //	Ready for the next roll: dice, modifier, d20 mode and reason start over (who rolls and the visibility stay)
            ResetPool();
            if (tray is not null)
            {
                await tray.ShowAsync(new DiceRollResult(roll.Label, roll.Dice.Select(d => new DieFace(d.Sides, d.Value, d.Dropped)).ToList(), roll.Modifier, roll.Total, roll.Note));
            }
        }
    }

    //	The same dice again, with the same label and visibility
    private Task RerollAsync(CampaignRollDto roll) => RollAsync(roll.Expression, roll.Label, roll.Hidden);

    private async Task RevealAsync(CampaignRollDto roll)
    {
        if (await Campaigns.RevealRollAsync(CampaignId, roll.Id) is { } shown)
        {
            Merge(new[] { shown });
        }
    }

    private async Task ClearAsync()
    {
        clearing = false;
        if ((await Campaigns.ClearRollsAsync(CampaignId)).Ok)
        {
            rolls = new List<CampaignRollDto>();
            fresh.Clear();
        }
    }

    public void Dispose()
    {
        stop?.Cancel();
        timer?.Dispose();
    }
}
