@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.DTOs
@using RealmForge.Shared.Enums
@inject CampaignDataService Campaigns
@inject LanguageStateService LanguageState
@inject IJSRuntime JS
@implements IDisposable

@* The masters' soundboard: in the drawer of the table (played for everyone) and on the campaign page (Standalone: prepared
   there, listened to on this device only). A sound is a link to audio hosted elsewhere or an audio file uploaded *@
<section class="rf-sounds@(Standalone ? " rf-sounds-page" : null)" data-test="vtt-sounds">
    <header class="rf-snd-top">
        <div class="rf-snd-top-text">
            <div class="rf-snd-head">
                <span class="rf-snd-kicker">@UiText.SoundsKicker(Lang)</span>
                <span class="rf-snd-count" data-test="sounds-count">@(board?.Sounds.Count ?? 0)</span>
            </div>
            <p class="rf-snd-hint">@(Standalone ? UiText.SoundsPageHint(Lang) : UiText.SoundsHint(Lang))</p>
        </div>
        @if (Standalone && board is not null)
        {
            <div class="rf-pl-pills">
                <span class="rf-pl-pill accent">@UiText.SoundTracksCount(board.Sounds.Count(x => !x.Effect), Lang)</span>
                <span class="rf-pl-pill">@UiText.SoundEffectsCount(board.Sounds.Count(x => x.Effect), Lang)</span>
            </div>
        }
    </header>

    <div class="rf-snd-work">
    <div class="rf-snd-form">
        @if (Standalone)
        {
            <span class="rf-ov-kicker rf-snd-form-title">@UiText.SoundAddTitle(Lang)</span>
        }
        <div class="rf-snd-seg" role="tablist">
            <button type="button" role="tab" aria-selected="@(!fromFile)" class="@(!fromFile ? "on" : null)" @onclick="() => SetSource(false)" data-test="sound-src-link"><Icon Name="link" /> @UiText.SoundSourceLink(Lang)</button>
            <button type="button" role="tab" aria-selected="@fromFile" class="@(fromFile ? "on" : null)" @onclick="() => SetSource(true)" data-test="sound-src-file"><Icon Name="upload" /> @UiText.SoundSourceFile(Lang)</button>
        </div>
        <input class="rf-form-control" maxlength="80" placeholder="@UiText.SoundName(Lang)" @bind="draft.Name" @bind:event="oninput" data-test="sound-name" />
        @if (fromFile)
        {
            <label class="rf-snd-drop@(picked is not null ? " has-file" : null)" data-test="sound-drop">
                <InputFile OnChange="PickFile" accept="@SoundFiles.Accept" class="rf-snd-file" data-test="sound-file" />
                <Icon Name="music-note-beamed" />
                <span>@(picked?.Name ?? UiText.SoundFilePick(Lang))</span>
            </label>
            <span class="rf-snd-quota" data-test="sound-quota">
                <span class="rf-snd-quota-bar"><span style="width: @QuotaPercent%"></span></span>
                @UiText.SoundFileLimits(SoundFiles.Megabytes(board?.StorageUsed ?? 0), SoundFiles.Megabytes(board?.StorageMax is > 0 ? board.StorageMax : SoundFiles.MaxCampaignBytes), Lang)
            </span>
        }
        else
        {
            <input class="rf-form-control" maxlength="500" type="url" placeholder="@UiText.SoundUrl(Lang)" @bind="draft.Url" data-test="sound-url" />
        }
        <span class="rf-snd-label">@UiText.SoundMode(Lang)</span>
        <div class="rf-snd-seg">
            <button type="button" class="@(!draft.Effect ? "on" : null)" aria-pressed="@(!draft.Effect)" @onclick="() => draft.Effect = false" data-test="sound-mode-loop"><Icon Name="repeat" /> @UiText.SoundModeLoop(Lang)</button>
            <button type="button" class="@(draft.Effect ? "on" : null)" aria-pressed="@draft.Effect" @onclick="() => draft.Effect = true" data-test="sound-effect"><Icon Name="lightning" /> @UiText.SoundModeOnce(Lang)</button>
        </div>
        <label class="rf-snd-volume">
            <span><Icon Name="volume-up" /> @UiText.SoundVolume(Lang)</span>
            <input type="range" min="0" max="100" step="5" @bind="draft.Volume" @bind:event="oninput" style="--val: @(draft.Volume)%" aria-label="@UiText.SoundVolume(Lang)" />
            <span class="rf-snd-pct">@draft.Volume%</span>
        </label>
        @if (error is not null)
        {
            <span class="small text-warning" data-test="sound-error">@error</span>
        }
        <button type="button" class="btn btn-rf-orange rf-snd-add" disabled="@busy" @onclick="AddAsync" data-test="sound-add">
            @if (uploading)
            {
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> @UiText.SoundUploading(Lang)
            }
            else
            {
                <Icon Name="plus" /> @UiText.SoundAdd(Lang)
            }
        </button>
    </div>

    <div class="rf-snd-lib">
    @if (Standalone && board is { Sounds.Count: > 0 })
    {
        @* The library: by kind, by name, and one button that silences this device *@
        <div class="rf-snd-toolbar">
            <div class="rf-ses-filters" role="tablist">
                @foreach (var f in new[] { "all", "loop", "once" })
                {
                    var key = f;
                    <button type="button" role="tab" aria-selected="@(soundFilter == key)" class="rf-ses-filter @(soundFilter == key ? "on" : null)" @onclick="() => soundFilter = key" data-test="sound-filter">@UiText.SoundFilter(key, Lang)</button>
                }
            </div>
            <div class="rf-snd-tools">
                <label class="rf-snd-search">
                    <Icon Name="search" />
                    <input type="search" class="rf-form-control" placeholder="@UiText.SoundSearch(Lang)" @bind="soundQuery" @bind:event="oninput" aria-label="@UiText.SoundSearch(Lang)" data-test="sound-search" />
                </label>
                <button type="button" class="rf-snd-stopall" disabled="@(previewing is null)" @onclick="StopPreviewAllAsync" data-test="sound-stop-all"><Icon Name="stop-fill" /> @UiText.SoundStopAll(Lang)</button>
            </div>
        </div>
    }
    @if (board is null)
    {
        <span class="small" style="color: var(--rf-text-muted);">…</span>
    }
    else if (board.Sounds.Count == 0)
    {
        <div class="rf-snd-empty" data-test="sounds-empty">
            <Icon Name="music-note-beamed" />
            <strong>@UiText.SoundsEmptyTitle(Lang)</strong>
            <span>@UiText.SoundsEmpty(Lang)</span>
        </div>
    }
    else
    {
        @if (!Standalone && (board.Playing is not null || board.PlayingScene is not null))
        {
            <button type="button" class="btn btn-sm btn-rf-outline align-self-start" disabled="@busy" @onclick="StopAsync" data-test="sound-stop"><Icon Name="stop-fill" /> @UiText.SoundStop(Lang)</button>
        }
        @foreach (var group in Listed.GroupBy(s => s.Effect).OrderBy(g => g.Key))
        {
            <span class="rf-mini-label">@(group.Key ? UiText.SoundEffects(Lang) : UiText.SoundTracks(Lang))</span>
            <div class="rf-snd-list">
                @foreach (var s in group)
                {
                    var sound = s;
                    var on = Standalone ? previewing == sound.Id : board.Playing == sound.Id;
                    <div class="rf-snd-card@(on ? " on" : null)" data-test="sound-row">
                        <button type="button" class="rf-snd-play" disabled="@busy"
                                title="@(Standalone ? (on ? UiText.SoundPreviewStop(Lang) : UiText.SoundPreview(Lang)) : UiText.SoundPlay(Lang))"
                                aria-label="@(Standalone ? (on ? UiText.SoundPreviewStop(Lang) : UiText.SoundPreview(Lang)) : UiText.SoundPlay(Lang))"
                                @onclick="() => PlayAsync(sound)" data-test="sound-play">
                            <Icon Name="@(on ? "stop-fill" : sound.Effect ? "lightning" : "play-fill")" />
                        </button>
                        <div class="rf-snd-info">
                            <strong>@sound.Name</strong>
                            <span class="rf-snd-meta">
                                <span class="rf-snd-badge@(sound.Effect ? " once" : null)">@(sound.Effect ? UiText.SoundBadgeOnce(Lang) : UiText.SoundBadgeLoop(Lang))</span>
                                <span>@(SoundFiles.IsFile(sound.Url) ? UiText.SoundFromFile(Lang) : UiText.SoundFromLink(Lang)) · @sound.Volume%</span>
                            </span>
                        </div>
                        <button type="button" class="rf-snd-del" disabled="@busy" title="@UiText.BtnRemove(Lang)" aria-label="@UiText.BtnRemove(Lang)" @onclick="() => DeleteAsync(sound)" data-test="sound-delete"><Icon Name="close" /></button>
                        @if (Standalone)
                        {
                            <label class="rf-snd-card-vol">
                                <Icon Name="volume-up" />
                                <input type="range" min="0" max="100" step="5" value="@sound.Volume" style="--val: @(sound.Volume)%" aria-label="@UiText.SoundVolume(Lang)"
                                       @onchange="e => SetVolumeAsync(sound, e.Value?.ToString())" data-test="sound-volume" />
                                <span class="rf-snd-pct">@sound.Volume%</span>
                            </label>
                        }
                    </div>
                }
            </div>
        }

        @if (Standalone && !Listed.Any())
        {
            <div class="rf-ov-empty">@UiText.SoundsNoneHere(Lang)</div>
        }
        @* Sound scenes: a track, loops over it and an effect, with one click *@
        <span class="rf-mini-label d-flex align-items-center gap-2"><Icon Name="collection-play" /> @UiText.SoundScenes(Lang)</span>
        @if ((board.Scenes ?? new()).Count == 0 && scene is null)
        {
            <span class="small" style="color: var(--rf-text-muted);">@UiText.SoundScenesHint(Lang)</span>
        }
        <ul class="rf-sound-list">
            @foreach (var sc in board.Scenes ?? new())
            {
                var soundScene = sc;
                <li class="@(board.PlayingScene == soundScene.Id ? "on" : null)" data-test="scene-row">
                    <button type="button" class="rf-sound-play" disabled="@(busy || Standalone)" title="@(Standalone ? null : UiText.SoundScenePlay(Lang))" @onclick="() => PlaySceneAsync(soundScene)" data-test="scene-play">
                        <Icon Name="collection-play" />
                        <span>@soundScene.Name</span>
                        <span class="rf-sound-scene-meta">@SceneSummary(soundScene)</span>
                        @if (soundScene.MapId is not null)
                        {
                            <span class="rf-sound-scene-meta" title="@UiText.SoundSceneMapLinked(Lang)"><Icon Name="map" /></span>
                        }
                    </button>
                    <button type="button" class="rf-vtt-row-action" disabled="@busy" title="@UiText.BtnRemove(Lang)" aria-label="@UiText.BtnRemove(Lang)" @onclick="() => DeleteSceneAsync(soundScene)" data-test="scene-delete"><Icon Name="trash" /></button>
                </li>
            }
        </ul>
        @if (scene is null)
        {
            <button type="button" class="btn btn-sm btn-rf-outline align-self-start" disabled="@(busy || board.Sounds.Count == 0)" @onclick="NewScene" data-test="scene-new"><Icon Name="plus" /> @UiText.SoundSceneNew(Lang)</button>
        }
        else
        {
            <div class="rf-card2 d-flex flex-column gap-2" data-test="scene-form">
                <input class="rf-form-control" maxlength="80" placeholder="@UiText.SoundSceneName(Lang)" @bind="scene.Name" data-test="scene-name" />
                <label class="d-flex flex-column gap-1">
                    <span class="small">@UiText.SoundTracks(Lang)</span>
                    <select class="rf-form-control" value="@(scene.TrackId?.ToString() ?? string.Empty)" @onchange="PickTrack" data-test="scene-track">
                        <option value="">@UiText.SoundSceneNone(Lang)</option>
                        @foreach (var trackOption in board.Sounds.Where(x => !x.Effect))
                        {
                            <option value="@trackOption.Id">@trackOption.Name</option>
                        }
                    </select>
                </label>
                <span class="small">@UiText.SoundSceneLayers(SoundsLimits.MaxLayers, Lang)</span>
                <div class="rf-sound-scene-layers">
                    @foreach (var layerOption in board.Sounds)
                    {
                        var layer = layerOption;
                        var picked = scene.Layers.Contains(layer.Id);
                        <label class="form-check d-flex align-items-center gap-2 mb-0">
                            <input type="checkbox" class="form-check-input" checked="@picked" disabled="@(!picked && scene.Layers.Count >= SoundsLimits.MaxLayers)" @onchange="() => ToggleLayer(layer.Id)" data-test="scene-layer" />
                            <span class="small">@layer.Name</span>
                        </label>
                    }
                </div>
                <label class="d-flex flex-column gap-1">
                    <span class="small">@UiText.SoundSceneCue(Lang)</span>
                    <select class="rf-form-control" value="@(scene.CueId?.ToString() ?? string.Empty)" @onchange="PickCue">
                        <option value="">@UiText.SoundSceneNone(Lang)</option>
                        @foreach (var cueOption in board.Sounds.Where(x => x.Effect))
                        {
                            <option value="@cueOption.Id">@cueOption.Name</option>
                        }
                    </select>
                </label>
                @if (MapId is not null)
                {
                    <label class="form-check d-flex align-items-center gap-2 mb-0">
                        <input type="checkbox" class="form-check-input" @bind="sceneOnMap" data-test="scene-map" />
                        <span class="small">@UiText.SoundSceneOnMap(Lang)</span>
                    </label>
                }
                @if (sceneError is not null)
                {
                    <span class="small text-warning">@sceneError</span>
                }
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-sm btn-rf-outline" @onclick="() => scene = null">@UiText.BtnCancel(Lang)</button>
                    <button type="button" class="btn btn-sm btn-rf-orange" disabled="@busy" @onclick="SaveSceneAsync" data-test="scene-save">@UiText.BtnConfirm(Lang)</button>
                </div>
            </div>
        }
    }
    </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public Guid CampaignId { get; set; }

    //	Something the table plays changed (the table refreshes at once)
    [Parameter] public EventCallback OnChanged { get; set; }

    //	The map open at the table: a new scene can start with it
    [Parameter] public Guid? MapId { get; set; }

    //	On the campaign page, away from the table: sounds are listened to on this device only
    [Parameter] public bool Standalone { get; set; }

    private bool fromFile;
    private string soundFilter = "all";
    private string soundQuery = string.Empty;

    //	The sounds of the library that pass the filter and the search (the table shows them all)
    private IEnumerable<CampaignSoundDto> Listed => (board?.Sounds ?? new()).Where(x => !Standalone
        || ((soundFilter == "all" || (soundFilter == "once") == x.Effect)
            && (soundQuery.Length == 0 || x.Name.Contains(soundQuery.Trim(), StringComparison.CurrentCultureIgnoreCase))));

    private async Task StopPreviewAllAsync()
    {
        await StopPreviewAsync();
        previewing = null;
    }

    //	The volume of a sound, saved as it is moved
    private async Task SetVolumeAsync(CampaignSoundDto sound, string? text)
    {
        if (!int.TryParse(text, out var volume))
        {
            return;
        }
        busy = true;
        var result = await Campaigns.UpdateSoundAsync(CampaignId, sound.Id, new SaveCampaignSoundDto { Name = sound.Name, Url = sound.Url, Effect = sound.Effect, Volume = Math.Clamp(volume, 0, 100) });
        busy = false;
        if (!result.Ok)
        {
            error = UiText.SoundInvalid(Lang);
            return;
        }
        await LoadAsync();
    }
    private IBrowserFile? picked;
    private bool uploading;
    private Guid? previewing;
    private DotNetObjectReference<CampaignSoundboard>? self;

    private double QuotaPercent => board is { StorageMax: > 0 } ? Math.Min(100, Math.Round(100d * board.StorageUsed / board.StorageMax, 1)) : 0;

    private void SetSource(bool file)
    {
        fromFile = file;
        error = null;
    }

    private void PickFile(InputFileChangeEventArgs e)
    {
        picked = e.File;
        error = null;
        //	The name of the file, without its extension, until the master writes one
        if (string.IsNullOrWhiteSpace(draft.Name))
        {
            var bare = Path.GetFileNameWithoutExtension(e.File.Name);
            draft.Name = bare.Length > 80 ? bare[..80] : bare;
        }
    }

    private static readonly string[] AudioExtensions = { ".mp3", ".ogg", ".oga", ".m4a", ".wav" };

    private async Task UploadAsync()
    {
        if (picked is null || string.IsNullOrWhiteSpace(draft.Name) || !AudioExtensions.Contains(Path.GetExtension(picked.Name).ToLowerInvariant()))
        {
            error = UiText.SoundFileInvalid(Lang);
            return;
        }
        if (picked.Size > SoundFiles.MaxFileBytes)
        {
            error = UiText.SoundFileTooBig(Lang);
            return;
        }
        if (board is not null && board.StorageMax > 0 && board.StorageUsed + picked.Size > board.StorageMax)
        {
            error = UiText.SoundFileNoRoom(Lang);
            return;
        }
        busy = uploading = true;
        (CampaignSoundDto? Value, string? Error) result;
        try
        {
            await using var stream = picked.OpenReadStream(SoundFiles.MaxFileBytes);
            result = await Campaigns.UploadSoundAsync(CampaignId, stream, picked.Name, picked.ContentType, draft.Name.Trim(), draft.Effect, draft.Volume);
        }
        catch (Exception)
        {
            result = (null, null);
        }
        busy = uploading = false;
        if (result.Value is null)
        {
            error = string.IsNullOrWhiteSpace(result.Error) ? UiText.SoundFileInvalid(Lang) : result.Error;
            return;
        }
        error = null;
        picked = null;
        draft = new SaveCampaignSoundDto { Effect = draft.Effect, Volume = draft.Volume };
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    [JSInvokable]
    public void PreviewEnded()
    {
        previewing = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        if (previewing is not null)
        {
            _ = StopPreviewAsync();
        }
        self?.Dispose();
    }

    private async Task StopPreviewAsync()
    {
        try
        {
            await JS.InvokeAsync<bool>("rfSound.preview", null, 0, null);
        }
        catch (Exception)
        {
        }
    }

    private static class SoundsLimits
    {
        public const int MaxLayers = 4;
    }

    private SaveSoundSceneDto? scene;
    private bool sceneOnMap;
    private string? sceneError;

    private CampaignSoundboardDto? board;
    private SaveCampaignSoundDto draft = new();
    private bool busy;
    private string? error;

    private LanguageCode Lang => LanguageState.CurrentLanguage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => board = await Campaigns.GetSoundsAsync(CampaignId) ?? new CampaignSoundboardDto(new(), null);

    // ----- Scenes -----

    private string SceneSummary(SoundSceneDto s) => UiText.SoundSceneSummary(s.TrackId is not null, s.Layers.Count, s.CueId is not null, Lang);

    private void NewScene()
    {
        scene = new SaveSoundSceneDto();
        sceneOnMap = false;
        sceneError = null;
    }

    private void PickTrack(ChangeEventArgs e)
    {
        if (scene is not null)
        {
            scene.TrackId = Guid.TryParse(e.Value?.ToString(), out var picked) ? picked : null;
        }
    }

    private void PickCue(ChangeEventArgs e)
    {
        if (scene is not null)
        {
            scene.CueId = Guid.TryParse(e.Value?.ToString(), out var picked) ? picked : null;
        }
    }

    private void ToggleLayer(Guid id)
    {
        if (scene is null)
        {
            return;
        }
        if (!scene.Layers.Remove(id) && scene.Layers.Count < SoundsLimits.MaxLayers)
        {
            scene.Layers.Add(id);
        }
    }

    private async Task SaveSceneAsync()
    {
        if (scene is null)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(scene.Name) || (scene.TrackId is null && scene.Layers.Count == 0 && scene.CueId is null))
        {
            sceneError = UiText.SoundSceneInvalid(Lang);
            return;
        }
        scene.MapId = sceneOnMap ? MapId : null;
        busy = true;
        var (added, failure) = await Campaigns.AddSoundSceneAsync(CampaignId, scene);
        busy = false;
        if (added is null)
        {
            sceneError = failure ?? UiText.SoundSceneInvalid(Lang);
            return;
        }
        scene = null;
        await LoadAsync();
    }

    private async Task PlaySceneAsync(SoundSceneDto s)
    {
        await UnlockAsync();
        busy = true;
        await Campaigns.PlaySoundSceneAsync(CampaignId, s.Id);
        busy = false;
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task DeleteSceneAsync(SoundSceneDto s)
    {
        busy = true;
        await Campaigns.DeleteSoundSceneAsync(CampaignId, s.Id);
        busy = false;
        await LoadAsync();
    }

    private async Task AddAsync()
    {
        if (fromFile)
        {
            await UploadAsync();
            return;
        }
        if (string.IsNullOrWhiteSpace(draft.Name) || !Uri.TryCreate(draft.Url?.Trim(), UriKind.Absolute, out var uri) || uri.Scheme != Uri.UriSchemeHttps)
        {
            error = UiText.SoundInvalid(Lang);
            return;
        }
        busy = true;
        var (added, failure) = await Campaigns.AddSoundAsync(CampaignId, draft);
        busy = false;
        if (added is null)
        {
            error = string.IsNullOrWhiteSpace(failure) ? UiText.SoundInvalid(Lang) : failure;
            return;
        }
        error = null;
        draft = new SaveCampaignSoundDto { Effect = draft.Effect, Volume = draft.Volume };
        await LoadAsync();
    }

    private async Task PlayAsync(CampaignSoundDto sound)
    {
        if (Standalone)
        {
            self ??= DotNetObjectReference.Create(this);
            try
            {
                var playing = await JS.InvokeAsync<bool>("rfSound.preview", Campaigns.SoundUrl(sound.Url), sound.Volume, self);
                previewing = playing ? sound.Id : null;
            }
            catch (Exception)
            {
                previewing = null;
            }
            return;
        }
        //	The click lets this browser play too
        await UnlockAsync();
        busy = true;
        await Campaigns.PlaySoundAsync(CampaignId, sound.Id);
        busy = false;
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task StopAsync()
    {
        busy = true;
        await Campaigns.StopSoundsAsync(CampaignId);
        busy = false;
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task DeleteAsync(CampaignSoundDto sound)
    {
        if (previewing == sound.Id)
        {
            await StopPreviewAsync();
            previewing = null;
        }
        busy = true;
        await Campaigns.DeleteSoundAsync(CampaignId, sound.Id);
        busy = false;
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task UnlockAsync()
    {
        try
        {
            await JS.InvokeAsync<bool>("rfSound.unlock");
        }
        catch (Exception)
        {
        }
    }
}
