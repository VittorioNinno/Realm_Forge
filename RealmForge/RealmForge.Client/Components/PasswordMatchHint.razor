@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@implements IDisposable
@inject LanguageStateService LanguageState

@* Live check under "repeat the new password": warns about a typo before the form is sent *@
<div id="@Id" class="small mt-2 rf-password-match" role="status" aria-live="polite" data-test="@DataTest">
    @switch (State(Password, Repeat))
    {
        case MatchState.Different:
            <span class="text-warning">@UiText.PasswordRepeatDiffers(LanguageState.CurrentLanguage)</span>
            break;
        case MatchState.Same:
            <span class="text-success"><Icon Name="check" /> @UiText.PasswordsMatch(LanguageState.CurrentLanguage)</span>
            break;
    }
</div>

@code {
    public enum MatchState { Empty, Typing, Different, Same }

    [Parameter] public string Password { get; set; } = "";
    [Parameter] public string Repeat { get; set; } = "";
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? DataTest { get; set; }

    ///	<summary>
    ///	Same: identical. Typing: the repetition is still a beginning of the password, no warning yet.
    ///	Different: a character differs or the repetition is longer.
    ///	</summary>
    public static MatchState State(string? password, string? repeat)
    {
        password ??= "";
        repeat ??= "";
        if (repeat.Length == 0) return MatchState.Empty;
        if (repeat == password) return MatchState.Same;
        return password.StartsWith(repeat, StringComparison.Ordinal) ? MatchState.Typing : MatchState.Different;
    }

    public static bool IsDifferent(string? password, string? repeat) => State(password, repeat) == MatchState.Different;

    protected override void OnInitialized() => LanguageState.OnLanguageChanged += StateHasChanged;

    public void Dispose() => LanguageState.OnLanguageChanged -= StateHasChanged;
}
