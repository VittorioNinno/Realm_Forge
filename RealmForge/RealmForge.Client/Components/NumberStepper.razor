@* A number field with − and + in the forge style (no browser spinners) *@
<div class="rf-stepper @Class" data-test="@DataTest">
    <button type="button" class="rf-stepper-btn" @onclick="() => Set(Value - Step)" disabled="@(Value <= Min)" aria-label="@($"−{Step}")">−</button>
    <input type="number" class="rf-stepper-input" min="@Min" max="@Max" value="@Value" @onchange="OnInput" aria-label="@AriaLabel" data-test="@InputTest" />
    <button type="button" class="rf-stepper-btn" @onclick="() => Set(Value + Step)" disabled="@(Value >= Max)" aria-label="@($"+{Step}")">+</button>
</div>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public int Min { get; set; } = int.MinValue / 2;
    [Parameter] public int Max { get; set; } = int.MaxValue / 2;
    [Parameter] public int Step { get; set; } = 1;
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? DataTest { get; set; }
    [Parameter] public string? InputTest { get; set; }
    [Parameter] public string? Class { get; set; }

    private Task Set(int value) => ValueChanged.InvokeAsync(Math.Clamp(value, Min, Max));

    private Task OnInput(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out var value) ? Set(value) : Set(Value);
}
