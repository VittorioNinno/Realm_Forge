@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.Campaigns
@using RealmForge.Shared.DTOs
@using RealmForge.Shared.Enums
@inject CampaignDataService Campaigns
@inject LanguageStateService LanguageState

@* The clock of a campaign: the time inside the game and the effects of the characters running on it; the masters move
   it on (the long spells end, days of travel eat the rations). Compact: the drawer of the table *@
<section class="rf-clock @(Compact ? "compact" : "rf-ov-card rf-ov-time")" data-test="campaign-clock">
    <div class="rf-clock-head">
        <span class="rf-ov-icon"><Icon Name="hourglass-split" /></span>
        <span class="rf-clock-title">
            <span class="rf-ov-kicker">@UiText.ClockTitle(Lang)</span>
            <span class="rf-clock-line">
                <strong class="rf-clock-now" data-test="clock-now">@(clock is null ? "…" : UiText.ClockText(clock.Minutes, Lang))</strong>
                @if (clock is not null)
                {
                    var phase = PhaseOf(GameClock.Hour(clock.Minutes));
                    <span class="rf-clock-phase @phase">@UiText.ClockPhase(phase, Lang)</span>
                }
            </span>
        </span>
        @if (Runs && clock is not null)
        {
            <button type="button" class="rf-ov-ghost @(setOpen ? "on" : null)" aria-expanded="@(setOpen ? "true" : "false")" @onclick="() => setOpen = !setOpen" data-test="clock-set-open"><Icon Name="clock" /> @UiText.ClockSetShort(Lang)</button>
        }
    </div>
    <p class="rf-ov-desc">@(Runs ? UiText.ClockHintMaster(Lang) : UiText.ClockHintPlayer(Lang))</p>

    @if (Runs && clock is not null)
    {
        @if (setOpen)
        {
            <div class="rf-clock-set" data-test="clock-set-box">
                <label class="rf-ov-field">
                    <span class="rf-ov-micro">@UiText.ClockDay(Lang)</span>
                    <input type="number" class="rf-form-control text-center" min="1" @bind="setDay" data-test="clock-set-day" />
                </label>
                <label class="rf-ov-field">
                    <span class="rf-ov-micro">@UiText.ClockTime(Lang)</span>
                    <input type="time" class="rf-form-control" @bind="setTime" data-test="clock-set-time" />
                </label>
                <button type="button" class="btn btn-rf-orange" disabled="@busy" @onclick="SetAsync" data-test="clock-set">@UiText.ClockApply(Lang)</button>
            </div>
        }
        <div class="rf-clock-steps">
            <button type="button" class="rf-clock-step" disabled="@busy" @onclick="() => MoveAsync(10)" data-test="clock-10">@UiText.ClockPlus10(Lang)</button>
            <button type="button" class="rf-clock-step" disabled="@busy" @onclick="() => MoveAsync(60)" data-test="clock-hour">@UiText.ClockPlusHour(Lang)</button>
            <button type="button" class="rf-clock-step featured" disabled="@busy" @onclick="() => MoveAsync(480)" data-test="clock-rest">@UiText.ClockLongRest(Lang)</button>
            <button type="button" class="rf-clock-step" disabled="@busy" @onclick="() => MoveAsync(GameClock.MinutesPerDay)" data-test="clock-day">@UiText.ClockPlusDay(Lang)</button>
        </div>
        <div class="rf-clock-box">
            <div class="rf-clock-custom">
                <span class="rf-clock-custom-label">@UiText.ClockCustom(Lang)</span>
                <input type="number" class="rf-form-control text-center" min="1" max="720" @bind="amount" aria-label="@UiText.ClockCustom(Lang)" data-test="clock-amount" />
                <select class="rf-form-control" @bind="unit" aria-label="@UiText.ClockCustom(Lang)" data-test="clock-unit">
                    <option value="m">@UiText.ClockMinutes(Lang)</option>
                    <option value="h">@UiText.ClockHours(Lang)</option>
                    <option value="d">@UiText.ClockDays(Lang)</option>
                </select>
                <button type="button" class="btn btn-rf-orange" disabled="@busy" @onclick="MoveCustomAsync" data-test="clock-go">@UiText.ClockGo(Lang)</button>
            </div>
            <label class="rf-ov-check">
                <input type="checkbox" @bind="rations" data-test="clock-rations" />
                <span>@UiText.ClockRations(Lang)</span>
            </label>
        </div>
    }

    @if (report.Count > 0)
    {
        <ul class="rf-clock-report" role="status" data-test="clock-report">
            @foreach (var line in report)
            {
                <li>@line</li>
            }
        </ul>
    }

    @if (clock is not null)
    {
        <div class="rf-clock-effects">
            <div class="rf-clock-effects-head">
                <span class="rf-ov-micro">@UiText.ClockEffects(Lang)</span>
                <span class="rf-clock-count">@UiText.ClockActive(clock.Effects.Count, Lang)</span>
            </div>
            @if (clock.Effects.Count == 0)
            {
                <div class="rf-ov-empty">@UiText.ClockNoEffects(Lang)</div>
            }
            else
            {
                <ul>
                    @foreach (var effect in clock.Effects)
                    {
                        <li data-test="clock-effect"><strong>@effect.Character</strong> · @effect.Name <span class="small">@UiText.ClockLeft(effect.Until - clock.Minutes, Lang)</span></li>
                    }
                </ul>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public Guid CampaignId { get; set; }
    [Parameter] public CampaignRole Role { get; set; } = CampaignRole.Player;
    [Parameter] public bool Compact { get; set; }

    //	The time moved (the table follows it at once)
    [Parameter] public EventCallback<long> OnMoved { get; set; }

    private CampaignClockDto? clock;
    private bool busy;
    private int amount = 2;
    private string unit = "h";
    private bool UnitDays => unit == "d";
    private bool setOpen;

    //	The part of the day an hour falls in
    private static string PhaseOf(int hour) => hour switch
    {
        >= 6 and < 12 => "morning",
        >= 12 and < 18 => "afternoon",
        >= 18 and < 22 => "evening",
        _ => "night"
    };
    private bool rations = true;
    private long setDay = 1;
    private TimeOnly setTime = new(8, 0);
    private List<string> report = new();

    private LanguageCode Lang => LanguageState.CurrentLanguage;
    private bool Runs => CampaignRules.RunsTheTable(Role);

    protected override async Task OnParametersSetAsync()
    {
        if (clock is null)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        clock = await Campaigns.GetClockAsync(CampaignId);
        if (clock is not null)
        {
            setDay = GameClock.Day(clock.Minutes);
            setTime = new TimeOnly(GameClock.Hour(clock.Minutes), GameClock.Minute(clock.Minutes));
        }
    }

    private Task MoveAsync(int minutes) => SendAsync(new MoveClockDto { Minutes = minutes, Rations = rations });

    private Task MoveCustomAsync()
    {
        var steps = Math.Clamp(amount, 1, UnitDays ? 30 : 720);
        return MoveAsync(unit switch { "d" => steps * GameClock.MinutesPerDay, "m" => steps, _ => steps * 60 });
    }

    private Task SetAsync() => SendAsync(new MoveClockDto { Set = (Math.Max(1, setDay) - 1) * GameClock.MinutesPerDay + setTime.Hour * 60 + setTime.Minute });

    private async Task SendAsync(MoveClockDto dto)
    {
        busy = true;
        var (moved, error) = await Campaigns.MoveClockAsync(CampaignId, dto);
        busy = false;
        if (moved is null)
        {
            report = new() { error ?? UiText.ClockFailed(Lang) };
            return;
        }
        report = moved.Expired.Select(e => UiText.ClockExpired(e.Character, e.Name, Lang))
            .Concat(moved.Days > 0 ? new[] { UiText.ClockAte(moved.Days, Lang) } : Array.Empty<string>())
            .Concat(moved.Hungry.Select(h => UiText.ClockHungry(h.Character, h.Days, Lang)))
            .ToList();
        await LoadAsync();
        await OnMoved.InvokeAsync(moved.Minutes);
    }
}
