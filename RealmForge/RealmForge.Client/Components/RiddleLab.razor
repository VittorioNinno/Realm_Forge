@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.DTOs
@using RealmForge.Shared.Enums
@using RealmForge.Shared.Puzzles
@inject CampaignDataService Campaigns
@inject LanguageStateService LanguageState

@* The riddles lab of a handout: the answer that solves it and the door it opens, a cipher to turn a text into a
   message to decode, the catalogue of riddles with the hints of each check *@
<details class="rf-riddle-lab" open="@(Draft.PuzzleAnswer is { Length: > 0 })" data-test="riddle-lab">
    <summary><span class="rf-riddle-sum"><Icon Name="puzzle" /> @UiText.RiddleLab(Lang)</span><span class="rf-riddle-chevron"><Icon Name="chevron-down" /></span></summary>

    <div class="rf-riddle-row">
        <label class="d-flex flex-column gap-1 flex-grow-1">
            <span class="rf-form-label mb-0">@UiText.RiddleAnswer(Lang)</span>
            <input class="rf-form-control" maxlength="240" placeholder="@UiText.RiddleAnswerHint(Lang)" @bind="Draft.PuzzleAnswer" data-test="riddle-answer" />
        </label>
        <label class="d-flex flex-column gap-1 flex-grow-1">
            <span class="rf-form-label mb-0">@UiText.RiddleDoor(Lang)</span>
            <select class="rf-form-control" value="@(Draft.PuzzleDoorId?.ToString() ?? string.Empty)" @onchange="PickDoor" data-test="riddle-door">
                <option value="">@UiText.RiddleNoDoor(Lang)</option>
                @foreach (var doorOption in doors)
                {
                    <option value="@doorOption.Id">@doorOption.Map · @doorOption.Label</option>
                }
            </select>
        </label>
    </div>

    <span class="rf-mini-label">@UiText.RiddleCipher(Lang)</span>
    <div class="rf-riddle-row rf-riddle-cipher">
        <select class="rf-form-control" @bind="cipher" aria-label="@UiText.RiddleCipher(Lang)" data-test="riddle-cipher">
            @foreach (var kindOption in Enum.GetValues<CipherKind>())
            {
                <option value="@kindOption">@UiText.CipherName(kindOption, Lang)</option>
            }
        </select>
        @if (Ciphers.NeedsKey(cipher))
        {
            <input class="rf-form-control" maxlength="40" placeholder="@(cipher == CipherKind.Caesar ? UiText.RiddleShift(Lang) : UiText.RiddleKeyword(Lang))" @bind="key" @bind:event="oninput" data-test="riddle-key" />
        }
    </div>
    <textarea class="rf-form-control" rows="2" maxlength="1000" placeholder="@UiText.RiddlePlain(Lang)" @bind="plain" @bind:event="oninput" data-test="riddle-plain"></textarea>
    @if (plain.Length > 0)
    {
        <div class="rf-riddle-preview" data-test="riddle-preview">@Encoded</div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-sm btn-rf-outline" @onclick="InsertCipher" data-test="riddle-insert"><Icon Name="plus" /> @UiText.RiddleInsert(Lang)</button>
            <button type="button" class="btn btn-sm btn-rf-outline" @onclick="UseAsAnswer">@UiText.RiddleUseAnswer(Lang)</button>
        </div>
    }

    <span class="rf-mini-label">@UiText.RiddleCatalog(Lang)</span>
    <select class="rf-form-control" @bind="riddleId" aria-label="@UiText.RiddleCatalog(Lang)" data-test="riddle-pick">
        <option value="">—</option>
        @foreach (var riddleOption in RiddleCatalog.All)
        {
            <option value="@riddleOption.Id">@(Lang == LanguageCode.En ? riddleOption.PlaceEn : riddleOption.PlaceIt)</option>
        }
    </select>
    @if (RiddleCatalog.Find(riddleId) is { } chosenRiddle)
    {
        <div class="rf-riddle-card">
            <p class="mb-2"><em>@(Lang == LanguageCode.En ? chosenRiddle.TextEn : chosenRiddle.TextIt)</em></p>
            <span class="small" style="color: var(--rf-text-muted);">@UiText.RiddleHintsFor(Lang)</span>
            <ul class="rf-riddle-hints">
                @foreach (var hintRow in chosenRiddle.Hints)
                {
                    <li><span class="rf-riddle-dc">@hintRow.Skill CD @hintRow.Dc</span> @(Lang == LanguageCode.En ? hintRow.En : hintRow.It)</li>
                }
            </ul>
            <button type="button" class="btn btn-sm btn-rf-orange" @onclick="() => UseRiddle(chosenRiddle)" data-test="riddle-use"><Icon Name="plus" /> @UiText.RiddleUse(Lang)</button>
        </div>
    }
</details>

@code {
    [Parameter, EditorRequired] public Guid CampaignId { get; set; }
    [Parameter, EditorRequired] public SaveCampaignHandoutDto Draft { get; set; } = default!;

    //	The texts changed from here: the editor re-renders them
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<PuzzleDoorDto> doors = new();
    private CipherKind cipher = CipherKind.Caesar;
    private string key = "3";
    private string plain = string.Empty;
    private string riddleId = string.Empty;

    private LanguageCode Lang => LanguageState.CurrentLanguage;
    private string Encoded => Ciphers.Encode(cipher, plain, key);

    protected override async Task OnInitializedAsync() => doors = await Campaigns.GetPuzzleDoorsAsync(CampaignId) ?? new();

    private void PickDoor(ChangeEventArgs e) => Draft.PuzzleDoorId = Guid.TryParse(e.Value?.ToString(), out var picked) ? picked : null;

    //	The coded message goes at the end of both texts, in a block that keeps its spacing
    private async Task InsertCipher()
    {
        var block = $"\n\n```\n{Encoded}\n```";
        Draft.BodyIt = (Draft.BodyIt ?? string.Empty).TrimEnd() + block;
        Draft.BodyEn = (Draft.BodyEn ?? string.Empty).TrimEnd() + block;
        await OnChanged.InvokeAsync();
    }

    private void UseAsAnswer() => Draft.PuzzleAnswer = plain.Trim();

    private async Task UseRiddle(Riddle riddle)
    {
        if (string.IsNullOrWhiteSpace(Draft.TitleIt) && string.IsNullOrWhiteSpace(Draft.TitleEn))
        {
            Draft.TitleIt = riddle.PlaceIt;
            Draft.TitleEn = riddle.PlaceEn;
        }
        Draft.BodyIt = ((Draft.BodyIt ?? string.Empty).TrimEnd() + "\n\n> " + riddle.TextIt).Trim();
        Draft.BodyEn = ((Draft.BodyEn ?? string.Empty).TrimEnd() + "\n\n> " + riddle.TextEn).Trim();
        Draft.PuzzleAnswer = $"{riddle.AnswerIt}|{riddle.AnswerEn}";
        await OnChanged.InvokeAsync();
    }
}
