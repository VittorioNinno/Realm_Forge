@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.Campaigns
@using RealmForge.Shared.DTOs
@using RealmForge.Shared.Enums
@inject EncounterDataService Encounters
@inject CampaignDataService Campaigns
@inject LanguageStateService LanguageState

@* Encounters tab of a campaign: the list (masters and co-masters see them all, the players only the ones under way
   that were shown to them) and the encounter that is open *@
<section class="enc" data-test="campaign-encounters">
    @if (openId is { } id)
    {
        <EncounterTracker CampaignId="Campaign.Id" EncounterId="id" Campaign="Campaign" OnClose="CloseAsync" GenerateOnOpen="generateOnOpen" GenerateType="newType" />
    }
    else
    {
        <div class="small mb-3" style="color: var(--rf-text-muted);">
            @(EncounterRules.CanManage(Campaign.MyRole) ? UiText.EncountersHintMaster(Lang) : UiText.EncountersHintPlayer(Lang))
        </div>

        @if (EncounterRules.CanManage(Campaign.MyRole))
        {
            <section class="enc-card enc-new" data-test="encounter-create">
                <span class="enc-kicker">@UiText.EncounterNewKicker(Lang)</span>
                <div class="enc-new-grid">
                    <label>
                        <span class="enc-micro">@UiText.EncounterName(Lang)</span>
                        <input class="rf-form-control" maxlength="100" placeholder="@UiText.EncounterNamePlaceholder(Lang)" @bind="newName" @bind:event="oninput" data-test="encounter-new-name" />
                    </label>
                    <label>
                        <span class="enc-micro">@UiText.EncounterLinkedMap(Lang)</span>
                        <RfSelect TValue="Guid?" @bind-Value="newMap" Options="MapOptions" />
                    </label>
                    <label>
                        <span class="enc-micro">@UiText.EncounterGenTheme(Lang)</span>
                        <RfSelect TValue="CreatureType?" @bind-Value="newType" Options="ThemeOptions" />
                    </label>
                    <div class="enc-new-actions">
                        <button type="button" class="enc-btn" disabled="@(string.IsNullOrWhiteSpace(newName) || busy)" @onclick="() => CreateAsync(false)" data-test="encounter-new-create">@UiText.EncounterCreateEmpty(Lang)</button>
                        <button type="button" class="enc-btn primary" disabled="@(string.IsNullOrWhiteSpace(newName) || busy)" @onclick="() => CreateAsync(true)" data-test="encounter-new-generate"><Icon Name="dice" /> @UiText.EncounterCreateFilled(Lang)</button>
                    </div>
                </div>
                @if (error is not null)
                {
                    <div class="small text-warning mt-2">@error</div>
                }
            </section>
        }

        @if (list is null)
        {
            <div class="small" style="color: var(--rf-text-muted);">…</div>
        }
        else if (list.Count == 0)
        {
            <div class="rf-account-card text-center" data-test="encounters-empty">@UiText.EncountersEmpty(Lang)</div>
        }
        else
        {
            <div class="enc-list" data-test="encounter-list">
                @foreach (var item in list)
                {
                    var e = item;
                    <article class="enc-list-card status-@e.Status.ToString().ToLowerInvariant()">
                        <button type="button" class="enc-list-main" @onclick="() => Open(e.Id)" data-test="encounter-item">
                            <span class="enc-list-title">
                                <strong class="rf-encounter-item-name">@e.Name</strong>
                                <span class="enc-status status-@e.Status.ToString().ToLowerInvariant()"><span class="dot"></span>@UiText.EncounterStatusName(e.Status, Lang)</span>
                                @if (e.Status == EncounterStatus.Running)
                                {
                                    <span class="enc-round">@UiText.EncounterRound(e.Round, Lang)</span>
                                }
                                @if (e.Rating is { } rating && e.Ruleset is { } ruleset)
                                {
                                    <span class="enc-diff level-@Level(ruleset, rating, e.MonsterXp)">@UiText.EncounterRating(ruleset, rating, Lang) · @e.MonsterXp @UiText.XpLabel(Lang)</span>
                                }
                                @if (e.Shown)
                                {
                                    <span class="enc-shown"><Icon Name="eye" /> @UiText.EncounterShownShort(Lang)</span>
                                }
                            </span>
                            <span class="enc-list-sub">
                                @if (e.MapName is not null)
                                {
                                    <span>@UiText.EncounterOnMap(e.MapName, Lang)</span>
                                    <span class="sep">•</span>
                                }
                                <span>@UiText.EncounterSides(e.Characters, e.Monsters, Lang)</span>
                            </span>
                        </button>
                        @if (EncounterRules.CanManage(Campaign.MyRole))
                        {
                            <div class="enc-list-actions">
                                <button type="button" class="enc-btn" @onclick="() => Open(e.Id)">@UiText.EncounterOpen(Lang)</button>
                                @if (e.Status != EncounterStatus.Finished)
                                {
                                    <a class="enc-cta" href="@($"campaigns/{Campaign.Id}/vtt?encounter={e.Id}")">@UiText.EncounterOnTableShort(Lang) <Icon Name="caret-right" /></a>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public CampaignDetailDto Campaign { get; set; } = default!;

    private LanguageCode Lang => LanguageState.CurrentLanguage;
    private List<EncounterSummaryDto>? list;
    private Guid? openId;
    private string newName = string.Empty;
    private Guid? newMap;
    private CreatureType? newType;
    private bool generateOnOpen;
    private List<CampaignMapSummaryDto>? maps;
    private string? error;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (EncounterRules.CanManage(Campaign.MyRole))
        {
            maps = await Campaigns.GetMapsAsync(Campaign.Id) ?? new();
        }
    }

    private void Open(Guid id)
    {
        generateOnOpen = false;
        openId = id;
    }

    private List<RfSelect<Guid?>.OptionItem> MapOptions => new List<RfSelect<Guid?>.OptionItem> { new(null, UiText.EncounterNoMap(Lang)) }
        .Concat((maps ?? new()).Select(m => new RfSelect<Guid?>.OptionItem(m.Id, m.Name)))
        .ToList();

    private List<RfSelect<CreatureType?>.OptionItem> ThemeOptions => new List<RfSelect<CreatureType?>.OptionItem> { new(null, UiText.EncounterGenAny(Lang)) }
        .Concat(Enum.GetValues<CreatureType>()
            .Select(t => new RfSelect<CreatureType?>.OptionItem(t, UiText.FormatCreatureType(t, Lang)))
            .OrderBy(o => o.Label, StringComparer.CurrentCultureIgnoreCase))
        .ToList();

    private static string Level(RulesetVersion ruleset, int rating, int xp) => xp == 0 ? "none" : rating <= 1 ? "low" : rating == 2 ? "mid" : "high";

    private async Task LoadAsync() => list = await Encounters.GetEncountersAsync(Campaign.Id) ?? new List<EncounterSummaryDto>();

    private async Task CreateAsync(bool fill)
    {
        if (string.IsNullOrWhiteSpace(newName))
        {
            return;
        }
        busy = true;
        error = null;
        var result = await Encounters.SaveAsync(Campaign.Id, null, new SaveEncounterDto { Name = newName.Trim(), MapId = newMap });
        busy = false;
        if (result.Encounter is { } created)
        {
            newName = string.Empty;
            generateOnOpen = fill;
            openId = created.Id;
            await LoadAsync();
            return;
        }
        error = UiText.CampaignActionFailed(result.Status, Lang);
    }

    private async Task CloseAsync()
    {
        openId = null;
        await LoadAsync();
    }
}
