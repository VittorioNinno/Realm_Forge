@typeparam TValue
@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@inject LanguageStateService LanguageState

@* Arrow selector of the character wizard: ‹ value ›. The arrows cycle through the options, the value opens the full list. *@
<div class="rf-forge-selector" data-test="@DataTest" @onclick:stopPropagation="true">
    <button type="button" class="rf-forge-selector-btn" aria-label="‹" disabled="@ArrowsDisabled" @onclick="() => Step(-1)" data-test="selector-prev">
        <Icon Name="chevron-left" />
    </button>
    <button type="button" class="rf-forge-selector-display @(HasValue ? null : "placeholder")" @onclick="() => open = !open" data-test="selector-value">@(HasValue ? CurrentLabel : Placeholder ?? UiText.SelectorPlaceholder(LanguageState.CurrentLanguage))</button>
    <button type="button" class="rf-forge-selector-btn" aria-label="›" disabled="@ArrowsDisabled" @onclick="() => Step(1)" data-test="selector-next">
        <Icon Name="chevron-right" />
    </button>

    @if (open && Options.Count > 0)
    {
        <div class="rf-forge-selector-menu" role="listbox">
            @foreach (var option in Options)
            {
                var selected = EqualityComparer<TValue>.Default.Equals(option.Value, Value);
                @* An option that cannot be chosen stays in the list, greyed out, with the reason under its name *@
                <button type="button" role="option" class="rf-forge-selector-option @(selected ? "selected" : null) @(option.Disabled ? "disabled" : null)"
                        disabled="@option.Disabled" aria-disabled="@(option.Disabled ? "true" : null)" @onclick="() => SelectAsync(option.Value)">
                    <span>@option.Label</span>
                    @if (option.Note is not null)
                    {
                        <small>@option.Note</small>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    //	Disabled: shown but not selectable (a requirement not met); Note: the requirement, under the name
    public record Option(TValue Value, string Label, bool Disabled = false, string? Note = null);

    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public List<Option> Options { get; set; } = new();
    [Parameter] public string? DataTest { get; set; }

    //	Shown while nothing is chosen yet: a required choice does not offer an empty option
    [Parameter] public string? Placeholder { get; set; }

    private bool open;

    private bool HasValue => Options.Any(o => EqualityComparer<TValue>.Default.Equals(o.Value, Value));

    private bool ArrowsDisabled => Options.Count == 0 || (Options.Count == 1 && HasValue);

    private string CurrentLabel => Options.FirstOrDefault(o => EqualityComparer<TValue>.Default.Equals(o.Value, Value))?.Label ?? "—";

    private async Task Step(int delta)
    {
        if (Options.Count == 0)
        {
            return;
        }

        //	The arrows skip the options that cannot be chosen
        var index = Options.FindIndex(o => EqualityComparer<TValue>.Default.Equals(o.Value, Value));
        for (var step = 0; step < Options.Count; step++)
        {
            index = index < 0 ? 0 : (index + delta + Options.Count) % Options.Count;
            if (!Options[index].Disabled)
            {
                await SelectAsync(Options[index].Value);
                return;
            }
        }
    }

    private async Task SelectAsync(TValue value)
    {
        open = false;
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
