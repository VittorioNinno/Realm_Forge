@* Starting class: its skills, its subclass when the levels reach it, proficiencies and features *@
@{
    var cls = W.StartingClass;
    var entry = W.StartingClassBuild;
    var detail = cls is null ? null : W.ClassDetails.GetValueOrDefault(cls.Id);
    var level = cls is null ? 0 : W.ClassLevelOf(cls.Id);
}

<div class="rf-wizard-row">
    <div class="rf-wizard-label">@UiText.LabelStartingClass(Lang)</div>
    <div class="rf-wizard-field">
        <ForgeSelector TValue="Guid" Value="@(cls?.Id ?? Guid.Empty)" ValueChanged="W.SetStartingClassAsync" Options="ClassOptions" DataTest="wizard-class" />
    </div>
</div>

@if (cls is not null && entry is not null)
{
    <SubclassRow W="W" Class="cls" Entry="entry" ClassLevel="level" />

    <div class="rf-wizard-panel" data-test="wizard-class-panel">
        <div class="rf-wizard-block-title">@cls.Name</div>
        <div class="rf-class-summary">
            <div class="rf-class-summary-head">
                <span class="rf-class-summary-die" title="@UiText.LabelHitDie(Lang)">d@(cls.HitDie)</span>
                <div>
                    <div class="rf-class-summary-label">@UiText.LabelPrimaryAbility(Lang)</div>
                    <div class="rf-class-summary-value">@string.Join(", ", cls.PrimaryAbilities.Select(a => FeatPrerequisiteFormatter.AbilityName(a, Lang)))</div>
                </div>
                <div>
                    <div class="rf-class-summary-label">@UiText.SheetHitPoints(Lang)</div>
                    <div class="rf-class-summary-value">@UiText.HitPointsSummary(cls.HitDie, Lang)</div>
                </div>
            </div>
            <dl class="rf-def-list">
                <dt>@UiText.LabelSaves(Lang)</dt>
                <dd>@string.Join(", ", cls.SavingThrows.Select(a => FeatPrerequisiteFormatter.AbilityName(a, Lang)))</dd>
                <dt>@UiText.SheetArmorTraining(Lang)</dt>
                <dd>@UiText.ArmorTrainingText(CharacterRules.Armor(cls, Ruleset, true), Lang)</dd>
                @if (!string.IsNullOrWhiteSpace(detail?.WeaponProficiencies))
                {
                    <dt>@UiText.LabelWeapons(Lang)</dt>
                    <dd>@detail.WeaponProficiencies</dd>
                }
                @if (!string.IsNullOrWhiteSpace(detail?.ToolProficiencies))
                {
                    <dt>@UiText.LabelTools(Lang)</dt>
                    <dd>@detail.ToolProficiencies</dd>
                }
                @if (cls.SpellcastingAbility is { } spellAbility)
                {
                    <dt>@UiText.LabelSpellcastingAbility(Lang)</dt>
                    <dd>@FeatPrerequisiteFormatter.AbilityName(spellAbility, Lang)@(cls.SpellList is { } list ? $" · {UiText.SpellListOf(GameTerms.ClassName(list, Lang), Lang)}" : null)</dd>
                }
            </dl>
            @if (!string.IsNullOrWhiteSpace(detail?.Description))
            {
                <FeatureBlock Title="@UiText.LabelClassDescription(Lang)" Text="@detail.Description" Ruleset="Ruleset" />
            }
        </div>

        <div class="rf-wizard-block-title">@UiText.LabelClassSkills(cls.SkillChoiceCount, Lang)</div>
        <SkillPicker W="W" Chosen="entry.Skills" Count="cls.SkillChoiceCount" Options="cls.SkillOptions" DataTest="wizard-skill" />
        @if (cls.SkillOptions.Any(s => W.Computed.SkillProficiencies.Contains(s) && !entry.Skills.Contains(s)))
        {
            <div class="small mb-3" style="color: var(--rf-text-muted);">@UiText.HintKnownSkills(Lang)</div>
        }

        @if (detail is not null)
        {
            <div class="rf-wizard-block-title">@UiText.LabelFeaturesUpToLevel(Math.Max(1, level), Lang)</div>
            @foreach (var feature in detail.Features.Where(f => f.Level <= Math.Max(1, level)).OrderBy(f => f.Level).ThenBy(f => f.SortOrder))
            {
                <FeatureBlock Title="@feature.Name" Text="@feature.Description" Level="feature.Level" Ruleset="Ruleset" />
            }
            @if (detail.Subclasses.FirstOrDefault(s => s.Id == entry.SubclassId) is { } subclass)
            {
                @foreach (var feature in subclass.Features.Where(f => f.Level <= level).OrderBy(f => f.Level).ThenBy(f => f.SortOrder))
                {
                    <FeatureBlock Title="@feature.Name" Text="@feature.Description" Level="feature.Level" Badge="@subclass.Name" Ruleset="Ruleset" />
                }
            }
        }
    </div>
}

@code {
    private List<ForgeSelector<Guid>.Option> ClassOptions =>
        Context.Classes.Select(c => new ForgeSelector<Guid>.Option(c.Id, c.Name)).ToList();
}
