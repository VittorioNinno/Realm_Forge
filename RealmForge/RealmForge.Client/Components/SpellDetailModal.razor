@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.DTOs
@using RealmForge.Shared.Enums
@using RealmForge.Shared.Localization
@inject SpellDataService SpellService
@inject GlossaryService Glossary
@inject LanguageStateService LanguageState

@* Details of a spell over the current page (wizard, sheet): stat block, description and higher levels *@
@if (SpellId is not null)
{
    <div class="rf-modal-backdrop rf-info-backdrop" @onclick="CloseAsync">
        <aside class="rf-info-modal wide" @onclick:stopPropagation="true" data-test="spell-detail-modal">
            @if (spell is null)
            {
                <div class="small" style="color: var(--rf-text-muted);">@UiText.LoadingArchives(Lang)</div>
            }
            else
            {
                <header class="rf-info-head">
                    <div>
                        <span class="rf-info-kicker">@GameTerms.SpellSubtitle(spell.Level, spell.School, spell.Ritual, Lang, spell.Ruleset)</span>
                        <h3 class="rf-info-title">@spell.Name</h3>
                    </div>
                    <div class="rf-info-head-right">
                        <span class="rf-info-badge">@UiText.FormatRuleset(spell.Ruleset, Lang)</span>
                        <button type="button" class="rf-info-close" @onclick="CloseAsync" aria-label="@UiText.BtnClose(Lang)" data-test="spell-detail-close"><Icon Name="close" /></button>
                    </div>
                </header>
                @Actions
                <div class="rf-info-stats cols-2">
                    <div class="rf-info-stat highlight"><span>@UiText.LabelCastingTime(Lang)</span><strong>@spell.CastingTime</strong></div>
                    <div class="rf-info-stat"><span>@UiText.LabelRange(Lang)</span><strong>@spell.Range</strong></div>
                    <div class="rf-info-stat"><span>@UiText.LabelComponents(Lang)</span><strong>@Components(spell)</strong></div>
                    <div class="rf-info-stat"><span>@UiText.LabelDuration(Lang)</span><strong>@(spell.Concentration ? $"{UiText.ConcentrationShort(Lang)}, " : null)@spell.Duration</strong></div>
                </div>
                @if (spell.Classes.Count > 0)
                {
                    <div class="rf-info-row"><span>@UiText.SpellClassLists(Lang)</span><strong>@string.Join(", ", spell.Classes.Select(c => GameTerms.ClassName(c, Lang)))</strong></div>
                }
                <div class="rf-info-body">
                    <div @key="spell.Description" class="rf-markdown-container">@((MarkupString)MarkdownText.ToHtml(spell.Description, Glossary.Linker(Lang, spell.Ruleset)))</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(spell.HigherLevels))
                {
                    <div class="rf-info-highlight">
                        <div class="head"><span class="pill">@GameTerms.SpellHigherLevelsHeading(spell.Level, Lang, spell.Ruleset)</span></div>
                        <div @key="spell.HigherLevels" class="rf-markdown-container">@((MarkupString)MarkdownText.ToHtml(spell.HigherLevels, Glossary.Linker(Lang, spell.Ruleset)))</div>
                    </div>
                }
                <footer class="rf-info-foot">
                    <span>@UiText.SpellFootNote(Lang)</span>
                    <a href="@($"spells?id={spell.Id}")" target="_blank" rel="noopener">@UiText.OpenInCompendium(Lang) <Icon Name="external" /></a>
                </footer>
            }
        </aside>
    </div>
}

@code {
    [Parameter] public Guid? SpellId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    //	Optional panel under the title (the sheet uses it to cast the spell)
    [Parameter] public RenderFragment? Actions { get; set; }

    private SpellDetailResponseDto? spell;
    private Guid? loaded;

    private LanguageCode Lang => LanguageState.CurrentLanguage;

    protected override async Task OnParametersSetAsync()
    {
        if (SpellId is { } id && loaded != id)
        {
            loaded = id;
            spell = null;
            await Glossary.EnsureLoadedAsync(Lang);
            spell = await SpellService.GetSpellDetailAsync(id, Lang);
        }
        else if (SpellId is null)
        {
            loaded = null;
            spell = null;
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private static string Components(SpellDetailResponseDto s)
    {
        var parts = new List<string>();
        if (s.Verbal) parts.Add("V");
        if (s.Somatic) parts.Add("S");
        if (s.Material) parts.Add(string.IsNullOrWhiteSpace(s.MaterialComponent) ? "M" : $"M ({s.MaterialComponent})");
        return parts.Count == 0 ? "—" : string.Join(", ", parts);
    }
}
