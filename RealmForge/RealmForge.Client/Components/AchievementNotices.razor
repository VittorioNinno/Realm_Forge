@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.DTOs
@using RealmForge.Shared.Enums
@implements IAsyncDisposable
@inject AchievementDataService Achievements
@inject Dice3dService Dice3d
@inject LanguageStateService LanguageState
@inject NavigationManager Navigation

@* An achievement earned (at the table, on a sheet, anywhere): a notice with the die it unlocks, wherever the person is
   in the app, gone by itself after a few seconds. Never over the virtual tabletop, where it would cover the controls in
   the middle of the game: it waits for the person to leave the table. Each one is told once, then marked as seen. *@
@if (notices.Count > 0)
{
    <div class="rf-live-notices rf-ach-notices" role="status" aria-live="polite" data-test="achievement-notices">
        @foreach (var n in notices)
        {
            var notice = n;
            var swatch = Dice3dSettings.Swatches.TryGetValue(notice.Skin, out var sw) ? sw : ("#ffb04d", "#ff8c00", "#141414");
            <div class="rf-live-notice rf-ach-notice" data-test="achievement-notice" data-key="@notice.Key">
                <span class="rf-ach-medal" style="--ach-c1: @swatch.Item1; --ach-c2: @swatch.Item2; --ach-dot: @swatch.Item3;"><Icon Name="trophy-fill" /></span>
                <div class="rf-live-notice-text">
                    <div class="rf-live-notice-title">@UiText.AchievementNoticeTitle(UiText.AchievementName(notice.Key, Lang), Lang)</div>
                    <div class="rf-live-notice-by">@UiText.AchievementNoticeDie(UiText.Dice3dSkinName(notice.Skin, Lang), Lang)</div>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <button type="button" class="btn btn-sm btn-rf-orange" @onclick="() => Open(notice)" data-test="achievement-notice-open"><Icon Name="trophy" /> @UiText.AchievementNoticeOpen(Lang)</button>
                    </div>
                </div>
                <button type="button" class="rf-live-notice-close" aria-label="@UiText.AchievementNoticeClose(Lang)" title="@UiText.AchievementNoticeClose(Lang)" @onclick="() => Dismiss(notice)" data-test="achievement-notice-close"><Icon Name="close" /></button>
            </div>
        }
    </div>
}

@code {
    private static readonly TimeSpan Every = TimeSpan.FromSeconds(60);
    private static readonly TimeSpan Shown = TimeSpan.FromSeconds(10);

    private LanguageCode Lang => LanguageState.CurrentLanguage;
    private readonly List<AchievementDto> notices = new();
    private readonly CancellationTokenSource stop = new();

    protected override void OnInitialized() => LanguageState.OnLanguageChanged += Refresh;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _ = LoopAsync();
        }
    }

    private async Task LoopAsync()
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(3), stop.Token);
            using var timer = new PeriodicTimer(Every);
            do
            {
                await InvokeAsync(CheckAsync);
            }
            while (await timer.WaitForNextTickAsync(stop.Token));
        }
        catch (OperationCanceledException)
        {
        }
    }

    private bool AtTheTable => System.Text.RegularExpressions.Regex.IsMatch(Navigation.ToBaseRelativePath(Navigation.Uri), @"^campaigns/[^/]+/vtt", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    private async Task CheckAsync()
    {
        if (AtTheTable)
        {
            return;
        }
        var news = (await Achievements.NewsAsync()).Where(a => notices.All(n => n.Key != a.Key)).ToList();
        if (news.Count == 0)
        {
            return;
        }
        notices.AddRange(news);
        StateHasChanged();
        //	Told: not again, here or in another tab; the new die is ready for the next throw
        await Achievements.SeenAsync(news.Select(a => a.Key));
        await Dice3d.UnlockedAsync(reload: true);
        _ = HideLaterAsync(news.Select(a => a.Key).ToList());
    }

    private async Task HideLaterAsync(List<string> keys)
    {
        try
        {
            await Task.Delay(Shown, stop.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        await InvokeAsync(() =>
        {
            notices.RemoveAll(n => keys.Contains(n.Key));
            StateHasChanged();
        });
    }

    private void Open(AchievementDto notice)
    {
        Dismiss(notice);
        Navigation.NavigateTo("account#achievements");
    }

    private void Dismiss(AchievementDto notice) => notices.RemoveAll(n => n.Key == notice.Key);

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    public ValueTask DisposeAsync()
    {
        stop.Cancel();
        stop.Dispose();
        LanguageState.OnLanguageChanged -= Refresh;
        return ValueTask.CompletedTask;
    }
}
