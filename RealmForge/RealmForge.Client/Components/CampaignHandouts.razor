@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.Campaigns
@using RealmForge.Shared.DTOs
@using RealmForge.Shared.Enums
@inject CampaignDataService Campaigns
@inject ImageDataService Images
@inject LanguageStateService LanguageState

@* The handouts of a campaign: the masters write them (Italian and English, a picture) and reveal them to the players
   during a session; the players find here the ones they were shown. Compact: the drawer of the table *@
<section class="rf-ho @(Compact ? "compact" : "page")" data-test="campaign-handouts">
    <header class="rf-ho-head">
        <span class="rf-ho-kicker">@UiText.CampaignTabHandouts(Lang)</span>
        <span class="rf-ho-count" data-test="handouts-count">@(handouts?.Count ?? 0)</span>
    </header>
    @if (!Compact)
    {
        <p class="rf-ho-intro">@(Runs ? UiText.HandoutsHintMaster(Lang) : UiText.HandoutsHintPlayer(Lang))</p>
    }

    @if (Runs && draft is not null)
    {
        @* Writing one: a language at a time (a dot where something is written), the riddle folded, the picture *@
        <div class="rf-ho-form" data-test="handout-form">
            <div class="rf-ho-langbar">
                <div class="rf-ho-seg" role="tablist" aria-label="@UiText.HandoutLanguage(Lang)">
                    <button type="button" role="tab" class="@(langTab == "it" ? "active" : null)" aria-selected="@(langTab == "it" ? "true" : "false")" @onclick="@(() => langTab = "it")" data-test="handout-tab-it">
                        <span>Italiano (IT)</span><span class="rf-ho-dot @(Written(draft.TitleIt, draft.BodyIt) ? "filled" : null)"></span>
                    </button>
                    <button type="button" role="tab" class="@(langTab == "en" ? "active" : null)" aria-selected="@(langTab == "en" ? "true" : "false")" @onclick="@(() => langTab = "en")" data-test="handout-tab-en">
                        <span>English (EN)</span><span class="rf-ho-dot @(Written(draft.TitleEn, draft.BodyEn) ? "filled" : null)"></span>
                    </button>
                </div>
                <span class="rf-ho-note">@UiText.HandoutLanguagesHint(Lang)</span>
            </div>
            <div class="rf-ho-fields" hidden="@(langTab != "it")">
                <label class="rf-ho-field">
                    <span class="rf-ho-label">@UiText.HandoutTitle(Lang) · IT</span>
                    <input class="rf-form-control rf-ho-input" maxlength="120" placeholder="@UiText.HandoutTitlePlaceholder(Lang)" @bind="draft.TitleIt" @bind:event="oninput" data-test="handout-title-it" />
                </label>
                <label class="rf-ho-field">
                    <span class="rf-ho-label-row"><span class="rf-ho-label">@UiText.HandoutBody(Lang) · IT</span><span class="rf-ho-md">**grassetto**, *corsivo*</span></span>
                    <textarea class="rf-form-control" rows="@(Compact ? 5 : 8)" maxlength="8000" placeholder="@UiText.HandoutBodyPlaceholder(Lang)" @bind="draft.BodyIt" @bind:event="oninput" data-test="handout-body-it"></textarea>
                </label>
            </div>
            <div class="rf-ho-fields" hidden="@(langTab != "en")">
                <label class="rf-ho-field">
                    <span class="rf-ho-label">@UiText.HandoutTitle(Lang) · EN</span>
                    <input class="rf-form-control rf-ho-input" maxlength="120" placeholder="e.g. The burgomaster's sealed letter" @bind="draft.TitleEn" @bind:event="oninput" data-test="handout-title-en" />
                </label>
                <label class="rf-ho-field">
                    <span class="rf-ho-label-row"><span class="rf-ho-label">@UiText.HandoutBody(Lang) · EN</span><span class="rf-ho-md">**bold**, *italic*</span></span>
                    <textarea class="rf-form-control" rows="@(Compact ? 5 : 8)" maxlength="8000" placeholder="Write the content of the handout…" @bind="draft.BodyEn" @bind:event="oninput" data-test="handout-body-en"></textarea>
                </label>
            </div>
            <RiddleLab CampaignId="CampaignId" Draft="draft" OnChanged="StateHasChanged" />
            <div class="rf-ho-field">
                <span class="rf-ho-label">@UiText.HandoutImage(Lang)</span>
                <ImagePicker Selected="draft.ImageId" Name="@(draft.TitleIt.Length > 0 ? draft.TitleIt : draft.TitleEn)" OnPick="id => draft!.ImageId = id" />
            </div>
            @if (error is not null)
            {
                <div class="small text-warning" role="alert">@error</div>
            }
            <footer class="rf-ho-footer">
                <button type="button" class="rf-ho-btn" @onclick="() => draft = null" data-test="handout-cancel">@UiText.BtnCancel(Lang)</button>
                <button type="button" class="rf-ho-btn primary" disabled="@busy" @onclick="SaveAsync" data-test="handout-save">@UiText.BtnConfirm(Lang)</button>
            </footer>
        </div>
    }
    else
    {
        @if (Runs)
        {
            <button type="button" class="rf-ho-new" @onclick="New" data-test="handout-new"><Icon Name="plus" /> @UiText.HandoutNew(Lang)</button>
        }
        @if (handouts is null)
        {
            <div class="small" style="color: var(--rf-text-muted);">…</div>
        }
        else if (handouts.Count == 0)
        {
            <div class="rf-ho-empty" data-test="handouts-empty">
                <Icon Name="file-text" />
                <p>@(Runs ? UiText.HandoutsEmptyMaster(Lang) : UiText.HandoutsEmptyPlayer(Lang))</p>
                @if (Runs)
                {
                    <span>@UiText.HandoutsEmptyHint(Lang)</span>
                }
            </div>
        }
        else
        {
            <div class="rf-ho-list">
                @foreach (var h in handouts)
                {
                    var handout = h;
                    <article class="rf-ho-card @(handout.RevealedAt is null ? "hidden" : "shown") @(handout.IsScene ? "scene" : null)" data-test="handout-row">
                        <button type="button" class="rf-ho-open" @onclick="() => reading = handout" data-test="handout-open">
                            @if (handout.ImageId is { } image)
                            {
                                <img src="@Images.FileUrl(image)" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="rf-ho-thumb"><Icon Name="file-text" /></span>
                            }
                            <span class="rf-ho-card-text">
                                <strong>@handout.Title</strong>
                                <span class="rf-ho-meta">
                                    <span class="rf-ho-state @(handout.RevealedAt is null ? null : "on")">@(handout.RevealedAt is { } at ? UiText.HandoutRevealedAt(at, Lang) : UiText.HandoutHidden(Lang))</span>
                                    @if (handout.Puzzle)
                                    {
                                        <span class="rf-riddle-badge @(handout.SolvedAt is null ? null : "solved")" data-test="handout-puzzle"><Icon Name="@(handout.SolvedAt is null ? "puzzle" : "unlock")" /> @(handout.SolvedAt is null ? UiText.HandoutPuzzle(Lang) : UiText.HandoutSolved(Lang))</span>
                                    }
                                </span>
                            </span>
                        </button>
                        @if (Runs)
                        {
                            <div class="rf-ho-actions">
                                <button type="button" class="rf-ho-show @(handout.RevealedAt is null ? "primary" : null)" disabled="@busy" @onclick="() => RevealAsync(handout, true)" data-test="handout-reveal">
                                    <Icon Name="eye" /> @(handout.RevealedAt is null ? UiText.HandoutReveal(Lang) : UiText.HandoutRevealAgain(Lang))
                                </button>
                                @if (handout.RevealedAt is not null)
                                {
                                    <button type="button" class="rf-vtt-row-action" disabled="@busy" title="@UiText.HandoutHide(Lang)" aria-label="@UiText.HandoutHide(Lang)" @onclick="() => RevealAsync(handout, false)" data-test="handout-hide"><Icon Name="eye-slash" /></button>
                                }
                                <button type="button" class="rf-vtt-row-action @(handout.IsScene ? "on" : null)" disabled="@busy" title="@(handout.IsScene ? UiText.SceneEnd(Lang) : UiText.SceneShow(Lang))"
                                        aria-label="@(handout.IsScene ? UiText.SceneEnd(Lang) : UiText.SceneShow(Lang))" aria-pressed="@(handout.IsScene ? "true" : "false")" @onclick="() => SceneAsync(handout)" data-test="handout-scene"><Icon Name="images" /></button>
                                <button type="button" class="rf-vtt-row-action" title="@UiText.Edit(Lang)" aria-label="@UiText.Edit(Lang)" @onclick="() => Edit(handout)" data-test="handout-edit"><Icon Name="pencil" /></button>
                                <button type="button" class="rf-vtt-row-action" disabled="@busy" title="@UiText.BtnRemove(Lang)" aria-label="@UiText.BtnRemove(Lang)" @onclick="() => DeleteAsync(handout)" data-test="handout-delete"><Icon Name="trash" /></button>
                            </div>
                        }
                    </article>
                }
            </div>
        }
    }
</section>

@if (reading is not null)
{
    <HandoutView Handout="reading" CampaignId="CampaignId" OnClose="() => reading = null" OnSolved="LoadAsync" />
}

@code {
    [Parameter, EditorRequired] public Guid CampaignId { get; set; }
    [Parameter] public CampaignRole Role { get; set; } = CampaignRole.Player;
    [Parameter] public bool Compact { get; set; }

    //	Something changed that the table shows (the scene)
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<CampaignHandoutDto>? handouts;
    private SaveCampaignHandoutDto? draft;
    private Guid? editingId;
    private CampaignHandoutDto? reading;
    private bool busy;
    private string? error;
    private string langTab = "it";

    private static bool Written(string? title, string? body) => !string.IsNullOrWhiteSpace(title) || !string.IsNullOrWhiteSpace(body);

    private LanguageCode Lang => LanguageState.CurrentLanguage;
    private bool Runs => CampaignRules.RunsTheTable(Role);

    protected override async Task OnParametersSetAsync()
    {
        if (handouts is null)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync() => handouts = await Campaigns.GetHandoutsAsync(CampaignId, Lang) ?? new();

    private void New()
    {
        langTab = Lang == LanguageCode.En ? "en" : "it";
        draft = new SaveCampaignHandoutDto();
        editingId = null;
        error = null;
    }

    private void Edit(CampaignHandoutDto h)
    {
        draft = new SaveCampaignHandoutDto { TitleIt = h.TitleIt ?? string.Empty, TitleEn = h.TitleEn ?? string.Empty, BodyIt = h.BodyIt ?? string.Empty, BodyEn = h.BodyEn ?? string.Empty, ImageId = h.ImageId, PuzzleAnswer = h.PuzzleAnswer, PuzzleDoorId = h.PuzzleDoorId };
        editingId = h.Id;
        langTab = Written(h.TitleIt, h.BodyIt) || !Written(h.TitleEn, h.BodyEn) ? "it" : "en";
        error = null;
    }

    private async Task SaveAsync()
    {
        if (draft is null)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(draft.TitleIt) && string.IsNullOrWhiteSpace(draft.TitleEn))
        {
            error = UiText.HandoutNeedsTitle(Lang);
            return;
        }
        busy = true;
        var ok = editingId is { } id
            ? (await Campaigns.UpdateHandoutAsync(CampaignId, id, draft)).Ok
            : (await Campaigns.AddHandoutAsync(CampaignId, draft, Lang)).Value is not null;
        busy = false;
        if (!ok)
        {
            error = UiText.MapSaveFailed(Lang);
            return;
        }
        draft = null;
        await LoadAsync();
    }

    private async Task RevealAsync(CampaignHandoutDto h, bool reveal)
    {
        busy = true;
        await Campaigns.RevealHandoutAsync(CampaignId, h.Id, reveal);
        busy = false;
        await LoadAsync();
    }

    //	The handout in place of the map for the whole table (again: back to the map)
    private async Task SceneAsync(CampaignHandoutDto h)
    {
        busy = true;
        if (h.IsScene)
        {
            await Campaigns.EndSceneAsync(CampaignId);
        }
        else
        {
            await Campaigns.ShowSceneAsync(CampaignId, h.Id);
        }
        busy = false;
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task DeleteAsync(CampaignHandoutDto h)
    {
        busy = true;
        await Campaigns.DeleteHandoutAsync(CampaignId, h.Id);
        busy = false;
        await LoadAsync();
    }
}
