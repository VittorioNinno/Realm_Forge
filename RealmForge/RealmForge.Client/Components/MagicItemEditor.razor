@using System.Text.Json
@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.Characters
@using RealmForge.Shared.Enums
@using RealmForge.Shared.Localization
@using RealmForge.Shared.Rules
@inject LanguageStateService LanguageState

@* Magic properties of an inventory item: a ready-made SRD item or a custom one (rarity, attunement, effects that
   the sheet applies on its own, charges and how they come back, healing for potions) *@
<div class="rf-modal-backdrop" @onclick="Cancel">
    <div class="rf-modal-dialog rf-magic-editor" @onclick:stopPropagation="true" data-test="magic-editor">
        <h2 class="h5 mb-3" style="color: var(--rf-orange-primary); font-family: var(--rf-font-display);">
            @(IsNew ? UiText.MagicNewTitle(Lang) : UiText.MagicEditTitle(ItemName ?? string.Empty, Lang))
        </h2>

        <div class="rf-magic-field">
            <label class="rf-mini-label" for="magic-template">@UiText.MagicTemplate(Lang)</label>
            <select id="magic-template" class="rf-wizard-input" value="@(draft.Template ?? string.Empty)" @onchange="ApplyTemplate" data-test="magic-template">
                <option value="">@UiText.MagicCustom(Lang)</option>
                @foreach (var template in Templates)
                {
                    <option value="@template.Key">@template.Name(Lang)</option>
                }
            </select>
            @if (MagicItemCatalog.Find(draft.Template) is { } chosen)
            {
                <div class="small mt-1" style="color: var(--rf-text-secondary);">@chosen.Summary(Lang)</div>
            }
        </div>

        @if (IsNew)
        {
            <div class="rf-magic-field">
                <label class="rf-mini-label" for="magic-name">@UiText.MagicName(Lang)</label>
                <input id="magic-name" class="rf-wizard-input" maxlength="150" value="@name" @onchange="e => name = e.Value?.ToString() ?? string.Empty" data-test="magic-name" />
            </div>
        }

        <div class="rf-magic-grid">
            <div class="rf-magic-field">
                <label class="rf-mini-label" for="magic-rarity">@UiText.MagicRarity(Lang)</label>
                <select id="magic-rarity" class="rf-wizard-input" value="@((int)draft.Rarity)" @onchange="e => draft.Rarity = (ItemRarity)ToInt(e, 2)">
                    @foreach (var rarity in Enum.GetValues<ItemRarity>())
                    {
                        <option value="@((int)rarity)">@UiText.RarityName(rarity, Lang)</option>
                    }
                </select>
            </div>
            <div class="rf-magic-field">
                <span class="rf-mini-label">@UiText.SheetAttuned(Lang)</span>
                <button type="button" class="rf-toggle @(draft.RequiresAttunement ? "on" : null)" aria-pressed="@draft.RequiresAttunement"
                        @onclick="() => draft.RequiresAttunement = !draft.RequiresAttunement" data-test="magic-attunement">
                    <span class="rf-toggle-track"><span class="rf-toggle-thumb"></span></span>
                    <span>@UiText.MagicRequiresAttunement(Lang)</span>
                </button>
            </div>
        </div>

        <div class="rf-mini-title">@UiText.MagicEffects(Lang)</div>
        @foreach (var effect in draft.Effects.ToList())
        {
            var e = effect;
            <div class="rf-magic-effect" data-test="magic-effect">
                <select class="rf-wizard-input" value="@((int)e.Kind)" @onchange="ev => e.Kind = (MagicEffectKind)ToInt(ev, 1)" aria-label="@UiText.MagicEffects(Lang)">
                    @foreach (var kind in Enum.GetValues<MagicEffectKind>())
                    {
                        <option value="@((int)kind)">@UiText.MagicEffectName(kind, Lang)</option>
                    }
                </select>
                @if (e.Kind is MagicEffectKind.SetAbilityScore or MagicEffectKind.AbilityScoreBonus)
                {
                    <select class="rf-wizard-input" value="@((int)(e.Ability ?? AbilityScore.Strength))" @onchange="ev => e.Ability = (AbilityScore)ToInt(ev, 1)">
                        @foreach (var ability in CharacterMath.Abilities)
                        {
                            <option value="@((int)ability)">@FeatPrerequisiteFormatter.AbilityName(ability, Lang)</option>
                        }
                    </select>
                }
                @if (e.Kind == MagicEffectKind.Resistance)
                {
                    <select class="rf-wizard-input" value="@((int)(e.DamageType ?? DamageType.Fire))" @onchange="ev => e.DamageType = (DamageType)ToInt(ev, 1)">
                        @foreach (var type in Enum.GetValues<DamageType>())
                        {
                            <option value="@((int)type)">@EquipmentTerms.DamageTypeName(type, Lang)</option>
                        }
                    </select>
                }
                else
                {
                    <NumberStepper Value="e.Value" ValueChanged="v => e.Value = v" Min="-30" Max="30" AriaLabel="@UiText.MagicValue(Lang)" />
                }
                <button type="button" class="rf-mini-btn" @onclick="() => draft.Effects.Remove(e)" aria-label="@UiText.BtnRemove(Lang)">✕</button>
            </div>
        }
        <button type="button" class="rf-tool-btn mb-2" @onclick="AddEffect" data-test="magic-add-effect">+ @UiText.MagicAddEffect(Lang)</button>

        <div class="rf-mini-title">@UiText.MagicCharges(Lang)</div>
        <div class="rf-magic-grid">
            <div class="rf-magic-field">
                <span class="rf-mini-label">@UiText.MagicChargesMax(Lang)</span>
                <NumberStepper Value="draft.Charges" ValueChanged="v => { draft.Charges = v; draft.ChargesUsed = Math.Min(draft.ChargesUsed, v); }" Min="0" Max="99" AriaLabel="@UiText.MagicChargesMax(Lang)" InputTest="magic-charges" />
            </div>
            @if (draft.Charges > 0)
            {
                <div class="rf-magic-field">
                    <label class="rf-mini-label" for="magic-recharge">@UiText.MagicRecharge(Lang)</label>
                    <select id="magic-recharge" class="rf-wizard-input" value="@((int)draft.Recharge)" @onchange="e => draft.Recharge = (ItemRecharge)ToInt(e, 0)">
                        @foreach (var recharge in Enum.GetValues<ItemRecharge>())
                        {
                            <option value="@((int)recharge)">@UiText.RechargeName(recharge, Lang)</option>
                        }
                    </select>
                </div>
                <div class="rf-magic-field">
                    <label class="rf-mini-label" for="magic-recharge-dice">@UiText.MagicRechargeDice(Lang)</label>
                    <input id="magic-recharge-dice" class="rf-wizard-input" maxlength="10" placeholder="1d6+1" value="@draft.RechargeDice" @onchange="e => draft.RechargeDice = Dice(e.Value?.ToString())" />
                </div>
            }
        </div>

        <div class="rf-magic-field">
            <label class="rf-mini-label" for="magic-heal">@UiText.MagicHealDice(Lang)</label>
            <input id="magic-heal" class="rf-wizard-input" maxlength="10" placeholder="2d4+2" value="@draft.HealDice" @onchange="e => draft.HealDice = Dice(e.Value?.ToString())" data-test="magic-heal" />
        </div>

        @if (error is not null)
        {
            <div class="rf-cast-warning mt-2">@error</div>
        }

        <div class="d-flex flex-wrap justify-content-end gap-2 mt-3">
            @if (!IsNew && Initial is not null)
            {
                <button type="button" class="btn btn-rf-outline me-auto" @onclick="RemoveMagic" data-test="magic-remove">@UiText.MagicRemove(Lang)</button>
            }
            <button type="button" class="btn btn-rf-outline" @onclick="Cancel">@UiText.BtnCancel(Lang)</button>
            <button type="button" class="btn btn-rf-orange" @onclick="Save" data-test="magic-save">@UiText.BtnConfirm(Lang)</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public string? ItemName { get; set; }

    //	Weapon, armor or shield from the compendium; null for a free item (wondrous items, rings, wands, potions)
    [Parameter] public MagicTemplateKind? Kind { get; set; }
    [Parameter] public MagicItemProperties? Initial { get; set; }
    [Parameter] public EventCallback<(string? Name, MagicItemProperties? Magic)> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private MagicItemProperties draft = new();
    private string name = string.Empty;
    private string? error;

    private LanguageCode Lang => LanguageState.CurrentLanguage;

    private IEnumerable<MagicItemTemplate> Templates => Kind is { } kind
        ? MagicItemCatalog.OfKind(kind)
        : MagicItemCatalog.All.Where(t => t.Kind is MagicTemplateKind.Wondrous or MagicTemplateKind.Potion);

    protected override void OnInitialized()
    {
        draft = Initial is null ? new MagicItemProperties() : JsonSerializer.Deserialize<MagicItemProperties>(JsonSerializer.Serialize(Initial))!;
        name = ItemName ?? string.Empty;
    }

    private void ApplyTemplate(ChangeEventArgs e)
    {
        var template = MagicItemCatalog.Find(e.Value?.ToString());
        if (template is null)
        {
            draft.Template = null;
            return;
        }
        var used = Math.Min(draft.ChargesUsed, template.Charges);
        draft = template.Create();
        draft.ChargesUsed = used;
        if (IsNew)
        {
            name = template.Name(Lang);
        }
    }

    private void AddEffect() => draft.Effects.Add(new MagicEffect { Kind = Kind == MagicTemplateKind.Weapon ? MagicEffectKind.AttackAndDamage : MagicEffectKind.ArmorClass, Value = 1 });

    private static string? Dice(string? value)
    {
        var text = value?.Replace(" ", string.Empty).Replace('−', '-').ToLowerInvariant();
        return string.IsNullOrEmpty(text) ? null : System.Text.RegularExpressions.Regex.IsMatch(text, @"^\d{1,2}d\d{1,3}([+-]\d{1,3})?$") ? text : null;
    }

    private Task Save()
    {
        if (IsNew && string.IsNullOrWhiteSpace(name))
        {
            error = UiText.MagicNameMissing(Lang);
            return Task.CompletedTask;
        }
        return OnSave.InvokeAsync((IsNew ? name.Trim() : null, draft));
    }

    private Task RemoveMagic() => OnSave.InvokeAsync((null, null));

    private Task Cancel() => OnCancel.InvokeAsync();

    private static int ToInt(ChangeEventArgs e, int fallback) => int.TryParse(e.Value?.ToString(), out var value) ? value : fallback;
}
