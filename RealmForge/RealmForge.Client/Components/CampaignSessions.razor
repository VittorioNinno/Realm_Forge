@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.Campaigns
@using RealmForge.Shared.DTOs
@using RealmForge.Shared.Enums
@inject CampaignDataService Campaigns
@inject LanguageStateService LanguageState
@inject IJSRuntime JS

@* Sessions of a campaign: the next one on top with its date and plan, then the played ones with their recap; masters
   and co-masters write them and keep their notes behind the screen *@
<section class="rf-ses" data-test="campaign-sessions">
    <header class="rf-ses-top">
        <div class="rf-ses-top-text">
            <span class="rf-ov-kicker">@UiText.SessionsKicker(Lang)</span>
            <p class="rf-ses-intro">@UiText.SessionsHint(Manage, Lang)</p>
        </div>
        @if (Manage && editing is null)
        {
            <button type="button" class="btn btn-rf-orange rf-ses-new" @onclick="NewSession" data-test="session-new"><Icon Name="plus" /> @UiText.BtnNewSession(Lang)</button>
        }
    </header>

    @if (editing is not null)
    {
        <div class="rf-ses-editor" data-test="session-form">
            <div class="rf-ses-editor-head">
                <span class="rf-ov-kicker">@(editing == Guid.Empty ? UiText.BtnNewSession(Lang) : UiText.SessionNumber(editingNumber, Lang))</span>
                <button type="button" class="rf-ses-close" title="@UiText.BtnCancel(Lang)" aria-label="@UiText.BtnCancel(Lang)" @onclick="() => editing = null"><Icon Name="close" /></button>
            </div>
            <div class="rf-ses-meta">
                <label class="rf-ses-field">
                    <span class="rf-ses-label">@UiText.SessionTitle(Lang)</span>
                    <input class="rf-form-control" maxlength="120" placeholder="@UiText.SessionTitlePlaceholder(Lang)" @bind="draft.Title" data-test="session-title" />
                </label>
                <label class="rf-ses-field">
                    <span class="rf-ses-label">@UiText.SessionWhen(Lang)</span>
                    <input class="rf-form-control" type="datetime-local" value="@WhenText" @onchange="e => WhenText = e.Value?.ToString()" data-test="session-when" />
                </label>
                <div class="rf-ses-field" data-test="session-status">
                    <span class="rf-ses-label">@UiText.SessionStatusLabel(Lang)</span>
                    <RfSelect TValue="CampaignSessionStatus" Value="draft.Status" ValueChanged="SetStatus" Options="StatusOptions" />
                </div>
            </div>
            <div class="rf-ses-split">
                <div class="rf-ses-pane">
                    <div class="rf-ses-pane-head">
                        <div class="rf-ses-tabs" role="tablist">
                            <button type="button" role="tab" aria-selected="@(!recapTab)" class="@(!recapTab ? "on" : null)" @onclick="() => recapTab = false" data-test="session-tab-plan">@UiText.SessionPlan(Lang) <i class="@(string.IsNullOrWhiteSpace(draft.Plan) ? null : "on")"></i></button>
                            <button type="button" role="tab" aria-selected="@recapTab" class="@(recapTab ? "on" : null)" @onclick="() => recapTab = true" data-test="session-tab-recap">@UiText.SessionRecap(Lang) <i class="@(string.IsNullOrWhiteSpace(draft.Recap) ? null : "on")"></i></button>
                        </div>
                        <span class="rf-ses-tag public">@UiText.SessionVisibleAll(Lang)</span>
                    </div>
                    <textarea class="rf-form-control rf-ses-text" rows="6" maxlength="8000" placeholder="@UiText.SessionPlanHint(Lang)" @bind="draft.Plan" @bind:event="oninput" hidden="@recapTab" data-test="session-plan"></textarea>
                    <textarea class="rf-form-control rf-ses-text" rows="6" maxlength="8000" placeholder="@UiText.SessionRecapHint(Lang)" @bind="draft.Recap" @bind:event="oninput" hidden="@(!recapTab)" data-test="session-recap"></textarea>
                </div>
                <div class="rf-ses-pane secret">
                    <div class="rf-ses-pane-head">
                        <span class="rf-ses-label"><Icon Name="eye-slash" /> @UiText.SessionMasterNotes(Lang)</span>
                        <span class="rf-ses-tag private">@UiText.SessionMastersOnly(Lang)</span>
                    </div>
                    <textarea class="rf-form-control rf-ses-text" rows="6" maxlength="8000" placeholder="@UiText.SessionMasterNotesHint(Lang)" @bind="draft.MasterNotes" data-test="session-master-notes"></textarea>
                </div>
            </div>
            @if (error is not null)
            {
                <div class="small text-warning rf-ses-error">@error</div>
            }
            <footer class="rf-ses-editor-foot">
                <span class="rf-ses-hint">@UiText.SessionRecapLater(Lang)</span>
                <span class="d-flex gap-2">
                    <button type="button" class="btn btn-rf-outline" @onclick="() => editing = null">@UiText.BtnCancel(Lang)</button>
                    <button type="button" class="btn btn-rf-orange" disabled="@saving" @onclick="SaveAsync" data-test="session-save">@UiText.BtnConfirm(Lang)</button>
                </span>
            </footer>
        </div>
    }

    <div class="rf-ses-list-head">
        <span class="rf-ov-kicker">@UiText.SessionsHistory(sessions?.Count ?? 0, Lang)</span>
        <div class="rf-ses-filters" role="tablist">
            @foreach (var f in new[] { "all", "planned", "played" })
            {
                var key = f;
                <button type="button" role="tab" aria-selected="@(filter == key)" class="rf-ses-filter @(filter == key ? "on" : null)" @onclick="() => filter = key" data-test="session-filter" data-filter="@key">@UiText.SessionFilter(key, Lang)</button>
            }
        </div>
    </div>

    @if (sessions is null)
    {
        <div class="rf-ses-empty">…</div>
    }
    else if (sessions.Count == 0 || !Shown.Any())
    {
        <div class="rf-ses-empty" data-test="sessions-empty">
            <Icon Name="calendar-event" />
            <strong>@(sessions.Count == 0 ? UiText.SessionsEmpty(Lang) : UiText.SessionsNoneHere(Lang))</strong>
            @if (Manage && sessions.Count == 0)
            {
                <span>@UiText.SessionsEmptyHint(Lang)</span>
            }
        </div>
    }
    else
    {
        <div class="rf-ses-list">
        @foreach (var session in Shown)
        {
            var s = session;
            var isNext = s.Id == Next?.Id;
            <article class="rf-ses-card @(isNext ? "next" : null) @StatusClass(s.Status)" data-test="session" data-status="@s.Status.ToString().ToLowerInvariant()">
                <span class="rf-ses-num">#@s.Number</span>
                <div class="rf-ses-main">
                    <div class="rf-ses-title-row">
                        <h4 data-test="session-title-text">@(string.IsNullOrWhiteSpace(s.Title) ? UiText.SessionNumber(s.Number, Lang) : s.Title)</h4>
                        <span class="rf-ses-status @(isNext ? "next" : StatusClass(s.Status))">@(isNext ? UiText.SessionNext(Lang) : UiText.SessionStatusName(s.Status, Lang))</span>
                        <span class="rf-ses-date" data-test="session-when-text">
                            @if (s.ScheduledAt is { } at)
                            {
                                @UiText.FormatDateTime(at, Lang)
                                @if (s.Status == CampaignSessionStatus.Planned && UiText.SessionCountdown(at, Lang) is { Length: > 0 } countdown)
                                {
                                    <span class="rf-session-countdown">&nbsp;· @countdown</span>
                                }
                            }
                            else
                            {
                                @UiText.SessionNoDate(Lang)
                            }
                        </span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(s.Plan) && s.Status != CampaignSessionStatus.Played)
                    {
                        <div class="rf-ses-block">
                            <span class="rf-ses-label">@UiText.SessionPlan(Lang)</span>
                            <div class="rf-markdown-container" data-test="session-plan-text">@((MarkupString)MarkdownText.ToHtml(s.Plan, null))</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(s.Recap))
                    {
                        <div class="rf-ses-block">
                            <span class="rf-ses-label">@UiText.SessionRecap(Lang)</span>
                            <div class="rf-markdown-container" data-test="session-recap-text">@((MarkupString)MarkdownText.ToHtml(s.Recap, null))</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(s.MasterNotes))
                    {
                        <details class="rf-ses-secret" open>
                            <summary><Icon Name="eye-slash" /> @UiText.SessionMasterNotes(Lang)</summary>
                            <div class="rf-markdown-container" data-test="session-master-notes-text">@((MarkupString)MarkdownText.ToHtml(s.MasterNotes, null))</div>
                        </details>
                    }
                    <span class="rf-ses-by">@UiText.SessionUpdatedBy(s.UpdatedBy, s.UpdatedAt, Lang)</span>
                </div>
                <div class="rf-ses-actions">
                    <button type="button" class="rf-ses-icon" disabled="@(exporting == s.Id)" title="@UiText.ExportSessionHint(Lang)" aria-label="@UiText.ExportLog(Lang)" @onclick="() => ExportAsync(s)" data-test="session-export"><Icon Name="download" /></button>
                    @if (s.CanEdit)
                    {
                        <button type="button" class="rf-ses-icon" title="@UiText.Edit(Lang)" aria-label="@UiText.Edit(Lang)" @onclick="() => Edit(s)" data-test="session-edit"><Icon Name="pencil" /></button>
                        <button type="button" class="rf-ses-icon danger" title="@UiText.BtnRemove(Lang)" aria-label="@UiText.BtnRemove(Lang)" @onclick="() => removing = s" data-test="session-delete"><Icon Name="close" /></button>
                    }
                </div>
            </article>
        }
        </div>
    }
</section>

@if (removing is not null)
{
    <div class="rf-modal-backdrop" @onclick="() => removing = null">
        <div class="rf-modal-dialog" style="max-width: 440px;" @onclick:stopPropagation="true" data-test="session-delete-confirm">
            <h2 class="h4 mb-3 pb-2" style="border-bottom: 1px solid var(--rf-border-light); font-family: var(--rf-font-display);">@UiText.SessionNumber(removing.Number, Lang)</h2>
            <p class="mb-3">@UiText.SessionDeleteConfirm(Lang)</p>
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-sm btn-rf-outline" @onclick="() => removing = null">@UiText.BtnCancel(Lang)</button>
                <button type="button" class="btn btn-sm btn-rf-orange" @onclick="DeleteAsync" data-test="session-delete-yes">@UiText.BtnRemove(Lang)</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid CampaignId { get; set; }
    [Parameter] public CampaignRole Role { get; set; } = CampaignRole.Player;
    [Parameter] public string CampaignName { get; set; } = string.Empty;

    //	The session whose log is being exported
    private Guid? exporting;

    //	The log of a session as Markdown: the session and the rolls of its day
    private async Task ExportAsync(CampaignSessionDto session)
    {
        exporting = session.Id;
        var window = SessionLogExport.WindowOf(session);
        var rolls = window is { } w ? await Campaigns.GetAllRollsAsync(CampaignId, w.From, w.To) ?? new() : new List<CampaignRollDto>();
        var text = SessionLogExport.Markdown(CampaignName, session, rolls, Lang);
        await SaveFileAsync(SessionLogExport.FileName(CampaignName, UiText.ExportSession(session.Number, Lang), "md"), "text/markdown", text);
        exporting = null;
    }

    //	A text file saved by the browser
    private async Task SaveFileAsync(string name, string mime, string text)
    {
        var bytes = System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(text)).ToArray();
        await JS.InvokeVoidAsync("rfDownloadFile", name, mime, Convert.ToBase64String(bytes));
    }

    //	Tells the campaign page that the sessions changed (the next session shown in the overview)
    [Parameter] public EventCallback<List<CampaignSessionDto>> OnChanged { get; set; }

    private LanguageCode Lang => LanguageState.CurrentLanguage;
    private bool Manage => SessionRules.CanManageSessions(Role);
    private List<CampaignSessionDto>? sessions;

    //	Session being written: Guid.Empty for a new one, null when the form is closed
    private Guid? editing;
    private int editingNumber;
    private SaveCampaignSessionDto draft = new();
    private DateTime? when;

    //	The browser gives and takes "2026-11-14T21:00" whatever the language: parsed by hand, not with the culture
    private const string WhenFormat = "yyyy-MM-dd'T'HH':'mm";

    private string? WhenText
    {
        get => when?.ToString(WhenFormat, System.Globalization.CultureInfo.InvariantCulture);
        set => when = DateTime.TryParseExact(value?.Length > 16 ? value[..16] : value, WhenFormat, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var parsed) ? parsed : null;
    }
    private string? error;
    private bool saving;
    private CampaignSessionDto? removing;

    private CampaignSessionDto? Next => NextSession(sessions);

    private List<RfSelect<CampaignSessionStatus>.OptionItem> StatusOptions => Enum.GetValues<CampaignSessionStatus>()
        .Select(s => new RfSelect<CampaignSessionStatus>.OptionItem(s, UiText.SessionStatusName(s, Lang)))
        .ToList();

    //	The next session first, then the newest
    private IEnumerable<CampaignSessionDto> Ordered => (sessions ?? new())
        .OrderBy(s => s.Id == Next?.Id ? 0 : 1)
        .ThenByDescending(s => s.Number);

    ///	<summary>
    ///	The first planned session that is not over yet (by date; the ones without a date after the dated ones).
    ///	</summary>
    public static CampaignSessionDto? NextSession(IEnumerable<CampaignSessionDto>? sessions) => sessions?
        .Where(s => s.Status == CampaignSessionStatus.Planned && (s.ScheduledAt is null || s.ScheduledAt.Value.AddHours(12) >= DateTimeOffset.UtcNow))
        .OrderBy(s => s.ScheduledAt is null ? 1 : 0)
        .ThenBy(s => s.ScheduledAt)
        .ThenBy(s => s.Number)
        .FirstOrDefault();

    private bool recapTab;
    private string filter = "all";

    private IEnumerable<CampaignSessionDto> Shown => Ordered.Where(s => filter switch
    {
        "planned" => s.Status == CampaignSessionStatus.Planned,
        "played" => s.Status == CampaignSessionStatus.Played,
        _ => true
    });

    //	A session marked as played opens on its recap
    private void SetStatus(CampaignSessionStatus status)
    {
        draft.Status = status;
        if (status == CampaignSessionStatus.Played)
        {
            recapTab = true;
        }
    }

    private static string StatusClass(CampaignSessionStatus status) => status switch
    {
        CampaignSessionStatus.Played => "played",
        CampaignSessionStatus.Cancelled => "cancelled",
        _ => "planned"
    };

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        sessions = await Campaigns.GetSessionsAsync(CampaignId) ?? new List<CampaignSessionDto>();
        await OnChanged.InvokeAsync(sessions);
    }

    private void NewSession()
    {
        draft = new SaveCampaignSessionDto();
        recapTab = false;
        //	A week after the last dated session, at the same time: the usual rhythm of a table
        var last = sessions?.Where(s => s.ScheduledAt is not null).MaxBy(s => s.ScheduledAt);
        when = last?.ScheduledAt is { } previous ? previous.ToLocalTime().AddDays(7).DateTime : null;
        error = null;
        editing = Guid.Empty;
        editingNumber = (sessions?.Select(s => s.Number).DefaultIfEmpty(0).Max() ?? 0) + 1;
    }

    private void Edit(CampaignSessionDto session)
    {
        draft = new SaveCampaignSessionDto
        {
            Title = session.Title,
            Status = session.Status,
            Plan = session.Plan,
            Recap = session.Recap,
            MasterNotes = session.MasterNotes ?? string.Empty
        };
        when = session.ScheduledAt?.ToLocalTime().DateTime;
        error = null;
        editing = session.Id;
        editingNumber = session.Number;
    }

    private async Task SaveAsync()
    {
        saving = true;
        draft.ScheduledAt = when is { } local
            ? new DateTimeOffset(DateTime.SpecifyKind(local, DateTimeKind.Unspecified), TimeZoneInfo.Local.GetUtcOffset(local))
            : null;
        var result = await Campaigns.SaveSessionAsync(CampaignId, editing is { } id && id != Guid.Empty ? id : null, draft);
        saving = false;
        if (!result.Ok)
        {
            error = UiText.CampaignActionFailed(result.Status, Lang);
            return;
        }
        editing = null;
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (removing is { } session && (await Campaigns.DeleteSessionAsync(CampaignId, session.Id)).Ok)
        {
            removing = null;
            await LoadAsync();
        }
    }
}
