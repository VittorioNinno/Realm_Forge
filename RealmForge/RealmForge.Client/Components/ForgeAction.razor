@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@implements IDisposable
@inject AuthService Auth
@inject LanguageStateService LanguageState
@inject CrossTabService CrossTab

@* Create button of the compendium pages: sign in first, then confirm the e-mail, then forge *@
@if (!isAuthenticated)
{
    <a href="account" class="btn btn-rf-outline">@UiText.BtnLoginToForge(LanguageState.CurrentLanguage)</a>
}
else if (emailConfirmed == false)
{
    <a href="account" class="btn btn-rf-outline" data-test="verify-to-forge" title="@UiText.HintVerifyToForge(LanguageState.CurrentLanguage)">
        @UiText.BtnVerifyToForge(LanguageState.CurrentLanguage)
    </a>
}
else if (emailConfirmed == true)
{
    @ChildContent
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool isAuthenticated;
    private bool? emailConfirmed;

    protected override void OnInitialized()
    {
        LanguageState.OnLanguageChanged += StateHasChanged;
        CrossTab.OnEmailConfirmed += HandleEmailConfirmed;
    }

    //	The e-mail was confirmed in another tab (link in the e-mail): show the create button right away
    private async void HandleEmailConfirmed()
    {
        if (isAuthenticated)
        {
            emailConfirmed = await Auth.IsEmailConfirmedAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    //	Re-evaluated on every authentication change (sign-in, sign-out, token refresh)
    protected override async Task OnParametersSetAsync()
    {
        isAuthenticated = AuthState != null && (await AuthState).User.Identity?.IsAuthenticated == true;
        emailConfirmed = isAuthenticated ? await Auth.IsEmailConfirmedAsync() : null;
    }

    public void Dispose()
    {
        LanguageState.OnLanguageChanged -= StateHasChanged;
        CrossTab.OnEmailConfirmed -= HandleEmailConfirmed;
    }
}
