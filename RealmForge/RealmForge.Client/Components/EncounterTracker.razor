@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.Campaigns
@using RealmForge.Shared.DTOs
@using RealmForge.Shared.Enums
@using RealmForge.Shared.Monsters
@implements IDisposable
@inject EncounterDataService Encounters
@inject MonsterDataService MonsterService
@inject CampaignDataService Campaigns
@inject ImageDataService Images
@inject LanguageStateService LanguageState

@* One encounter: masters and co-masters build it (monsters, characters, others), see its difficulty for the party and
   run it (initiative, hit points, conditions, rounds); the players follow the initiative order of a shown encounter *@
<div class="enc" data-test="encounter">
    @* The top bar: back, name, status; on the right what the masters do with it (all 40 px high) *@
    <header class="enc-top">
        <div class="enc-top-left">
            <button type="button" class="enc-back" @onclick="() => OnClose.InvokeAsync()" data-test="encounter-back"><Icon Name="left" /> @UiText.EncountersBack(Lang)</button>
            @if (encounter is not null)
            {
                @if (Manage)
                {
                    <input class="enc-title-input" maxlength="100" @bind="draft.Name" @bind:after="SaveAsync" aria-label="@UiText.EncounterName(Lang)" data-test="encounter-name" />
                }
                else
                {
                    <h2 class="enc-title">@encounter.Name</h2>
                }
                <span class="enc-status status-@draft.Status.ToString().ToLowerInvariant()" data-test="encounter-status"><span class="dot"></span>@UiText.EncounterStatusName(draft.Status, Lang)</span>
                @if (draft.Status == EncounterStatus.Running)
                {
                    <span class="enc-round" data-test="encounter-round">@UiText.EncounterRound(draft.Round, Lang)</span>
                }
            }
        </div>
        @if (encounter is not null)
        {
            <div class="enc-top-right">
                @if (Manage)
                {
                    <button type="button" class="enc-toggle @(draft.Shown ? "on" : null)" aria-pressed="@(draft.Shown ? "true" : "false")" title="@UiText.EncounterShownHint(Lang)" @onclick="ToggleShownAsync" data-test="encounter-shown">
                        <span class="dot"></span>@(draft.Shown ? UiText.EncounterShown(Lang) : UiText.EncounterHidden(Lang))
                    </button>
                    @switch (draft.Status)
                    {
                        case EncounterStatus.Planned:
                            <button type="button" class="enc-btn" disabled="@(draft.Combatants.Count == 0)" @onclick="StartAsync" data-test="encounter-start"><Icon Name="play" /> @UiText.EncounterStart(Lang)</button>
                            break;
                        case EncounterStatus.Running:
                            <button type="button" class="enc-btn square" title="@UiText.ToolBack(Lang)" @onclick="PreviousAsync" data-test="encounter-prev"><Icon Name="caret-left" /></button>
                            <button type="button" class="enc-btn" @onclick="NextAsync" data-test="encounter-next">@UiText.EncounterNextTurn(Lang) <Icon Name="caret-right" /></button>
                            <button type="button" class="enc-btn" @onclick="FinishAsync" data-test="encounter-finish">@UiText.EncounterFinish(Lang)</button>
                            break;
                        default:
                            <button type="button" class="enc-btn" @onclick="ReopenAsync" data-test="encounter-reopen">@UiText.EncounterReopen(Lang)</button>
                            break;
                    }
                    @if (draft.Status != EncounterStatus.Finished)
                    {
                        <a class="enc-cta" href="@($"campaigns/{CampaignId}/vtt?encounter={EncounterId}")" data-test="encounter-vtt"><Icon Name="play" /> @UiText.EncounterOnTable(Lang)</a>
                    }
                }
                else
                {
                    <button type="button" class="enc-btn" @onclick="LoadAsync" data-test="encounter-refresh"><Icon Name="refresh" /> @UiText.BtnRefresh(Lang)</button>
                }
            </div>
        }
    </header>

    @if (message is not null)
    {
        <div class="alert alert-warning bg-dark border-warning text-warning p-2 small mb-3" data-test="encounter-message">@message</div>
    }

    @if (loading)
    {
        <div class="small" style="color: var(--rf-text-muted);">…</div>
    }
    else if (encounter is null)
    {
        <div class="rf-account-card text-center">@UiText.EncounterNotFound(Lang)</div>
    }
    else if (Manage)
    {
        <div class="enc-grid">
            <div class="enc-col">
                @Difficulty
                @Combatants
                @AddCard
            </div>
            <aside class="enc-col">
                @MapCard
                <section class="enc-card enc-notes">
                    <div class="enc-card-head">
                        <div>
                            <span class="enc-kicker">@UiText.EncounterMastersOnly(Lang)</span>
                            <h3 class="enc-h">@UiText.EncounterNotes(Lang)</h3>
                        </div>
                    </div>
                    <textarea class="rf-form-control" rows="8" maxlength="8000" placeholder="@UiText.EncounterNotesHint(Lang)" @bind="draft.Notes" @bind:after="SaveAsync" data-test="encounter-notes"></textarea>
                    <div class="enc-card-foot">
                        <span class="enc-saved">@(saved ? $"✓ {UiText.EncounterSaved(Lang)}" : null)</span>
                        @if (confirmDelete)
                        {
                            <span class="d-flex gap-2">
                                <button type="button" class="enc-btn" @onclick="() => confirmDelete = false">@UiText.BtnCancel(Lang)</button>
                                <button type="button" class="enc-btn danger solid" @onclick="DeleteAsync" data-test="encounter-delete-yes">@UiText.EncounterDeleteConfirm(Lang)</button>
                            </span>
                        }
                        else
                        {
                            <button type="button" class="enc-btn danger" @onclick="() => confirmDelete = true" data-test="encounter-delete">@UiText.Delete(Lang)</button>
                        }
                    </div>
                </section>
            </aside>
        </div>
    }
    else
    {
        @Combatants
    }
</div>

@if (statblock is not null)
{
    <div class="rf-modal-backdrop" @onclick="() => statblock = null">
        <div class="rf-modal-dialog" style="max-width: 760px;" @onclick:stopPropagation="true" data-test="encounter-statblock">
            <div class="d-flex justify-content-end mb-2">
                <button class="btn btn-sm btn-rf-outline" @onclick="() => statblock = null"><Icon Name="close" /></button>
            </div>
            <MonsterStatBlock Monster="statblock" />
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid CampaignId { get; set; }
    [Parameter, EditorRequired] public Guid EncounterId { get; set; }
    [Parameter, EditorRequired] public CampaignDetailDto Campaign { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    //	Just created to be filled: the generator runs once, with this kind of creatures
    [Parameter] public bool GenerateOnOpen { get; set; }
    [Parameter] public CreatureType? GenerateType { get; set; }

    //	The players' view follows the masters every few seconds
    private const int RefreshSeconds = 8;

    private LanguageCode Lang => LanguageState.CurrentLanguage;
    private bool Manage => encounter?.CanManage == true;

    private EncounterDto? encounter;
    private SaveEncounterDto draft = new();
    private bool loading = true;
    private string? message;
    private bool confirmDelete;
    private RulesetVersion difficultyRuleset = RulesetVersion.Dnd5e_2014;

    private List<MonsterResponseDto>? monsters;
    private string monsterSearch = string.Empty;
    private bool rollHp;
    private readonly Dictionary<Guid, int> addCounts = new();
    private readonly Dictionary<Guid, string?> amounts = new();
    private string otherName = string.Empty;
    private MonsterDetailDto? statblock;

    private readonly SemaphoreSlim saveLock = new(1, 1);
    private System.Threading.Timer? refresh;

    protected override async Task OnInitializedAsync()
    {
        difficultyRuleset = Campaign.Ruleset ?? RulesetVersion.Dnd5e_2014;
        await LoadAsync();
        loading = false;
        await LoadPicturesAsync();
        if (Manage)
        {
            await LoadMapsAsync();
            if (GenerateOnOpen)
            {
                genType = GenerateType;
                await GenerateAsync();
            }
        }
        if (encounter is not null)
        {
            var manage = encounter.CanManage;
            refresh = new System.Threading.Timer(_ => InvokeAsync(async () =>
            {
                if (manage)
                {
                    await RefreshSheetsAsync();
                }
                else
                {
                    await LoadAsync();
                }
                StateHasChanged();
            }), null, TimeSpan.FromSeconds(RefreshSeconds), TimeSpan.FromSeconds(RefreshSeconds));
        }
    }

    private async Task LoadAsync()
    {
        var loaded = await Encounters.GetEncounterAsync(CampaignId, EncounterId);
        if (loaded is null && encounter is not null && !encounter.CanManage)
        {
            //	Hidden again or finished: the players go back to the list
            message = UiText.EncounterNotFound(Lang);
        }
        encounter = loaded;
        if (loaded is not null)
        {
            draft = ToDraft(loaded);
        }
    }

    private static SaveEncounterDto ToDraft(EncounterDto e) => new()
    {
        Name = e.Name,
        Notes = e.Notes,
        Status = e.Status,
        Round = e.Round,
        CurrentId = e.CurrentId,
        Shown = e.Shown,
        PartyIds = e.PartyIds.ToList(),
        Version = e.Version,
        MapId = e.MapId,
        Combatants = e.Combatants.Select(c => new EncounterCombatant
        {
            Id = c.Id,
            Kind = c.Kind,
            MonsterId = c.MonsterId,
            CharacterId = c.CharacterId,
            Name = c.Name,
            Initiative = c.Initiative,
            InitiativeBonus = c.InitiativeBonus,
            ArmorClass = c.ArmorClass,
            MaxHp = c.MaxHp,
            Hp = c.Hp,
            TempHp = c.TempHp,
            Xp = c.Xp,
            ChallengeRating = c.ChallengeRating,
            Conditions = c.Conditions.ToList(),
            Note = c.Note,
            Hidden = c.Hidden,
            Health = c.Health,
            SheetHp = c.SheetHp,
            SheetTempHp = c.SheetTempHp,
            SheetConditions = c.SheetConditions?.ToList(),
            X = c.X,
            Y = c.Y
        }).ToList()
    };

    //	The characters as their sheets are now (and the values a next save compares with)
    private void TakeSheets(EncounterDto from)
    {
        foreach (var c in draft.Combatants.Where(c => c.Kind == CombatantKind.Character))
        {
            if (from.Combatants.FirstOrDefault(s => s.Id == c.Id) is { } fresh)
            {
                c.Hp = fresh.Hp;
                c.MaxHp = fresh.MaxHp;
                c.TempHp = fresh.TempHp;
                c.ArmorClass = fresh.ArmorClass;
                c.Conditions = fresh.Conditions.ToList();
                c.SheetHp = fresh.SheetHp;
                c.SheetTempHp = fresh.SheetTempHp;
                c.SheetConditions = fresh.SheetConditions?.ToList();
            }
        }
    }

    //	Masters: the hit points and conditions the players change on their sheets show up without a reload
    private async Task RefreshSheetsAsync()
    {
        if (!await saveLock.WaitAsync(0))
        {
            return;
        }
        try
        {
            if (await Encounters.GetEncounterAsync(CampaignId, EncounterId) is { } loaded)
            {
                TakeSheets(loaded);
            }
        }
        finally
        {
            saveLock.Release();
        }
    }

    //	Every change is saved at once; a save made meanwhile by another master reloads the encounter
    private async Task SaveAsync()
    {
        if (!Manage || encounter is null)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(draft.Name))
        {
            draft.Name = encounter.Name;
        }
        await saveLock.WaitAsync();
        try
        {
            var result = await Encounters.SaveAsync(CampaignId, EncounterId, draft);
            if (result.Encounter is { } saved)
            {
                encounter = saved;
                draft.Version = saved.Version;
                TakeSheets(saved);
                message = null;
                this.saved = true;
            }
            else if (result.Status == System.Net.HttpStatusCode.Conflict && result.Current is { } current)
            {
                encounter = current;
                draft = ToDraft(current);
                message = UiText.EncounterConflict(Lang);
            }
            else
            {
                message = UiText.CampaignActionFailed(result.Status, Lang);
            }
        }
        finally
        {
            saveLock.Release();
        }
    }

    // ===== Difficulty =====

    private List<int> PartyLevels => encounter is null ? new() : encounter.Characters.Where(c => draft.PartyIds.Contains(c.CharacterId)).Select(c => c.Level).ToList();

    private EncounterBudget Budget => EncounterMath.Evaluate(difficultyRuleset, PartyLevels,
        draft.Combatants.Where(c => c.Kind == CombatantKind.Monster).Select(c => c.Xp).ToList());

    private List<RfSelect<RulesetVersion>.OptionItem> RulesetOptions => new()
    {
        new(RulesetVersion.Dnd5e_2014, UiText.FormatRuleset(RulesetVersion.Dnd5e_2014, Lang)),
        new(RulesetVersion.Dnd5e_2024, UiText.FormatRuleset(RulesetVersion.Dnd5e_2024, Lang))
    };

    //	A character in the party is on the field too (while the encounter is being prepared), out of it it leaves
    private async Task TogglePartyAsync(Guid characterId)
    {
        var joins = !draft.PartyIds.Remove(characterId);
        if (joins)
        {
            draft.PartyIds.Add(characterId);
        }
        if (draft.Status == EncounterStatus.Planned)
        {
            if (joins && draft.Combatants.All(c => c.CharacterId != characterId) && Campaign.Characters.FirstOrDefault(c => c.Character.Id == characterId) is { } entry)
            {
                draft.Combatants.Add(CharacterCombatant(entry));
            }
            else if (!joins)
            {
                draft.Combatants.RemoveAll(c => c.CharacterId == characterId);
            }
        }
        await SaveAsync();
    }

    private static EncounterCombatant CharacterCombatant(CampaignCharacterDto entry) => new()
    {
        Kind = CombatantKind.Character,
        CharacterId = entry.Character.Id,
        Name = entry.Character.Name,
        ArmorClass = entry.Character.ArmorClass,
        MaxHp = entry.Character.MaxHitPoints,
        Hp = entry.Character.CurrentHitPoints
    };

    // ===== Adding =====

    private async Task EnsureMonstersAsync()
    {
        monsters ??= await MonsterService.GetMonstersAsync(Lang, Campaign.Ruleset);
    }

    private List<MonsterResponseDto> MonsterResults
    {
        get
        {
            var term = monsterSearch.Trim();
            if (term.Length < 2 || monsters is null)
            {
                return new();
            }
            return monsters
                .Where(m => m.Name.Contains(term, StringComparison.OrdinalIgnoreCase) || (m.Alias?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
                .OrderBy(m => m.Name.StartsWith(term, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                .ThenBy(m => m.Name, StringComparer.CurrentCultureIgnoreCase)
                .Take(12)
                .ToList();
        }
    }

    private int CountOf(Guid monsterId) => addCounts.TryGetValue(monsterId, out var n) ? n : 1;

    private void SetCount(Guid monsterId, object? value)
    {
        if (int.TryParse(value?.ToString(), out var n))
        {
            addCounts[monsterId] = Math.Clamp(n, 1, 20);
        }
    }

    //	"Goblin 1", "Goblin 2"… when there is more than one of a kind
    private async Task AddMonsterAsync(MonsterResponseDto m)
    {
        var count = CountOf(m.Id);
        var same = draft.Combatants.Where(c => c.MonsterId == m.Id).ToList();
        if (same.Count + count > EncounterRules.MaxCombatants - (draft.Combatants.Count - same.Count))
        {
            message = UiText.EncounterTooMany(Lang);
            return;
        }
        if (same.Count == 1 && same[0].Name == m.Name)
        {
            same[0].Name = $"{m.Name} 1";
        }
        for (var i = 1; i <= count; i++)
        {
            var hp = rollHp ? Roll(m.HitDice) ?? m.HitPoints : m.HitPoints;
            draft.Combatants.Add(new EncounterCombatant
            {
                Kind = CombatantKind.Monster,
                MonsterId = m.Id,
                Name = same.Count + count > 1 ? $"{m.Name} {same.Count + i}" : m.Name,
                InitiativeBonus = MonsterMath.Modifier(m.Dexterity),
                ArmorClass = m.ArmorClass,
                MaxHp = Math.Max(1, hp),
                Hp = Math.Max(1, hp),
                Xp = m.Xp,
                ChallengeRating = m.ChallengeRating
            });
        }
        addCounts.Remove(m.Id);
        await SaveAsync();
    }

    //	The characters of the party that are not on the field yet
    private List<CampaignCharacterDto> PartyToAdd => Campaign.Characters
        .Where(e => draft.PartyIds.Count == 0 || draft.PartyIds.Contains(e.Character.Id))
        .Where(e => draft.Combatants.All(c => c.CharacterId != e.Character.Id))
        .ToList();

    private async Task AddPartyAsync()
    {
        foreach (var entry in PartyToAdd)
        {
            draft.Combatants.Add(CharacterCombatant(entry));
        }
        await SaveAsync();
    }

    private async Task AddOtherAsync()
    {
        if (string.IsNullOrWhiteSpace(otherName))
        {
            return;
        }
        draft.Combatants.Add(new EncounterCombatant { Kind = CombatantKind.Other, Name = otherName.Trim() });
        otherName = string.Empty;
        await SaveAsync();
    }

    private async Task RemoveAsync(EncounterCombatant c)
    {
        draft.Combatants.RemoveAll(x => x.Id == c.Id);
        if (draft.CurrentId == c.Id)
        {
            draft.CurrentId = null;
        }
        await SaveAsync();
    }

    private async Task RenameAsync(EncounterCombatant c, object? value)
    {
        var name = value?.ToString()?.Trim();
        if (!string.IsNullOrEmpty(name))
        {
            c.Name = name;
            await SaveAsync();
        }
    }

    // ===== Running =====

    private static int RollDie(int faces) => Random.Shared.Next(1, faces + 1);

    //	A dice formula rolled ("2d8 + 2"); null when it cannot be read
    private static int? Roll(string? formula)
    {
        var match = System.Text.RegularExpressions.Regex.Match((formula ?? string.Empty).Replace(" ", string.Empty).ToLowerInvariant(), @"^(\d+)d(\d+)([+-]\d+)?$");
        if (!match.Success)
        {
            return null;
        }
        var count = Math.Min(int.Parse(match.Groups[1].Value), 200);
        var faces = Math.Min(int.Parse(match.Groups[2].Value), 100);
        var total = match.Groups[3].Success ? int.Parse(match.Groups[3].Value) : 0;
        for (var i = 0; i < count; i++)
        {
            total += RollDie(faces);
        }
        return total;
    }

    private async Task SetInitiativeAsync(EncounterCombatant c, object? value)
    {
        c.Initiative = int.TryParse(value?.ToString(), out var n) ? n : null;
        await SaveAsync();
    }

    //	Monsters and others without initiative roll d20 + bonus (the players roll their own)
    private void RollMissingInitiative()
    {
        foreach (var c in draft.Combatants.Where(c => c.Kind != CombatantKind.Character && c.Initiative is null))
        {
            c.Initiative = RollDie(20) + c.InitiativeBonus;
        }
    }

    private async Task RollInitiativeAsync()
    {
        RollMissingInitiative();
        await SaveAsync();
    }

    //	Who still takes turns: characters always, the others until they drop
    private List<EncounterCombatant> Acting => EncounterRules.Order(draft.Combatants)
        .Where(c => c.Kind == CombatantKind.Character || c.MaxHp == 0 || c.Hp > 0)
        .ToList();

    private async Task StartAsync()
    {
        RollMissingInitiative();
        draft.Status = EncounterStatus.Running;
        draft.Round = 1;
        draft.CurrentId = Acting.FirstOrDefault()?.Id;
        await SaveAsync();
    }

    private async Task NextAsync()
    {
        var order = Acting;
        if (order.Count == 0)
        {
            return;
        }
        var index = order.FindIndex(c => c.Id == draft.CurrentId);
        if (index + 1 >= order.Count)
        {
            draft.Round++;
            draft.CurrentId = order[0].Id;
        }
        else
        {
            draft.CurrentId = order[index + 1].Id;
        }
        await SaveAsync();
    }

    private async Task PreviousAsync()
    {
        var order = Acting;
        if (order.Count == 0)
        {
            return;
        }
        var index = order.FindIndex(c => c.Id == draft.CurrentId);
        if (index <= 0)
        {
            if (draft.Round > 1)
            {
                draft.Round--;
                draft.CurrentId = order[^1].Id;
            }
        }
        else
        {
            draft.CurrentId = order[index - 1].Id;
        }
        await SaveAsync();
    }

    private async Task FinishAsync()
    {
        draft.Status = EncounterStatus.Finished;
        draft.CurrentId = null;
        await SaveAsync();
    }

    private async Task ReopenAsync()
    {
        draft.Status = EncounterStatus.Planned;
        draft.Round = 0;
        draft.CurrentId = null;
        await SaveAsync();
    }

    private async Task ToggleShownAsync()
    {
        draft.Shown = !draft.Shown;
        await SaveAsync();
    }

    private string? AmountOf(EncounterCombatant c) => amounts.TryGetValue(c.Id, out var text) ? text : null;

    //	-1 damage (temporary hit points first), +1 healing (up to the maximum), 0 temporary hit points (the higher stays)
    private async Task ApplyAsync(EncounterCombatant c, int direction)
    {
        if (!int.TryParse(AmountOf(c), out var amount) || amount <= 0)
        {
            return;
        }
        switch (direction)
        {
            case < 0:
                var absorbed = Math.Min(c.TempHp, amount);
                c.TempHp -= absorbed;
                c.Hp = Math.Max(0, c.Hp - (amount - absorbed));
                break;
            case > 0:
                c.Hp = c.MaxHp > 0 ? Math.Min(c.MaxHp, Math.Max(0, c.Hp) + amount) : c.Hp + amount;
                break;
            default:
                c.TempHp = Math.Max(c.TempHp, amount);
                break;
        }
        amounts.Remove(c.Id);
        await SaveAsync();
    }

    private List<RfSelect<string>.OptionItem> ConditionOptions(EncounterCombatant c) =>
        new List<RfSelect<string>.OptionItem> { new(string.Empty, "+ " + UiText.EncounterCondition(Lang)) }
            .Concat(EncounterRules.Conditions.Where(k => !c.Conditions.Contains(k))
                //	A character concentrates on a spell of its sheet
                .Where(k => c.Kind != CombatantKind.Character || k != EncounterRules.Concentrating)
                .Select(k => new RfSelect<string>.OptionItem(k, UiText.ConditionName(k, Lang)))
                .OrderBy(o => o.Label, StringComparer.CurrentCultureIgnoreCase))
            .ToList();

    private async Task AddConditionAsync(EncounterCombatant c, string? key)
    {
        if (!string.IsNullOrEmpty(key) && !c.Conditions.Contains(key))
        {
            c.Conditions.Add(key);
            await SaveAsync();
        }
    }

    private async Task RemoveConditionAsync(EncounterCombatant c, string key)
    {
        c.Conditions.Remove(key);
        await SaveAsync();
    }

    private async Task ToggleHiddenAsync(EncounterCombatant c)
    {
        c.Hidden = !c.Hidden;
        await SaveAsync();
    }

    private async Task OpenStatblockAsync(Guid monsterId)
    {
        statblock = await MonsterService.GetMonsterAsync(monsterId, Lang);
        if (statblock is null)
        {
            message = UiText.EncounterStatblockMissing(Lang);
        }
    }

    private async Task DeleteAsync()
    {
        if (await Encounters.DeleteAsync(CampaignId, EncounterId))
        {
            await OnClose.InvokeAsync();
        }
    }

    public void Dispose()
    {
        refresh?.Dispose();
        saveLock.Dispose();
    }
    // ===== The cards =====

    //	How hard it is for the characters chosen: the verdict, the XP against the thresholds, and the generator
    private RenderFragment Difficulty => __builder =>
    {
        var budget = Budget;
        var top = budget.Thresholds.Length > 0 ? budget.Thresholds[^1] : 0;
        var scale = Math.Max(top * 1.25, Math.Max(100, budget.AdjustedXp));
        <section class="enc-card" data-test="encounter-difficulty">
            <div class="enc-card-head">
                <div>
                    <span class="enc-kicker">@UiText.EncounterBudgetKicker(budget.Ruleset, Lang)</span>
                    <h3 class="enc-h">@UiText.EncounterDifficulty(Lang)</h3>
                </div>
                <div class="enc-head-right">
                    @if (Campaign.Ruleset is null)
                    {
                        <div class="enc-ruleset" data-test="encounter-rules">
                            <RfSelect TValue="RulesetVersion" @bind-Value="difficultyRuleset" Options="RulesetOptions" />
                        </div>
                    }
                    <span class="enc-verdict level-@VerdictLevel(budget)"><span class="dot"></span><strong data-test="encounter-rating">@UiText.EncounterRating(budget.Ruleset, budget.Rating, Lang)</strong></span>
                </div>
            </div>

            <div class="enc-party">
                <span class="enc-micro">@UiText.EncounterPartyLabel(Lang)</span>
                @if (encounter!.Characters.Count == 0)
                {
                    <span class="small" style="color: var(--rf-text-muted);">@UiText.EncounterNoCharacters(Lang)</span>
                }
                else
                {
                    <div class="enc-party-chips" data-test="encounter-party">
                        @foreach (var member in encounter.Characters)
                        {
                            var m = member;
                            var inParty = draft.PartyIds.Contains(m.CharacterId);
                            <button type="button" class="enc-pc @(inParty ? "on" : null)" aria-pressed="@(inParty ? "true" : "false")" @onclick="() => TogglePartyAsync(m.CharacterId)">
                                <span class="check">@(inParty ? "✓" : "+")</span><strong>@m.Name</strong><span class="lvl">@UiText.CharacterLevel(m.Level, Lang)</span>
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="enc-meter">
                <div class="enc-meter-row">
                    <div class="enc-meter-now">
                        <span class="enc-micro">@UiText.EncounterThreat(Lang)</span>
                        <strong>@budget.AdjustedXp @UiText.XpLabel(Lang)</strong>
                        <span>@UiText.EncounterXpLine(budget.TotalXp, budget.Multiplier, budget.AdjustedXp, budget.Ruleset, Lang)</span>
                    </div>
                    @if (budget.Thresholds.Length > 0)
                    {
                        <div class="enc-meter-legend">
                            @for (var i = 0; i < budget.Thresholds.Length; i++)
                            {
                                <span><small>@UiText.EncounterRating(budget.Ruleset, i + 1, Lang):</small> <strong>@budget.Thresholds[i] @UiText.XpLabel(Lang)</strong></span>
                            }
                        </div>
                    }
                </div>
                <div class="enc-meter-track">
                    @foreach (var t in budget.Thresholds)
                    {
                        <span class="enc-meter-mark" style="left: @N(Math.Min(100, t / scale * 100))%;"></span>
                    }
                    <span class="enc-meter-fill level-@VerdictLevel(budget)" style="width: @N(Math.Min(100, budget.AdjustedXp / scale * 100))%;"></span>
                </div>
                <p class="enc-advice">@UiText.EncounterAdvice(budget.Ruleset, budget.Rating, budget.TotalXp, Lang)</p>
                @if (budget.Thresholds.Length > 0)
                {
                    <span class="enc-micro">@UiText.EncounterXpEach(budget.XpPerCharacter(PartyLevels.Count), Lang)</span>
                }
            </div>

            <div class="enc-gen" data-test="encounter-generator">
                <div class="enc-gen-head">
                    <span class="enc-gen-badge">@UiText.EncounterGenBadge(Lang)</span>
                    <strong>@UiText.EncounterGenTitle(Lang)</strong>
                </div>
                <div class="enc-gen-grid">
                    <label>
                        <span class="enc-micro">@UiText.EncounterGenTheme(Lang)</span>
                        <RfSelect TValue="CreatureType?" @bind-Value="genType" Options="ThemeOptions" />
                    </label>
                    <label>
                        <span class="enc-micro">@UiText.EncounterGenTarget(Lang)</span>
                        <RfSelect TValue="int" @bind-Value="genLevel" Options="TargetOptions(budget)" />
                    </label>
                    <button type="button" class="enc-btn primary" disabled="@(PartyLevels.Count == 0 || generating)" @onclick="GenerateAsync" data-test="encounter-generate"><Icon Name="dice" /> @UiText.EncounterGenGo(Lang)</button>
                </div>
                @if (PartyLevels.Count == 0)
                {
                    <span class="enc-micro">@UiText.EncounterGenNeedParty(Lang)</span>
                }
                @if (generating)
                {
                    <span class="enc-gen-note" data-test="encounter-gen-running">@UiText.EncounterGenRunning(Lang)</span>
                }
                else if (genNote is not null)
                {
                    <span class="enc-gen-note @(genFailed ? "bad" : "good")" data-test="encounter-gen-result">@genNote</span>
                }
            </div>
        </section>
    };

    //	The initiative order: initiative, who, where it starts, hit points
    private RenderFragment Combatants => __builder =>
    {
        <section class="enc-card" data-test="encounter-combatants">
            <div class="enc-card-head">
                <div>
                    <span class="enc-kicker">@UiText.EncounterCombatantsKicker(Lang)</span>
                    <h3 class="enc-h">@UiText.EncounterCombatants(Lang)</h3>
                </div>
                @if (Manage && draft.Combatants.Count > 0)
                {
                    <div class="enc-head-right">
                        @if (draft.Status == EncounterStatus.Planned && draft.Combatants.Any(c => c.Kind == CombatantKind.Monster))
                        {
                            <button type="button" class="enc-btn" @onclick="ClearMonstersAsync" data-test="encounter-clear-monsters">@UiText.EncounterClearMonsters(Lang)</button>
                        }
                        <button type="button" class="enc-btn" @onclick="RollInitiativeAsync" data-test="encounter-roll-initiative"><Icon Name="dice" /> @UiText.EncounterRollInitiative(Lang)</button>
                    </div>
                }
            </div>

            @if (draft.Combatants.Count == 0)
            {
                <div class="small" style="color: var(--rf-text-muted);" data-test="encounter-combatants-empty">@UiText.EncounterNoCombatants(Lang)</div>
            }
            <div class="enc-rows">
                @foreach (var combatant in EncounterRules.Order(draft.Combatants))
                {
                    var c = combatant;
                    var current = draft.Status == EncounterStatus.Running && draft.CurrentId == c.Id;
                    var down = c.Kind != CombatantKind.Character && (c.Health == CombatantHealth.Down || (c.Health is null && c.MaxHp > 0 && c.Hp <= 0));
                    var kind = c.Kind == CombatantKind.Character ? "pc" : c.Kind == CombatantKind.Monster ? "monster" : "other";
                    <div class="rf-combatant enc-row @kind @(current ? "current" : null) @(down ? "down" : null) @(c.Hidden ? "hidden-foe" : null) @(placing == c.Id ? "placing" : null)" data-test="encounter-combatant">
                        <div class="enc-init">
                            @if (Manage)
                            {
                                <input type="number" title="@UiText.EncounterInitiative(Lang)" placeholder="—" value="@c.Initiative" @onchange="e => SetInitiativeAsync(c, e.Value)" data-test="combatant-initiative" />
                            }
                            else
                            {
                                <span>@(c.Initiative?.ToString() ?? "—")</span>
                            }
                        </div>
                        <div class="enc-who">
                            <span class="enc-ava @kind @(current ? "current" : null)">@if (AvatarOf(c) is { } avatar)
                                {
                                    <img src="@avatar" alt="" loading="lazy" data-test="combatant-avatar" />
                                }
                                else
                                {
                                    @Code(c.Name)
                                }
                                @if (current)
                                {
                                    <span class="enc-ava-turn"><Icon Name="play" /></span>
                                }</span>
                            <div class="enc-who-main">
                                <div class="enc-name-line">
                                    @if (Manage)
                                    {
                                        <input class="enc-name" maxlength="100" value="@c.Name" @onchange="e => RenameAsync(c, e.Value)" data-test="combatant-name" />
                                    }
                                    else
                                    {
                                        <strong>@c.Name</strong>
                                    }
                                    <span class="enc-tag">@UiText.CombatantKindName(c.Kind, Lang)@(c.ChallengeRating is { } cr && Manage ? $" · {UiText.MonsterChallengeShort(Lang)} {MonsterMath.FormatChallenge(cr)} ({c.Xp} {UiText.XpLabel(Lang)})" : null)</span>
                                </div>
                                <div class="enc-sub">
                                    @if (Manage && map is not null)
                                    {
                                        <button type="button" class="enc-chip @(placing == c.Id ? "on" : null)" title="@UiText.EncounterPlaceHint(Lang)" @onclick="() => placing = c.Id" data-test="combatant-place"><Icon Name="geo-alt" /> @(c.X is { } x && c.Y is { } y ? UiText.EncounterCell(CellName(x, y), Lang) : UiText.EncounterNoCell(Lang))</button>
                                    }
                                    @if (Manage)
                                    {
                                        <button type="button" class="enc-chip @(c.Hidden ? "warn" : null)" title="@UiText.EncounterHideHint(Lang)" @onclick="() => ToggleHiddenAsync(c)" data-test="combatant-hide"><Icon Name="@(c.Hidden ? "eye-slash" : "eye")" /> @(c.Hidden ? UiText.EncounterHiddenFoe(Lang) : UiText.EncounterVisibleFoe(Lang))</button>
                                    }
                                    @if (c.MonsterId is { } monsterId)
                                    {
                                        <button type="button" class="enc-chip" @onclick="() => OpenStatblockAsync(monsterId)" data-test="combatant-statblock"><Icon Name="file-text" /> @UiText.EncounterStatblock(Lang)</button>
                                    }
                                    @if (c.Kind == CombatantKind.Character && c.CharacterId is { } characterId && Manage)
                                    {
                                        <a class="enc-chip" href="@($"characters/{characterId}")" title="@UiText.EncounterSheetSynced(Lang)" data-test="combatant-sheet"><Icon Name="file-text" /> @UiText.EncounterOpenSheet(Lang)</a>
                                    }
                                </div>
                                <div class="rf-combatant-conditions">
                                    @foreach (var key in c.Conditions)
                                    {
                                        var k = key;
                                        if (Manage)
                                        {
                                            <button type="button" class="rf-condition-chip" title="@UiText.BtnRemove(Lang)" @onclick="() => RemoveConditionAsync(c, k)">@UiText.ConditionName(k, Lang) <Icon Name="close" /></button>
                                        }
                                        else
                                        {
                                            <span class="rf-condition-chip">@UiText.ConditionName(k, Lang)</span>
                                        }
                                    }
                                    @if (Manage)
                                    {
                                        <div class="rf-condition-add" data-test="combatant-condition">
                                            <RfSelect TValue="string" Value="@(string.Empty)" ValueChanged="v => AddConditionAsync(c, v)" Options="ConditionOptions(c)" />
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="enc-life">
                            @if (Manage || c.Kind == CombatantKind.Character)
                            {
                                <span class="enc-ac" title="@UiText.MonsterArmorClass(Lang)"><Icon Name="shield" /> @c.ArmorClass</span>
                                <div class="enc-hp">
                                    <span data-test="combatant-hp"><Icon Name="heart" /> @c.Hp@(c.MaxHp > 0 ? $"/{c.MaxHp}" : null)@(c.TempHp > 0 ? $" (+{c.TempHp})" : null)</span>
                                    @if (c.MaxHp > 0)
                                    {
                                        <span class="enc-hp-bar"><span class="@(c.Hp * 2 <= c.MaxHp ? "low" : null)" style="width: @N(Math.Clamp(c.Hp / (double)c.MaxHp, 0, 1) * 100)%;"></span></span>
                                    }
                                </div>
                            }
                            else if (c.Health is { } health)
                            {
                                <span class="rf-health rf-health-@health.ToString().ToLowerInvariant()" data-test="combatant-health">@UiText.HealthName(health, Lang)</span>
                            }
                            @if (Manage)
                            {
                                <div class="enc-hp-edit">
                                    <input type="number" min="0" placeholder="0" value="@AmountOf(c)" @onchange="e => amounts[c.Id] = e.Value?.ToString()" aria-label="@UiText.ToolHpAmount(Lang)" data-test="combatant-amount" />
                                    <button type="button" title="@UiText.EncounterDamage(Lang)" @onclick="() => ApplyAsync(c, -1)" data-test="combatant-damage">−</button>
                                    <button type="button" title="@UiText.EncounterHeal(Lang)" @onclick="() => ApplyAsync(c, 1)" data-test="combatant-heal">+</button>
                                    <button type="button" title="@UiText.EncounterTempHp(Lang)" @onclick="() => ApplyAsync(c, 0)">T</button>
                                    <button type="button" class="del" title="@UiText.BtnRemove(Lang)" @onclick="() => RemoveAsync(c)" data-test="combatant-remove"><Icon Name="close" /></button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    };

    //	Monsters from the compendium, the party, anyone else; one click for one more of those already there
    private RenderFragment AddCard => __builder =>
    {
        <section class="enc-card" data-test="encounter-add">
            <div class="enc-card-head">
                <div>
                    <span class="enc-kicker">@UiText.EncounterAddKicker(Lang)</span>
                    <h3 class="enc-h">@UiText.EncounterAddMonsters(Lang)</h3>
                </div>
                <label class="rf-checkbox-wrapper small mb-0">
                    <input type="checkbox" class="rf-checkbox" @bind="rollHp" data-test="encounter-roll-hp" />
                    <span>@UiText.EncounterRollHp(Lang)</span>
                </label>
            </div>
            <input class="rf-form-control" placeholder="@UiText.PlaceholderSearchMonsters(Lang)" @bind="monsterSearch" @bind:event="oninput" @onfocus="EnsureMonstersAsync" data-test="encounter-monster-search" />
            @if (MonsterResults.Count > 0)
            {
                <div class="rf-monster-picker" data-test="encounter-monster-results">
                    @foreach (var monster in MonsterResults)
                    {
                        var m = monster;
                        <div class="rf-monster-pick">
                            <span class="rf-monster-pick-name">@m.Name</span>
                            <span class="small" style="color: var(--rf-text-muted);">@UiText.MonsterChallengeShort(Lang) @MonsterMath.FormatChallenge(m.ChallengeRating) · @UiText.MonsterArmorClassShort(Lang) @m.ArmorClass · @UiText.MonsterHitPointsShort(Lang) @m.HitPoints · @m.Xp @UiText.XpLabel(Lang)</span>
                            <input type="number" min="1" max="20" class="rf-form-control rf-monster-pick-count" value="@CountOf(m.Id)" @onchange="e => SetCount(m.Id, e.Value)" />
                            <button type="button" class="btn btn-sm btn-rf-orange" @onclick="() => AddMonsterAsync(m)" data-test="encounter-monster-add">+ @UiText.BtnAdd(Lang)</button>
                        </div>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(monsterSearch) && monsters is not null)
            {
                <div class="small" style="color: var(--rf-text-muted);">@UiText.NoMonstersFound(Lang)</div>
            }
            @if (QuickMonsters.Count > 0)
            {
                <div class="enc-quick">
                    <span class="enc-micro">@UiText.EncounterQuickAdd(Lang)</span>
                    <div class="enc-quick-chips">
                        @foreach (var q in QuickMonsters)
                        {
                            var quick = q;
                            <button type="button" class="enc-quick-btn" @onclick="() => AddOneMoreAsync(quick)" data-test="encounter-quick-add"><strong>+ @quick.Name</strong><span>@quick.Xp @UiText.XpLabel(Lang)</span></button>
                        }
                    </div>
                </div>
            }
            <div class="enc-add-row">
                <button type="button" class="enc-btn" disabled="@(PartyToAdd.Count == 0)" @onclick="AddPartyAsync" data-test="encounter-add-party">+ @UiText.EncounterAddParty(Lang)</button>
                <input class="rf-form-control" maxlength="100" placeholder="@UiText.EncounterOtherPlaceholder(Lang)" @bind="otherName" @bind:event="oninput" data-test="encounter-other-name" />
                <button type="button" class="enc-btn" disabled="@(string.IsNullOrWhiteSpace(otherName))" @onclick="AddOtherAsync" data-test="encounter-add-other">+ @UiText.BtnAdd(Lang)</button>
            </div>
        </section>
    };

    //	Where each one starts, on a map of the campaign: a combatant chosen, then its cell clicked
    private RenderFragment MapCard => __builder =>
    {
        <section class="enc-card" data-test="encounter-map">
            <div class="enc-card-head">
                <div>
                    <span class="enc-kicker">@UiText.EncounterMapKicker(Lang)</span>
                    <h3 class="enc-h">@UiText.EncounterMapTitle(Lang)</h3>
                </div>
            </div>
            @if (maps is null)
            {
                <div class="small" style="color: var(--rf-text-muted);">…</div>
            }
            else if (maps.Count == 0)
            {
                <p class="small mb-0" style="color: var(--rf-text-muted);">@UiText.EncounterNoMaps(Lang)</p>
            }
            else
            {
                <div data-test="encounter-map-select">
                    <RfSelect TValue="Guid?" Value="draft.MapId" ValueChanged="SetMapAsync" Options="MapOptions" />
                </div>
                @if (map is not null)
                {
                    <p class="enc-micro mb-0">@((MarkupString)UiText.EncounterPlaceHow(Lang))</p>
                    <div class="enc-brushes">
                        @foreach (var c in draft.Combatants)
                        {
                            var who = c;
                            <button type="button" class="enc-brush @(who.Kind == CombatantKind.Character ? "pc" : who.Kind == CombatantKind.Monster ? "monster" : "other") @(placing == who.Id ? "on" : null)" @onclick="() => placing = who.Id" data-test="encounter-brush">
                                <span class="code">@if (AvatarOf(who) is { } face)
                                    {
                                        <img src="@face" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        @Code(who.Name)
                                    }</span><span class="name">@who.Name</span><small>@(who.X is { } bx && who.Y is { } by ? CellName(bx, by) : "—")</small>
                            </button>
                        }
                    </div>
                    var (w, h) = (map.Width, map.Height);
                    <svg class="enc-minimap" viewBox="0 0 @w @h" data-test="encounter-minimap">
                        <image href="@map.Image" x="0" y="0" width="@w" height="@h" preserveAspectRatio="none" />
                        @foreach (var (col, row) in Cells)
                        {
                            var cell = (col, row);
                            <polygon points="@Points(col, row)" class="enc-cell" @onclick="() => PlaceAtAsync(cell.col, cell.row)" />
                        }
                        @foreach (var c in draft.Combatants.Where(c => c.X is not null && c.Y is not null))
                        {
                            var (cx, cy) = MapGeometry.Center(map.GridType, map.GridSize, map.GridOffsetX, map.GridOffsetY, c.X!.Value, c.Y!.Value);
                            var r = map.GridSize * 0.42;
                            var kind = c.Kind == CombatantKind.Character ? "pc" : c.Kind == CombatantKind.Monster ? "monster" : "other";
                            <g class="enc-token @kind @(placing == c.Id ? "on" : null) @(c.Hidden ? "hidden-foe" : null)" @onclick="() => placing = c.Id">
                                <circle cx="@N(cx)" cy="@N(cy)" r="@N(r)" />
                                @if (AvatarOf(c) is { } picture)
                                {
                                    var clip = $"enc-clip-{c.Id:N}";
                                    <clipPath id="@clip"><circle cx="@N(cx)" cy="@N(cy)" r="@N(r * 0.9)" /></clipPath>
                                    <image href="@picture" x="@N(cx - r * 0.9)" y="@N(cy - r * 0.9)" width="@N(r * 1.8)" height="@N(r * 1.8)" clip-path="url(#@clip)" preserveAspectRatio="xMidYMid slice" />
                                }
                                else
                                {
                                    <text x="@N(cx)" y="@N(cy)" font-size="@N(r * 0.8)" text-anchor="middle" dominant-baseline="central">@Code(c.Name)</text>
                                }
                            </g>
                        }
                    </svg>
                    <div class="enc-card-foot">
                        <span class="enc-micro">@(placing is { } pid && draft.Combatants.FirstOrDefault(c => c.Id == pid) is { } chosen ? UiText.EncounterPlacing(chosen.Name, Lang) : UiText.EncounterPlaceHint(Lang))</span>
                        <button type="button" class="enc-link" @onclick="SpreadAsync" data-test="encounter-spread">@UiText.EncounterSpread(Lang)</button>
                    </div>
                }
            }
        </section>
    };

    private static string N(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
