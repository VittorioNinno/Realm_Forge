@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@implements IDisposable
@inject LanguageStateService LanguageState

@* Password field with its own show / hide button, always visible.
   The browser's eye (Edge) appears only while typing and disappears after leaving the field or after autofill, so it is hidden in app.css. *@
<div class="rf-password @(Invalid ? "rf-password-invalid" : null)">
    <input type="@(visible ? "text" : "password")" class="rf-form-control"
           autocomplete="@Autocomplete" spellcheck="false" autocapitalize="off"
           value="@Value" @oninput="OnInputAsync" @onkeydown="OnKeyDownAsync" @ref="input"
           data-test="@DataTest" aria-invalid="@(Invalid ? "true" : null)" aria-describedby="@DescribedBy" />
    <button type="button" class="rf-password-toggle" @onclick="() => visible = !visible"
            aria-label="@ToggleLabel" title="@ToggleLabel" aria-pressed="@(visible ? "true" : "false")"
            data-test="@(DataTest is null ? null : $"{DataTest}-toggle")">
        <Icon Name="@(visible ? "eye-slash" : "eye")" />
    </button>
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    //	current-password (sign-in, change) or new-password (registration, new password): password managers rely on it
    [Parameter] public string Autocomplete { get; set; } = "current-password";
    [Parameter] public string? DataTest { get; set; }

    //	Highlights the field, e.g. a repeated password that differs from the new one
    [Parameter] public bool Invalid { get; set; }
    [Parameter] public string? DescribedBy { get; set; }

    //	Enter in the field (the sign-in form submits or moves to the empty field)
    [Parameter] public EventCallback OnEnter { get; set; }

    private bool visible;
    private ElementReference input;

    public ValueTask FocusAsync() => input.FocusAsync();

    private Task OnKeyDownAsync(KeyboardEventArgs e) => e.Key == "Enter" ? OnEnter.InvokeAsync() : Task.CompletedTask;

    private string ToggleLabel => visible
        ? UiText.HidePassword(LanguageState.CurrentLanguage)
        : UiText.ShowPassword(LanguageState.CurrentLanguage);

    protected override void OnInitialized() => LanguageState.OnLanguageChanged += StateHasChanged;

    //	Updated on every key press, so checks such as the matching hint react while typing
    private Task OnInputAsync(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");

    public void Dispose() => LanguageState.OnLanguageChanged -= StateHasChanged;
}
