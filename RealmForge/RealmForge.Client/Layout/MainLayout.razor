@inherits LayoutComponentBase
@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.Enums
@implements IDisposable
@inject LanguageStateService LanguageState
@inject CrossTabService CrossTab
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="page @(Collapsed ? "sidebar-collapsed" : null)">
    <div class="sidebar">
        <NavMenu Collapsed="Collapsed" OnToggle="ToggleSidebarAsync" />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span class="text-secondary small rf-version-notice">@UiText.VersionNotice(LanguageState.CurrentLanguage)</span>

            <div class="d-flex align-items-center gap-3">
                <RealmForge.Client.Components.LanguageSelector />
                <a href="https://github.com/VittorioNinno/realm-forge" target="_blank" rel="noopener" class="rf-github-link" title="GitHub">
                    <Icon Name="github" Class="rf-nav-icon" /> <span>GitHub</span>
                </a>
            </div>
        </div>

        <article class="content px-4">
            <RealmForge.Client.Components.ApiErrorBanner />
            <RealmForge.Client.Components.LiveTableNotices />
            @Body
        </article>
    </main>
</div>

@code {
    //	The side menu folded to its icons: chosen by hand (remembered), or on its own in the character wizard
    private bool collapsed;
    private bool? wizardCollapsed;
    private bool OnWizard => System.Text.RegularExpressions.Regex.IsMatch(Navigation.ToBaseRelativePath(Navigation.Uri), @"^characters/(new|[0-9a-f-]{36}/edit)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    private bool Collapsed => OnWizard ? wizardCollapsed ?? true : collapsed;

    protected override void OnInitialized()
    {
        LanguageState.OnLanguageChanged += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!OnWizard)
        {
            wizardCollapsed = null;
        }
        StateHasChanged();
    }

    private async Task ToggleSidebarAsync()
    {
        if (OnWizard)
        {
            wizardCollapsed = !Collapsed;
            return;
        }
        collapsed = !collapsed;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "rf-sidebar", collapsed ? "1" : "0");
        }
        catch (Exception)
        {
        }
    }

    //	Listen to messages from other RealmForge tabs (e.g. e-mail confirmed from the link in the e-mail)
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                collapsed = await JS.InvokeAsync<string?>("localStorage.getItem", "rf-sidebar") == "1";
                if (collapsed && !OnWizard)
                {
                    StateHasChanged();
                }
            }
            catch (Exception)
            {
            }
            await CrossTab.StartAsync();
        }
    }

    public void Dispose()
    {
        LanguageState.OnLanguageChanged -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}