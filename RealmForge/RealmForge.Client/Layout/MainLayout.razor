@inherits LayoutComponentBase
@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.Enums
@implements IDisposable
@inject LanguageStateService LanguageState

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span class="text-secondary small">@UiText.VersionNotice(LanguageState.CurrentLanguage)</span>

            <div class="d-flex align-items-center gap-3">
                <RealmForge.Client.Components.LanguageSelector />
                <a href="https://github.com/VittorioNinno/realm-forge" target="_blank" rel="noopener" class="rf-github-link" title="GitHub">
                    <NavIcon Name="github" /> <span>GitHub</span>
                </a>
            </div>
        </div>

        <article class="content px-4">
            <RealmForge.Client.Components.ApiErrorBanner />
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        LanguageState.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        LanguageState.OnLanguageChanged -= StateHasChanged;
    }
}