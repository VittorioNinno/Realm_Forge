@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@implements IDisposable
@inject LanguageStateService LanguageState
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center gap-2" href="">
            <img src="img/icon-192.png" alt="" class="rf-brand-icon" width="30" height="30" />
            <span class="brand-title fw-bold" style="color: var(--rf-orange-primary);">RealmForge</span>
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable rf-sidebar-body" @onclick="ToggleNavMenu">
    <nav class="flex-column rf-nav">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <Icon Name="home" Class="rf-nav-icon" /> @UiText.NavDashboard(LanguageState.CurrentLanguage)
            </NavLink>
        </div>

        @* Global search: every section of the compendium and the glossary *@
        <div class="nav-item px-3" data-test="nav-search">
            <NavLink class="nav-link" href="search">
                <Icon Name="search" Class="rf-nav-icon" /> @UiText.SearchTitle(LanguageState.CurrentLanguage)
            </NavLink>
        </div>

        @* The characters of the signed-in user *@
        <div class="nav-item px-3" data-test="nav-characters">
            <NavLink class="nav-link" href="characters">
                <Icon Name="characters" Class="rf-nav-icon" /> @UiText.NavCharacters(LanguageState.CurrentLanguage)
            </NavLink>
        </div>

        @* The campaigns: the table, its characters and the shared content *@
        <div class="nav-item px-3" data-test="nav-campaigns">
            <NavLink class="nav-link" href="campaigns">
                <Icon Name="campaigns" Class="rf-nav-icon" /> @UiText.CampaignsTitle(LanguageState.CurrentLanguage)
            </NavLink>
        </div>

        @* Rules glossary: a reference of its own, before the compendium *@
        <div class="nav-item px-3 rf-nav-reference" data-test="nav-rules">
            <NavLink class="nav-link" href="rules">
                <Icon Name="rules" Class="rf-nav-icon" /> @UiText.NavRules(LanguageState.CurrentLanguage)
            </NavLink>
        </div>

        @* Reference data: always reachable, but kept out of the way in a collapsible section at the bottom *@
        <div class="rf-nav-group px-3" data-test="nav-compendium">
            <button type="button" class="rf-nav-group-toggle" aria-expanded="@compendiumOpen"
                    @onclick="ToggleCompendium" @onclick:stopPropagation="true">
                <Icon Name="compendium" Class="rf-nav-icon" />
                <span class="flex-grow-1 text-start">@UiText.NavCompendium(LanguageState.CurrentLanguage)</span>
                <span class="rf-nav-chevron @(compendiumOpen ? "open" : null)"><Icon Name="chevron" Class="rf-nav-icon" /></span>
            </button>

            @if (compendiumOpen)
            {
                <div class="rf-nav-group-items">
                    <NavLink class="nav-link" href="species">
                        <Icon Name="species" Class="rf-nav-icon" /> @UiText.NavSpecies(LanguageState.CurrentLanguage)
                    </NavLink>
                    <NavLink class="nav-link" href="backgrounds">
                        <Icon Name="backgrounds" Class="rf-nav-icon" /> @UiText.BackgroundsTitle(LanguageState.CurrentLanguage)
                    </NavLink>
                    <NavLink class="nav-link" href="feats">
                        <Icon Name="feats" Class="rf-nav-icon" /> @UiText.FeatsTitle(LanguageState.CurrentLanguage)
                    </NavLink>
                    <NavLink class="nav-link" href="spells">
                        <Icon Name="spells" Class="rf-nav-icon" /> @UiText.SpellsTitle(LanguageState.CurrentLanguage)
                    </NavLink>
                    <NavLink class="nav-link" href="classes">
                        <Icon Name="classes" Class="rf-nav-icon" /> @UiText.ClassesTitle(LanguageState.CurrentLanguage)
                    </NavLink>
                    <NavLink class="nav-link" href="equipment">
                        <Icon Name="equipment" Class="rf-nav-icon" /> @UiText.EquipmentTitle(LanguageState.CurrentLanguage)
                    </NavLink>
                    <NavLink class="nav-link" href="magic-items">
                        <Icon Name="magic-items" Class="rf-nav-icon" /> @UiText.MagicItemsTitle(LanguageState.CurrentLanguage)
                    </NavLink>
                    <NavLink class="nav-link" href="monsters">
                        <Icon Name="monsters" Class="rf-nav-icon" /> @UiText.MonstersTitle(LanguageState.CurrentLanguage)
                    </NavLink>
                    <NavLink class="nav-link" href="npcs" data-test="nav-npcs">
                        <Icon Name="npcs" Class="rf-nav-icon" /> @UiText.NpcsTitle(LanguageState.CurrentLanguage)
                    </NavLink>
                    <NavLink class="nav-link" href="modules" data-test="nav-modules">
                        <Icon Name="modules" Class="rf-nav-icon" /> @UiText.ModulesTitle(LanguageState.CurrentLanguage)
                    </NavLink>
                </div>
            }
        </div>

    </nav>

    @* Account (sign in / signed-in user and sign out) pinned at the bottom of the sidebar *@
    <UserMenu />
</div>

@code {
    private static readonly string[] CompendiumRoutes = ["species", "subspecies", "backgrounds", "feats", "spells", "classes", "equipment", "magic-items", "monsters", "npcs", "modules"];

    private bool collapseNavMenu = true;
    private bool compendiumOpen;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private void ToggleCompendium() => compendiumOpen = !compendiumOpen;

    protected override void OnInitialized()
    {
        //	Opened automatically when the user lands directly on a compendium page
        compendiumOpen = IsCompendiumRoute(Navigation.Uri);
        LanguageState.OnLanguageChanged += StateHasChanged;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!compendiumOpen && IsCompendiumRoute(e.Location))
        {
            compendiumOpen = true;
            StateHasChanged();
        }
    }

    private bool IsCompendiumRoute(string uri)
    {
        var path = Navigation.ToBaseRelativePath(uri).Split('?', '#')[0].Split('/')[0];
        return CompendiumRoutes.Contains(path, StringComparer.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        LanguageState.OnLanguageChanged -= StateHasChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
