@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.Enums
@implements IDisposable
@inject LanguageStateService LanguageState
@inject NavigationManager Navigation

@* The side menu: the emblem and the name on top (with the button that folds it to its icons), the main pages, the
   glossary and the compendium group, the account at the bottom. Folded (64 px) only the icons
   stay, each with its name as a tooltip; on phones it is a bar with the menu button *@
<aside class="rf-sidebar @(Collapsed ? "is-collapsed" : null)">
    <header class="sb-header">
        <a class="sb-brand" href="" title="RealmForge">
            <span class="sb-logo-box"><img src="img/icon-192.png" alt="" class="rf-brand-icon" width="28" height="28" /></span>
            <span class="sb-brand-text brand-title">RealmForge</span>
        </a>
        <button type="button" class="sb-toggle-btn" title="@ToggleText" aria-label="@ToggleText" aria-expanded="@(Collapsed ? "false" : "true")" @onclick="OnToggle" data-test="sidebar-collapse">
            <Icon Name="chevron-double-left" />
        </button>
        <button type="button" class="sb-mobile-btn" title="Menu" aria-label="Menu" aria-expanded="@(collapseNavMenu ? "false" : "true")" @onclick="ToggleNavMenu">
            <Icon Name="list" />
        </button>
    </header>

    <div class="sb-body @(collapseNavMenu ? "mobile-closed" : null)" @onclick="CloseMobile">
        <div class="sb-scroll-area">
            <nav class="sb-nav-group" aria-label="@UiText.NavMain(Lang)">
                <NavLink class="nav-link sb-item" href="" Match="NavLinkMatch.All" data-tooltip="@UiText.NavDashboard(Lang)">
                    <span class="sb-icon"><Icon Name="home" Class="rf-nav-icon" /></span>
                    <span class="sb-label">@UiText.NavDashboard(Lang)</span>
                </NavLink>
                @* Global search: every section of the compendium and the glossary *@
                <NavLink class="nav-link sb-item" href="search" data-tooltip="@UiText.SearchTitle(Lang)" data-test="nav-search">
                    <span class="sb-icon"><Icon Name="search" Class="rf-nav-icon" /></span>
                    <span class="sb-label">@UiText.SearchTitle(Lang)</span>
                </NavLink>
                @* The characters of the signed-in user *@
                <NavLink class="nav-link sb-item" href="characters" data-tooltip="@UiText.NavCharacters(Lang)" data-test="nav-characters">
                    <span class="sb-icon"><Icon Name="characters" Class="rf-nav-icon" /></span>
                    <span class="sb-label">@UiText.NavCharacters(Lang)</span>
                </NavLink>
                @* The campaigns: the table, its characters and the shared content *@
                <NavLink class="nav-link sb-item" href="campaigns" data-tooltip="@UiText.CampaignsTitle(Lang)" data-test="nav-campaigns">
                    <span class="sb-icon"><Icon Name="campaigns" Class="rf-nav-icon" /></span>
                    <span class="sb-label">@UiText.CampaignsTitle(Lang)</span>
                </NavLink>
            </nav>

            <div class="sb-divider"></div>

            @* Reference: the rules glossary, then the compendium, a group that opens on its own on its pages *@
            <nav class="sb-nav-group" aria-label="@UiText.NavCompendium(Lang)">
                <div data-test="nav-rules">
                <NavLink class="nav-link sb-item" href="rules" data-tooltip="@UiText.NavRules(Lang)">
                    <span class="sb-icon"><Icon Name="rules" Class="rf-nav-icon" /></span>
                    <span class="sb-label">@UiText.NavRules(Lang)</span>
                </NavLink>
                </div>
                <div data-test="nav-compendium">
                    <button type="button" class="rf-nav-group-toggle sb-section-trigger" aria-expanded="@(compendiumOpen ? "true" : "false")"
                            data-tooltip="@UiText.NavCompendium(Lang)" @onclick="ToggleCompendium" @onclick:stopPropagation="true">
                        <span class="sb-icon"><Icon Name="compendium" Class="rf-nav-icon" /></span>
                        <span class="sb-sec-text">@UiText.NavCompendium(Lang)</span>
                        <span class="sb-sec-chevron rf-nav-chevron @(compendiumOpen ? "open" : null)"><Icon Name="chevron" /></span>
                    </button>
                    @if (compendiumOpen)
                    {
                        <div class="sb-sub-items rf-nav-group-items">
                <NavLink class="nav-link sb-item" href="species" data-tooltip="@UiText.NavSpecies(Lang)">
                    <span class="sb-icon"><Icon Name="species" Class="rf-nav-icon" /></span>
                    <span class="sb-label">@UiText.NavSpecies(Lang)</span>
                </NavLink>
                <NavLink class="nav-link sb-item" href="backgrounds" data-tooltip="@UiText.BackgroundsTitle(Lang)">
                    <span class="sb-icon"><Icon Name="backgrounds" Class="rf-nav-icon" /></span>
                    <span class="sb-label">@UiText.BackgroundsTitle(Lang)</span>
                </NavLink>
                <NavLink class="nav-link sb-item" href="feats" data-tooltip="@UiText.FeatsTitle(Lang)">
                    <span class="sb-icon"><Icon Name="feats" Class="rf-nav-icon" /></span>
                    <span class="sb-label">@UiText.FeatsTitle(Lang)</span>
                </NavLink>
                <NavLink class="nav-link sb-item" href="spells" data-tooltip="@UiText.SpellsTitle(Lang)">
                    <span class="sb-icon"><Icon Name="spells" Class="rf-nav-icon" /></span>
                    <span class="sb-label">@UiText.SpellsTitle(Lang)</span>
                </NavLink>
                <NavLink class="nav-link sb-item" href="classes" data-tooltip="@UiText.ClassesTitle(Lang)">
                    <span class="sb-icon"><Icon Name="classes" Class="rf-nav-icon" /></span>
                    <span class="sb-label">@UiText.ClassesTitle(Lang)</span>
                </NavLink>
                <NavLink class="nav-link sb-item" href="equipment" data-tooltip="@UiText.EquipmentTitle(Lang)">
                    <span class="sb-icon"><Icon Name="equipment" Class="rf-nav-icon" /></span>
                    <span class="sb-label">@UiText.EquipmentTitle(Lang)</span>
                </NavLink>
                <NavLink class="nav-link sb-item" href="magic-items" data-tooltip="@UiText.MagicItemsTitle(Lang)">
                    <span class="sb-icon"><Icon Name="magic-items" Class="rf-nav-icon" /></span>
                    <span class="sb-label">@UiText.MagicItemsTitle(Lang)</span>
                </NavLink>
                <NavLink class="nav-link sb-item" href="monsters" data-tooltip="@UiText.MonstersTitle(Lang)">
                    <span class="sb-icon"><Icon Name="monsters" Class="rf-nav-icon" /></span>
                    <span class="sb-label">@UiText.MonstersTitle(Lang)</span>
                </NavLink>
                <NavLink class="nav-link sb-item" href="npcs" data-tooltip="@UiText.NpcsTitle(Lang)" data-test="nav-npcs">
                    <span class="sb-icon"><Icon Name="npcs" Class="rf-nav-icon" /></span>
                    <span class="sb-label">@UiText.NpcsTitle(Lang)</span>
                </NavLink>
                <NavLink class="nav-link sb-item" href="modules" data-tooltip="@UiText.ModulesTitle(Lang)" data-test="nav-modules">
                    <span class="sb-icon"><Icon Name="modules" Class="rf-nav-icon" /></span>
                    <span class="sb-label">@UiText.ModulesTitle(Lang)</span>
                </NavLink>
                        </div>
                    }
                </div>
            </nav>
        </div>

        <footer class="sb-footer">
            @* Account (sign in / signed-in user and sign out); the menu folds from the button on top *@
            <UserMenu />
        </footer>
    </div>
</aside>

@code {
    private static readonly string[] CompendiumRoutes = ["species", "subspecies", "backgrounds", "feats", "spells", "classes", "equipment", "magic-items", "monsters", "npcs", "modules"];

    private bool collapseNavMenu = true;
    private bool compendiumOpen;

    //	Folded to its icons (desktop), and what folds or unfolds it (the layout keeps the choice)
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }

    private LanguageCode Lang => LanguageState.CurrentLanguage;

    private string ToggleText => Collapsed ? UiText.SidebarExpand(Lang) : UiText.SidebarCollapse(Lang);

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    //	A choice in the menu closes it on phones
    private void CloseMobile() => collapseNavMenu = true;

    //	Folded, the compendium unfolds the menu first
    private async Task ToggleCompendium()
    {
        if (Collapsed)
        {
            compendiumOpen = true;
            await OnToggle.InvokeAsync();
            return;
        }
        compendiumOpen = !compendiumOpen;
    }

    protected override void OnInitialized()
    {
        //	Opened automatically when the user lands directly on a compendium page
        compendiumOpen = IsCompendiumRoute(Navigation.Uri);
        LanguageState.OnLanguageChanged += StateHasChanged;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!compendiumOpen && IsCompendiumRoute(e.Location))
        {
            compendiumOpen = true;
            StateHasChanged();
        }
    }

    private bool IsCompendiumRoute(string uri)
    {
        var path = Navigation.ToBaseRelativePath(uri).Split('?', '#')[0].Split('/')[0];
        return CompendiumRoutes.Contains(path, StringComparer.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        LanguageState.OnLanguageChanged -= StateHasChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
