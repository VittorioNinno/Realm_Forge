@page "/images"
@using RealmForge.Client.Components
@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.DTOs
@using RealmForge.Shared.Enums
@using RealmForge.Shared.Monsters
@implements IDisposable
@inject ImageDataService Images
@inject MonsterDataService MonsterService
@inject LanguageStateService LanguageState
@inject IJSRuntime JS

<PageTitle>RealmForge - @UiText.ImagesTitle(Lang)</PageTitle>

@* The account's images: pictures for the tokens of the virtual tabletop and for monsters and NPCs (on their page,
   their sheet and their tokens). Uploaded here, from a token or from a monster's page *@
<div class="container-fluid px-0 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3" style="border-bottom: 2px solid var(--rf-orange-primary);">
        <div>
            <h1 class="h3 fw-bold mb-2 rf-page-title" data-test="images-title">@UiText.ImagesTitle(Lang)</h1>
            <p class="mb-0 small" style="color: var(--rf-text-muted); letter-spacing: 1px; text-transform: uppercase;">@UiText.ImagesSubtitle(Lang)</p>
        </div>
        <AuthorizeView>
            <Authorized>
                <label class="btn btn-rf-orange text-uppercase mb-0" data-test="images-upload">
                    <InputFile OnChange="UploadAsync" accept="image/*" multiple class="d-none" />
                    <Icon Name="plus" /> @UiText.ImageUpload(Lang)
                </label>
            </Authorized>
        </AuthorizeView>
    </div>

    <AuthorizeView>
        <NotAuthorized>
            <div class="rf-account-card text-center">
                <p class="mb-3" style="color: var(--rf-text-secondary);">@UiText.ImagesSignIn(Lang)</p>
                <a href="account" class="btn btn-rf-orange">@UiText.NavAccount(Lang)</a>
            </div>
        </NotAuthorized>
        <Authorized>
            @if (error is not null)
            {
                <div class="rf-cast-warning mb-3" role="alert">@error</div>
            }
            @if (images is null)
            {
                <div class="small" style="color: var(--rf-text-muted);">…</div>
            }
            else if (images.Count == 0)
            {
                <div class="rf-account-card text-center" data-test="images-empty">
                    <p class="mb-0" style="color: var(--rf-text-secondary);">@UiText.ImagesEmpty(Lang)</p>
                </div>
            }
            else
            {
                <div class="rf-images" data-test="images-list">
                    @foreach (var image in images)
                    {
                        var item = image;
                        <article class="rf-image-card" data-test="image-card">
                            <img src="@Images.FileUrl(item.Id)" alt="@item.Name" loading="lazy" />
                            <div class="rf-image-card-body">
                                <input class="rf-form-control" maxlength="100" value="@item.Name" @onchange="e => RenameAsync(item, e.Value?.ToString())" aria-label="@UiText.ImageName(Lang)" data-test="image-name" />
                                <div class="rf-image-uses">
                                    @foreach (var monsterId in item.Monsters)
                                    {
                                        var used = monsterId;
                                        <span class="rf-image-use" data-test="image-use">
                                            @NameOf(used)
                                            <button type="button" class="rf-vtt-icon-button" aria-label="@UiText.BtnRemove(Lang)" @onclick="() => UnassignAsync(used)"><Icon Name="close" /></button>
                                        </span>
                                    }
                                </div>
                                <div class="position-relative">
                                    <input class="rf-form-control" placeholder="@UiText.ImageAssign(Lang)" value="@(assigning == item.Id ? search : null)" @oninput="e => SearchAsync(item.Id, e)" data-test="image-assign" />
                                    @if (assigning == item.Id && results.Count > 0)
                                    {
                                        <div class="rf-forge-selector-menu" style="left: 0; right: 0;">
                                            @foreach (var m in results)
                                            {
                                                var monster = m;
                                                <button type="button" class="rf-forge-selector-option" @onclick="() => AssignAsync(item.Id, monster)" data-test="image-assign-result">
                                                    @monster.Name <span class="small" style="color: var(--rf-text-muted);">· @(monster.IsNpc ? UiText.TokenKindName(RealmForge.Shared.Campaigns.TokenKind.Npc, Lang) : UiText.TokenKindName(RealmForge.Shared.Campaigns.TokenKind.Monster, Lang))</span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                                <button type="button" class="btn btn-sm btn-rf-outline align-self-start" style="border-color: #dc3545; color: #dc3545;" @onclick="() => DeleteAsync(item)" data-test="image-delete"><Icon Name="trash" /> @UiText.BtnRemove(Lang)</button>
                            </div>
                        </article>
                    }
                </div>
            }
        </Authorized>
    </AuthorizeView>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private LanguageCode Lang => LanguageState.CurrentLanguage;
    private List<UserImageDto>? images;
    private Dictionary<Guid, string> names = new();
    private string? error;
    private Guid? assigning;
    private string search = string.Empty;
    private List<MonsterResponseDto> results = new();

    protected override async Task OnInitializedAsync()
    {
        LanguageState.OnLanguageChanged += StateHasChanged;
        if (AuthState is not null && (await AuthState).User.Identity?.IsAuthenticated == true)
        {
            images = (await Images.GetImagesAsync(fresh: true)).ToList();
            var monsters = await MonsterService.GetMonstersAsync(Lang);
            names = monsters.GroupBy(m => m.Id).ToDictionary(g => g.Key, g => g.First().Name);
        }
    }

    private string NameOf(Guid monsterId) => names.TryGetValue(monsterId, out var name) ? name : "?";

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        error = null;
        foreach (var file in e.GetMultipleFiles(20))
        {
            if (await ImageUpload.SendAsync(Images, JS, file) is null)
            {
                error = UiText.ImageTooLarge(Lang);
            }
        }
        images = (await Images.GetImagesAsync()).ToList();
    }

    private async Task RenameAsync(UserImageDto image, string? name)
    {
        if (!string.IsNullOrWhiteSpace(name) && name.Trim() != image.Name)
        {
            error = await Images.RenameAsync(image.Id, name.Trim()) ? null : UiText.MapSaveFailed(Lang);
            images = (await Images.GetImagesAsync()).ToList();
        }
    }

    private async Task DeleteAsync(UserImageDto image)
    {
        error = await Images.DeleteAsync(image.Id) ? null : UiText.MapSaveFailed(Lang);
        images = (await Images.GetImagesAsync()).ToList();
    }

    private async Task SearchAsync(Guid imageId, ChangeEventArgs e)
    {
        assigning = imageId;
        search = e.Value?.ToString() ?? string.Empty;
        var term = search.Trim();
        if (term.Length < 2)
        {
            results = new();
            return;
        }
        var all = await MonsterService.GetMonstersAsync(Lang);
        results = all.Where(m => m.Name.Contains(term, StringComparison.OrdinalIgnoreCase))
            .OrderBy(m => RealmForge.Shared.Text.SearchRank.Of(term, m.Name, new[] { m.Alias })).ThenBy(m => m.Name).Take(8).ToList();
    }

    private async Task AssignAsync(Guid imageId, MonsterResponseDto monster)
    {
        assigning = null;
        search = string.Empty;
        results = new();
        error = await Images.ChooseAsync(monster.Id, imageId) ? null : UiText.MapSaveFailed(Lang);
        images = (await Images.GetImagesAsync(fresh: true)).ToList();
    }

    private async Task UnassignAsync(Guid monsterId)
    {
        error = await Images.ChooseAsync(monsterId, null) ? null : UiText.MapSaveFailed(Lang);
        images = (await Images.GetImagesAsync(fresh: true)).ToList();
    }

    public void Dispose() => LanguageState.OnLanguageChanged -= StateHasChanged;
}
