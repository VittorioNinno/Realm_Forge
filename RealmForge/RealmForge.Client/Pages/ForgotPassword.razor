@page "/forgot-password"
@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@implements IDisposable
@inject AuthService Auth
@inject LanguageStateService LanguageState

<PageTitle>RealmForge - @UiText.LinkForgotPassword(LanguageState.CurrentLanguage)</PageTitle>

@* Step 1 of the password recovery: the e-mail with the reset link *@
<div class="container-fluid px-0 py-4" style="max-width: 460px;" data-test="forgot-password">
    <h1 class="h3 fw-bold mb-4 pb-3 rf-page-title" style="border-bottom: 2px solid var(--rf-orange-primary);">
        @UiText.ForgotPasswordTitle(LanguageState.CurrentLanguage)
    </h1>

    @if (sentTo != null)
    {
        <div class="alert bg-dark border-success text-success small" data-test="forgot-password-sent">
            @UiText.ForgotPasswordSent(sentTo, LanguageState.CurrentLanguage)
        </div>
        <p class="small" style="color: var(--rf-text-muted);">@UiText.ForgotPasswordUnconfirmedHint(LanguageState.CurrentLanguage)</p>
        <a href="account" class="btn btn-rf-outline">@UiText.BtnBackToLogin(LanguageState.CurrentLanguage)</a>
    }
    else
    {
        <p class="small mb-3" style="color: var(--rf-text-secondary);">@UiText.ForgotPasswordIntro(LanguageState.CurrentLanguage)</p>

        @if (error != null)
        {
            <div class="alert alert-warning bg-dark border-warning text-warning p-2 small mb-3">@UiText.AuthError(error, LanguageState.CurrentLanguage)</div>
        }

        <div class="mb-4">
            <label class="rf-form-label">Email</label>
            <input type="email" class="rf-form-control" autocomplete="username" data-test="forgot-email" @bind="email" />
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <a href="account" class="small">@UiText.BtnBackToLogin(LanguageState.CurrentLanguage)</a>
            <button class="btn btn-rf-orange" data-test="forgot-submit" @onclick="SubmitAsync" disabled="@isBusy">
                @(isBusy ? "..." : UiText.BtnSendResetLink(LanguageState.CurrentLanguage))
            </button>
        </div>
    }
</div>

@code {
    private string email = "";
    private string? error;
    private string? sentTo;
    private bool isBusy;

    protected override void OnInitialized() => LanguageState.OnLanguageChanged += StateHasChanged;

    private async Task SubmitAsync()
    {
        error = null;

        if (string.IsNullOrWhiteSpace(email))
        {
            error = "MissingEmail";
            return;
        }

        isBusy = true;
        var result = await Auth.ForgotPasswordAsync(email.Trim());
        isBusy = false;

        //	The same answer for every address: whether an account exists is never revealed
        if (result.Success)
        {
            sentTo = email.Trim();
        }
        else
        {
            error = result.Errors.FirstOrDefault() ?? "Unknown";
        }
    }

    public void Dispose() => LanguageState.OnLanguageChanged -= StateHasChanged;
}
