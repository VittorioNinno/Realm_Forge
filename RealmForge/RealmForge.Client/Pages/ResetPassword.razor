@page "/reset-password"
@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@implements IDisposable
@inject AuthService Auth
@inject LanguageStateService LanguageState

<PageTitle>RealmForge - @UiText.ResetPasswordTitle(LanguageState.CurrentLanguage)</PageTitle>

@* Step 2 of the password recovery: landing page of the link in the reset e-mail (?email=...&code=...) *@
<div class="container-fluid px-0 py-4" style="max-width: 460px;" data-test="reset-password">
    <h1 class="h3 fw-bold mb-4 pb-3 rf-page-title" style="border-bottom: 2px solid var(--rf-orange-primary);">
        @UiText.ResetPasswordTitle(LanguageState.CurrentLanguage)
    </h1>

    @if (done)
    {
        <div class="alert bg-dark border-success text-success small" data-test="reset-password-done">@UiText.ResetPasswordDone(LanguageState.CurrentLanguage)</div>
        <a href="account" class="btn btn-rf-orange">@UiText.BtnBackToLogin(LanguageState.CurrentLanguage)</a>
    }
    else if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Code))
    {
        @* Opened without the parameters of the e-mail link *@
        <div class="alert alert-warning bg-dark border-warning text-warning small" data-test="reset-password-invalid">@UiText.AuthError("InvalidResetLink", LanguageState.CurrentLanguage)</div>
        <a href="forgot-password" class="btn btn-rf-outline">@UiText.BtnRequestNewLink(LanguageState.CurrentLanguage)</a>
    }
    else
    {
        <p class="small mb-3" style="color: var(--rf-text-secondary);">@UiText.ResetPasswordFor(Email, LanguageState.CurrentLanguage)</p>

        @if (errors.Count > 0)
        {
            <div class="alert alert-warning bg-dark border-warning text-warning p-2 small mb-3" data-test="reset-password-errors">
                @foreach (var error in errors)
                {
                    <div>@UiText.AuthError(error, LanguageState.CurrentLanguage)</div>
                }
            </div>
        }

        @* Lets password managers store the new password for the right account *@
        <input type="email" autocomplete="username" value="@Email" readonly hidden />
        <div class="mb-3">
            <label class="rf-form-label">@UiText.LabelNewPassword(LanguageState.CurrentLanguage)</label>
            <PasswordInput @bind-Value="newPassword" Autocomplete="new-password" DataTest="reset-new" />
        </div>
        <div class="mb-2">
            <label class="rf-form-label">@UiText.LabelRepeatPassword(LanguageState.CurrentLanguage)</label>
            <PasswordInput @bind-Value="repeatPassword" Autocomplete="new-password" DataTest="reset-repeat"
                           Invalid="@PasswordMatchHint.IsDifferent(newPassword, repeatPassword)" DescribedBy="reset-match" />
            <PasswordMatchHint Password="@newPassword" Repeat="@repeatPassword" Id="reset-match" DataTest="reset-match" />
        </div>
        <div class="small mb-4" style="color: var(--rf-text-muted);">@UiText.PasswordHint(LanguageState.CurrentLanguage)</div>

        <div class="d-flex justify-content-between align-items-center gap-3">
            @if (errors.Contains("InvalidToken"))
            {
                <a href="forgot-password" class="small">@UiText.BtnRequestNewLink(LanguageState.CurrentLanguage)</a>
            }
            else
            {
                <span></span>
            }
            <button class="btn btn-rf-orange" data-test="reset-submit" @onclick="SubmitAsync" disabled="@isBusy">
                @(isBusy ? "..." : UiText.BtnSetPassword(LanguageState.CurrentLanguage))
            </button>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")] public string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "code")] public string? Code { get; set; }

    private string newPassword = "";
    private string repeatPassword = "";
    private List<string> errors = new();
    private bool isBusy;
    private bool done;

    protected override void OnInitialized() => LanguageState.OnLanguageChanged += StateHasChanged;

    private async Task SubmitAsync()
    {
        errors.Clear();

        if (string.IsNullOrWhiteSpace(newPassword))
        {
            errors.Add("MissingPasswords");
            return;
        }

        if (newPassword != repeatPassword)
        {
            errors.Add("PasswordsDiffer");
            return;
        }

        isBusy = true;
        var result = await Auth.ResetPasswordAsync(Email!, Code!, newPassword);
        isBusy = false;

        if (result.Success)
        {
            done = true;
            newPassword = repeatPassword = "";
        }
        else
        {
            errors = result.Errors.ToList();
        }
    }

    public void Dispose() => LanguageState.OnLanguageChanged -= StateHasChanged;
}
