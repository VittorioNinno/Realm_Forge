@page "/characters/{Id:guid}"
@using RealmForge.Client.Components
@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.Characters
@using RealmForge.Shared.DTOs
@using RealmForge.Shared.Enums
@using RealmForge.Shared.Localization
@using RealmForge.Shared.Rules

<PageTitle>RealmForge - @(character?.Name ?? UiText.NavCharacters(Lang))</PageTitle>

<div class="py-4">
    <a href="characters" class="small text-decoration-none d-inline-block mb-3" style="color: var(--rf-text-muted);">@UiText.BtnBackToCharacters(Lang)</a>

    @if (loading)
    {
        <div class="small" style="color: var(--rf-text-muted);">@UiText.LoadingCharacters(Lang)</div>
    }
    else if (character is null)
    {
        <div class="rf-account-card text-center" data-test="character-missing">@UiText.CharacterNotFound(Lang)</div>
    }
    else if (computed is null || context is null)
    {
        <div class="rf-account-card text-center">@UiText.RulesUnavailable(Lang)</div>
    }
    else
    {
        var c = computed;
        <div class="rf-sheet2" data-test="character-sheet">

            @* ===== Toolbar: save state and the less frequent actions, kept out of the way ===== *@
            <div class="rf-sheet-toolbar">
                <span class="rf-sheet-save @(saveStatus == SaveStatus.Failed ? "text-warning" : null)" data-test="sheet-save-status">@SaveText</span>
                <a class="rf-tool-btn" href="@($"characters/{character.Id}/edit")" title="@UiText.BtnEditCharacter(Lang)" data-test="sheet-edit">@Icon("edit")<span>@UiText.BtnEditShort(Lang)</span></a>
                <button type="button" class="rf-tool-btn" @onclick="DownloadPdfAsync" title="@UiText.BtnDownloadPdf(Lang)" data-test="sheet-pdf">@Icon("download")<span>PDF</span></button>
                <button type="button" class="rf-tool-btn danger" @onclick="() => deleteOpen = true" title="@UiText.Delete(Lang)" data-test="sheet-delete">@Icon("trash")<span>@UiText.Delete(Lang)</span></button>
            </div>

            @* ===== Identity card: portrait, name, origin, classes with the level up, personal details, traits ===== *@
            <section class="rf-card2 rf-hero">
                <div class="rf-hero-top">
                    <div class="rf-hero-portrait @(Sheet.Portrait is null ? "empty" : null)" style="@(Sheet.Portrait is { } src ? $"background-image: url('{src}');" : null)">
                        <label class="rf-hero-portrait-upload" title="@UiText.BtnPortrait(Lang)">
                            <InputFile OnChange="UploadPortraitAsync" accept="image/*" class="d-none" />
                            @(Sheet.Portrait is null ? UiText.BtnPortrait(Lang) : "✎")
                        </label>
                        @if (Sheet.Portrait is not null)
                        {
                            <button type="button" class="rf-hero-portrait-remove" @onclick="RemovePortrait" aria-label="@UiText.BtnRemove(Lang)">✕</button>
                        }
                    </div>
                    <div class="rf-hero-info">
                        <div class="rf-sheet-name" data-test="sheet-name">@character.Name</div>
                        <div class="rf-hero-origin">
                            @(c.Subspecies is { } sub ? $"{sub.Name} ({c.Species?.Name})" : c.Species?.Name)
                            <span class="rf-hero-sep">|</span>
                            <a href="@($"backgrounds?id={character.BackgroundId}")" class="text-reset">@c.Background?.Name</a>
                        </div>
                        <div class="rf-hero-classline">
                            <span class="rf-hero-classes" data-test="sheet-classes">@ClassLine</span>
                            <span class="rf-hero-level">@UiText.CharacterLevel(c.Level, Lang)</span>
                            @if (c.Level < 20)
                            {
                                <a class="rf-levelup-pill @(ReadyToLevelUp ? "ready rf-pulse" : null)" href="@($"characters/{character.Id}/edit?levelup=true")" data-test="sheet-levelup">@Icon("up")@UiText.BtnLevelUp(Lang)</a>
                            }
                        </div>
                        <div class="rf-hero-bio">
                            @BioField(UiText.LabelAge(Lang), Sheet.Age, v => Sheet.Age = v, "age")
                            @BioField(UiText.LabelGender(Lang), Sheet.Gender, v => Sheet.Gender = v, "gender")
                            <div><div class="rf-mini-label">@UiText.LabelAlignment(Lang)</div><div class="rf-hero-bio-value">@UiText.AlignmentName(character.Build.Alignment, Lang)</div></div>
                            @BioField(UiText.LabelFaith(Lang), Sheet.Faith, v => Sheet.Faith = v, "faith")
                            <div><div class="rf-mini-label">@UiText.LabelSize(Lang)</div><div class="rf-hero-bio-value">@UiText.FormatSizeSingle(character.Build.Size, Lang)</div></div>
                            <div><div class="rf-mini-label">@UiText.LabelEdition(Lang)</div><div class="rf-hero-bio-value">@UiText.FormatRuleset(Ruleset, Lang)</div></div>
                        </div>
                    </div>
                </div>
                @if (portraitError is not null)
                {
                    <div class="small text-warning mt-2">@portraitError</div>
                }

                @if (SpeciesTraits.Any())
                {
                    <div class="rf-mini-title mt-3">@UiText.SheetSensesAndTraits(Lang)</div>
                    <div class="rf-chip-list">
                        @foreach (var trait in SpeciesTraits)
                        {
                            var t = trait;
                            <button type="button" class="rf-chip @(openTrait == t.Name ? "open" : null)" @onclick="() => ToggleTrait(t.Name)" data-test="sheet-trait">@t.Name</button>
                        }
                    </div>
                    @if (SpeciesTraits.FirstOrDefault(t => t.Name == openTrait) is { } shown)
                    {
                        <div class="rf-chip-detail rf-markdown-container">@((MarkupString)MarkdownText.ToHtml(shown.Description, Glossary.Linker(Lang, Ruleset)))</div>
                    }
                }

                <div class="rf-hero-footer">
                    <div><span class="rf-mini-label">@UiText.LabelLanguages(Ruleset, Lang):</span> @string.Join(", ", c.Languages.Select(l => CharacterLanguages.Name(Ruleset, l, Lang)))</div>
                    @if (c.Feats.Count > 0)
                    {
                        <div><span class="rf-mini-label">@UiText.SheetFeats(Lang):</span> @string.Join(", ", c.Feats.Select(f => f.Feat.Name))</div>
                    }
                    <div><span class="rf-mini-label">@UiText.SheetArmorTraining(Lang):</span> @UiText.ArmorTrainingText(c.ArmorTraining, Lang)</div>
                    @if (!string.IsNullOrWhiteSpace(backgroundDetail?.ToolProficiencies))
                    {
                        <div><span class="rf-mini-label">@UiText.LabelTools(Lang):</span> @backgroundDetail.ToolProficiencies</div>
                    }
                </div>
            </section>

            @if (c.Issues.Count > 0)
            {
                <div class="rf-sheet-todo" data-test="sheet-todo">
                    <span class="fw-bold">@UiText.SheetTodoBanner(Lang)</span>
                    @string.Join(" · ", c.Issues.Select(i => UiText.Issue(i, Ruleset, Lang)).Distinct().Take(6))
                    <a href="@($"characters/{character.Id}/edit")" class="ms-1">@UiText.BtnEditCharacter(Lang)</a>
                </div>
            }

            @* ===== Stats strip: defenses, speed, inspiration and passive scores ===== *@
            <section class="rf-stat-strip" data-test="sheet-stats">
                <div class="rf-defense"><div class="rf-mini-label">@UiText.SheetArmorClass(Lang)</div><div class="rf-defense-value" data-test="sheet-ac">@c.ArmorClass</div></div>
                <button type="button" class="rf-defense rf-rollable" @onclick="() => Roll(UiText.SheetInitiative(Lang), c.Initiative)" data-test="sheet-initiative">
                    <div class="rf-mini-label">@UiText.SheetInitiative(Lang)</div><div class="rf-defense-value">@CharacterMath.FormatModifier(c.Initiative)</div>
                </button>
                <div class="rf-defense"><div class="rf-mini-label">@UiText.SheetSpeed(Lang)</div><div class="rf-defense-value rf-defense-small">@UiText.FormatSpeed(c.Speed, Lang)</div></div>
                <div class="rf-defense"><div class="rf-mini-label">@UiText.SheetProficiency(Lang)</div><div class="rf-defense-value">@CharacterMath.FormatModifier(c.ProficiencyBonus)</div></div>
                <button type="button" class="rf-defense rf-inspiration @(Sheet.Inspiration ? "on" : null)" @onclick="ToggleInspiration" aria-pressed="@Sheet.Inspiration" data-test="sheet-inspiration">
                    <div class="rf-mini-label">@UiText.SheetInspiration(Ruleset, Lang)</div>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.9L22 10l-5.5 4.8L18.2 22 12 18.3 5.8 22l1.7-7.2L2 10l7.1-1.1z" /></svg>
                </button>
                <div class="rf-defense"><div class="rf-mini-label">@UiText.PassiveShort(GameTerms.SkillName(Skill.Perception, Lang), Lang)</div><div class="rf-defense-value">@c.PassivePerception</div></div>
                <div class="rf-defense"><div class="rf-mini-label">@UiText.PassiveShort(GameTerms.SkillName(Skill.Investigation, Lang), Lang)</div><div class="rf-defense-value">@Passive(Skill.Investigation)</div></div>
                <div class="rf-defense"><div class="rf-mini-label">@UiText.PassiveShort(GameTerms.SkillName(Skill.Insight, Lang), Lang)</div><div class="rf-defense-value">@Passive(Skill.Insight)</div></div>
            </section>

            @* ===== Hit points, death saves, hit dice and rests, experience ===== *@
            <section class="rf-card2" data-test="sheet-hp-box">
                <div class="rf-hp @HpState" data-test="sheet-hp-panel">
                    <div class="rf-hp-top">
                        <div class="rf-hp-heart" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.7 4.5c2.1 0 3.6 1.1 5.3 3 1.7-1.9 3.2-3 5.3-3 3.7 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21z" /></svg>
                        </div>
                        <div class="rf-hp-numbers">
                            <div class="rf-mini-label">@UiText.SheetHitPoints(Lang)</div>
                            <div class="rf-hp-value">
                                <span class="rf-hp-current" data-test="sheet-hp-current">@CurrentHp</span>
                                <span class="rf-hp-max">/ <span data-test="sheet-hp">@MaxHp</span></span>
                                @if (Sheet.TemporaryHitPoints > 0)
                                {
                                    <span class="rf-hp-temp-chip" data-test="sheet-hp-temp">+@Sheet.TemporaryHitPoints @UiText.SheetTempShort(Lang)</span>
                                }
                            </div>
                        </div>
                        <div class="rf-hp-actions">
                            <div class="rf-hp-stepper">
                                <button type="button" class="rf-hp-step" @onclick="() => amount = Math.Max(1, amount - 1)" aria-label="−1">−</button>
                                <input type="number" min="0" max="9999" class="rf-hp-amount" value="@amount" @onchange="e => amount = int.TryParse(e.Value?.ToString(), out var v) ? Math.Max(0, v) : 0"
                                       aria-label="@UiText.PlaceholderAmount(Lang)" data-test="sheet-hp-amount" />
                                <button type="button" class="rf-hp-step" @onclick="() => amount = Math.Min(9999, amount + 1)" aria-label="+1">+</button>
                            </div>
                            <div class="rf-hp-buttons">
                                <button type="button" class="rf-hp-btn damage" @onclick="Damage" data-test="sheet-damage">@UiText.BtnDamage(Lang)</button>
                                <button type="button" class="rf-hp-btn heal" @onclick="Heal" data-test="sheet-heal">@UiText.BtnHeal(Lang)</button>
                                <button type="button" class="rf-hp-btn temp" @onclick="SetTemp" data-test="sheet-temp">@UiText.BtnTempHp(Lang)</button>
                            </div>
                        </div>
                    </div>
                    <div class="rf-hp-track" role="progressbar" aria-valuemin="0" aria-valuemax="@MaxHp" aria-valuenow="@CurrentHp">
                        <div class="rf-hp-fill" style="width: @(FillPercent)%;"></div>
                        @if (Sheet.TemporaryHitPoints > 0)
                        {
                            <div class="rf-hp-temp-fill" style="width: @(TempPercent)%;"></div>
                        }
                    </div>

                    @if (CurrentHp == 0)
                    {
                        <div class="rf-death @(Stable ? "stable" : Dead ? "dead" : null)" data-test="sheet-death-saves">
                            <div class="rf-death-head">
                                <span class="rf-mini-label">@UiText.SheetDeathSaves(Lang)</span>
                                @if (Stable || Dead)
                                {
                                    <span class="rf-death-state" data-test="sheet-death-state">@(Stable ? UiText.DeathSaveStable(Lang) : UiText.DeathSaveDead(Lang))</span>
                                }
                            </div>
                            <div class="rf-death-body">
                                <div class="rf-death-group">
                                    <span>@UiText.SheetSuccesses(Lang)</span>
                                    @for (var i = 1; i <= 3; i++)
                                    {
                                        var value = i;
                                        <button type="button" class="rf-death-box success @(Sheet.DeathSaveSuccesses >= value ? "on" : null)" @onclick="() => SetDeathSaves(true, value)" aria-label="@UiText.SheetSuccesses(Lang) @value"></button>
                                    }
                                </div>
                                <div class="rf-death-group">
                                    <span>@UiText.SheetFailures(Lang)</span>
                                    @for (var i = 1; i <= 3; i++)
                                    {
                                        var value = i;
                                        <button type="button" class="rf-death-box fail @(Sheet.DeathSaveFailures >= value ? "on" : null)" @onclick="() => SetDeathSaves(false, value)" aria-label="@UiText.SheetFailures(Lang) @value"></button>
                                    }
                                </div>
                                <button type="button" class="rf-death-roll" disabled="@(Stable || Dead)" @onclick="RollDeathSave" data-test="sheet-death-roll">@UiText.BtnRollDeathSave(Lang)</button>
                            </div>
                        </div>
                    }

                    <div class="rf-hp-footer">
                        <div class="rf-hp-footer-dice">
                            <span class="rf-mini-label">@UiText.SheetHitDice(Lang)</span>
                            @foreach (var (die, count) in c.HitDice)
                            {
                                <span class="rf-hitdice-value" data-test="sheet-hit-dice">@(count - HitDiceSpent(die))<span>/@(count)</span> <small>d@(die)</small></span>
                            }
                        </div>
                        <div class="rf-hp-footer-rests">
                            <button type="button" class="rf-rest-btn short" @onclick="() => shortRestOpen = true" data-test="sheet-short-rest">@UiText.BtnShortRest(Lang)</button>
                            <button type="button" class="rf-rest-btn long" @onclick="() => longRestOpen = true" data-test="sheet-long-rest">@UiText.BtnLongRest(Lang)</button>
                        </div>
                    </div>
                </div>

                <div class="rf-bar-row mb-0">
                    <div class="rf-advancement" role="group" aria-label="@UiText.LabelAdvancement(Lang)">
                        <span class="rf-mini-label">@UiText.LabelAdvancement(Lang)</span>
                        @foreach (var type in new[] { AdvancementType.Experience, AdvancementType.Milestone })
                        {
                            var t = type;
                            <button type="button" class="rf-wizard-pill @(Sheet.Advancement == t ? "selected" : null)" @onclick="() => SetAdvancement(t)"
                                    aria-pressed="@(Sheet.Advancement == t)" data-test="@($"sheet-advancement-{t.ToString().ToLowerInvariant()}")">@UiText.AdvancementName(t, Lang)</button>
                        }
                    </div>
                    @if (Sheet.Advancement == AdvancementType.Milestone)
                    {
                        <div class="small" style="color: var(--rf-text-secondary);" data-test="sheet-milestone">@UiText.MilestoneSheetText(Lang)</div>
                    }
                    else
                    {
                        <div class="rf-bar-label">
                            <span>@UiText.SheetExperience(Lang)</span>
                            <span data-test="sheet-xp-value">@Sheet.Experience / @NextLevelExperience</span>
                        </div>
                        <div class="rf-bar"><div class="rf-bar-fill xp" style="width: @(ExperiencePercent)%;"></div></div>
                        <div class="rf-bar-controls">
                            <NumberStepper Value="xpAmount" ValueChanged="v => xpAmount = v" Min="-1000000" Max="1000000" Step="10" AriaLabel="@UiText.SheetExperience(Lang)" InputTest="sheet-xp-amount" />
                            <button type="button" class="rf-wizard-btn" @onclick="AddExperience" data-test="sheet-xp-add">@UiText.BtnAddExperience(Lang)</button>
                        </div>
                        @if (ReadyToLevelUp)
                        {
                            <div class="small mt-2" style="color: var(--rf-orange-primary);">@UiText.ReadyToLevelUp(Lang)</div>
                        }
                    }
                </div>
            </section>

            @* ===== Ability scores ===== *@
            <div class="rf-ability-grid" data-test="sheet-scores">
                @foreach (var ability in CharacterMath.Abilities)
                {
                    var a = ability;
                    var proficient = c.SaveProficiencies.Contains(a);
                    var saveLabel = UiText.SheetSaveShort(Lang) + " " + FeatPrerequisiteFormatter.AbilityName(a, Lang);
                    <div class="rf-ability-card">
                        <button type="button" class="rf-ability-main rf-rollable" @onclick="() => Roll(FeatPrerequisiteFormatter.AbilityName(a, Lang), c.Modifier(a))">
                            <div class="rf-mini-label">@FeatPrerequisiteFormatter.AbilityName(a, Lang)</div>
                            <div class="rf-ability-mod">@CharacterMath.FormatModifier(c.Modifier(a))</div>
                            <div class="rf-ability-score">@c.Score(a)</div>
                        </button>
                        <button type="button" class="rf-ability-save rf-rollable @(proficient ? "proficient" : null)" @onclick="() => Roll(saveLabel, c.SaveBonus(a))" title="@UiText.SheetSaves(Lang)">
                            @UiText.SheetSaveShort(Lang) @CharacterMath.FormatModifier(c.SaveBonus(a))
                        </button>
                    </div>
                }
            </div>

            @* ===== Conditions and exhaustion ===== *@
            <section class="rf-card2" data-test="sheet-conditions">
                <div class="rf-card2-head"><span>@UiText.SheetConditionsTitle(Lang)</span></div>
                <div class="rf-exhaustion @(Sheet.Exhaustion > 0 ? "active" : null)">
                    <span>@UiText.SheetExhaustion(Lang) (@UiText.LevelShort(Lang) @Sheet.Exhaustion)</span>
                    <div class="d-flex gap-2">
                        <button type="button" class="rf-mini-btn" @onclick="() => ChangeExhaustion(-1)" data-test="sheet-exhaustion-minus">−</button>
                        <button type="button" class="rf-mini-btn" @onclick="() => ChangeExhaustion(1)" data-test="sheet-exhaustion-plus">+</button>
                        <button type="button" class="rf-mini-btn" @onclick="() => ChangeExhaustion(-ExhaustionMax)">@UiText.BtnReset(Lang)</button>
                    </div>
                </div>
                <div class="rf-condition-grid">
                    @foreach (var condition in conditions)
                    {
                        var cond = condition;
                        var active = Sheet.Conditions.Contains(cond.Key);
                        var implied = IsImplied(cond.Key);
                        <button type="button" class="rf-condition @(active ? "active" : implied ? "implied" : null)" title="@cond.Summary"
                                @onclick="() => ClickCondition(cond.Key)" data-test="sheet-condition">@cond.Name</button>
                    }
                </div>
                @if (Sheet.Exhaustion > 0 || Sheet.Conditions.Count > 0)
                {
                    <div class="rf-condition-notes">
                        @if (Sheet.Exhaustion > 0)
                        {
                            <div><strong class="text-danger">@UiText.SheetExhaustion(Lang) [@Sheet.Exhaustion]:</strong> @UiText.ExhaustionEffect(Ruleset, Sheet.Exhaustion, Lang)</div>
                        }
                        @foreach (var condition in conditions.Where(x => Sheet.Conditions.Contains(x.Key) || IsImplied(x.Key)))
                        {
                            <div><strong>@condition.Name.ToUpperInvariant() @(IsImplied(condition.Key) ? UiText.ConditionEffect(Lang) : UiText.ConditionCause(Lang)):</strong> @condition.Summary</div>
                        }
                    </div>
                }
            </section>

            @* ===== Dice result ===== *@
            <div class="rf-sheet-roller">
                <div class="rf-sheet-rollmode">
                    @foreach (var mode in Enum.GetValues<RollMode>())
                    {
                        var m = mode;
                        <button type="button" class="rf-wizard-pill @(rollMode == m ? "selected" : null)" @onclick="() => rollMode = m">@RollModeName(m)</button>
                    }
                </div>
                <span class="small" style="color: var(--rf-text-muted);">@UiText.HintClickToRoll(Lang)</span>
            </div>

            @TurnSummary(c)

            <div class="rf-sheet-tabs" role="tablist">
                @foreach (var t in Enum.GetValues<SheetTab>())
                {
                    var current = t;
                    <button type="button" role="tab" class="rf-sheet-tab @(tab == current ? "active" : null)" @onclick="() => tab = current" data-test="sheet-tab-@current.ToString().ToLowerInvariant()">@TabName(current)</button>
                }
            </div>

            <div class="rf-sheet-tab-body">
                @switch (tab)
                {
                    case SheetTab.Overview:
                        @OverviewTab(c)
                        break;
                    case SheetTab.Spells:
                        @SpellsTab(c)
                        break;
                    case SheetTab.Inventory:
                        @InventoryTab(c)
                        break;
                    case SheetTab.Features:
                        @FeaturesTab(c)
                        break;
                    default:
                        @NotesTab(c)
                        break;
                }
            </div>
        </div>
    }
</div>

<SpellDetailModal SpellId="spellDetailId" OnClose="CloseSpell" Actions="CastPanel()" />
<DiceTray @ref="diceTray" />

@if (shortRestOpen && computed is not null)
{
    <div class="rf-modal-backdrop" @onclick="() => shortRestOpen = false">
        <div class="rf-modal-dialog" style="max-width: 460px;" @onclick:stopPropagation="true" data-test="sheet-short-rest-dialog">
            <h2 class="h5 mb-2" style="color: var(--rf-orange-primary);">@UiText.BtnShortRest(Lang)</h2>
            <p class="small" style="color: var(--rf-text-secondary);">@UiText.ShortRestText(Lang)</p>
            <div class="d-flex flex-wrap gap-2 mb-3">
                @foreach (var (die, count) in computed.HitDice)
                {
                    var d = die;
                    var total = count;
                    <button type="button" class="btn btn-rf-outline btn-sm" disabled="@(HitDiceSpent(d) >= total || CurrentHp >= MaxHp)" @onclick="() => SpendHitDie(d, total)" data-test="sheet-spend-hit-die">
                        @UiText.BtnSpendHitDie(d, Lang) (@(total - HitDiceSpent(d)))
                    </button>
                }
            </div>
            @if (lastRoll is not null)
            {
                <div class="rf-sheet-lastroll mb-3">@lastRoll</div>
            }
            <div class="small mb-3">@UiText.SheetHitPoints(Lang): @CurrentHp / @MaxHp</div>
            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-rf-outline" @onclick="() => shortRestOpen = false">@UiText.BtnCancel(Lang)</button>
                <button class="btn btn-rf-orange" @onclick="FinishShortRest" data-test="sheet-short-rest-done">@UiText.BtnConfirm(Lang)</button>
            </div>
        </div>
    </div>
}

@if (longRestOpen)
{
    <div class="rf-modal-backdrop" @onclick="() => longRestOpen = false">
        <div class="rf-modal-dialog" style="max-width: 460px; text-align: center;" @onclick:stopPropagation="true" data-test="sheet-long-rest-dialog">
            <h2 class="h5 mb-2" style="color: var(--rf-orange-primary);">@UiText.BtnLongRest(Lang)</h2>
            <p style="color: var(--rf-text-secondary);">@UiText.LongRestText(Ruleset, Lang)</p>
            <div class="d-flex justify-content-center gap-2">
                <button class="btn btn-rf-outline" @onclick="() => longRestOpen = false">@UiText.BtnCancel(Lang)</button>
                <button class="btn btn-rf-orange" @onclick="LongRest" data-test="sheet-long-rest-done">@UiText.BtnConfirm(Lang)</button>
            </div>
        </div>
    </div>
}

@if (deleteOpen && character is not null)
{
    <div class="rf-modal-backdrop" @onclick="() => deleteOpen = false">
        <div class="rf-modal-dialog" @onclick:stopPropagation="true" style="max-width: 450px; text-align: center;">
            <h2 class="h4 mb-3" style="color: var(--rf-orange-primary);">@UiText.ConfirmDeletion(Lang)</h2>
            <div class="p-3 mb-4 rounded" style="background-color: var(--rf-bg-main); border: 1px solid var(--rf-border-subtle); color: var(--rf-text-secondary); line-height: 1.5;">
                @UiText.DeleteCharacterWarning(character.Name, Lang)
            </div>
            <div class="d-flex justify-content-center gap-3">
                <button class="btn btn-rf-outline" @onclick="() => deleteOpen = false">@UiText.BtnCancel(Lang)</button>
                <button class="btn btn-rf-orange" style="background-color: #dc3545; border-color: #dc3545;" @onclick="DeleteAsync" data-test="sheet-delete-confirm">@UiText.Delete(Lang)</button>
            </div>
        </div>
    </div>
}

@code {
    private string TabName(SheetTab t) => t switch
    {
        SheetTab.Overview => UiText.TabCombat(Lang),
        SheetTab.Spells => UiText.TabSpells(Lang),
        SheetTab.Inventory => UiText.TabInventory(Lang),
        SheetTab.Features => UiText.TabFeatures(Lang),
        _ => UiText.TabNotes(Lang)
    };

    private string RollModeName(RollMode m) => m switch
    {
        RollMode.Advantage => UiText.RollAdvantage(Lang),
        RollMode.Disadvantage => UiText.RollDisadvantage(Lang),
        _ => UiText.RollNormal(Lang)
    };

    private RenderFragment BioField(string label, string? value, Action<string?> set, string key) => @<div>
        <div class="rf-mini-label">@label</div>
        <input class="rf-hero-bio-input" value="@value" maxlength="40" placeholder="—" @onchange="e => SetBio(set, e)" aria-label="@label" data-test="@($"sheet-bio-{key}")" />
    </div>;

    // ===== Combat: skills, attacks, proficiencies =====
    private RenderFragment OverviewTab(ComputedCharacter c) => @<div class="rf-sheet-columns">
        <section class="rf-card2">
            <div class="rf-card2-head"><span>@UiText.SheetSkills(Lang)</span></div>
            <ul class="rf-sheet-list rf-sheet-rolls" data-test="sheet-skills">
                @foreach (var skill in Enum.GetValues<Skill>().OrderBy(s => GameTerms.SkillName(s, Lang)))
                {
                    var s = skill;
                    var proficient = c.SkillProficiencies.Contains(s);
                    <li class="@(proficient ? "rf-sheet-proficient" : null) @(c.Expertise.Contains(s) ? "rf-sheet-expert" : null)" @onclick="() => Roll(GameTerms.SkillName(s, Lang), c.SkillBonus(s))">
                        <span>@GameTerms.SkillName(s, Lang) <span class="small" style="color: var(--rf-text-muted);">(@UiText.AbilityShort(GameTerms.SkillAbility(s), Lang))</span></span>
                        <span>@CharacterMath.FormatModifier(c.SkillBonus(s))</span>
                    </li>
                }
            </ul>
        </section>
        <div>
            @if (ClassResources.Count > 0)
            {
                <section class="rf-card2" data-test="sheet-class-resources">
                    <div class="rf-card2-head"><span>@UiText.SheetClassResources(Lang)</span></div>
                    @foreach (var resource in ClassResources)
                    {
                        @ClassResourceRow(resource)
                    }
                </section>
            }
            <section class="rf-card2">
                <div class="rf-card2-head"><span>@UiText.SheetAttacks(Lang)</span></div>
                @if (c.Attacks.Count == 0)
                {
                    <div class="small" style="color: var(--rf-text-muted);">@UiText.NoAttacks(Lang)</div>
                }
                else
                {
                    <ul class="rf-sheet-list" data-test="sheet-attacks">
                        @foreach (var attack in c.Attacks)
                        {
                            var at = attack;
                            <li class="rf-sheet-attack">
                                <span class="fw-bold">@at.Item.Name@(at.Proficient ? null : $" ({UiText.SheetNotProficient(Lang)})")</span>
                                <button type="button" class="rf-wizard-pill" @onclick="() => Roll(at.Item.Name, at.AttackBonus)">@CharacterMath.FormatModifier(at.AttackBonus)</button>
                                <button type="button" class="rf-wizard-pill" @onclick="() => RollDamage(at.Item.Name, at.Damage)">
                                    @at.Damage @(at.DamageType is { } dt ? EquipmentTerms.DamageTypeName(dt, Lang) : null)
                                </button>
                                @if (at.VersatileDamage is { } versatile)
                                {
                                    <button type="button" class="rf-wizard-pill" @onclick="() => RollDamage(at.Item.Name, versatile)">@versatile</button>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>
            <section class="rf-card2">
                <div class="rf-card2-head"><span>@UiText.SheetProficiencies(Lang)</span></div>
                @foreach (var info in c.Classes.Where(i => i.Starting))
                {
                    if (classDetails.GetValueOrDefault(info.Class.Id) is { } detail)
                    {
                        if (!string.IsNullOrWhiteSpace(detail.WeaponProficiencies))
                        {
                            <div class="rf-wizard-text small mb-1"><strong>@UiText.LabelWeapons(Lang):</strong> @detail.WeaponProficiencies</div>
                        }
                        if (!string.IsNullOrWhiteSpace(detail.ToolProficiencies))
                        {
                            <div class="rf-wizard-text small mb-1"><strong>@UiText.LabelTools(Lang):</strong> @detail.ToolProficiencies</div>
                        }
                    }
                }
                <div class="rf-wizard-text small mb-1"><strong>@UiText.SheetArmorTraining(Lang):</strong> @UiText.ArmorTrainingText(c.ArmorTraining, Lang)</div>
                @if (!string.IsNullOrWhiteSpace(Sheet.OtherProficiencies))
                {
                    <div class="rf-wizard-text small mb-1">@Sheet.OtherProficiencies</div>
                }
            </section>
        </div>
    </div>;

    // ===== Spells: slots used with a button, spells with their details =====
    private RenderFragment SpellsTab(ComputedCharacter c) => @<div>
        @ConcentrationBanner()
        <div class="small mb-3" style="color: var(--rf-text-muted);">@UiText.HintCastFromSpell(Lang)</div>
        @if (c.SpellSlots.Any(s => s > 0) || c.PactSlots > 0)
        {
            <section class="rf-card2" data-test="sheet-slots">
                <div class="rf-card2-head"><span>@UiText.SheetSpellSlots(Lang)</span></div>
                @for (var l = 1; l <= 9; l++)
                {
                    var level = l;
                    var total = c.SpellSlots[level - 1];
                    if (total == 0)
                    {
                        continue;
                    }
                    var left = total - SpentSlots(level);
                    <div class="rf-slot-row">
                        <span class="rf-slot-level">@UiText.SlotLevel(level, Lang)</span>
                        <div class="rf-slot-dots">
                            @for (var i = 0; i < total; i++)
                            {
                                var index = i;
                                <button type="button" class="rf-slot-dot @(index < left ? "full" : null)" @onclick="() => ToggleSlot(level, total - 1 - index)" aria-label="@UiText.SlotLevel(level, Lang) @(index + 1)" data-test="sheet-slot"></button>
                            }
                        </div>
                        <span class="rf-slot-count">@left / @total</span>
                    </div>
                }
                @if (c.PactSlots > 0)
                {
                    var pactLeft = c.PactSlots - Sheet.SpentPactSlots;
                    <div class="rf-slot-row">
                        <span class="rf-slot-level">@UiText.SheetPactSlots(c.PactSlotLevel, Lang)</span>
                        <div class="rf-slot-dots">
                            @for (var i = 0; i < c.PactSlots; i++)
                            {
                                var index = i;
                                <button type="button" class="rf-slot-dot @(index < pactLeft ? "full" : null)" @onclick="() => TogglePactSlot(c.PactSlots - 1 - index)" data-test="sheet-pact-slot"></button>
                            }
                        </div>
                        <span class="rf-slot-count">@pactLeft / @c.PactSlots</span>
                    </div>
                }
            </section>
        }

        @if (c.Spellcasting.Count == 0)
        {
            <div class="small" style="color: var(--rf-text-muted);">@UiText.NoSpellsForClass(Lang)</div>
        }
        @foreach (var source in c.Spellcasting)
        {
            var name = source.Class is { } cls ? (cls.Subclass is { } sub && cls.Class.CasterProgression == CasterProgression.None ? $"{cls.Class.Name} · {sub.Name}" : cls.Class.Name)
                : source.Source == "species" ? UiText.SpellSourceSpecies(Ruleset, Lang) : source.Source;
            var spells = source.ChosenCantrips.Concat(source.ChosenSpells).Select(id => context!.Spells.FirstOrDefault(s => s.Id == id)).Where(s => s is not null).Select(s => s!).ToList();
            var attackLabel = UiText.SheetSpellAttack(Lang);
            <section class="rf-card2" data-test="sheet-spellcasting">
                <div class="rf-card2-head">
                    <span>@name</span>
                    <span class="rf-card2-head-accent">@UiText.SheetSpellcasting(source.Ability, source.SaveDc, source.AttackBonus, Lang)</span>
                </div>
                <div class="rf-spell-counts">
                    <div><div class="rf-mini-label">@UiText.LabelCantrips(Lang)</div><div class="rf-defense-value">@source.ChosenCantrips.Count / @source.Cantrips</div></div>
                    <div><div class="rf-mini-label">@UiText.SheetSpellsPrepared(Lang)</div><div class="rf-defense-value">@source.ChosenSpells.Count / @source.Spells</div></div>
                    <button type="button" class="rf-defense rf-rollable" @onclick="() => Roll(attackLabel, source.AttackBonus)">
                        <div class="rf-mini-label">@attackLabel</div><div class="rf-defense-value">@CharacterMath.FormatModifier(source.AttackBonus)</div>
                    </button>
                </div>
                @foreach (var group in spells.GroupBy(s => s.Level).OrderBy(g => g.Key))
                {
                    <div class="rf-mini-title">@(group.Key == 0 ? UiText.LabelCantrips(Lang) : GameTerms.SpellLevel(group.Key, Lang))</div>
                    <div class="rf-spell-rows" data-test="sheet-spells" data-level="@group.Key">
                        @foreach (var spell in group.OrderBy(s => s.Name))
                        {
                            var sp = spell;
                            <a href="@($"spells?id={sp.Id}")" class="rf-spell-row @(Sheet.Concentration == sp.Id ? "concentrating" : null)" @onclick="() => OpenSpell(sp, source)" @onclick:preventDefault="true">
                                <span class="rf-spell-row-name">@sp.Name</span>
                                <span class="rf-spell-row-tags">
                                    @if (sp.Concentration)
                                    {
                                        <span title="@UiText.ConcentrationShort(Lang)">C</span>
                                    }
                                    @if (sp.Ritual)
                                    {
                                        <span title="@UiText.RitualShort(Lang)">R</span>
                                    }
                                    <span class="rf-spell-row-school">@GameTerms.SchoolName(sp.School, Lang)</span>
                                </span>
                            </a>
                        }
                    </div>
                }
            </section>
        }
    </div>;

    // ===== Inventory: coins, worn items, backpack =====
    private RenderFragment InventoryTab(ComputedCharacter c) => @<section class="rf-card2">
        <div class="rf-coin-grid" data-test="sheet-coins">
            @foreach (var coin in new[] { CoinType.Cp, CoinType.Sp, CoinType.Ep, CoinType.Gp, CoinType.Pp })
            {
                var type = coin;
                <div class="rf-coin @($"rf-coin-{type.ToString().ToLowerInvariant()}")">
                    <div class="rf-coin-head">
                        <span class="rf-coin-badge">@UiText.CoinName(type, Lang)</span>
                        <span class="rf-mini-label">@UiText.CoinLongName(type, Lang)</span>
                    </div>
                    <div class="rf-coin-stepper">
                        <button type="button" class="rf-mini-btn" @onclick="() => AddCoin(type, -1)" aria-label="−1">−</button>
                        <input type="number" min="0" class="rf-coin-input" value="@Coin(type)" @onchange="e => SetCoin(type, e.Value?.ToString())" aria-label="@UiText.CoinLongName(type, Lang)" data-test="sheet-coin-@type.ToString().ToLowerInvariant()" />
                        <button type="button" class="rf-mini-btn" @onclick="() => AddCoin(type, 1)" aria-label="+1">+</button>
                    </div>
                </div>
            }
        </div>

        <div class="position-relative my-3">
            <input class="rf-wizard-input" placeholder="@UiText.PlaceholderSearchItem(Lang)" value="@itemSearch" @oninput="e => itemSearch = e.Value?.ToString() ?? string.Empty" data-test="sheet-item-search" />
            @if (!string.IsNullOrWhiteSpace(itemSearch))
            {
                <div class="rf-forge-selector-menu" style="left: 0; right: 0;">
                    @foreach (var item in SearchResults)
                    {
                        var it = item;
                        <button type="button" class="rf-forge-selector-option" @onclick="() => AddItem(it)" data-test="sheet-item-result">@it.Name <span class="small" style="color: var(--rf-text-muted);">· @EquipmentTerms.CategoryName(it.Category, Lang)</span></button>
                    }
                    <button type="button" class="rf-forge-selector-option" @onclick="AddFreeItem" data-test="sheet-item-free">@UiText.BtnAddFreeItem(itemSearch.Trim(), Lang)</button>
                </div>
            }
        </div>

        <div data-test="sheet-inventory">
            @foreach (var group in new[] { true, false })
            {
                var equipped = group;
                var items = Sheet.Inventory.Where(i => i.Equipped == equipped).ToList();
                if (items.Count == 0 && equipped)
                {
                    continue;
                }
                <div class="rf-mini-title">@(equipped ? UiText.SheetEquippedGroup(Lang) : UiText.SheetBackpack(Lang))</div>
                @foreach (var entry in items)
                {
                    var item = entry;
                    var info = ItemOf(item);
                    <div class="rf-item-row" data-test="sheet-item">
                        <div class="rf-item-name">
                            @if (info is not null)
                            {
                                <a href="@($"equipment?id={info.Id}")" target="_blank" rel="noopener" class="text-reset">@info.Name</a>
                                <span class="small" style="color: var(--rf-text-muted);">@ItemDetail(info)</span>
                            }
                            else
                            {
                                <span>@item.Name</span>
                            }
                        </div>
                        <div class="rf-item-controls">
                            <button type="button" class="rf-mini-btn" @onclick="() => ChangeQuantity(item, -1)" aria-label="−1">−</button>
                            <span class="rf-item-qty">×@item.Quantity</span>
                            <button type="button" class="rf-mini-btn" @onclick="() => ChangeQuantity(item, 1)" aria-label="+1">+</button>
                            @if (IsWearable(item))
                            {
                                <button type="button" class="rf-item-equip @(item.Equipped ? "on" : null)" @onclick="() => Equip(item)" data-test="sheet-item-equip">@(item.Equipped ? UiText.BtnUnequip(Lang) : UiText.BtnEquip(Lang))</button>
                            }
                            <button type="button" class="rf-mini-btn @(item.Attuned ? "on" : null)" title="@UiText.SheetAttuned(Lang)" @onclick="() => ToggleAttuned(item)">✦</button>
                            <button type="button" class="rf-mini-btn" @onclick="() => RemoveItem(item)" title="@UiText.BtnDeleteItem(Lang)" aria-label="@UiText.BtnDeleteItem(Lang)" data-test="sheet-item-remove">✕</button>
                        </div>
                    </div>
                }
            }
        </div>
        <div class="small mt-2 @(CarriedWeight > CarryingCapacity ? "text-warning" : null)" style="color: var(--rf-text-muted);">
            @UiText.SheetCarrying(UiText.FormatWeight(CarriedWeight, Lang), UiText.FormatWeight(CarryingCapacity, Lang), Lang)
        </div>
    </section>;

    private string ItemDetail(ContextItem info)
    {
        var parts = new List<string>();
        if (info.ArmorCategory is not null && info.ArmorClass is not null)
        {
            parts.Add(EquipmentTerms.FormatArmorClass(info.ArmorCategory, info.ArmorClass, info.ArmorAddsDexterity, info.ArmorMaxDexterityBonus, Lang));
        }
        if (info.DamageDice is not null)
        {
            parts.Add(EquipmentTerms.FormatDamage(info.DamageDice, info.DamageType, Lang));
        }
        if (info.WeightInPounds is { } w)
        {
            parts.Add(UiText.FormatWeight(w, Lang));
        }
        return parts.Count == 0 ? string.Empty : "· " + string.Join(" · ", parts);
    }

    // ===== Features: resources, class, species and background features =====
    private RenderFragment FeaturesTab(ComputedCharacter c) => @<div>
        <section class="rf-card2">
            <div class="rf-card2-head"><span>@UiText.SheetOtherResources(Lang)</span></div>
            <div class="small mb-2" style="color: var(--rf-text-muted);">@UiText.HintOtherResources(Lang)</div>
            @foreach (var counter in Sheet.Resources.ToList())
            {
                var resource = counter;
                <div class="rf-slot-row" data-test="sheet-resource">
                    <span class="rf-slot-level">@resource.Name@(resource.ShortRest ? " ↺" : null)</span>
                    <div class="rf-slot-dots">
                        @for (var i = 0; i < resource.Maximum; i++)
                        {
                            var index = i;
                            <button type="button" class="rf-slot-dot @(index < resource.Maximum - resource.Used ? "full" : null)" @onclick="() => UseResource(resource, resource.Maximum - 1 - index)"></button>
                        }
                    </div>
                    <button type="button" class="rf-mini-btn" @onclick="() => RemoveResource(resource)" aria-label="@UiText.BtnRemove(Lang)">✕</button>
                </div>
            }
            <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
                <input class="rf-wizard-input flex-grow-1" style="min-width: 180px; width: auto;" placeholder="@UiText.PlaceholderResource(Lang)" value="@newResource" @oninput="e => newResource = e.Value?.ToString() ?? string.Empty" data-test="sheet-resource-name" />
                <NumberStepper Value="newResourceMax" ValueChanged="v => newResourceMax = v" Min="1" Max="99" AriaLabel="@UiText.LabelUses(Lang)" />
                <button type="button" class="rf-toggle @(newResourceShort ? "on" : null)" aria-pressed="@newResourceShort" @onclick="() => newResourceShort = !newResourceShort" data-test="sheet-resource-short">
                    <span class="rf-toggle-track"><span class="rf-toggle-thumb"></span></span>
                    <span>@UiText.LabelShortRestReset(Lang)</span>
                </button>
                <button type="button" class="btn btn-rf-outline btn-sm" @onclick="AddResource" data-test="sheet-resource-add">@UiText.BtnAdd(Lang)</button>
            </div>
        </section>

        @if (c.Feats.Count > 0)
        {
            <section class="rf-card2">
                <div class="rf-card2-head"><span>@UiText.SheetFeats(Lang)</span></div>
                <div class="rf-chip-list">
                    @foreach (var feat in c.Feats)
                    {
                        <a href="@($"feats?id={feat.Feat.Id}")" target="_blank" rel="noopener" class="rf-chip text-decoration-none">@feat.Feat.Name</a>
                    }
                </div>
            </section>
        }

        @foreach (var info in c.Classes)
        {
            if (classDetails.GetValueOrDefault(info.Class.Id) is { } detail)
            {
                <section class="rf-card2">
                    <div class="rf-card2-head"><span>@UiText.SheetFeaturesOf(info.Class.Name, info.Level, Lang)</span></div>
                    @foreach (var feature in detail.Features.Where(f => f.Level <= info.Level).OrderBy(f => f.Level).ThenBy(f => f.SortOrder))
                    {
                        <FeatureBlock Title="@feature.Name" Text="@feature.Description" Level="feature.Level" Ruleset="Ruleset" />
                    }
                    @if (detail.Subclasses.FirstOrDefault(s => s.Id == info.Subclass?.Id) is { } subclass)
                    {
                        @foreach (var feature in subclass.Features.Where(f => f.Level <= info.Level).OrderBy(f => f.Level).ThenBy(f => f.SortOrder))
                        {
                            <FeatureBlock Title="@feature.Name" Text="@feature.Description" Level="feature.Level" Badge="@subclass.Name" Ruleset="Ruleset" />
                        }
                    }
                </section>
            }
        }

        @if (backgroundDetail is not null && !string.IsNullOrWhiteSpace(backgroundDetail.FeatureName))
        {
            <section class="rf-card2">
                <div class="rf-card2-head"><span>@UiText.LabelBackgroundFeature(Lang)</span></div>
                <FeatureBlock Title="@backgroundDetail.FeatureName" Text="@backgroundDetail.FeatureDescription" Ruleset="Ruleset" />
            </section>
        }

        <section class="rf-card2">
            <div class="rf-card2-head"><span>@UiText.LabelFeatureNotes(Lang)</span></div>
            <textarea class="rf-wizard-input rf-wizard-textarea" rows="4" value="@Sheet.FeatureNotes" @onchange="e => SetText(v => Sheet.FeatureNotes = v, e)" data-test="sheet-feature-notes"></textarea>
        </section>
    </div>;

    // ===== Notes: personality, story, physical details, manual adjustments =====
    private RenderFragment NotesTab(ComputedCharacter c) => @<div>
        <section class="rf-card2">
            @NoteField(UiText.LabelPersonalityTraits(Lang), Sheet.Traits, v => Sheet.Traits = v, 2)
            @NoteField(UiText.LabelIdeals(Lang), Sheet.Ideals, v => Sheet.Ideals = v, 2)
            @NoteField(UiText.LabelBonds(Lang), Sheet.Bonds, v => Sheet.Bonds = v, 2)
            @NoteField(UiText.LabelFlaws(Lang), Sheet.Flaws, v => Sheet.Flaws = v, 2)
            @NoteField(UiText.LabelAppearance(Lang), Sheet.Appearance, v => Sheet.Appearance = v, 2)
            @TextRow(UiText.LabelHeight(Lang), Sheet.Height, v => Sheet.Height = v, "height")
            @TextRow(UiText.SheetWeight(Lang), Sheet.Weight, v => Sheet.Weight = v, "weight")
            @NoteField(UiText.LabelBackstory(Lang), Sheet.Backstory, v => Sheet.Backstory = v, 5)
            @NoteField(UiText.LabelAllies(Lang), Sheet.Allies, v => Sheet.Allies = v, 2)
            @NoteField(UiText.LabelNotes(Lang), Sheet.Notes, v => Sheet.Notes = v, 6)
        </section>

        <details class="rf-card2 rf-collapsible" data-test="sheet-adjustments">
            <summary class="rf-card2-head"><span>@UiText.SheetAdjustments(Lang)</span><span class="rf-collapsible-hint">@UiText.LabelAdvanced(Lang)</span></summary>
            <div class="small mb-3" style="color: var(--rf-text-secondary);">@UiText.HintAdjustments(Lang)</div>
            @NumberRow(UiText.LabelMaxHpAdjustment(Lang), Sheet.MaxHitPointsAdjustment, v => Sheet.MaxHitPointsAdjustment = v, "max-hp")
            @NumberRow(UiText.SheetArmorClass(Lang), Sheet.ArmorClassAdjustment, v => Sheet.ArmorClassAdjustment = v, "ac")
            @NumberRow(UiText.SheetSpeed(Lang), Sheet.SpeedAdjustment, v => Sheet.SpeedAdjustment = v, "speed")
            @NumberRow(UiText.SheetInitiative(Lang), Sheet.InitiativeAdjustment, v => Sheet.InitiativeAdjustment = v, "initiative")

            <div class="rf-wizard-counter">@UiText.LabelExtraSkills(Lang)</div>
            <div class="rf-wizard-pills">
                @foreach (var skill in Enum.GetValues<Skill>().OrderBy(s => GameTerms.SkillName(s, Lang)))
                {
                    var s = skill;
                    <button type="button" class="rf-wizard-pill @(Sheet.ExtraSkills.Contains(s) ? "selected" : null)" @onclick="() => ToggleExtra(Sheet.ExtraSkills, s)">@GameTerms.SkillName(s, Lang)</button>
                }
            </div>
            <div class="rf-wizard-counter">@UiText.LabelExtraExpertise(Lang)</div>
            <div class="rf-wizard-pills">
                @foreach (var skill in c.SkillProficiencies.OrderBy(s => GameTerms.SkillName(s, Lang)))
                {
                    var s = skill;
                    <button type="button" class="rf-wizard-pill @(Sheet.ExtraExpertise.Contains(s) ? "selected" : null)" @onclick="() => ToggleExtra(Sheet.ExtraExpertise, s)">@GameTerms.SkillName(s, Lang)</button>
                }
            </div>
            <div class="rf-wizard-counter">@UiText.LabelExtraSaves(Lang)</div>
            <div class="rf-wizard-pills">
                @foreach (var ability in CharacterMath.Abilities)
                {
                    var a = ability;
                    <button type="button" class="rf-wizard-pill @(Sheet.ExtraSaves.Contains(a) ? "selected" : null)" @onclick="() => ToggleExtra(Sheet.ExtraSaves, a)">@FeatPrerequisiteFormatter.AbilityName(a, Lang)</button>
                }
            </div>
            @NoteField(UiText.LabelOtherProficiencies(Lang), Sheet.OtherProficiencies, v => Sheet.OtherProficiencies = v, 2)
        </details>
    </div>;

    private RenderFragment TextRow(string label, string? value, Action<string?> set, string key) => @<div class="rf-wizard-row">
        <div class="rf-wizard-label">@label</div>
        <div class="rf-wizard-field">
            <input class="rf-wizard-input" value="@value" maxlength="40" @onchange="e => SetText(set, e)" data-test="@($"sheet-{key}")" />
        </div>
    </div>;

    private RenderFragment NumberRow(string label, int value, Action<int> set, string key) => @<div class="rf-wizard-row">
        <div class="rf-wizard-label">@label</div>
        <div class="rf-wizard-field">
            <NumberStepper Value="value" ValueChanged="v => SetAdjustment(set, v)" Min="-99" Max="99" AriaLabel="@label" InputTest="@($"sheet-adjust-{key}")" />
        </div>
    </div>;

    //	A class resource: dots with "use" for a few uses, a counter for pools of points (Lay on Hands, Ki…)
    private RenderFragment ClassResourceRow(ClassResource resource) => @<div class="rf-slot-row" data-test="sheet-class-resource">
        <div class="rf-resource-name">
            <span>@resource.Name</span>
            <small>@ResetName(resource.Reset)</small>
        </div>
        @if (resource.Pool || resource.Maximum > 10)
        {
            <div class="rf-resource-pool">
                <button type="button" class="rf-mini-btn" @onclick="() => SetResourceLeft(resource, ResourceLeft(resource) - 1)" aria-label="−1">−</button>
                <input type="number" min="0" max="@resource.Maximum" class="rf-coin-input" value="@ResourceLeft(resource)" @onchange="e => SetResourceInput(resource, e)" aria-label="@resource.Name" data-test="sheet-class-resource-left" />
                <span class="rf-resource-max">/ @resource.Maximum</span>
                <button type="button" class="rf-mini-btn" @onclick="() => SetResourceLeft(resource, ResourceLeft(resource) + 1)" aria-label="+1">+</button>
            </div>
        }
        else
        {
            var left = ResourceLeft(resource);
            <div class="rf-slot-dots">
                @for (var i = 0; i < resource.Maximum; i++)
                {
                    var index = i;
                    <button type="button" class="rf-slot-dot @(index < left ? "full" : null)" @onclick="() => ToggleResource(resource, resource.Maximum - 1 - index)" aria-label="@resource.Name @(index + 1)"></button>
                }
            </div>
            <button type="button" class="rf-slot-use" disabled="@(left == 0)" @onclick="() => SetResourceLeft(resource, left - 1)" data-test="sheet-class-resource-use">@UiText.BtnUse(Lang)</button>
        }
    </div>;

    private void SetAdjustment(Action<int> set, int value)
    {
        set(value);
        Changed();
    }

    private static RenderFragment Icon(string name) => name switch
    {
        "edit" => @<svg class="rf-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4zM14 6l4 4" /></svg>,
        "download" => @<svg class="rf-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4M5 20h14" /></svg>,
        "trash" => @<svg class="rf-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M10 7V5h4v2M7 7l1 13h8l1-13" /></svg>,
        _ => @<svg class="rf-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5m0 0l-6 6m6-6l6 6" /></svg>
    };

    private RenderFragment ConcentrationBanner() => @<text>
        @if (ConcentrationSpell is { } focus)
        {
            <div class="rf-concentration" data-test="sheet-concentration">
                <span class="rf-concentration-dot"></span>
                <span>@UiText.ConcentratingOn(Lang) <strong>@focus.Name</strong></span>
                <button type="button" class="rf-tool-btn" @onclick="EndConcentration" data-test="sheet-concentration-end">@UiText.BtnEndConcentration(Lang)</button>
            </div>
        }
    </text>;

    // ===== What the character can do in a turn =====
    private RenderFragment TurnSummary(ComputedCharacter c) => @<section class="rf-card2 rf-turn" data-test="sheet-turn">
        <div class="rf-card2-head">
            <span>@UiText.TurnTitle(Lang)</span>
            <span class="rf-card2-head-accent">@UiText.TurnMovement(UiText.FormatSpeed(c.Speed, Lang), Lang)</span>
        </div>
        @ConcentrationBanner()
        @if (lastCast is not null)
        {
            <div class="small mb-2" style="color: var(--rf-text-secondary);" data-test="sheet-last-cast">@UiText.LastCast(Lang) <strong>@lastCast</strong></div>
        }
        @{
            var features = TurnActions.Features(c, Lang);
            var attacks = TurnActions.AttacksPerAction(c);
        }
        <div class="rf-turn-grid">
            <div class="rf-turn-col">
                <div class="rf-mini-title">@UiText.TurnAction(Lang)</div>
                <div class="rf-turn-chips">
                    @foreach (var action in StandardActions)
                    {
                        <a class="rf-turn-chip" href="@($"rules?id={action.Id}")" target="_blank" rel="noopener" title="@action.Summary">
                            @action.Name@(action.Key == "attack" && attacks > 1 ? $" ×{attacks}" : null)
                        </a>
                    }
                    @foreach (var feature in features.Where(f => f.Slot == TurnSlot.Action))
                    {
                        <span class="rf-turn-chip feature" title="@feature.Note">@feature.Name</span>
                    }
                </div>
            </div>
            <div class="rf-turn-col">
                <div class="rf-mini-title">@UiText.TurnBonusAction(Lang)</div>
                @TurnOptions(features.Where(f => f.Slot == TurnSlot.BonusAction), SpellsFor(TurnSlot.BonusAction), RuleEntry(Ruleset == RulesetVersion.Dnd5e_2024 ? "bonus-action" : "bonus-actions"))
            </div>
            <div class="rf-turn-col">
                <div class="rf-mini-title">@UiText.TurnReaction(Lang)</div>
                @TurnOptions(features.Where(f => f.Slot == TurnSlot.Reaction), SpellsFor(TurnSlot.Reaction), RuleEntry(Ruleset == RulesetVersion.Dnd5e_2024 ? "reaction" : "opportunity-attacks"))
            </div>
        </div>
    </section>;

    private RenderFragment TurnOptions(IEnumerable<TurnFeature> features, IEnumerable<(ContextSpell Spell, SpellcastingInfo Source)> spells, RuleEntryResponseDto? rule) => @<div class="rf-turn-chips">
        @foreach (var feature in features)
        {
            <span class="rf-turn-chip feature" title="@feature.Note">@feature.Name@(feature.Note is null ? null : $" · {feature.Note}")</span>
        }
        @foreach (var (spell, source) in spells)
        {
            var sp = spell;
            var src = source;
            <button type="button" class="rf-turn-chip spell" @onclick="() => OpenSpell(sp, src)">✦ @sp.Name</button>
        }
        @if (rule is not null)
        {
            <a class="rf-turn-rule" href="@($"rules?id={rule.Id}")" target="_blank" rel="noopener" title="@rule.Summary">@UiText.TurnRule(Lang)</a>
        }
    </div>;

    // ===== Casting a spell from its details =====
    private RenderFragment CastPanel() => @<text>
        @if (castSpell is { } sp && castSource is { } src && computed is { } c)
        {
            <div class="rf-cast" data-test="spell-cast">
                @if (CannotAct)
                {
                    <div class="rf-cast-warning" data-test="spell-cast-blocked">@UiText.CastBlocked(Lang)</div>
                }
                else
                {
                    @if (sp.Concentration && Sheet.Concentration is { } current && current != sp.Id && ConcentrationSpell is { } other)
                    {
                        <div class="rf-cast-warning soft">@UiText.CastEndsConcentration(other.Name, Lang)</div>
                    }
                    @if (sp.Level == 0)
                    {
                        <button type="button" class="rf-cast-option primary" @onclick="() => Cast(sp, UiText.LabelCantrips(Lang))" data-test="spell-cast-cantrip">@UiText.BtnCast(Lang)</button>
                    }
                    else
                    {
                        <div class="rf-mini-label mb-2">@UiText.CastWith(Lang)</div>
                        <div class="rf-cast-options">
                            @if (HasFreeUse(src, sp))
                            {
                                <button type="button" class="rf-cast-option free" disabled="@(!FreeUseLeft(sp))" @onclick="() => CastFree(sp)" data-test="spell-cast-free">
                                    <strong>@UiText.CastFree(Lang)</strong><small>@(FreeUseLeft(sp) ? UiText.CastFreeHint(Lang) : UiText.CastFreeUsed(Lang))</small>
                                </button>
                            }
                            @if (CanCastAsRitual(src, sp))
                            {
                                <button type="button" class="rf-cast-option" @onclick="() => Cast(sp, UiText.CastRitual(Lang))" data-test="spell-cast-ritual">
                                    <strong>@UiText.CastRitual(Lang)</strong><small>@UiText.CastRitualHint(Lang)</small>
                                </button>
                            }
                            @for (var l = sp.Level; l <= 9; l++)
                            {
                                var level = l;
                                var total = c.SpellSlots[level - 1];
                                if (total == 0)
                                {
                                    continue;
                                }
                                var left = total - SpentSlots(level);
                                <button type="button" class="rf-cast-option" disabled="@(left == 0)" @onclick="() => CastWithSlot(sp, level)" data-test="@($"spell-cast-slot-{level}")">
                                    <strong>@UiText.SlotLevel(level, Lang)</strong>
                                    <small>@UiText.SlotsLeft(left, total, Lang)@(level > sp.Level ? $" · {UiText.CastUpcast(Lang)}" : null)</small>
                                </button>
                            }
                            @if (c.PactSlots > 0 && c.PactSlotLevel >= sp.Level)
                            {
                                var pactLeft = c.PactSlots - Sheet.SpentPactSlots;
                                <button type="button" class="rf-cast-option" disabled="@(pactLeft == 0)" @onclick="() => CastWithPact(sp)" data-test="spell-cast-pact">
                                    <strong>@UiText.CastPact(c.PactSlotLevel, Lang)</strong><small>@UiText.SlotsLeft(pactLeft, c.PactSlots, Lang)</small>
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        }
    </text>;

    private RenderFragment NoteField(string label, string? value, Action<string?> set, int rows) => @<div class="rf-wizard-row">
        <div class="rf-wizard-label">@label</div>
        <div class="rf-wizard-field">
            <textarea class="rf-wizard-input rf-wizard-textarea" rows="@rows" value="@value" @onchange="e => SetText(set, e)"></textarea>
        </div>
    </div>;
}
