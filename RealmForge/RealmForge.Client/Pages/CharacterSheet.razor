    private RenderFragment TextRow(string label, string? value, Action<string?> set, string key) => @<div class="rf-wizard-row">
        <div class="rf-wizard-label">@label</div>
        <div class="rf-wizard-field">
            <input class="rf-wizard-input" value="@value" maxlength="40" @onchange="e => SetText(set, e)" data-test="@($"sheet-{key}")" />
        </div>
    </div>;

    private RenderFragment NumberRow(string label, int value, Action<int> set, string key) => @<div class="rf-wizard-row">
        <div class="rf-wizard-label">@label</div>
        <div class="rf-wizard-field">
            <NumberStepper Value="value" ValueChanged="v => SetAdjustment(set, v)" Min="-99" Max="99" AriaLabel="@label" InputTest="@($"sheet-adjust-{key}")" />
        </div>
    </div>;

    //	A class resource: dots with "use" for a few uses, a counter for pools of points (Lay on Hands, Ki…)
    private RenderFragment ClassResourceRow(ClassResource resource) => @<div class="rf-slot-row" data-test="sheet-class-resource">
        <div class="rf-resource-name">
            <span>@resource.Name</span>
            <small>@ResetName(resource.Reset)</small>
        </div>
        @if (resource.Pool || resource.Maximum > 10)
        {
            <div class="rf-resource-pool">
                <button type="button" class="rf-mini-btn" @onclick="() => SetResourceLeft(resource, ResourceLeft(resource) - 1)" aria-label="−1">−</button>
                <input type="number" min="0" max="@resource.Maximum" class="rf-coin-input" value="@ResourceLeft(resource)" @onchange="e => SetResourceInput(resource, e)" aria-label="@resource.Name" data-test="sheet-class-resource-left" />
                <span class="rf-resource-max">/ @resource.Maximum</span>
                <button type="button" class="rf-mini-btn" @onclick="() => SetResourceLeft(resource, ResourceLeft(resource) + 1)" aria-label="+1">+</button>
            </div>
        }
        else
        {
            var left = ResourceLeft(resource);
            <div class="rf-slot-dots">
                @for (var i = 0; i < resource.Maximum; i++)
                {
                    var index = i;
                    <button type="button" class="rf-slot-dot @(index < left ? "full" : null)" @onclick="() => ToggleResource(resource, resource.Maximum - 1 - index)" aria-label="@resource.Name @(index + 1)"></button>
                }
            </div>
            <button type="button" class="rf-slot-use" disabled="@(left == 0)" @onclick="() => SetResourceLeft(resource, left - 1)" data-test="sheet-class-resource-use">@UiText.BtnUse(Lang)</button>
        }
    </div>;

    private void SetAdjustment(Action<int> set, int value)
    {
        set(value);
        Changed();
    }

    private RenderFragment ConcentrationBanner() => @<text>
        @if (ConcentrationSpell is { } focus)
        {
            <div class="rf-concentration" data-test="sheet-concentration">
                <span class="rf-concentration-dot"></span>
                <span>@UiText.ConcentratingOn(Lang) <strong>@focus.Name</strong></span>
                @if (concentrationDc is { } dc)
                {
                    <button type="button" class="rf-concentration-save" @onclick="RollConcentrationAsync" data-test="sheet-concentration-save">@UiText.ConcentrationSave(dc, Lang)</button>
                }
                <button type="button" class="rf-tool-btn" @onclick="EndConcentration" data-test="sheet-concentration-end">@UiText.BtnEndConcentration(Lang)</button>
            </div>
        }
    </text>;

    // ===== What the character can do in a turn =====
    // ===== Attacks: one row per weapon, every button says what it rolls =====
    private RenderFragment AttackRow(AttackInfo at) => @<div class="rf-attack">
        <div class="rf-attack-name">
            <span>@at.Item.Name</span>
            <small>@AttackDetail(at)</small>
        </div>
        <div class="rf-attack-rolls">
            <button type="button" class="rf-attack-btn" @onclick="() => Roll(at.Item.Name, at.AttackBonus)" data-test="sheet-attack-hit">
                <span class="rf-attack-btn-label">@UiText.LabelToHit(Lang)</span><span class="rf-attack-btn-value">@CharacterMath.FormatModifier(at.AttackBonus)</span>
            </button>
            <button type="button" class="rf-attack-btn damage" @onclick="() => RollDamage(at.Item.Name, at.Damage)" data-test="sheet-attack-damage">
                <span class="rf-attack-btn-label">@UiText.LabelDamage(Lang)</span><span class="rf-attack-btn-value">@at.Damage @(at.DamageType is { } dt ? EquipmentTerms.DamageTypeName(dt, Lang) : null)</span>
            </button>
            @if (at.VersatileDamage is { } versatile)
            {
                <button type="button" class="rf-attack-btn damage" @onclick="() => RollDamage(at.Item.Name, versatile)">
                    <span class="rf-attack-btn-label">@UiText.LabelTwoHands(Lang)</span><span class="rf-attack-btn-value">@versatile</span>
                </button>
            }
        </div>
    </div>;

    private RenderFragment UnarmedRow(ComputedCharacter c)
    {
        var (bonus, damage) = UnarmedStrike(c);
        var name = UiText.UnarmedStrike(Lang);
        return @<div class="rf-attack unarmed">
            <div class="rf-attack-name">
                <span>@name</span>
                <small>@UiText.UnarmedDetail(Lang)</small>
            </div>
            <div class="rf-attack-rolls">
                <button type="button" class="rf-attack-btn" @onclick="() => Roll(name, bonus)">
                    <span class="rf-attack-btn-label">@UiText.LabelToHit(Lang)</span><span class="rf-attack-btn-value">@CharacterMath.FormatModifier(bonus)</span>
                </button>
                <button type="button" class="rf-attack-btn damage" @onclick="() => RollDamage(name, damage)">
                    <span class="rf-attack-btn-label">@UiText.LabelDamage(Lang)</span><span class="rf-attack-btn-value">@damage @EquipmentTerms.DamageTypeName(DamageType.Bludgeoning, Lang)</span>
                </button>
            </div>
        </div>;
    }

    private string AttackDetail(AttackInfo at)
    {
        var parts = new List<string>();
        if (at.Item.WeaponRange is { } range)
        {
            parts.Add(EquipmentTerms.WeaponRangeLabel(range, Lang));
        }
        if (at.Item.NormalRange is { } normal && at.Item.LongRange is { } longRange)
        {
            parts.Add($"{EquipmentTerms.FormatRange(normal, longRange, Lang)} {(Lang == LanguageCode.It ? "m" : "ft")}");
        }
        parts.AddRange(at.Item.WeaponProperties.Where(p => p != WeaponProperty.Versatile).Select(p => EquipmentTerms.PropertyName(p, Lang)));
        if (at.Item.Mastery is { } mastery && character!.Build.Classes.Any(e => e.WeaponMasteries.Contains(at.Item.Id)))
        {
            parts.Add($"{UiText.LabelMastery(Lang)}: {EquipmentTerms.MasteryName(mastery, Lang)}");
        }
        if (!at.Proficient)
        {
            parts.Add(UiText.SheetNotProficient(Lang));
        }
        return string.Join(" · ", parts);
    }

    // ===== What the character can do in a turn: every option, ready to roll or cast =====
    private RenderFragment TurnSummary(ComputedCharacter c)
    {
        var features = TurnActions.Features(c, Lang);
        var attacks = TurnActions.AttacksPerAction(c);
        var magicKey = Ruleset == RulesetVersion.Dnd5e_2024 ? "magic" : "cast-a-spell";
        var attackRule = StandardActions.FirstOrDefault(a => a.Key == "attack");
        var magicRule = StandardActions.FirstOrDefault(a => a.Key == magicKey);
        var actionSpells = SpellsFor(TurnSlot.Action).Where(x => CanCastNow(x.Spell, x.Source)).ToList();
        var bonusSpells = SpellsFor(TurnSlot.BonusAction).Where(x => CanCastNow(x.Spell, x.Source)).ToList();
        var reactionSpells = SpellsFor(TurnSlot.Reaction).Where(x => CanCastNow(x.Spell, x.Source)).ToList();
        var offHand = OffHandAttacks(c);
        var (unarmedBonus, unarmedDamage) = UnarmedStrike(c);
        var unarmedName = UiText.UnarmedStrike(Lang);
        return @<section class="rf-card2 rf-turn" data-test="sheet-turn">
            <div class="rf-card2-head">
                <span>@UiText.TurnTitle(Lang)</span>
                <span class="rf-card2-head-accent">@UiText.TurnMovement(UiText.FormatSpeed(c.Speed, Lang), Lang)</span>
            </div>
            @ConcentrationBanner()
            @if (CannotAct)
            {
                <div class="rf-cast-warning mb-2">@UiText.TurnBlocked(Lang)</div>
            }
            @if (lastCast is not null)
            {
                <div class="small mb-2" style="color: var(--rf-text-secondary);" data-test="sheet-last-cast">@UiText.LastCast(Lang) <strong>@lastCast</strong></div>
            }

            <div class="rf-turn-block">
                <div class="rf-turn-block-title">@UiText.TurnAction(Lang)</div>
                <div class="rf-turn-row">
                    <div class="rf-turn-row-label">@(attackRule?.Name ?? "Attack")@(attacks > 1 ? $" ×{attacks}" : null)</div>
                    <div class="rf-turn-chips" data-test="sheet-turn-attacks">
                        @foreach (var attack in c.Attacks)
                        {
                            var at = attack;
                            @TurnAttack(at.Item.Name, at.AttackBonus, at.Damage)
                        }
                        @TurnAttack(unarmedName, unarmedBonus, unarmedDamage)
                    </div>
                </div>
                @if (c.Spellcasting.Count > 0)
                {
                    <div class="rf-turn-row">
                        <div class="rf-turn-row-label">@(magicRule?.Name ?? "Magic")</div>
                        <div class="rf-turn-chips" data-test="sheet-turn-spells">
                            @foreach (var (spell, source) in actionSpells)
                            {
                                var sp = spell;
                                var src = source;
                                <button type="button" class="rf-turn-chip spell" @onclick="() => OpenSpell(sp, src)"><Icon Name="spells" /> @sp.Name@(sp.Level > 0 ? $" ({sp.Level}°)" : null)</button>
                            }
                            @if (actionSpells.Count == 0)
                            {
                                <span class="rf-turn-none">@UiText.TurnNoSpells(Lang)</span>
                            }
                        </div>
                    </div>
                }
                @if (features.Any(f => f.Slot == TurnSlot.Action))
                {
                    <div class="rf-turn-row">
                        <div class="rf-turn-row-label">@UiText.TurnFeatures(Lang)</div>
                        @FeatureChips(features.Where(f => f.Slot == TurnSlot.Action))
                    </div>
                }
                <div class="rf-turn-row">
                    <div class="rf-turn-row-label">@UiText.TurnOtherActions(Lang)</div>
                    <div class="rf-turn-chips">
                        @foreach (var action in StandardActions.Where(a => a.Key != "attack" && a.Key != magicKey))
                        {
                            <a class="rf-turn-chip" href="@($"rules?id={action.Id}")" target="_blank" rel="noopener" title="@action.Summary">@action.Name</a>
                        }
                    </div>
                </div>
            </div>

            <div class="rf-turn-split">
                <div class="rf-turn-block">
                    <div class="rf-turn-block-title">@UiText.TurnBonusAction(Lang) @RuleLink(Ruleset == RulesetVersion.Dnd5e_2024 ? "bonus-action" : "bonus-actions")</div>
                    <div class="rf-turn-chips" data-test="sheet-turn-bonus">
                        @foreach (var attack in offHand)
                        {
                            var at = attack;
                            @TurnAttack($"{at.Item.Name} · {UiText.TurnOffHand(Lang)}", at.AttackBonus, OffHandDamage(at))
                        }
                        @FeatureChips(features.Where(f => f.Slot == TurnSlot.BonusAction), inline: true)
                        @foreach (var (spell, source) in bonusSpells)
                        {
                            var sp = spell;
                            var src = source;
                            <button type="button" class="rf-turn-chip spell" @onclick="() => OpenSpell(sp, src)"><Icon Name="spells" /> @sp.Name</button>
                        }
                        @if (offHand.Count == 0 && !features.Any(f => f.Slot == TurnSlot.BonusAction) && bonusSpells.Count == 0)
                        {
                            <span class="rf-turn-none">@UiText.TurnNothing(Lang)</span>
                        }
                    </div>
                </div>
                <div class="rf-turn-block">
                    <div class="rf-turn-block-title">@UiText.TurnReaction(Lang) @RuleLink(Ruleset == RulesetVersion.Dnd5e_2024 ? "reaction" : "opportunity-attacks")</div>
                    <div class="rf-turn-chips" data-test="sheet-turn-reaction">
                        @FeatureChips(features.Where(f => f.Slot == TurnSlot.Reaction), inline: true)
                        @foreach (var (spell, source) in reactionSpells)
                        {
                            var sp = spell;
                            var src = source;
                            <button type="button" class="rf-turn-chip spell" @onclick="() => OpenSpell(sp, src)"><Icon Name="spells" /> @sp.Name</button>
                        }
                    </div>
                </div>
                <div class="rf-turn-block">
                    <div class="rf-turn-block-title">@UiText.TurnFree(Lang)</div>
                    <div class="rf-turn-chips">
                        <span class="rf-turn-chip muted">@UiText.TurnInteract(Lang)</span>
                        <span class="rf-turn-chip muted">@UiText.TurnTalk(Lang)</span>
                    </div>
                </div>
            </div>
        </section>;
    }

    private RenderFragment TurnAttack(string name, int bonus, string damage) => @<span class="rf-turn-attack">
        <span class="rf-turn-attack-name">@name</span>
        <button type="button" @onclick="() => Roll(name, bonus)" title="@UiText.LabelToHit(Lang)">@CharacterMath.FormatModifier(bonus)</button>
        <button type="button" @onclick="() => RollDamage(name, damage)" title="@UiText.LabelDamage(Lang)">@damage</button>
    </span>;

    private RenderFragment FeatureChips(IEnumerable<TurnFeature> features, bool inline = false) => @<text>
        @if (!inline)
        {
            <div class="rf-turn-chips">@FeatureChipList(features)</div>
        }
        else
        {
            @FeatureChipList(features)
        }
    </text>;

    private RenderFragment FeatureChipList(IEnumerable<TurnFeature> features) => @<text>
        @foreach (var feature in features)
        {
            var left = FeatureUsesLeft(feature);
            <span class="rf-turn-chip feature @(left == 0 ? "spent" : null)" title="@feature.Note">
                @feature.Name@(feature.Note is null ? null : $" · {feature.Note}")
                @if (left is { } uses)
                {
                    <span class="rf-turn-uses">@uses</span>
                }
            </span>
        }
    </text>;

    private RenderFragment RuleLink(string key) => @<text>
        @if (RuleEntry(key) is { } rule)
        {
            <a class="rf-turn-rule" href="@($"rules?id={rule.Id}")" target="_blank" rel="noopener" title="@rule.Summary">@UiText.TurnRule(Lang) <Icon Name="external" /></a>
        }
    </text>;

    // ===== Casting a spell from its details =====
    private RenderFragment CastPanel() => @<text>
        @if (castSpell is { } sp && castSource is { } src && computed is { } c)
        {
            <div class="rf-cast" data-test="spell-cast">
                @if (CannotAct)
                {
                    <div class="rf-cast-warning" data-test="spell-cast-blocked">@UiText.CastBlocked(Lang)</div>
                }
                else
                {
                    @if (sp.Concentration && Sheet.Concentration is { } current && current != sp.Id && ConcentrationSpell is { } other)
                    {
                        <div class="rf-cast-warning soft">@UiText.CastEndsConcentration(other.Name, Lang)</div>
                    }
                    @if (sp.Level == 0)
                    {
                        <button type="button" class="rf-cast-option primary" @onclick="() => Cast(sp, UiText.LabelCantrips(Lang))" data-test="spell-cast-cantrip">@UiText.BtnCast(Lang)</button>
                    }
                    else
                    {
                        <div class="rf-mini-label mb-2">@UiText.CastWith(Lang)</div>
                        <div class="rf-cast-options">
                            @if (HasFreeUse(src, sp))
                            {
                                <button type="button" class="rf-cast-option free" disabled="@(!FreeUseLeft(sp))" @onclick="() => CastFree(sp)" data-test="spell-cast-free">
                                    <strong>@UiText.CastFree(Lang)</strong><small>@(FreeUseLeft(sp) ? UiText.CastFreeHint(Lang) : UiText.CastFreeUsed(Lang))</small>
                                </button>
                            }
                            @if (CanCastAsRitual(src, sp))
                            {
                                <button type="button" class="rf-cast-option" @onclick="() => Cast(sp, UiText.CastRitual(Lang))" data-test="spell-cast-ritual">
                                    <strong>@UiText.CastRitual(Lang)</strong><small>@UiText.CastRitualHint(Lang)</small>
                                </button>
                            }
                            @for (var l = sp.Level; l <= 9; l++)
                            {
                                var level = l;
                                var total = c.SpellSlots[level - 1];
                                if (total == 0)
                                {
                                    continue;
                                }
                                var left = total - SpentSlots(level);
                                <button type="button" class="rf-cast-option" disabled="@(left == 0)" @onclick="() => CastWithSlot(sp, level)" data-test="@($"spell-cast-slot-{level}")">
                                    <strong>@UiText.SlotLevel(level, Lang)</strong>
                                    <small>@UiText.SlotsLeft(left, total, Lang)@(level > sp.Level ? $" · {UiText.CastUpcast(Lang)}" : null)</small>
                                </button>
                            }
                            @if (c.PactSlots > 0 && c.PactSlotLevel >= sp.Level)
                            {
                                var pactLeft = c.PactSlots - Sheet.SpentPactSlots;
                                <button type="button" class="rf-cast-option" disabled="@(pactLeft == 0)" @onclick="() => CastWithPact(sp)" data-test="spell-cast-pact">
                                    <strong>@UiText.CastPact(c.PactSlotLevel, Lang)</strong><small>@UiText.SlotsLeft(pactLeft, c.PactSlots, Lang)</small>
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        }
    </text>;

    // ===== Spells changed as the rules allow (long rest, level up), wizard spellbook =====
    private RenderFragment BookEditor() => @<text>
        @if (bookSource is { } src && computed is not null)
        {
            var wizard = IsWizardBook(src);
            <div class="rf-modal-backdrop" @onclick="CloseBook">
                <div class="rf-modal-dialog rf-book" @onclick:stopPropagation="true" data-test="spell-book">
                    <h2 class="h5 mb-1" style="color: var(--rf-orange-primary); font-family: var(--rf-font-display);">@UiText.BookTitle(src.Class?.Class.Name ?? string.Empty, wizard, Lang)</h2>
                    <div class="small mb-2" style="color: var(--rf-text-secondary);">@UiText.SpellChangeRuleText(SpellChangeRules.For(Ruleset, src.Class!), Lang)</div>
                    <div class="rf-book-status">
                        <span>@UiText.BookNow(Lang) <strong>@ChangesText(src)</strong></span>
                        <button type="button" class="rf-toggle @(bookFree ? "on" : null)" aria-pressed="@bookFree" @onclick="() => bookFree = !bookFree" data-test="spell-book-free">
                            <span class="rf-toggle-track"><span class="rf-toggle-thumb"></span></span>
                            <span>@UiText.BookFreeCorrection(Lang)</span>
                        </button>
                    </div>

                    @if (wizard)
                    {
                        <div class="rf-book-tabs">
                            <button type="button" class="rf-sheet-tab @(!bookOnSpellbook ? "active" : null)" @onclick="() => bookOnSpellbook = false">@UiText.BookPrepared(Lang)</button>
                            <button type="button" class="rf-sheet-tab @(bookOnSpellbook ? "active" : null)" @onclick="() => bookOnSpellbook = true" data-test="spell-book-tab-book">@UiText.BookSpellbook(Lang)</button>
                        </div>
                    }

                    <input class="rf-wizard-input mb-2" placeholder="@UiText.PlaceholderSearchSpell(Lang)" value="@bookSearch" @oninput="e => bookSearch = e.Value?.ToString() ?? string.Empty" />

                    @if (wizard && bookOnSpellbook)
                    {
                        <div class="rf-book-counter">
                            @UiText.BookFreeLeft(Math.Max(0, LearnedLeft), Lang)
                            @if (CopyCost > 0)
                            {
                                <span> · @UiText.BookCopyCost(CopyCost, Lang)</span>
                            }
                        </div>
                        <div class="rf-book-list">
                            @foreach (var spell in BookOptions(1, src.MaxSpellLevel))
                            {
                                var sp = spell;
                                var inBook = draftBook.Contains(sp.Id);
                                var copied = draftCopied.Contains(sp.Id);
                                <div class="rf-book-row @(inBook ? "on" : null)">
                                    <span class="rf-book-name">@sp.Name <small>@GameTerms.SpellLevel(sp.Level, Lang)</small></span>
                                    @if (inBook)
                                    {
                                        <span class="rf-book-tag">@(copied ? UiText.BookCopied(Lang) : UiText.BookLearned(Lang))</span>
                                        @if (!originalBook.Contains(sp.Id) || bookFree)
                                        {
                                            <button type="button" class="rf-mini-btn" @onclick="() => RemoveFromBook(sp.Id)" aria-label="@UiText.BtnRemove(Lang)"><Icon Name="close" /></button>
                                        }
                                    }
                                    else
                                    {
                                        <button type="button" class="rf-book-add" @onclick="() => AddToBook(sp.Id)" data-test="spell-book-add">
                                            @(LearnedLeft > 0 ? UiText.BookWrite(Lang) : UiText.BookCopy(SpellChangeRules.CopyCostGold(sp.Level), Lang))
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        @if (src.Cantrips > 0)
                        {
                            <div class="rf-book-counter">@UiText.LabelCantrips(Lang) @draftCantrips.Count / @src.Cantrips</div>
                            <div class="rf-book-list">
                                @foreach (var spell in BookOptions(0, 0))
                                {
                                    var sp = spell;
                                    var chosen = draftCantrips.Contains(sp.Id);
                                    <button type="button" class="rf-book-pick @(chosen ? "on" : null)" disabled="@((chosen && !CanRemoveCantrip(sp.Id)) || (!chosen && draftCantrips.Count >= src.Cantrips))"
                                            @onclick="() => ToggleDraftCantrip(sp.Id)" data-test="spell-book-cantrip">@sp.Name</button>
                                }
                            </div>
                        }
                        <div class="rf-book-counter">@UiText.SheetSpellsPrepared(Lang) @draftSpells.Count / @src.Spells</div>
                        <div class="rf-book-list">
                            @foreach (var spell in (wizard ? BookOptions(1, src.MaxSpellLevel).Where(s => draftBook.Contains(s.Id)) : BookOptions(1, src.MaxSpellLevel)))
                            {
                                var sp = spell;
                                var chosen = draftSpells.Contains(sp.Id);
                                <button type="button" class="rf-book-pick @(chosen ? "on" : null)" disabled="@((chosen && !CanRemoveSpell(sp.Id)) || (!chosen && draftSpells.Count >= src.Spells))"
                                        @onclick="() => ToggleDraftSpell(sp.Id)" data-test="spell-book-spell">
                                    @sp.Name <small>@sp.Level°</small>
                                </button>
                            }
                        </div>
                    }

                    @if (bookError is not null)
                    {
                        <div class="rf-cast-warning mt-2" data-test="spell-book-error">@bookError</div>
                    }
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-rf-outline" @onclick="CloseBook">@UiText.BtnCancel(Lang)</button>
                        <button type="button" class="btn btn-rf-orange" disabled="@bookSaving" @onclick="SaveBookAsync" data-test="spell-book-save">@UiText.BtnConfirm(Lang)</button>
                    </div>
                </div>
            </div>
        }
    </text>;

    private RenderFragment NoteField(string label, string? value, Action<string?> set, int rows) => @<div class="rf-wizard-row">
        <div class="rf-wizard-label">@label</div>
        <div class="rf-wizard-field">
            <textarea class="rf-wizard-input rf-wizard-textarea" rows="@rows" value="@value" @onchange="e => SetText(set, e)"></textarea>
        </div>
    </div>;
}
