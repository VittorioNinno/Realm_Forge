            <h2 class="h5 mb-2" style="color: var(--rf-orange-primary); font-family: var(--rf-font-display);">@UiText.BtnShareCharacter(Lang)</h2>
            <SharePeople Title="@UiText.ShareCharacterTitle(Lang)" Hint="@UiText.ShareCharacterHint(Lang)"
                         Load="() => Characters.GetCharacterSharesAsync(characterId)" Add="email => Characters.ShareCharacterAsync(characterId, email)"
