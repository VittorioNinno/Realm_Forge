@BookEditor()
@if (magicEditorOpen)
{
    <MagicItemEditor IsNew="magicTarget is null" ItemName="@(magicTarget is null ? null : ItemName(magicTarget))" Kind="MagicKindOf(magicTarget)"
                     Initial="magicTarget?.Magic" Ruleset="Ruleset" OnSave="SaveMagic" OnCancel="() => magicEditorOpen = false" />
