@page "/characters"
@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.DTOs
@using RealmForge.Shared.Enums
@implements IDisposable
@inject CharacterDataService CharacterService
@inject CampaignDataService Campaigns
@inject LanguageStateService LanguageState

<PageTitle>RealmForge - @UiText.CharactersTitle(Lang)</PageTitle>

<div class="container-fluid px-0 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3" style="border-bottom: 2px solid var(--rf-orange-primary);">
        <div>
            <h1 class="h3 fw-bold mb-2 rf-page-title">@UiText.CharactersTitle(Lang)</h1>
            <p class="mb-0 small" style="color: var(--rf-text-muted); letter-spacing: 1px; text-transform: uppercase;">@UiText.CharactersSubtitle(Lang)</p>
        </div>
        <AuthorizeView>
            <Authorized>
                <a href="characters/new" class="btn btn-rf-orange" data-test="new-character">@UiText.BtnNewCharacter(Lang)</a>
            </Authorized>
        </AuthorizeView>
    </div>

    <AuthorizeView>
        <Authorized>
            @if (characters is null)
            {
                <div class="small" style="color: var(--rf-text-muted);">@UiText.LoadingCharacters(Lang)</div>
            }
            else if (characters.Count == 0)
            {
                <div class="rf-account-card text-center" data-test="characters-empty">
                    <p class="mb-3" style="color: var(--rf-text-secondary);">@UiText.CharactersEmpty(Lang)</p>
                    <a href="characters/new" class="btn btn-rf-orange">@UiText.BtnNewCharacter(Lang)</a>
                </div>
            }
            else
            {
                @* Cards like D&D Beyond's: the card opens the sheet; edit and delete below, and the campaigns it sits in
                   with the action to take it out of one *@
                <div class="rf-character-grid" data-test="characters-grid">
                    @foreach (var character in characters)
                    {
                        var ch = character;
                        <CharacterCard Character="ch" Href="@($"characters/{ch.Id}")" ShowBackground="true"
                                       Band="@(ch.Campaigns.Count > 0 ? CampaignBand(ch) : null)" Actions="CardActions(ch)" />
                    }
                </div>
                @if (actionError is not null)
                {
                    <div class="small text-warning mt-2" data-test="characters-error">@actionError</div>
                }
            }

            @if (shared is { Count: > 0 })
            {
                <h2 class="rf-characters-shared-title" data-test="shared-characters-title">@UiText.SharedCharactersTitle(Lang)</h2>
                <p class="small" style="color: var(--rf-text-muted);">@UiText.SharedCharactersHint(Lang)</p>
                <div class="rf-character-grid" data-test="shared-characters">
                    @foreach (var entry in shared)
                    {
                        <CharacterCard Character="entry.Character" Href="@($"characters/{entry.Character.Id}")" Shared="true"
                                       Owner="@UiText.CharacterOf(entry.OwnerName, Lang)" ShowBackground="true" DataTest="shared-character-card" />
                    }
                </div>
            }
        </Authorized>
        <NotAuthorized>
            <div class="rf-account-card text-center">
                <p class="mb-3" style="color: var(--rf-text-secondary);">@UiText.CharactersSignIn(Lang)</p>
                <a href="account" class="btn btn-rf-orange">@UiText.BtnLoginToForge(Lang)</a>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@if (deleting is not null)
{
    <div class="rf-modal-backdrop" @onclick="() => deleting = null">
        <div class="rf-modal-dialog" @onclick:stopPropagation="true" style="max-width: 448px; text-align: center;" data-test="character-delete-dialog">
            <h2 class="h4 mb-3" style="color: var(--rf-orange-primary);">@UiText.ConfirmDeletion(Lang)</h2>
            <div class="p-3 mb-4 rounded" style="background-color: var(--rf-bg-main); border: 1px solid var(--rf-border-subtle); color: var(--rf-text-secondary); line-height: 1.5;">
                @UiText.DeleteCharacterWarning(deleting.Name, Lang)
            </div>
            <div class="d-flex justify-content-center gap-3">
                <button class="btn btn-rf-outline" @onclick="() => deleting = null">@UiText.BtnCancel(Lang)</button>
                <button class="btn btn-rf-orange" style="background-color: #dc3545; border-color: #dc3545;" disabled="@busy" @onclick="DeleteAsync" data-test="character-delete-confirm">@UiText.Delete(Lang)</button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<CharacterSummaryDto>? characters;
    private CharacterSummaryDto? deleting;
    private bool busy;
    private string? actionError;
    private List<SharedCharacterDto>? shared;

    private LanguageCode Lang => LanguageState.CurrentLanguage;

    protected override async Task OnInitializedAsync()
    {
        LanguageState.OnLanguageChanged += OnLanguageChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var state = AuthState is null ? null : await AuthState;
        if (state?.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var mine = CharacterService.GetCharactersAsync(Lang);
        var others = CharacterService.GetSharedCharactersAsync(Lang);
        characters = await mine ?? new List<CharacterSummaryDto>();
        shared = await others;
    }

    private RenderFragment CardActions(CharacterSummaryDto ch) => @<text>
        <a class="rf-pc-action" href="@($"characters/{ch.Id}/edit")" data-test="character-edit"><Icon Name="edit" /> @UiText.BtnEditShort(Lang)</a>
        <button type="button" class="rf-pc-action danger" @onclick="() => deleting = ch" data-test="character-delete"><Icon Name="trash" /> @UiText.Delete(Lang)</button>
    </text>;

    private RenderFragment CampaignBand(CharacterSummaryDto ch) => @<text>
        @foreach (var campaign in ch.Campaigns)
        {
            var cmp = campaign;
            <div class="rf-pc-campaign" data-test="character-campaign">
                <span class="rf-pc-campaign-label">@UiText.LabelCampaign(Lang):</span>
                <a href="@($"campaigns/{cmp.Id}")">@cmp.Name</a>
                <button type="button" class="rf-pc-unlink ms-auto" disabled="@busy" title="@UiText.BtnTakeOut(Lang)" @onclick="() => LeaveCampaignAsync(ch, cmp)" data-test="character-campaign-remove">
                    <Icon Name="remove-person" /> @UiText.BtnTakeOutShort(Lang)
                </button>
            </div>
        }
    </text>;

    private async Task DeleteAsync()
    {
        if (deleting is not { } target)
        {
            return;
        }
        busy = true;
        actionError = null;
        if (await CharacterService.DeleteCharacterAsync(target.Id))
        {
            characters?.RemoveAll(c => c.Id == target.Id);
        }
        else
        {
            actionError = UiText.CampaignActionFailed(null, Lang);
        }
        busy = false;
        deleting = null;
    }

    private async Task LeaveCampaignAsync(CharacterSummaryDto ch, CharacterCampaignRefDto campaign)
    {
        busy = true;
        actionError = null;
        var result = await Campaigns.RemoveCharacterAsync(campaign.Id, ch.Id);
        busy = false;
        if (!result.Ok)
        {
            actionError = UiText.CampaignActionFailed(result.Status, Lang);
            return;
        }
        var index = characters?.FindIndex(c => c.Id == ch.Id) ?? -1;
        if (index >= 0)
        {
            characters![index] = ch with { Campaigns = ch.Campaigns.Where(c => c.Id != campaign.Id).ToList() };
        }
    }

    private void OnLanguageChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => LanguageState.OnLanguageChanged -= OnLanguageChanged;
}
