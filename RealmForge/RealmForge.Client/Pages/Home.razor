@page "/"
@using RealmForge.Client.Localization
@using RealmForge.Client.Components
@using RealmForge.Client.Services
@using RealmForge.Shared.Enums
@implements IDisposable
@inject LanguageStateService LanguageState

<PageTitle>RealmForge - @UiText.NavDashboard(Lang)</PageTitle>

<div class="py-4 rf-home">
    @* Welcome and a short introduction to the app *@
    <h1 class="rf-page-title mb-2">@UiText.HomeTitle(Lang)</h1>
    <div class="rf-home-intro mb-4" data-test="home-intro">
        @foreach (var paragraph in UiText.HomeIntro(Lang))
        {
            <p>@paragraph</p>
        }
    </div>

    @* What is in the app: one quiet link per section, no figures (the counts are in the account page) *@
    <h2 class="rf-home-section-title">@UiText.HomeWhatTitle(Lang)</h2>
    <div class="rf-home-modules mb-4" data-test="dashboard-modules">
        @foreach (var module in Modules)
        {
            <a href="@module.Href" class="rf-home-module" data-test="dashboard-@module.Href">
                <span class="rf-home-module-icon"><Icon Name="@module.Icon" Class="rf-nav-icon" /></span>
                <span class="min-w-0">
                    <span class="rf-home-module-title">@module.Title</span>
                    <span class="rf-home-module-text">@module.Subtitle</span>
                </span>
            </a>
        }
    </div>

    @* How the app works and the house rules, one after the other like a document *@
    <section class="rf-account-card mb-4" data-test="home-how">
        <div class="rf-account-card-title">@UiText.HomeHowTitle(Lang)</div>
        <dl class="rf-home-points mb-0">
            @foreach (var (title, text) in UiText.HomeHowItWorks(Lang))
            {
                <div><dt>@title</dt><dd>@text</dd></div>
            }
        </dl>
    </section>

    <section class="rf-account-card mb-4" data-test="home-rules">
        <div class="rf-account-card-title">@UiText.HomeRulesTitle(Lang)</div>
        <p class="small mb-3" style="color: var(--rf-text-secondary);">@UiText.HomeRulesIntro(Lang)</p>
        <dl class="rf-home-points mb-0">
            @foreach (var (title, text) in UiText.HomeHouseRules(Lang))
            {
                <div><dt>@title</dt><dd>@text</dd></div>
            }
        </dl>
    </section>

    @* Next step for the visitor: sign in to forge, or go to the account *@
    <div class="rf-account-card d-flex flex-wrap justify-content-between align-items-center gap-3">
        <AuthorizeView>
            <Authorized>
                <span class="small" style="color: var(--rf-text-secondary);">@UiText.DashboardSignedInHint(Lang)</span>
                <a href="account" class="btn btn-sm btn-rf-outline">@UiText.BtnGoToAccount(Lang)</a>
            </Authorized>
            <NotAuthorized>
                <span class="small" style="color: var(--rf-text-secondary);">@UiText.DashboardAnonymousHint(Lang)</span>
                <a href="account" class="btn btn-sm btn-rf-orange">@UiText.BtnLoginToForge(Lang)</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private record Module(string Href, string Icon, string Title, string Subtitle);

    private LanguageCode Lang => LanguageState.CurrentLanguage;

    private IEnumerable<Module> Modules
    {
        get
        {
            yield return new Module("rules", "rules", UiText.RulesTitle(Lang), UiText.HomeRulesModule(Lang));
            yield return new Module("species", "species", UiText.NavSpecies(Lang), UiText.SpeciesSubtitle(Lang));
            yield return new Module("backgrounds", "backgrounds", UiText.BackgroundsTitle(Lang), UiText.BackgroundsSubtitle(Lang));
            yield return new Module("feats", "feats", UiText.FeatsTitle(Lang), UiText.FeatsSubtitle(Lang));
            yield return new Module("spells", "spells", UiText.SpellsTitle(Lang), UiText.SpellsSubtitle(Lang));
            yield return new Module("classes", "classes", UiText.ClassesTitle(Lang), UiText.ClassesSubtitle(Lang));
            yield return new Module("equipment", "equipment", UiText.EquipmentTitle(Lang), UiText.EquipmentSubtitle(Lang));
            yield return new Module("magic-items", "magic-items", UiText.MagicItemsTitle(Lang), UiText.MagicItemsSubtitle(Lang));
            yield return new Module("monsters", "monsters", UiText.MonstersTitle(Lang), UiText.MonstersSubtitle(Lang));
        }
    }

    protected override void OnInitialized() => LanguageState.OnLanguageChanged += StateHasChanged;

    public void Dispose() => LanguageState.OnLanguageChanged -= StateHasChanged;
}
