@page "/account"
@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@using RealmForge.Shared.DTOs
@using RealmForge.Shared.Enums
@implements IDisposable
@inject AuthService Auth
@inject PasskeyService Passkeys
@inject LanguageStateService LanguageState
@inject CrossTabService CrossTab
@inject NavigationManager Navigation
@inject TokenAuthenticationStateProvider AuthStateProvider

<PageTitle>RealmForge - @UiText.AccountTitle(LanguageState.CurrentLanguage)</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container-fluid px-0 py-4" style="max-width: 760px;" data-test="account-summary">
            <h1 class="h3 fw-bold mb-4 pb-3 rf-page-title" style="border-bottom: 2px solid var(--rf-orange-primary);">
                @UiText.AccountProfileTitle(LanguageState.CurrentLanguage)
            </h1>

            @* Profile *@
            <div class="rf-account-card mb-3">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="rf-account-card-avatar">@Initial(summary?.Email ?? context.User.Identity?.Name)</span>
                    <div class="min-w-0">
                        <div class="fw-bold text-light text-truncate">@(summary?.Email ?? context.User.Identity?.Name)</div>
                        @if (summary != null)
                        {
                            <span class="badge @(summary.IsAdmin ? "badge-edition-2024" : "badge-edition-2014") mt-1" data-test="account-role">
                                @UiText.AccountRole(summary.IsAdmin, LanguageState.CurrentLanguage)
                            </span>
                        }
                    </div>
                </div>

                @if (summary != null)
                {
                    <p class="small mb-3" style="color: var(--rf-text-secondary);">@UiText.AccountRoleHint(summary.IsAdmin, LanguageState.CurrentLanguage)</p>
                    @if (summary.IsAdmin)
                    {
                        <a class="btn btn-sm btn-rf-orange mb-3" href="admin" data-test="account-admin">@UiText.BtnAdmin(LanguageState.CurrentLanguage)</a>
                    }
                    <dl class="rf-account-facts mb-0">
                        <dt>@UiText.LabelMemberSince(LanguageState.CurrentLanguage)</dt>
                        <dd>@(summary.RegisteredAt is DateTimeOffset at ? UiText.FormatDate(at.ToLocalTime(), LanguageState.CurrentLanguage) : UiText.LabelNotAvailable(LanguageState.CurrentLanguage))</dd>
                        <dt>@UiText.LabelEmailStatus(LanguageState.CurrentLanguage)</dt>
                        <dd data-test="account-email-status">@UiText.EmailStatus(summary.EmailConfirmed, LanguageState.CurrentLanguage)</dd>
                        <dt>@UiText.LabelInterfaceLanguage(LanguageState.CurrentLanguage)</dt>
                        <dd>@UiText.LanguageName(LanguageState.CurrentLanguage)</dd>
                    </dl>

                    @if (!summary.EmailConfirmed)
                    {
                        @* Unconfirmed address: creation is blocked until the link in the e-mail is opened *@
                        <div class="rf-account-verify mt-3" data-test="account-verify">
                            <span class="small">@UiText.HintVerifyToForge(LanguageState.CurrentLanguage)</span>
                            <button class="btn btn-sm btn-rf-orange" disabled="@isResending" @onclick="ResendConfirmationAsync">
                                @(isResending ? "..." : UiText.BtnResendConfirmation(LanguageState.CurrentLanguage))
                            </button>
                        </div>
                        @if (resendMessage != null)
                        {
                            <div class="small mt-2" style="color: var(--rf-text-secondary);" data-test="account-verify-sent">@resendMessage</div>
                        }
                    }
                }
            </div>

            @* Public name: what the other players see instead of the e-mail address *@
            @if (summary != null)
            {
                <div class="rf-account-card mb-3" data-test="account-nickname">
                    <div class="rf-account-card-title">@UiText.NicknameTitle(LanguageState.CurrentLanguage)</div>
                    <p class="small mb-2" style="color: var(--rf-text-secondary);">@UiText.NicknameHint(LanguageState.CurrentLanguage)</p>
                    <div class="d-flex flex-wrap gap-2">
                        <input class="rf-form-control flex-grow-1" maxlength="@RealmForge.Shared.Text.Nicknames.MaxLength" placeholder="@UiText.NicknamePlaceholder(LanguageState.CurrentLanguage)"
                               @bind="nickname" @bind:event="oninput" data-test="account-nickname-input" />
                        <button type="button" class="btn btn-rf-orange" disabled="@savingNickname" @onclick="SaveNicknameAsync" data-test="account-nickname-save">@UiText.BtnSaveNickname(LanguageState.CurrentLanguage)</button>
                    </div>
                    @if (nicknameMessage is not null)
                    {
                        <div class="small mt-2" style="color: var(--rf-text-secondary);" data-test="account-nickname-message">@nicknameMessage</div>
                    }
                </div>
            }

            @* Base content of the compendium per section and edition (moved here from the dashboard) *@
            @if (summary != null)
            {
                <CompendiumCounts />
            }

            @* Homebrew content created by the user *@
            @if (summary != null)
            {
                <div class="rf-account-card mb-3" data-test="account-homebrew">
                    <div class="rf-account-card-title">@UiText.AccountHomebrewTitle(LanguageState.CurrentLanguage)</div>
                    <div class="rf-account-stats">
                        @foreach (var (label, count, href) in HomebrewTiles(summary.Homebrew))
                        {
                            <a class="rf-account-stat" href="@href">
                                <span class="rf-account-stat-value">@count</span>
                                <span class="rf-account-stat-label">@label</span>
                            </a>
                        }
                    </div>
                    @if (summary.Homebrew.Total == 0)
                    {
                        <p class="small mt-3 mb-0" style="color: var(--rf-text-muted);">@UiText.AccountHomebrewEmpty(LanguageState.CurrentLanguage)</p>
                    }
                </div>
            }

            @* The bin: deleted entries, restorable for a few days *@
            <div class="rf-account-card mb-3" data-test="account-trash">
                <div class="rf-account-card-title">@UiText.TrashTitle(LanguageState.CurrentLanguage)</div>
                <p class="small mb-3" style="color: var(--rf-text-secondary);">@UiText.AccountTrashHint(LanguageState.CurrentLanguage)</p>
                <a href="trash" class="btn btn-sm btn-rf-outline" data-test="account-trash-open"><Icon Name="trash" /> @UiText.BtnOpenTrash(LanguageState.CurrentLanguage)</a>
            </div>

            @* Password change *@
            <div class="rf-account-card mb-3" data-test="account-password">
                <div class="rf-account-card-title">@UiText.AccountSecurityTitle(LanguageState.CurrentLanguage)</div>

                @if (passwordErrors.Count > 0)
                {
                    <div class="alert alert-warning bg-dark border-warning text-warning p-2 small mb-3">
                        @foreach (var error in passwordErrors)
                        {
                            <div>@UiText.AuthError(error, LanguageState.CurrentLanguage)</div>
                        }
                    </div>
                }
                @if (passwordChanged)
                {
                    <div class="alert bg-dark border-success text-success p-2 small mb-3">@UiText.PasswordChanged(LanguageState.CurrentLanguage)</div>
                }

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="rf-form-label rf-label-single-line">@UiText.LabelCurrentPassword(LanguageState.CurrentLanguage)</label>
                        <PasswordInput @bind-Value="currentPassword" Autocomplete="current-password" DataTest="pwd-current" />
                    </div>
                    <div class="col-md-4">
                        <label class="rf-form-label rf-label-single-line">@UiText.LabelNewPassword(LanguageState.CurrentLanguage)</label>
                        <PasswordInput @bind-Value="newPassword" Autocomplete="new-password" DataTest="pwd-new" />
                    </div>
                    <div class="col-md-4">
                        <label class="rf-form-label rf-label-single-line">@UiText.LabelRepeatPassword(LanguageState.CurrentLanguage)</label>
                        <PasswordInput @bind-Value="repeatPassword" Autocomplete="new-password" DataTest="pwd-repeat"
                                       Invalid="@PasswordMatchHint.IsDifferent(newPassword, repeatPassword)" DescribedBy="pwd-match" />
                        <PasswordMatchHint Password="@newPassword" Repeat="@repeatPassword" Id="pwd-match" DataTest="pwd-match" />
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center gap-3 mt-3">
                    <span class="small" style="color: var(--rf-text-muted);">@UiText.PasswordHint(LanguageState.CurrentLanguage)</span>
                    <button class="btn btn-sm btn-rf-orange flex-shrink-0 text-nowrap px-3" @onclick="ChangePasswordAsync" disabled="@isBusy">
                        @(isBusy ? "..." : UiText.BtnChangePassword(LanguageState.CurrentLanguage))
                    </button>
                </div>
            </div>

            @* Passkeys: sign-in without the password, one per device or password manager *@
            <div class="rf-account-card mb-3" data-test="account-passkeys">
                <div class="rf-account-card-title">@UiText.PasskeysTitle(LanguageState.CurrentLanguage)</div>
                <p class="small mb-3" style="color: var(--rf-text-secondary);">@UiText.PasskeysHint(LanguageState.CurrentLanguage)</p>
                @if (passkeys is { Count: > 0 })
                {
                    <ul class="rf-passkey-list mb-3">
                        @foreach (var passkey in passkeys)
                        {
                            var pk = passkey;
                            <li class="rf-passkey" data-test="account-passkey">
                                <Icon Name="key" />
                                <span class="rf-passkey-name">@pk.Name</span>
                                <span class="rf-passkey-date">@UiText.PasskeyCreated(pk.CreatedAt, LanguageState.CurrentLanguage)</span>
                                <button type="button" class="btn btn-sm btn-rf-outline ms-auto" @onclick="() => removingPasskey = pk" data-test="account-passkey-remove">@UiText.BtnRemove(LanguageState.CurrentLanguage)</button>
                            </li>
                        }
                    </ul>
                }
                else if (passkeys is not null)
                {
                    <div class="small mb-3" style="color: var(--rf-text-muted);" data-test="account-passkeys-empty">@UiText.PasskeysEmpty(LanguageState.CurrentLanguage)</div>
                }
                @if (passkeysSupported)
                {
                    <div class="d-flex flex-wrap gap-2">
                        <input class="rf-form-control flex-grow-1" style="min-width: 200px;" maxlength="60" placeholder="@UiText.PasskeyNamePlaceholder(LanguageState.CurrentLanguage)"
                               @bind="passkeyName" data-test="account-passkey-name" />
                        <button type="button" class="btn btn-rf-orange" disabled="@addingPasskey" @onclick="AddPasskeyAsync" data-test="account-passkey-add">
                            <Icon Name="key" /> @(addingPasskey ? "..." : UiText.BtnAddPasskey(LanguageState.CurrentLanguage))
                        </button>
                    </div>
                }
                else
                {
                    <div class="small" style="color: var(--rf-text-muted);">@UiText.AuthError("PasskeyUnsupported", LanguageState.CurrentLanguage)</div>
                }
                @if (passkeyMessage is not null)
                {
                    <div class="small mt-2" style="color: var(--rf-text-secondary);" data-test="account-passkey-message">@passkeyMessage</div>
                }
            </div>

            @if (removingPasskey is not null)
            {
                <div class="rf-modal-backdrop" @onclick="() => removingPasskey = null">
                    <div class="rf-modal-dialog" style="max-width: 440px;" @onclick:stopPropagation="true" data-test="account-passkey-remove-confirm">
                        <p class="mb-3">@UiText.PasskeyRemoveConfirm(removingPasskey.Name, LanguageState.CurrentLanguage)</p>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm btn-rf-outline" @onclick="() => removingPasskey = null">@UiText.BtnCancel(LanguageState.CurrentLanguage)</button>
                            <button type="button" class="btn btn-sm btn-rf-orange" @onclick="RemovePasskeyAsync" data-test="account-passkey-remove-yes">@UiText.BtnRemove(LanguageState.CurrentLanguage)</button>
                        </div>
                    </div>
                </div>
            }

            @* E-mail change: a confirmation link goes to the new address *@
            <div class="rf-account-card mb-3" data-test="account-email-change">
                <div class="rf-account-card-title">@UiText.AccountEmailTitle(LanguageState.CurrentLanguage)</div>
                <p class="small mb-3" style="color: var(--rf-text-secondary);">@UiText.AccountEmailHint(LanguageState.CurrentLanguage)</p>
                <div class="d-flex flex-wrap gap-2">
                    <input type="email" class="rf-form-control flex-grow-1" style="min-width: 240px;" autocomplete="email" maxlength="256"
                           placeholder="@UiText.PlaceholderNewEmail(LanguageState.CurrentLanguage)" @bind="newEmail" @bind:event="oninput" data-test="account-new-email" />
                    <button type="button" class="btn btn-rf-orange" disabled="@changingEmail" @onclick="ChangeEmailAsync" data-test="account-change-email">@UiText.BtnChangeEmail(LanguageState.CurrentLanguage)</button>
                </div>
                @if (emailMessage is not null)
                {
                    <div class="small mt-2" style="color: var(--rf-text-secondary);" data-test="account-email-message">@emailMessage</div>
                }
            </div>

            @* Account deletion, confirmed with the password *@
            <div class="rf-account-card rf-account-danger mb-3" data-test="account-delete">
                <div class="rf-account-card-title">@UiText.AccountDeleteTitle(LanguageState.CurrentLanguage)</div>
                <p class="small mb-3" style="color: var(--rf-text-secondary);">@UiText.AccountDeleteHint(LanguageState.CurrentLanguage)</p>
                <button type="button" class="btn btn-sm btn-rf-outline rf-btn-danger" @onclick="() => { deleteOpen = true; deletePassword = string.Empty; deleteError = null; }" data-test="account-delete-open">
                    <Icon Name="trash" /> @UiText.BtnDeleteAccount(LanguageState.CurrentLanguage)
                </button>
            </div>

            <div class="d-flex justify-content-end">
                <button class="btn btn-rf-outline" @onclick="LogoutAsync" data-test="account-logout">@UiText.BtnLogout(LanguageState.CurrentLanguage)</button>
            </div>

            @if (deleteOpen)
            {
                <div class="rf-modal-backdrop" @onclick="() => deleteOpen = false">
                    <div class="rf-modal-dialog" style="max-width: 480px;" @onclick:stopPropagation="true" data-test="account-delete-confirm">
                        <h2 class="h4 mb-3" style="color: #dc3545;">@UiText.AccountDeleteTitle(LanguageState.CurrentLanguage)</h2>
                        <ul class="small mb-3" style="color: var(--rf-text-secondary);">
                            @foreach (var line in UiText.AccountDeleteEffects(LanguageState.CurrentLanguage))
                            {
                                <li>@line</li>
                            }
                        </ul>
                        <label class="rf-form-label">@UiText.LabelCurrentPassword(LanguageState.CurrentLanguage)</label>
                        <PasswordInput @bind-Value="deletePassword" Autocomplete="current-password" DataTest="account-delete-password" />
                        @if (deleteError is not null)
                        {
                            <div class="small mt-2 text-warning" data-test="account-delete-error">@UiText.AuthError(deleteError, LanguageState.CurrentLanguage)</div>
                        }
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-rf-outline" @onclick="() => deleteOpen = false">@UiText.BtnCancel(LanguageState.CurrentLanguage)</button>
                            <button type="button" class="btn rf-btn-danger-solid" disabled="@(deleting || string.IsNullOrEmpty(deletePassword))"
                                    @onclick="DeleteAccountAsync" data-test="account-delete-yes">@(deleting ? "..." : UiText.BtnDeleteAccountForever(LanguageState.CurrentLanguage))</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container-fluid px-0 py-4" style="max-width: 460px;">
            <h1 class="h3 fw-bold mb-4 pb-3 rf-page-title" style="border-bottom: 2px solid var(--rf-orange-primary);">
                @(isRegisterMode ? UiText.AccountRegisterTitle(LanguageState.CurrentLanguage) : UiText.AccountLoginTitle(LanguageState.CurrentLanguage))
            </h1>

            @if (errors.Count > 0)
            {
                <div class="alert alert-warning bg-dark border-warning text-warning p-2 small mb-3">
                    @foreach (var error in errors)
                    {
                        <div>@UiText.AuthError(error, LanguageState.CurrentLanguage)</div>
                    }
                </div>
            }

            <div class="mb-3">
                <label class="rf-form-label">Email</label>
                <input type="email" class="rf-form-control" autocomplete="username" @bind="email" />
            </div>
            <div class="mb-4">
                <label class="rf-form-label">@UiText.LabelPassword(LanguageState.CurrentLanguage)</label>
                <PasswordInput @bind-Value="password" Autocomplete="@(isRegisterMode ? "new-password" : "current-password")" DataTest="auth-password" />
                @if (isRegisterMode)
                {
                    <div class="small mt-2" style="color: var(--rf-text-muted);">@UiText.PasswordHint(LanguageState.CurrentLanguage)</div>
                }
                else
                {
                    <div class="text-end mt-2">
                        <a href="forgot-password" class="small" data-test="forgot-password-link">@UiText.LinkForgotPassword(LanguageState.CurrentLanguage)</a>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <button type="button" class="btn btn-link p-0 small" @onclick="ToggleMode">
                    @(isRegisterMode ? UiText.AccountSwitchToLogin(LanguageState.CurrentLanguage) : UiText.AccountSwitchToRegister(LanguageState.CurrentLanguage))
                </button>
                <button class="btn btn-rf-orange" @onclick="SubmitAsync" disabled="@isBusy">
                    @(isBusy ? "..." : isRegisterMode ? UiText.BtnRegister(LanguageState.CurrentLanguage) : UiText.BtnLogin(LanguageState.CurrentLanguage))
                </button>
            </div>

            @if (!isRegisterMode && passkeysSupported)
            {
                <div class="rf-login-or my-3"><span>@UiText.LoginOr(LanguageState.CurrentLanguage)</span></div>
                <button type="button" class="btn btn-rf-outline w-100" @onclick="PasskeySignInAsync" disabled="@isBusy" data-test="auth-passkey">
                    <Icon Name="key" /> @UiText.BtnPasskeyLogin(LanguageState.CurrentLanguage)
                </button>
            }
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool isRegisterMode;
    private bool isBusy;
    private string email = "";
    private string password = "";
    private List<string> errors = new();

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private AccountSummaryDto? summary;
    private string nickname = string.Empty;
    private string? nicknameMessage;
    private bool savingNickname;

    //	Nickname: checked here first (length, characters), then by the server (never two equal ones)
    private async Task SaveNicknameAsync()
    {
        var lang = LanguageState.CurrentLanguage;
        var value = RealmForge.Shared.Text.Nicknames.Clean(nickname);
        if (value is not null && !RealmForge.Shared.Text.Nicknames.IsValid(value))
        {
            nicknameMessage = UiText.NicknameInvalid(lang);
            return;
        }
        savingNickname = true;
        var (ok, status) = await Auth.SetNicknameAsync(value);
        savingNickname = false;
        nicknameMessage = ok
            ? (value is null ? UiText.NicknameRemoved(lang) : UiText.NicknameSaved(value, lang))
            : status == System.Net.HttpStatusCode.Conflict ? UiText.NicknameTaken(lang) : UiText.NicknameInvalid(lang);
        if (ok)
        {
            nickname = value ?? string.Empty;
        }
    }
    private string newEmail = string.Empty;
    private string? emailMessage;
    private bool changingEmail;
    private bool deleteOpen;
    private bool deleting;
    private string deletePassword = string.Empty;
    private string? deleteError;

    private async Task ChangeEmailAsync()
    {
        var lang = LanguageState.CurrentLanguage;
        var value = newEmail.Trim();
        if (value.Length == 0 || !value.Contains('@'))
        {
            emailMessage = UiText.AuthError("InvalidEmail", lang);
            return;
        }
        changingEmail = true;
        var result = await Auth.ChangeEmailAsync(value);
        changingEmail = false;
        emailMessage = result.Success ? UiText.EmailChangeSent(value, lang) : UiText.AuthError(result.Errors.FirstOrDefault() ?? "Unknown", lang);
        if (result.Success)
        {
            newEmail = string.Empty;
        }
    }

    private async Task DeleteAccountAsync()
    {
        deleting = true;
        var (result, error) = await Auth.DeleteAccountAsync(deletePassword);
        deleting = false;
        if (result is null)
        {
            deleteError = error;
            return;
        }
        deleteOpen = false;
        Navigation.NavigateTo("account-deleted");
    }

    private string currentPassword = "";
    private string newPassword = "";
    private string repeatPassword = "";
    private List<string> passwordErrors = new();
    private bool passwordChanged;
    private bool? wasAuthenticated;

    protected override void OnInitialized()
    {
        LanguageState.OnLanguageChanged += StateHasChanged;
        CrossTab.OnEmailConfirmed += HandleEmailConfirmed;
        CrossTab.OnTabVisible += HandleTabVisible;
    }

    //	Back to this tab while the e-mail is still unconfirmed: re-check (it may have been confirmed in another window)
    private void HandleTabVisible()
    {
        if (summary is { EmailConfirmed: false })
        {
            HandleEmailConfirmed();
        }
    }

    //	The e-mail was confirmed in another tab: refresh the status shown here
    private async void HandleEmailConfirmed()
    {
        if (wasAuthenticated == true)
        {
            summary = await Auth.GetAccountSummaryAsync();
            resendMessage = null;
            if (summary?.EmailConfirmed == true)
            {
                //	Keeps the cached authentication state (used by the create buttons) in step
                AuthStateProvider.Refresh();
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    //	The summary is (re)loaded whenever the authentication state changes (sign-in on this page, sign-out elsewhere)
    protected override async Task OnParametersSetAsync()
    {
        var authenticated = AuthState != null && (await AuthState).User.Identity?.IsAuthenticated == true;

        if (authenticated != wasAuthenticated)
        {
            wasAuthenticated = authenticated;
            summary = authenticated ? await Auth.GetAccountSummaryAsync() : null;
            nickname = summary?.Nickname ?? string.Empty;
            passkeysSupported = await Passkeys.IsSupportedAsync();
            passkeys = authenticated ? await Passkeys.GetPasskeysAsync() ?? new List<PasskeyDto>() : null;
        }
    }

    // ===== Passkeys =====

    private bool passkeysSupported;
    private List<PasskeyDto>? passkeys;
    private string passkeyName = string.Empty;
    private string? passkeyMessage;
    private bool addingPasskey;
    private PasskeyDto? removingPasskey;

    private async Task AddPasskeyAsync()
    {
        var lang = LanguageState.CurrentLanguage;
        addingPasskey = true;
        passkeyMessage = null;
        var result = await Passkeys.AddAsync(string.IsNullOrWhiteSpace(passkeyName) ? null : passkeyName.Trim());
        addingPasskey = false;
        passkeyMessage = result.Success ? UiText.PasskeyAdded(lang) : UiText.AuthError(result.Errors.FirstOrDefault() ?? "PasskeyFailed", lang);
        if (result.Success)
        {
            passkeyName = string.Empty;
            passkeys = await Passkeys.GetPasskeysAsync() ?? passkeys;
        }
    }

    private async Task RemovePasskeyAsync()
    {
        if (removingPasskey is { } passkey && await Passkeys.RemoveAsync(passkey.Id))
        {
            passkeys = await Passkeys.GetPasskeysAsync() ?? passkeys;
        }
        removingPasskey = null;
    }

    //	Sign-in with a passkey: the browser offers the ones it has for this site
    private async Task PasskeySignInAsync()
    {
        errors.Clear();
        isBusy = true;
        var result = await Passkeys.SignInAsync();
        isBusy = false;
        if (result.Success)
        {
            Navigation.NavigateTo("");
        }
        else
        {
            errors = result.Errors.ToList();
        }
    }

    private IEnumerable<(string Label, int Count, string Href)> HomebrewTiles(HomebrewCountsDto h)
    {
        var lang = LanguageState.CurrentLanguage;
        yield return (UiText.FeatsTitle(lang), h.Feats, "feats");
        yield return (UiText.NavSpecies(lang), h.Species, "species");
        yield return (UiText.LabelSubspeciesShort(lang), h.Subspecies, "species");
        yield return (UiText.BackgroundsTitle(lang), h.Backgrounds, "backgrounds");
        yield return (UiText.SpellsTitle(lang), h.Spells, "spells");
        yield return (UiText.ClassesTitle(lang), h.Classes, "classes");
        yield return (UiText.LabelSubclassesShort(lang), h.Subclasses, "classes");
        yield return (UiText.EquipmentTitle(lang), h.Equipment, "equipment");
        yield return (UiText.MonstersTitle(lang), h.Monsters, "monsters");
        yield return (UiText.MagicItemsTitle(lang), h.MagicItems, "magic-items");
    }

    private static string Initial(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();

    private bool isResending;
    private string? resendMessage;

    private async Task ResendConfirmationAsync()
    {
        if (summary is null)
        {
            return;
        }

        isResending = true;
        var result = await Auth.ResendConfirmationAsync(summary.Email);
        isResending = false;

        resendMessage = result.Success
            ? UiText.ConfirmationSent(summary.Email, LanguageState.CurrentLanguage)
            : UiText.AuthError(result.Errors.FirstOrDefault() ?? "Unknown", LanguageState.CurrentLanguage);
    }

    private async Task ChangePasswordAsync()
    {
        passwordErrors.Clear();
        passwordChanged = false;

        if (string.IsNullOrWhiteSpace(currentPassword) || string.IsNullOrWhiteSpace(newPassword))
        {
            passwordErrors.Add("MissingPasswords");
            return;
        }

        if (newPassword != repeatPassword)
        {
            passwordErrors.Add("PasswordsDiffer");
            return;
        }

        isBusy = true;
        var result = await Auth.ChangePasswordAsync(currentPassword, newPassword);
        isBusy = false;

        if (result.Success)
        {
            passwordChanged = true;
            currentPassword = newPassword = repeatPassword = "";
        }
        else
        {
            passwordErrors = result.Errors.ToList();
        }
    }

    private void ToggleMode()
    {
        isRegisterMode = !isRegisterMode;
        errors.Clear();
    }

    private async Task SubmitAsync()
    {
        errors.Clear();

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errors.Add("MissingFields");
            return;
        }

        isBusy = true;
        var result = isRegisterMode
            ? await Auth.RegisterAsync(email.Trim(), password)
            : await Auth.LoginAsync(email.Trim(), password);
        isBusy = false;

        if (result.Success)
        {
            password = "";
            Navigation.NavigateTo("");
        }
        else
        {
            errors = result.Errors.ToList();
        }
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
    }

    public void Dispose()
    {
        LanguageState.OnLanguageChanged -= StateHasChanged;
        CrossTab.OnEmailConfirmed -= HandleEmailConfirmed;
        CrossTab.OnTabVisible -= HandleTabVisible;
    }
}
