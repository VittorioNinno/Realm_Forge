@page "/confirm-email"
@using RealmForge.Client.Localization
@using RealmForge.Client.Services
@implements IDisposable
@inject AuthService Auth
@inject LanguageStateService LanguageState
@inject CrossTabService CrossTab

<PageTitle>RealmForge - @UiText.ConfirmEmailTitle(LanguageState.CurrentLanguage)</PageTitle>

@* Landing page of the link in the confirmation e-mail *@
<div class="container-fluid px-0 py-4" style="max-width: 560px;" data-test="confirm-email">
    <h1 class="h3 fw-bold mb-4 pb-3 rf-page-title" style="border-bottom: 2px solid var(--rf-orange-primary);">
        @UiText.ConfirmEmailTitle(LanguageState.CurrentLanguage)
    </h1>

    @if (result is null)
    {
        <p class="text-secondary">@UiText.ConfirmEmailWorking(LanguageState.CurrentLanguage)</p>
    }
    else if (result.Success)
    {
        <div class="alert bg-dark border-success text-success" data-test="confirm-email-ok">@UiText.ConfirmEmailDone(LanguageState.CurrentLanguage)</div>
        @if (otherTabOpen)
        {
            @* The tab already open has been updated: this one (opened from the e-mail) closes itself *@
            <p class="small text-secondary" data-test="confirm-email-closing">@UiText.ConfirmEmailOtherTab(LanguageState.CurrentLanguage)</p>
        }
        <a href="account" class="btn btn-rf-orange">@UiText.BtnGoToAccount(LanguageState.CurrentLanguage)</a>
    }
    else
    {
        <div class="alert alert-warning bg-dark border-warning text-warning" data-test="confirm-email-failed">
            @foreach (var error in result.Errors)
            {
                <div>@UiText.AuthError(error, LanguageState.CurrentLanguage)</div>
            }
        </div>
        <a href="account" class="btn btn-rf-outline">@UiText.BtnGoToAccount(LanguageState.CurrentLanguage)</a>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "userId")] public string? UserId { get; set; }
    [SupplyParameterFromQuery(Name = "code")] public string? Code { get; set; }
    [SupplyParameterFromQuery(Name = "changedEmail")] public string? ChangedEmail { get; set; }

    private AuthResult? result;
    private bool otherTabOpen;
    private bool announced;

    protected override async Task OnInitializedAsync()
    {
        LanguageState.OnLanguageChanged += StateHasChanged;

        result = string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Code)
            ? AuthResult.Fail("InvalidConfirmationLink")
            : await Auth.ConfirmEmailAsync(UserId, Code, ChangedEmail);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        //	The confirmation runs in OnInitializedAsync: act on the first render after it succeeded
        if (announced || result?.Success != true)
        {
            return;
        }

        announced = true;
        await CrossTab.AnnounceAsync(CrossTabService.EmailConfirmed);
        otherTabOpen = await CrossTab.HasOtherTabsAsync();

        if (otherTabOpen)
        {
            StateHasChanged();
            await Task.Delay(2500);
            await CrossTab.TryCloseAsync();
        }
    }

    public void Dispose() => LanguageState.OnLanguageChanged -= StateHasChanged;
}
