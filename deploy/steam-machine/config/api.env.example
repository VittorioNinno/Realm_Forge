# RealmForge API on myrealmforge.com. This file stays on the Steam Machine:
# never commit it. install.sh sets the database password.
ConnectionStrings__DefaultConnection=Host=realmforge-db;Port=5432;Database=realmforge;Username=realmforge;Password=__DB_PASSWORD__
Database__MigrateOnStartup=true

# Addresses of the site allowed to call the API (the domain and, during the move, the pages.dev address)
Cors__AllowedOrigins__0=https://myrealmforge.com
Cors__AllowedOrigins__1=https://realmforge-epr.pages.dev

# E-mails through Brevo (the API key and a sender of the domain verified in Brevo)
Email__ClientBaseUrl=https://myrealmforge.com
Email__BrevoApiKey=
Email__FromAddress=noreply@myrealmforge.com

# Administrator account (optional)
Auth__AdminEmails__0=
