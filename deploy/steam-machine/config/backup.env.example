# Backups of the database. Without the passphrase the backups cannot be opened: keep a copy in a password manager.
BACKUP_PASSPHRASE=
# Nightly backups kept, and weekly ones (the Sunday copy)
KEEP_DAILY=14
KEEP_WEEKLY=8
# Off-site copy with rclone (e.g. "gdrive:RealmForge-backup"), configured with scripts/rclone-config.sh; empty = local only
RCLONE_REMOTE=
# Optional: a URL pinged after every successful backup (e.g. a healthchecks.io check that e-mails you when it stops)
HEALTHCHECK_URL=
