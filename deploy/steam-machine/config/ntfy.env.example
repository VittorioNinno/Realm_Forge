# Notifications and commands on the phone with ntfy (app "ntfy" for Android and iOS, free, no account).
# install.sh fills in the two topics and the PIN with random values: whoever knows a topic can read or write it,
# so keep them like passwords and do not share them.
NTFY_SERVER=https://ntfy.sh
# Alerts and answers: subscribe to this topic in the app
NTFY_TOPIC=__NTFY_TOPIC__
# Commands: write here, from the app, e.g. "riavvia 123456"
NTFY_CMD_TOPIC=__NTFY_CMD_TOPIC__
# Required in every command; the buttons of the notifications add it on their own
NTFY_PIN=__NTFY_PIN__
# Optional: an access token, for an own ntfy server or reserved topics (tk_...)
NTFY_TOKEN=
# Minutes between two checks of database, API, tunnel and the site
NTFY_CHECK_MINUTES=5
