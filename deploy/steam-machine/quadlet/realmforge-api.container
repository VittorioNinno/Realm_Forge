# RealmForge API: the image published by GitHub at every release (publish-api-image.yml), updated by
# podman-auto-update. Applies the migrations and synchronizes the Base content at startup.
[Unit]
Description=RealmForge API
Requires=realmforge-db.service
After=realmforge-db.service

[Container]
ContainerName=realmforge-api
Image=ghcr.io/vittorioninno/realmforge-api:release
AutoUpdate=registry
Network=realmforge.network
EnvironmentFile=%h/realmforge/config/api.env
# Public resolvers for the names outside the network (api.brevo.com for the e-mails): the resolver of the machine
# (systemd-resolved on 127.0.0.53, the router) is not always reachable from the containers, and then every e-mail
# fails with "Resource temporarily unavailable". The names of the containers are still resolved by Podman.
DNS=1.1.1.1
DNS=9.9.9.9
Environment=PORT=8080

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=900

[Install]
WantedBy=default.target
