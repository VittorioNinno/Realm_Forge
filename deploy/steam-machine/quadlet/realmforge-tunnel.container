# Cloudflare Tunnel: publishes the API as https://api.<domain> without opening ports on the router.
# The public hostname (api.<domain> -> http://realmforge-api:8080) is set in the Cloudflare dashboard.
[Unit]
Description=RealmForge Cloudflare Tunnel
After=realmforge-api.service

[Container]
ContainerName=realmforge-tunnel
Image=docker.io/cloudflare/cloudflared:latest
AutoUpdate=registry
Network=realmforge.network
EnvironmentFile=%h/realmforge/config/tunnel.env
Exec=tunnel --no-autoupdate run

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
