# RealmForge database: PostgreSQL 18, reachable only on the realmforge network (no port on the machine)
[Unit]
Description=RealmForge database (PostgreSQL)

[Container]
ContainerName=realmforge-db
Image=docker.io/library/postgres:18
Network=realmforge.network
Volume=realmforge-db.volume:/var/lib/postgresql
EnvironmentFile=%h/realmforge/config/db.env
ShmSize=256m
HealthCmd=pg_isready -U realmforge -d realmforge
HealthInterval=30s
HealthStartPeriod=30s

[Service]
Restart=always
TimeoutStartSec=600

[Install]
WantedBy=default.target
